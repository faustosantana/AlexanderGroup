<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_justech_admin_product_kanban" model="ir.ui.view">
        <field name="name">justech.admin.product.kanban</field>
        <field name="model">justech.admin.product</field>
        <field name="arch" type="xml">
            <kanban class="o_jac_product_kanban" create="0" records_draggable="0">
                <field name="name"/>
                <field name="hierarchy_code"/>
                <field name="short_description"/>
                <field name="icon"/>
                <field name="meta_label"/>
                <field name="estado_general"/>
                <field name="status_visual"/>
                <templates>
                    <t t-name="card">
                        <div class="o_jac_product_card o_jac_card_interactive"
                             t-attf-class="o_jac_tone_#{record.status_visual.raw_value}">
                            <div class="o_jac_product_head">
                                <span class="o_jac_hierarchy_badge"><field name="hierarchy_code"/></span>
                                <i t-attf-class="fa #{record.icon.raw_value or 'fa-cube'}"/>
                                <strong><field name="name"/></strong>
                                <span class="o_jac_estado_pill"><field name="estado_general"/></span>
                            </div>
                            <p class="o_jac_product_desc"><field name="short_description"/></p>
                            <div class="o_jac_product_meta"><span><field name="meta_label"/></span></div>
                            <div class="o_jac_card_actions">
                                <button name="action_open_detail" type="object"
                                        class="btn btn-primary btn-sm o_jac_stretched"
                                        title="Abrir producto">
                                    Abrir
                                </button>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_justech_admin_product_list" model="ir.ui.view">
        <field name="name">justech.admin.product.list</field>
        <field name="model">justech.admin.product</field>
        <field name="arch" type="xml">
            <list create="0">
                <field name="hierarchy_code" string="Nº"/>
                <field name="name"/>
                <field name="meta_label"/>
                <field name="estado_general"/>
                <field name="status_visual" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_justech_admin_product_form" model="ir.ui.view">
        <field name="name">justech.admin.product.form</field>
        <field name="model">justech.admin.product</field>
        <field name="arch" type="xml">
            <form class="o_jac_product_form o_justech_admin_center" create="0" delete="0" edit="0">
                <header>
                    <button name="action_back_console" type="object" string="← Volver"
                            class="btn-secondary"/>
                    <button name="action_revisar_pendientes" type="object"
                            string="Resolver" class="btn-primary"
                            invisible="warning_count == 0 and error_count == 0"/>
                    <button name="action_open_company_matrix" type="object"
                            string="Configurar" class="btn-secondary"/>
                    <div class="o_jac_header_more dropdown">
                        <button type="button" class="btn btn-secondary dropdown-toggle"
                                data-bs-toggle="dropdown">Más</button>
                        <div class="dropdown-menu">
                            <button name="action_run_diagnostics" type="object"
                                    string="Diagnosticar" class="dropdown-item"/>
                            <button name="action_open_users" type="object"
                                    string="Permisos" class="dropdown-item"/>
                            <button name="action_open_audit" type="object"
                                    string="Auditoría" class="dropdown-item"/>
                            <button name="action_open_system_status" type="object"
                                    string="Estado del sistema" class="dropdown-item"/>
                        </div>
                    </div>
                    <field name="status_visual" widget="badge"/>
                    <field name="warning_count" invisible="1"/>
                    <field name="error_count" invisible="1"/>
                </header>
                <sheet>
                    <div class="oe_title o_jac_product_title">
                        <span class="o_jac_hierarchy_badge o_jac_hierarchy_lg">
                            <field name="hierarchy_code" readonly="1"/>
                        </span>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <p class="o_jac_product_lead"><field name="short_description" readonly="1"/></p>
                    <group>
                        <group>
                            <field name="estado_general" readonly="1" string="Estado"/>
                            <field name="meta_label" readonly="1" string="Cobertura"/>
                            <field name="recommended_action_help" readonly="1" string="Acción requerida"/>
                        </group>
                        <group>
                            <field name="last_validation_label" readonly="1" string="Última validación"/>
                            <field name="module_count" readonly="1" string="Capacidades"/>
                        </group>
                    </group>

                    <group string="Indicadores" invisible="code != 'warranty' or estado_general in ('No configurado', 'Inactivo')">
                        <group>
                            <field name="warranty_open_count" readonly="1"/>
                            <field name="warranty_claim_count" readonly="1"/>
                        </group>
                        <group>
                            <field name="warranty_expired_count" readonly="1"/>
                            <field name="warranty_pending_approval_count" readonly="1"/>
                        </group>
                    </group>

                    <separator string="Capacidades" invisible="code == 'warranty' and estado_general in ('No configurado', 'Inactivo')"/>
                    <field name="nav_module_ids" mode="kanban" nolabel="1"
                             invisible="code == 'warranty' and estado_general in ('No configurado', 'Inactivo')">
                        <kanban create="0" class="o_jac_module_kanban o_jac_module_grid">
                            <field name="hierarchy_code"/>
                            <field name="functional_name"/>
                            <field name="short_description"/>
                            <field name="status_visual"/>
                            <field name="estado_general"/>
                            <field name="coverage_label"/>
                            <field name="is_global"/>
                            <field name="icon"/>
                            <templates>
                                <t t-name="card">
                                    <div class="o_jac_card o_jac_card_interactive"
                                         t-attf-class="o_jac_tone_#{record.status_visual.raw_value}">
                                        <div class="o_jac_card_head">
                                            <span class="o_jac_hierarchy_badge"><field name="hierarchy_code"/></span>
                                            <strong><field name="functional_name"/></strong>
                                            <span class="o_jac_estado_pill"><field name="estado_general"/></span>
                                        </div>
                                        <div class="o_jac_card_body"><field name="short_description"/></div>
                                        <div class="o_jac_card_meta">
                                            <span><field name="coverage_label"/></span>
                                            <span t-if="record.is_global.raw_value">Servicio global</span>
                                        </div>
                                        <div class="o_jac_card_actions">
                                            <button name="action_open_admin" type="object"
                                                    class="btn btn-primary btn-sm">Administrar</button>
                                            <button name="action_view_status" type="object"
                                                    class="btn btn-link btn-sm">Ver estado</button>
                                        </div>
                                    </div>
                                </t>
                            </templates>
                        </kanban>
                    </field>

                    <div class="o_jac_empty" invisible="code != 'warranty' or estado_general not in ('No configurado', 'Inactivo')">
                        <p><strong>Justech Garantías no está activo para esta empresa.</strong></p>
                        <p>Active y configure el producto para registrar garantías, reclamaciones y reportes.</p>
                        <button name="action_open_company_matrix" type="object"
                                string="Configurar / Activar" class="btn btn-primary"/>
                    </div>

                    <group string="Capacidades de Garantías" invisible="code != 'warranty' or estado_general in ('No configurado', 'Inactivo')">
                        <div class="o_jac_kpi_grid o_jac_capability_grid">
                            <div class="o_jac_kpi_card"><span class="o_jac_hierarchy_badge">3.1</span><strong>Configuración</strong></div>
                            <div class="o_jac_kpi_card"><span class="o_jac_hierarchy_badge">3.2</span><strong>Registro y seguimiento</strong></div>
                            <div class="o_jac_kpi_card"><span class="o_jac_hierarchy_badge">3.3</span><strong>Reclamaciones</strong></div>
                            <div class="o_jac_kpi_card"><span class="o_jac_hierarchy_badge">3.4</span><strong>Aprobaciones</strong></div>
                            <div class="o_jac_kpi_card"><span class="o_jac_hierarchy_badge">3.5</span><strong>Cierre</strong></div>
                            <div class="o_jac_kpi_card"><span class="o_jac_hierarchy_badge">3.6</span><strong>Reportes</strong></div>
                        </div>
                        <button name="action_open_warranty_ops" type="object"
                                string="Abrir operación" class="btn btn-secondary"/>
                    </group>

                    <notebook>
                        <page string="Empresas" name="companies">
                            <field name="company_line_ids" mode="list">
                                <list create="0" delete="0">
                                    <field name="company_id"/>
                                    <field name="module_id" string="Capacidad"/>
                                    <field name="functional_state" string="Estado"/>
                                    <field name="fiscal_engine" string="Motor"/>
                                    <field name="is_global" column_invisible="1"/>
                                    <button name="action_prepare_activate" type="object" string="Activar" class="btn-link"
                                            invisible="functional_state == 'active' or is_global"/>
                                    <button name="action_prepare_deactivate" type="object" string="Desactivar" class="btn-link"
                                            invisible="functional_state != 'active' or is_global"/>
                                </list>
                            </field>
                        </page>
                        <page string="Información" name="info" groups="base.group_system">
                            <group>
                                <field name="code" readonly="1"/>
                                <field name="capabilities_text" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_justech_admin_product" model="ir.actions.act_window">
        <field name="name">Productos Justech</field>
        <field name="res_model">justech.admin.product</field>
        <field name="view_mode">kanban,list,form</field>
    </record>
</odoo>
