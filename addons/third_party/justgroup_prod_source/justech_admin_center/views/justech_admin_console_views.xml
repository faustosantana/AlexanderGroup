<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_justech_admin_console_form" model="ir.ui.view">
        <field name="name">justech.admin.console.form</field>
        <field name="model">justech.admin.console</field>
        <field name="arch" type="xml">
            <form class="o_justech_admin_center o_jac_console_clean" create="0" delete="0">
                <header>
                    <button name="action_apply_company" type="object" string="Actualizar"
                            class="btn-primary"
                            title="Recalcula el estado de la empresa seleccionada"/>
                    <button name="action_open_pending_center" type="object"
                            string="Resolver acciones"
                            class="btn-secondary"
                            invisible="pending_count == 0"/>
                    <button name="action_open_system_status" type="object"
                            string="Estado del sistema" class="btn-secondary"/>
                    <div class="o_jac_header_more dropdown">
                        <button type="button" class="btn btn-secondary dropdown-toggle"
                                data-bs-toggle="dropdown">Más</button>
                        <div class="dropdown-menu">
                            <button name="action_open_company_hub" type="object"
                                    string="Vista de empresa" class="dropdown-item"/>
                            <button name="action_open_users" type="object"
                                    string="Usuarios y roles" class="dropdown-item"/>
                            <button name="action_open_audit" type="object"
                                    string="Auditoría" class="dropdown-item"/>
                            <button name="action_run_diagnostics" type="object"
                                    string="Diagnosticar" class="dropdown-item"
                                    groups="justech_admin_center.group_justech_admin_center_manager"/>
                            <button name="action_sync_catalog" type="object"
                                    string="Sincronizar catálogo" class="dropdown-item"/>
                            <button name="action_reauth" type="object"
                                    string="Reautenticar" class="dropdown-item"/>
                            <button name="action_open_uat_technical" type="object"
                                    string="Revisar cuentas de prueba" class="dropdown-item"
                                    groups="base.group_system"/>
                        </div>
                    </div>
                    <field name="status_visual" widget="badge"
                            decoration-success="status_visual == 'green'"
                            decoration-warning="status_visual == 'yellow'"
                            decoration-danger="status_visual == 'red'"/>
                    <field name="session_ok" invisible="1"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>Administración Justech</h1>
                    </div>

                    <group class="o_jac_company_selector">
                        <group>
                            <field name="filter_company_id" string="Empresa (sesión y consola)"
                                    options="{'no_create': True, 'no_open': True}"
                                    help="Al actualizar, la cabecera de Odoo y esta consola usan la misma empresa."/>
                        </group>
                        <group>
                            <field name="status_label" readonly="1" string="Estado"/>
                            <field name="status_reason" readonly="1" string="Motivo"/>
                            <field name="pending_count" readonly="1"/>
                            <field name="last_sync_at" readonly="1"/>
                        </group>
                    </group>

                    <separator string="Acciones requeridas" invisible="pending_count == 0"/>
                    <field name="pending_ids" mode="kanban" nolabel="1"
                             invisible="pending_count == 0"
                             options="{'no_create': True}">
                        <kanban create="0" class="o_jac_module_kanban o_jac_module_grid">
                            <field name="name"/>
                            <field name="severity"/>
                            <field name="company_id"/>
                            <field name="product_id"/>
                            <field name="impact"/>
                            <field name="recommendation"/>
                            <field name="action_label"/>
                            <templates>
                                <t t-name="card">
                                    <div class="o_jac_card o_jac_tone_yellow">
                                        <div class="o_jac_card_head">
                                            <strong><field name="name"/></strong>
                                            <span class="o_jac_estado_pill"><field name="severity"/></span>
                                        </div>
                                        <div class="o_jac_card_meta">
                                            <span><field name="company_id"/></span>
                                            <span><field name="product_id"/></span>
                                        </div>
                                        <div class="o_jac_card_body"><field name="impact"/></div>
                                        <div class="o_jac_card_meta"><field name="recommendation"/></div>
                                        <div class="o_jac_card_actions">
                                            <button name="action_resolve" type="object"
                                                    class="btn btn-primary btn-sm">
                                                <field name="action_label"/>
                                            </button>
                                        </div>
                                    </div>
                                </t>
                            </templates>
                        </kanban>
                    </field>
                    <div class="o_jac_empty" invisible="pending_count != 0">
                        No hay acciones requeridas para esta empresa.
                    </div>

                    <separator string="Productos"/>
                    <field name="product_ids" mode="kanban" nolabel="1"
                             options="{'no_create': True, 'no_open': True}"
                             context="{'kanban_view_ref': 'justech_admin_center.view_justech_admin_product_kanban', 'justech_admin_company_id': filter_company_id}"/>

                    <separator string="Actividad reciente"/>
                    <field name="activity_ids" mode="list" nolabel="1" readonly="1">
                        <list create="0" delete="0" limit="5">
                            <field name="create_date" string="Fecha"/>
                            <field name="executed_by" string="Usuario"/>
                            <field name="summary" string="Acción"/>
                            <field name="result" string="Resultado"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_justech_admin_console" model="ir.actions.server">
        <field name="name">Administración Justech</field>
        <field name="model_id" ref="model_justech_admin_console"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_console()</field>
    </record>
</odoo>
