<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_justech_admin_module_company_list" model="ir.ui.view">
        <field name="name">justech.admin.module.company.list</field>
        <field name="model">justech.admin.module.company</field>
        <field name="arch" type="xml">
            <list>
                <field name="company_id" string="Empresa"/>
                <field name="product_id" string="Producto"/>
                <field name="module_id" string="Submódulo"/>
                <field name="is_global" column_invisible="1"/>
                <field name="functional_state" string="Estado" widget="badge"
                         decoration-success="functional_state == 'active'"
                         decoration-warning="functional_state in ('attention', 'inactive')"
                         decoration-danger="functional_state in ('blocked', 'error')"/>
                <field name="fiscal_engine" string="Motor fiscal"/>
                <field name="last_change_at" string="Último cambio"/>
                <button name="action_prepare_activate" type="object" string="Activar" class="btn-link"
                        invisible="functional_state == 'active' or is_global"/>
                <button name="action_prepare_deactivate" type="object" string="Desactivar" class="btn-link"
                        invisible="functional_state != 'active' or is_global"/>
                <button name="action_prepare_engine_change" type="object" string="Cambiar motor" class="btn-link"
                        invisible="is_global"/>
            </list>
        </field>
    </record>

    <record id="view_justech_admin_module_company_form" model="ir.ui.view">
        <field name="name">justech.admin.module.company.form</field>
        <field name="model">justech.admin.module.company</field>
        <field name="arch" type="xml">
            <form create="0" delete="0">
                <header>
                    <button name="action_prepare_activate" type="object" string="Activar" class="btn-success"
                            invisible="functional_state == 'active'"
                            groups="justech_admin_center.group_justech_admin_center_manager"/>
                    <button name="action_prepare_deactivate" type="object" string="Desactivar" class="btn-warning"
                            invisible="functional_state != 'active'"
                            groups="justech_admin_center.group_justech_admin_center_manager"/>
                    <button name="action_prepare_engine_change" type="object" string="Cambiar motor" class="btn-primary"
                            groups="justech_admin_center.group_justech_admin_center_manager"/>
                    <field name="functional_state" widget="badge"/>
                </header>
                <sheet>
                    <group>
                        <group string="Empresa">
                            <field name="company_id" readonly="1"/>
                            <field name="product_id" readonly="1"/>
                            <field name="module_id" readonly="1"/>
                        </group>
                        <group string="Estado funcional">
                            <field name="functional_state"/>
                            <field name="fiscal_engine"/>
                            <field name="last_change_at"/>
                            <field name="last_change_uid"/>
                        </group>
                    </group>
                    <group string="Notas">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_justech_admin_module_company_search" model="ir.ui.view">
        <field name="name">justech.admin.module.company.search</field>
        <field name="model">justech.admin.module.company</field>
        <field name="arch" type="xml">
            <search>
                <field name="company_id"/>
                <field name="module_id"/>
                <field name="product_id"/>
                <filter name="active_only" string="Activos" domain="[('functional_state', '=', 'active')]"/>
                <filter name="unconfigured" string="No configurados" domain="[('functional_state', '=', 'unconfigured')]"/>
                <group>
                    <filter name="group_company" string="Empresa" context="{'group_by': 'company_id'}"/>
                    <filter name="group_product" string="Producto" context="{'group_by': 'product_id'}"/>
                    <filter name="group_module" string="Submódulo" context="{'group_by': 'module_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_justech_admin_module_company" model="ir.actions.act_window">
        <field name="name">Estados por empresa</field>
        <field name="res_model">justech.admin.module.company</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_company': 1}</field>
    </record>
</odoo>
