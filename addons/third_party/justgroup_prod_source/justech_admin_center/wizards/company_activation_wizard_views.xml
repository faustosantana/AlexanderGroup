<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_justech_admin_company_activation_wizard_form" model="ir.ui.view">
        <field name="name">justech.admin.company.activation.wizard.form</field>
        <field name="model">justech.admin.company.activation.wizard</field>
        <field name="arch" type="xml">
            <form class="o_jac_activation_wizard">
                <field name="line_id" invisible="1"/>
                <field name="operation" invisible="1"/>
                <field name="show_engine" invisible="1"/>
                <div class="o_jac_section_title">
                    <field name="product_name" readonly="1" class="o_jac_inline"/> —
                    <field name="module_name" readonly="1" class="o_jac_inline"/>
                </div>
                <group>
                    <group>
                        <field name="company_name" string="Empresa"/>
                        <field name="before_state" string="Estado actual"/>
                        <field name="after_state" string="Estado nuevo"/>
                    </group>
                    <group invisible="not show_engine">
                        <field name="before_engine" invisible="not before_engine"/>
                        <field name="new_engine"/>
                    </group>
                </group>
                <group string="Este producto habilitará">
                    <field name="enables_text" nolabel="1" colspan="2"/>
                </group>
                <group string="Antes de activar" invisible="operation != 'activate'">
                    <field name="setup_text" nolabel="1" colspan="2"/>
                </group>
                <group string="No afecta">
                    <field name="no_impact" nolabel="1" colspan="2"/>
                </group>
                <group>
                    <field name="confirmation" string="Confirmo el cambio"/>
                </group>
                <footer>
                    <button name="action_apply" type="object" string="Activar ahora" class="btn-primary"
                            invisible="operation != 'activate'"
                            groups="justech_admin_center.group_justech_admin_center_manager"/>
                    <button name="action_apply" type="object" string="Desactivar" class="btn-primary"
                            invisible="operation != 'deactivate'"
                            groups="justech_admin_center.group_justech_admin_center_manager"/>
                    <button name="action_apply" type="object" string="Cambiar motor" class="btn-primary"
                            invisible="operation != 'engine'"
                            groups="justech_admin_center.group_justech_admin_center_manager"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
