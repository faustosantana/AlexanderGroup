<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_justech_admin_auth_wizard_form" model="ir.ui.view">
        <field name="name">justech.admin.auth.wizard.form</field>
        <field name="model">justech.admin.auth.wizard</field>
        <field name="arch" type="xml">
            <form string="Autenticación Administración Justech">
                <field name="info" nolabel="1" colspan="2" widget="html"/>
                <group>
                    <field name="password" password="True" placeholder="Clave maestra"/>
                </group>
                <footer>
                    <button name="action_unlock" type="object" string="Desbloquear" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
