<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_jac_role_assign_wizard_form" model="ir.ui.view">
        <field name="name">justech.admin.role.assign.wizard.form</field>
        <field name="model">justech.admin.role.assign.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group invisible="mode == 'matrix'">
                        <field name="mode" invisible="1"/>
                        <field name="user_id" string="Usuario"/>
                        <field name="role_code" string="Rol"/>
                        <field name="role_explanation"/>
                        <field name="preview_before"/>
                        <field name="preview_after"/>
                        <field name="confirmation"/>
                    </group>
                    <group invisible="mode != 'matrix'">
                        <field name="mode" invisible="1"/>
                        <field name="preview_html" nolabel="1" widget="html"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_apply" type="object" string="Aplicar" class="btn-primary"
                            invisible="mode == 'matrix'"/>
                    <button string="Cerrar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
