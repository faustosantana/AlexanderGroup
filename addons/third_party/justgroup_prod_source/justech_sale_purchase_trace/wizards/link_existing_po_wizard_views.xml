<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_justech_link_existing_po_wizard_form" model="ir.ui.view">
        <field name="name">justech.link.existing.po.wizard.form</field>
        <field name="model">justech.link.existing.po.wizard</field>
        <field name="arch" type="xml">
            <form string="Relacionar compra existente" class="o_justech_sp_wizard o_justech_sp_link_wizard">
                <field name="info_html" nolabel="1" colspan="2" invisible="not info_html"/>
                <group class="o_justech_sp_wizard_header">
                    <group>
                        <field name="document_type" widget="radio" string="Tipo de documento"/>
                    </group>
                    <group>
                        <field name="sale_order_id" string="Orden de venta"/>
                        <field name="company_id" string="Empresa" groups="base.group_multi_company"/>
                    </group>
                </group>
                <group class="o_justech_sp_wizard_filters" col="3">
                    <field name="partner_id" string="Proveedor (opcional)"/>
                    <button name="action_load_candidates"
                            type="object"
                            string="Actualizar candidatos"
                            class="btn-secondary o_justech_sp_refresh_btn"/>
                </group>
                <field name="line_ids"
                         class="o_justech_sp_wizard_table"
                         invisible="document_type != 'purchase_order'">
                    <list editable="bottom" create="0" class="o_justech_sp_list">
                        <field name="selected" string="Sel." width="48px"/>
                        <field name="purchase_order_id" string="OC" width="120px"/>
                        <field name="partner_id" string="Proveedor"/>
                        <field name="product_id" string="Producto"/>
                        <field name="sale_line_id" column_invisible="1"/>
                        <field name="qty_po" string="Cant. OC" width="90px"/>
                        <field name="qty_assigned" string="Ya relacionada" width="110px"/>
                        <field name="qty_available" string="Disponible" width="100px"/>
                        <field name="qty_to_assign" string="A relacionar" width="110px"/>
                        <field name="date_order" string="Fecha" width="120px" optional="show"/>
                        <field name="po_state_label" string="Estado" optional="hide"/>
                        <field name="match_level" string="Coincidencia" optional="hide"/>
                        <field name="match_reason" string="Razón" optional="hide"/>
                        <field name="match_score" column_invisible="1"/>
                        <field name="purchase_line_id" column_invisible="1"/>
                        <field name="snapshot_pending" column_invisible="1"/>
                        <field name="snapshot_available" column_invisible="1"/>
                    </list>
                </field>
                <field name="bill_line_ids"
                         class="o_justech_sp_wizard_table"
                         invisible="document_type != 'vendor_bill'">
                    <list editable="bottom" create="0" class="o_justech_sp_list">
                        <field name="selected" string="Sel." width="48px"/>
                        <field name="vendor_bill_id" string="Factura" width="120px"/>
                        <field name="partner_id" string="Proveedor"/>
                        <field name="product_id" string="Producto"/>
                        <field name="ncf_display" string="NCF/e-CF" width="130px"/>
                        <field name="qty_bill" string="Cantidad" width="90px"/>
                        <field name="qty_assigned" string="Ya relacionada" width="110px"/>
                        <field name="qty_available" string="Disponible" width="100px"/>
                        <field name="qty_to_assign" string="A relacionar" width="110px"/>
                        <field name="bill_state_label" string="Tipo" optional="hide"/>
                        <field name="source_po_name" string="OC origen" optional="hide"/>
                        <field name="description" string="Descripción" optional="hide"/>
                        <field name="sale_line_id" column_invisible="1"/>
                        <field name="amount_bill" column_invisible="1"/>
                        <field name="amount_assigned" column_invisible="1"/>
                        <field name="amount_available" column_invisible="1"/>
                        <field name="amount_to_assign" column_invisible="1"/>
                        <field name="currency_id" column_invisible="1"/>
                        <field name="info_note" string="Nota" optional="hide"/>
                        <field name="vendor_bill_line_id" column_invisible="1"/>
                        <field name="purchase_line_id" column_invisible="1"/>
                        <field name="purchase_order_id" column_invisible="1"/>
                        <field name="snapshot_pending" column_invisible="1"/>
                        <field name="snapshot_available" column_invisible="1"/>
                        <field name="snapshot_amount_available" column_invisible="1"/>
                    </list>
                </field>
                <footer class="o_justech_sp_wizard_footer">
                    <button name="action_confirm_link"
                            type="object"
                            string="Confirmar relación"
                            class="btn-primary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
