<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_justech_qty_assignment_list" model="ir.ui.view">
        <field name="name">justech.purchase.sale.qty.assignment.list</field>
        <field name="model">justech.purchase.sale.qty.assignment</field>
        <field name="arch" type="xml">
            <list string="Asignaciones compra-venta">
                <field name="purchase_order_id"/>
                <field name="purchase_line_id"/>
                <field name="sale_order_id"/>
                <field name="sale_line_id"/>
                <field name="product_id"/>
                <field name="quantity"/>
                <field name="state"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="action_justech_qty_assignment" model="ir.actions.act_window">
        <field name="name">Asignaciones OC↔Venta</field>
        <field name="res_model">justech.purchase.sale.qty.assignment</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_justech_qty_assignment"
              name="Asignaciones OC↔Venta"
              parent="purchase.menu_purchase_root"
              action="action_justech_qty_assignment"
              sequence="90"
              groups="justech_sale_purchase_trace.group_justech_trace_manager"/>
</odoo>
