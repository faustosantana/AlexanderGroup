<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_move_form_justech_trace" model="ir.ui.view">
        <field name="name">account.move.form.justech.trace</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button"
                        type="object"
                        name="action_justech_invoice_related_purchases"
                        icon="fa-shopping-cart"
                        invisible="move_type not in ('out_invoice', 'out_refund')"
                        groups="account.group_account_invoice,sales_team.group_sale_salesman,purchase.group_purchase_user">
                    <field name="justech_related_purchase_count" widget="statinfo" string="Compras relacionadas"/>
                </button>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="action_justech_invoice_buy_pending"
                        type="object"
                        string="Generar orden de compra"
                        invisible="move_type not in ('out_invoice', 'out_refund') or state == 'cancel'"
                        groups="sales_team.group_sale_salesman,purchase.group_purchase_user"/>
                <button name="action_justech_invoice_link_existing_po"
                        type="object"
                        string="Relacionar compra existente"
                        invisible="move_type not in ('out_invoice', 'out_refund') or state == 'cancel'"
                        groups="sales_team.group_sale_salesman,purchase.group_purchase_user"/>
            </xpath>
        </field>
    </record>
</odoo>
