<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Coverage list for smart button / invoice -->
    <record id="view_sale_order_line_purchase_coverage_list" model="ir.ui.view">
        <field name="name">sale.order.line.purchase.coverage.list</field>
        <field name="model">sale.order.line</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" string="Abastecimiento">
                <field name="order_id" string="Orden de venta"/>
                <field name="product_id" string="Producto"/>
                <field name="justech_qty_sold" string="Vendido"/>
                <field name="justech_qty_stock_covered" string="Stock"/>
                <field name="justech_qty_purchased" string="Comprado"/>
                <field name="justech_qty_pending_purchase" string="Falta comprar"/>
                <field name="justech_qty_received" string="Recibido"/>
                <field name="justech_qty_pending_receive" string="Falta recibir"/>
                <field name="justech_qty_physical" string="Disp. físico"/>
                <field name="justech_qty_delivered_cust" string="Entregado"/>
                <field name="justech_qty_pending_deliver" string="Falta entregar"/>
                <field name="justech_supply_state" string="Estado"/>
                <field name="justech_purchase_ref" string="OC / Proveedor"/>
                <field name="justech_vendor_bill_ref" string="Factura proveedor"/>
                <field name="justech_trace_cost" string="Costo"/>
                <field name="justech_cost_origin" string="Origen costo"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_sale_order_line_purchase_coverage_form" model="ir.ui.view">
        <field name="name">sale.order.line.purchase.coverage.form</field>
        <field name="model">sale.order.line</field>
        <field name="arch" type="xml">
            <form string="Detalle abastecimiento" create="0" edit="0">
                <sheet>
                    <group>
                        <group>
                            <field name="product_id"/>
                            <field name="order_id"/>
                            <field name="justech_supply_state"/>
                            <field name="justech_coverage_state"/>
                        </group>
                        <group>
                            <field name="justech_qty_sold"/>
                            <field name="justech_qty_stock_covered"/>
                            <field name="justech_qty_purchased"/>
                            <field name="justech_qty_pending_purchase"/>
                            <field name="justech_qty_received"/>
                            <field name="justech_qty_pending_receive"/>
                            <field name="justech_qty_physical"/>
                            <field name="justech_qty_commercial"/>
                            <field name="justech_qty_delivered_cust"/>
                            <field name="justech_qty_pending_deliver"/>
                        </group>
                    </group>
                    <separator string="Detalle por proveedor"/>
                    <field name="justech_vendor_supply_html" nolabel="1" colspan="2"/>
                    <group>
                        <field name="justech_trace_cost"/>
                        <field name="justech_cost_origin"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sale_order_form_justech_trace" model="ir.ui.view">
        <field name="name">sale.order.form.justech.trace</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="justech_qty_pending_purchase" invisible="1"/>
                <!-- Header entry points hidden: use Margins «Gestionar compras» hub.
                     Methods kept for hub «Crear nueva compra» / legacy callers. -->
                <button name="action_justech_buy_pending"
                        type="object"
                        string="Generar orden de compra"
                        class="btn-primary"
                        invisible="1"
                        groups="sales_team.group_sale_salesman,purchase.group_purchase_user"/>
                <button name="action_justech_link_existing_po"
                        type="object"
                        string="Relacionar compra existente"
                        invisible="1"
                        groups="sales_team.group_sale_salesman,purchase.group_purchase_user"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button"
                        type="object"
                        name="action_justech_open_purchases"
                        icon="fa-shopping-cart"
                        groups="sales_team.group_sale_salesman,purchase.group_purchase_user">
                    <field name="justech_purchase_count" widget="statinfo" string="Compras"/>
                </button>
                <button class="oe_stat_button"
                        type="object"
                        name="action_justech_open_purchase_coverage"
                        icon="fa-cubes"
                        groups="sales_team.group_sale_salesman,purchase.group_purchase_user">
                    <div class="o_stat_info">
                        <span class="o_stat_value">
                            <field name="justech_qty_pending_purchase"/>
                        </span>
                        <span class="o_stat_text">Abastecimiento</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//field[@name='order_line']/list" position="inside">
                <field name="justech_qty_stock_covered" optional="hide" string="Stock cubierto"/>
                <field name="justech_qty_purchased" optional="show" string="Comprado"/>
                <field name="justech_qty_pending_purchase" optional="show" string="Pend. compra"/>
                <field name="justech_qty_received" optional="hide" string="Recibido"/>
                <field name="justech_qty_pending_receive" optional="show" string="Pend. recibir"/>
                <field name="justech_qty_pending_deliver" optional="hide" string="Pend. entregar"/>
                <field name="justech_supply_state" optional="show" string="Abastecimiento"/>
                <field name="justech_coverage_state" optional="hide" string="Cobertura"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Abastecimiento" name="justech_supply"
                      groups="sales_team.group_sale_salesman,purchase.group_purchase_user">
                    <group>
                        <group string="Pendientes">
                            <field name="justech_qty_pending_purchase"/>
                            <field name="justech_qty_pending_receive"/>
                            <field name="justech_qty_pending_deliver"/>
                        </group>
                    </group>
                    <separator string="Resumen"/>
                    <field name="justech_supply_summary_html" nolabel="1" colspan="2"/>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Hide legacy bi_convert smart button; keep model/code for rollback -->
    <record id="view_sale_order_legacy_bi_convert_secondary" model="ir.ui.view">
        <field name="name">sale.order.form.legacy.bi.convert.secondary</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="bi_convert_purchase_from_sales.sale_order_view"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_open_purchase_order']" position="attributes">
                <attribute name="invisible">True</attribute>
            </xpath>
            <xpath expr="//button[@name='%(bi_convert_purchase_from_sales.action_transientmodel_wizard)d']" position="attributes">
                <attribute name="invisible">True</attribute>
            </xpath>
        </field>
    </record>

    <!-- Hide native sale_purchase "Purchase"/Compras; keep method for rollback -->
    <record id="view_sale_order_hide_native_purchase_stat" model="ir.ui.view">
        <field name="name">sale.order.form.hide.native.purchase.stat</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_purchase.sale_order_inherited_form_purchase"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_view_purchase_orders']" position="attributes">
                <attribute name="invisible">True</attribute>
            </xpath>
        </field>
    </record>
</odoo>
