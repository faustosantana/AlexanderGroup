<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        HOTFIX 2026.1.5 — NCF en PDF con dual-write OFF

        Causa: l10n_do imprime solo l10n_latam_document_number en #do_informations.
        Con dual-write OFF, justech_do_ncf puede estar lleno y LATAM vacío.
        Además #informations (donde Justech añadía NCF) está oculto por Studio
        (display:none; line-height:0) → el NCF no se ve en el PDF.

        Solución: lectura única vía justech_get_ncf() (FDP: Justech → LATAM).
        Solo QWeb. Sin write, sin dual-write, sin tocar datos.
    -->
    <template
        id="report_invoice_document_justech_do_ncf_sot"
        inherit_id="l10n_do_accounting.l10n_do_report_invoice_document"
        priority="55"
    >
        <!-- Tipo de comprobante: LATAM report_name, fallback Justech -->
        <xpath expr="//div[@id='do_informations']//span[@t-field='o.l10n_latam_document_type_id.report_name']" position="replace">
            <span t-if="o.l10n_latam_document_type_id" t-field="o.l10n_latam_document_type_id.report_name"/>
            <span t-elif="o.justech_do_document_type_id" t-field="o.justech_do_document_type_id"/>
        </xpath>

        <!-- Etiqueta NCF/e-NCF visible si hay NCF canónico (Justech o LATAM) -->
        <xpath expr="//div[@id='do_informations']//strong[@t-if='o.l10n_latam_document_number']" position="attributes">
            <attribute name="t-if">o.justech_get_ncf()</attribute>
        </xpath>

        <!-- Valor NCF: SoT justech_get_ncf() — no escribe, no depende solo de LATAM -->
        <xpath expr="//div[@id='do_informations']//span[@t-field='o.l10n_latam_document_number']" position="replace">
            <span t-esc="o.justech_get_ncf()"/>
        </xpath>
    </template>
</odoo>
