<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Hotfix 19.0.2.7.0 — moneda + vigencia NCF (solo QWeb)

        Origen "Impuestos DOP":
          account.document_tax_totals_company_currency_template
          llamado desde account.report_invoice_document cuando
          tax_totals['display_in_company_currency'] es True
          (documento != moneda compañía + display_invoice_tax_company_currency).

        Origen "Válida hasta:" vacío:
          l10n_do lee o.l10n_do_ncf_expiration_date (legacy),
          mientras el Motor Justech guarda la vigencia en
          justech_do_ncf_range_id.date_to (ej. B01 → 2026-12-31).
    -->

    <template
        id="justech_hide_document_tax_totals_company_currency"
        inherit_id="account.document_tax_totals_company_currency_template"
        priority="50"
    >
        <xpath expr="//div[hasclass('totals_taxes_company_currency')]" position="replace">
            <!-- Justech: sin bloque de impuestos/total en moneda de compañía -->
            <t/>
        </xpath>
    </template>

    <template
        id="report_invoice_document_justech_ncf_validity"
        inherit_id="l10n_do_accounting.l10n_do_report_invoice_document"
        priority="50"
    >
        <xpath expr="//span[@id='fiscal_exp_date']" position="replace">
            <t t-set="justech_ncf_validity_date"
               t-value="o.l10n_do_ncf_expiration_date or (o.justech_do_ncf_range_id.date_to if o.justech_do_ncf_range_id else False) or o.company_id.l10n_do_ncf_exp_date"/>
            <span
                id="fiscal_exp_date"
                t-if="justech_ncf_validity_date and o.state == 'posted' and o.justech_get_ncf() and ((o.move_type in ['out_invoice', 'out_refund'] and not o.is_ecf_invoice) or (o.is_ecf_invoice and o.l10n_latam_document_type_id and o.l10n_latam_document_type_id.doc_code_prefix and o.l10n_latam_document_type_id.doc_code_prefix[1:] not in ('32', '34')))"
            >
                <strong>
                    <t t-if="o.is_ecf_invoice">Vencimiento e-NCF:</t>
                    <t t-else="">Válida hasta:</t>
                </strong>
                <span id="ecf_exp_date" t-esc="justech_ncf_validity_date" t-options='{"widget": "date"}'/>
            </span>
        </xpath>
    </template>
</odoo>
