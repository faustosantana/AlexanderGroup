<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Permisos separados Opción C (anulacion fiscal vs reversión contable). -->
    <record id="group_justech_void_ncf" model="res.groups">
        <field name="name">Anular NCF (608)</field>
        <field name="comment">Puede anular números fiscales para reporte 608. No implica reversión contable.</field>
        <field name="implied_ids" eval="[(4, ref('justech_l10n_do_base.group_justech_do_fiscal_user'))]"/>
    </record>
    <record id="group_justech_reverse_invoice" model="res.groups">
        <field name="name">Revertir factura</field>
        <field name="comment">Puede abrir el flujo estándar de nota de crédito / reversión.</field>
        <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
    </record>
    <record id="group_justech_reverse_paid_invoice" model="res.groups">
        <field name="name">Revertir factura pagada</field>
        <field name="comment">Permite revertir facturas pagadas o parcialmente pagadas (sin borrar pagos).</field>
        <field name="implied_ids" eval="[(4, ref('group_justech_reverse_invoice'))]"/>
    </record>
    <record id="group_justech_reverse_and_replace" model="res.groups">
        <field name="name">Revertir y reemplazar factura</field>
        <field name="comment">Puede usar reverse + create invoice (factura sustituta).</field>
        <field name="implied_ids" eval="[(4, ref('group_justech_reverse_invoice'))]"/>
    </record>

    <record id="rule_justech_do_ncf_range_company" model="ir.rule">
        <field name="name">NCF Range: multi-company</field>
        <field name="model_id" ref="model_justech_do_ncf_range"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_justech_do_ncf_consumption_company" model="ir.rule">
        <field name="name">NCF Consumption: multi-company</field>
        <field name="model_id" ref="model_justech_do_ncf_consumption"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
