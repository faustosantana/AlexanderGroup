<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_justech_do_ncf_consumption_tree" model="ir.ui.view">
        <field name="name">justech.do.ncf.consumption.list</field>
        <field name="model">justech.do.ncf.consumption</field>
        <field name="arch" type="xml">
            <list create="0" edit="0">
                <field name="consumption_date"/>
                <field name="ncf"/>
                <field name="range_id"/>
                <field name="move_id"/>
                <field name="state"/>
                <field name="void_user_id" optional="hide"/>
                <field name="void_datetime" optional="hide"/>
                <field name="void_reason" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="action_justech_do_ncf_consumption" model="ir.actions.act_window">
        <field name="name">Consumo NCF</field>
        <field name="res_model">justech.do.ncf.consumption</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
