<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_justech_do_invoice_correct_wizard_form" model="ir.ui.view">
        <field name="name">justech.do.invoice.correct.wizard.form</field>
        <field name="model">justech.do.invoice.correct.wizard</field>
        <field name="arch" type="xml">
            <form string="Corregir o Anular">
                <field name="permission_blocked" invisible="1"/>
                <field name="can_direct_cancel" invisible="1"/>
                <field name="needs_cn_conversion" invisible="1"/>
                <div class="alert alert-warning" role="alert" invisible="not permission_blocked">
                    <h3><field name="permission_title" nolabel="1" class="oe_inline"/></h3>
                    <field name="permission_message" nolabel="1"/>
                    <group>
                        <field name="permission_company" string="Empresa" readonly="1"/>
                        <field name="permission_required" string="Permiso requerido" readonly="1"/>
                        <field name="permission_role" string="Rol autorizado" readonly="1"/>
                    </group>
                </div>
                <div class="alert alert-info" role="alert" invisible="permission_blocked">
                    <p>
                        <strong>Acción recomendada:</strong>
                        <field name="recommended_action" nolabel="1" class="oe_inline"/>
                    </p>
                    <field name="recommendation_reason" nolabel="1"/>
                </div>
                <div class="alert alert-danger" role="alert" invisible="not historical_alert or permission_blocked">
                    <field name="historical_alert" nolabel="1"/>
                </div>
                <div class="alert alert-warning" role="alert" invisible="not payment_warning or permission_blocked">
                    <field name="payment_warning" nolabel="1"/>
                </div>
                <div class="alert alert-danger" role="alert"
                     invisible="not delivery_block_alert or permission_blocked or action_choice != 'cancel_entry'">
                    <field name="delivery_block_alert" nolabel="1"/>
                </div>
                <div class="alert alert-warning" role="alert"
                     invisible="not cn_conversion_warning or permission_blocked or action_choice != 'cancel_entry'">
                    <field name="cn_conversion_warning" nolabel="1"/>
                </div>
                <div class="alert alert-warning" role="alert"
                     invisible="not included_in_607_warning or permission_blocked">
                    <field name="included_in_607_warning" nolabel="1"/>
                </div>
                <group invisible="permission_blocked">
                    <group string="Documento">
                        <field name="move_id"/>
                        <field name="partner_id"/>
                        <field name="ncf"/>
                        <field name="state"/>
                        <field name="payment_state"/>
                        <field name="amount_total"/>
                        <field name="amount_residual"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="fiscal_ui_status"/>
                        <field name="operational_ui_status"/>
                        <field name="delivery_state"/>
                    </group>
                    <group string="Decisión">
                        <field name="action_choice" widget="radio"/>
                        <field name="can_reverse" invisible="1"/>
                    </group>
                </group>
                <group string="Qué hará el ERP automáticamente" col="2" invisible="permission_blocked">
                    <field name="effect_accounting" string="Contable"/>
                    <field name="effect_fiscal" string="Fiscal"/>
                    <field name="effect_payments" string="Pagos"/>
                    <field name="effect_documents" string="Documentos"/>
                    <field name="effect_reports" string="Reportes DGII"/>
                </group>
                <group string="Declaración obligatoria — Cancelar factura y asiento"
                       invisible="permission_blocked or action_choice != 'cancel_entry'">
                    <div class="alert alert-danger" role="alert" colspan="2">
                        <p>
                            Confirmo que esta factura y su NCF no fueron entregados, enviados,
                            comunicados ni puestos a disposición del cliente. Entiendo que la
                            empresa deberá gestionar la anulación o rectificación correspondiente
                            ante la DGII.
                        </p>
                    </div>
                    <field name="not_delivered_declaration"/>
                    <field name="confirm_cn_cancel"
                           invisible="not needs_cn_conversion"/>
                    <field name="direct_cancel_reason" required="action_choice == 'cancel_entry'"/>
                    <field name="fiscal_treatment_planned" required="action_choice == 'cancel_entry'"/>
                    <field name="direct_cancel_type"/>
                    <field name="unknown_delivery_justification"
                           invisible="delivery_state != 'unknown'"
                           placeholder="Obligatorio si la entrega es Desconocido"/>
                </group>
                <group string="Confirmación" invisible="permission_blocked">
                    <field name="confirmation_summary" nolabel="1" colspan="2"/>
                    <field name="user_confirmed"/>
                </group>
                <footer>
                    <button name="action_continue"
                            string="Confirmar y ejecutar"
                            type="object"
                            class="btn-primary"
                            data-hotkey="q"
                            invisible="permission_blocked"/>
                    <button string="Cerrar" special="cancel" class="btn-secondary" data-hotkey="z"
                            invisible="not permission_blocked"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary" data-hotkey="z"
                            invisible="permission_blocked"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
