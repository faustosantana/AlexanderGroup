<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_justech_do_ncf_range_tree" model="ir.ui.view">
        <field name="name">justech.do.ncf.range.list</field>
        <field name="model">justech.do.ncf.range</field>
        <field name="arch" type="xml">
            <list string="Rangos NCF">
                <field name="name" string="Nombre"/>
                <field name="prefix" string="Prefijo"/>
                <field name="flow_kind" string="Flujo" optional="show"/>
                <field name="next_ncf_display" string="Próximo NCF"/>
                <field name="sequence_start" string="Inicial" optional="hide"/>
                <field name="sequence_end" string="Secuencia Final"/>
                <field name="next_sequence" string="Próxima" optional="hide"/>
                <field name="remaining_count" string="Disponibles"/>
                <field name="consumed_count" string="Consumidos" optional="hide"/>
                <field name="pct_used" string="% Consumido" widget="progressbar"/>
                <field name="date_to" string="Fecha de Vencimiento"/>
                <field name="state" string="Estado" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-muted="state == 'draft'"
                       decoration-danger="state in ('expired', 'depleted', 'cancelled')"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
            </list>
        </field>
    </record>
    <record id="view_justech_do_ncf_range_form" model="ir.ui.view">
        <field name="name">justech.do.ncf.range.form</field>
        <field name="model">justech.do.ncf.range</field>
        <field name="arch" type="xml">
            <form string="Rango NCF">
                <header>
                    <button name="action_justech_save_return_center" type="object"
                            string="Guardar y volver al Centro"
                            class="btn-primary"
                            invisible="not context.get('justech_range_center_return')"
                            groups="justech_l10n_do_base.group_justech_do_fiscal_manager,base.group_system"/>
                    <button name="action_activate" string="Activar" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_cancel" string="Cerrar" type="object"
                            invisible="state in ('cancelled', 'depleted', 'expired')"/>
                    <button name="action_set_draft" string="Volver a borrador" type="object"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,active,depleted,expired,cancelled"/>
                </header>
                <div class="alert alert-info" role="alert"
                     invisible="not context.get('justech_renew_hint')">
                    Renovación: ajuste fecha de vencimiento y/o secuencia final según
                    autorización DGII. No se inventan números ni se eliminan rangos.
                </div>
                <sheet>
                    <group>
                        <group string="Identificación">
                            <field name="name"/>
                            <field name="document_type_id"/>
                            <field name="prefix" readonly="1"/>
                            <field name="flow_kind" readonly="1"/>
                            <field name="authorization_number"/>
                        </group>
                        <group string="Vigencia">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="journal_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <group string="Secuencia">
                        <field name="sequence_start"/>
                        <field name="sequence_end"/>
                        <field name="next_sequence"/>
                        <field name="next_ncf_display" readonly="1"/>
                        <field name="authorized_total" readonly="1"/>
                        <field name="consumed_count" readonly="1"/>
                        <field name="remaining_count" readonly="1"/>
                        <field name="pct_used" widget="progressbar" readonly="1"/>
                    </group>
                    <group string="Alertas (opcional)" groups="justech_l10n_do_base.group_justech_do_fiscal_manager">
                        <field name="alert_threshold_preventive"/>
                        <field name="alert_threshold_critical"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_justech_do_ncf_range" model="ir.actions.act_window">
        <field name="name">Ver rangos NCF</field>
        <field name="res_model">justech.do.ncf.range</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
