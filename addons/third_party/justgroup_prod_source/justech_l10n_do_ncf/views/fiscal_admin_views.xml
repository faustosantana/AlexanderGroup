<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_justech_do_ncf_admin_center_form" model="ir.ui.view">
        <field name="name">justech.do.ncf.admin.center.form</field>
        <field name="model">justech.do.ncf.admin.center</field>
        <field name="arch" type="xml">
            <form string="Centro de Administración Fiscal">
                <header>
                    <button name="action_refresh" string="Actualizar" type="object" class="btn-primary"/>
                    <button name="action_run_diagnostic" string="Ejecutar diagnóstico" type="object" class="btn-secondary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>Administración Fiscal NCF</h1>
                        <h2 class="text-muted">
                            <field name="company_id" readonly="1" options="{'no_open': True}"/>
                        </h2>
                    </div>
                    <group string="Resumen operativo">
                        <group>
                            <field name="active_range_count" string="Rangos activos"/>
                            <field name="expiring_range_count" string="Por vencer"/>
                            <field name="depleted_range_count" string="Agotados"/>
                        </group>
                        <group>
                            <field name="voided_consumption_count" string="NCF anulados"/>
                        </group>
                    </group>
                    <group string="Accesos rápidos">
                        <button name="action_open_active_ranges" type="object" string="Ver rangos activos" class="btn-link"/>
                        <button name="action_open_ranges" type="object" string="Todos los rangos" class="btn-link"/>
                        <button name="action_open_consumption" type="object" string="Consumo NCF" class="btn-link"/>
                        <button name="action_open_voided_consumption" type="object" string="Anulaciones" class="btn-link"/>
                        <button name="action_open_document_types" type="object" string="Tipos de comprobante" class="btn-link"/>
                    </group>
                    <group string="Migración / reconciliación"
                           groups="base.group_system,justech_l10n_do_base.group_justech_do_fiscal_manager">
                        <button name="action_open_ncf_migration" type="object"
                                string="Migrar numeración fiscal al Motor Justech" class="btn-primary"/>
                        <button name="action_open_ncf_reconcile" type="object"
                                string="Reconciliar numeración fiscal" class="btn-secondary"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_justech_do_ncf_admin_center" model="ir.actions.server">
        <field name="name">Centro de Administración Fiscal</field>
        <field name="model_id" ref="model_justech_do_ncf_admin_center"/>
        <field name="state">code</field>
        <field name="code">action = env['justech.do.ncf.admin.center'].open_for_user(env)</field>
    </record>
</odoo>
