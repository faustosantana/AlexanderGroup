<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form_margin_control" model="ir.ui.view">
        <field name="name">account.move.form.margin.control</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button name="action_view_margin_transactions" type="object" class="oe_stat_button" icon="fa-line-chart"
                        groups="justech_purchase_sale_margin_control.group_margin_readonly"
                        invisible="margin_transaction_count == 0">
                    <field name="margin_transaction_count" widget="statinfo" string="Operación margen"/>
                </button>
                <button name="action_view_related_purchase_orders" type="object" class="oe_stat_button" icon="fa-shopping-cart"
                        groups="justech_purchase_sale_margin_control.group_margin_readonly"
                        invisible="move_type not in ('out_invoice', 'out_refund') or jm_related_purchase_order_count == 0">
                    <field name="jm_related_purchase_order_count" widget="statinfo" string="Costos relacionados"/>
                </button>
                <button name="action_view_related_vendor_bills" type="object" class="oe_stat_button" icon="fa-file-text-o"
                        groups="justech_purchase_sale_margin_control.group_margin_purchase,justech_purchase_sale_margin_control.group_margin_finance,justech_purchase_sale_margin_control.group_margin_admin,justech_purchase_sale_margin_control.group_margin_auditor"
                        invisible="move_type not in ('out_invoice', 'out_refund') or jm_related_vendor_bill_count == 0">
                    <field name="jm_related_vendor_bill_count" widget="statinfo" string="Facturas proveedor"/>
                </button>
                <button name="action_view_related_sales" type="object" class="oe_stat_button" icon="fa-shopping-bag"
                        groups="justech_purchase_sale_margin_control.group_margin_readonly"
                        invisible="move_type not in ('in_invoice', 'in_refund') or related_sale_count == 0">
                    <field name="related_sale_count" widget="statinfo" string="Ventas relacionadas"/>
                </button>
                <button name="action_open_cost_allocations" type="object" class="oe_stat_button" icon="fa-balance-scale"
                        groups="justech_purchase_sale_margin_control.group_margin_purchase,justech_purchase_sale_margin_control.group_margin_finance,justech_purchase_sale_margin_control.group_margin_admin"
                        invisible="cost_allocation_count == 0">
                    <field name="cost_allocation_count" widget="statinfo" string="Asignaciones de costo"/>
                </button>
                <button name="action_view_payable_auxiliary" type="object" class="oe_stat_button" icon="fa-book"
                        groups="justech_purchase_sale_margin_control.group_margin_finance,justech_purchase_sale_margin_control.group_margin_admin"
                        invisible="move_type not in ('in_invoice', 'in_refund') or not has_payable_auxiliary">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Auxiliar CxP</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="action_manage_purchases" type="object"
                        string="Gestionar compras" class="btn-primary"
                        groups="justech_purchase_sale_margin_control.group_margin_purchase,justech_purchase_sale_margin_control.group_margin_finance,justech_purchase_sale_margin_control.group_margin_admin"
                        invisible="move_type not in ('out_invoice', 'out_refund')"/>
                <button name="action_view_margin_transactions" type="object"
                        string="Ver operación" class="btn-secondary"
                        groups="justech_purchase_sale_margin_control.group_margin_readonly"
                        invisible="margin_transaction_count == 0 or move_type not in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund')"/>
                <!-- Legacy / internal: keep methods, hide from invoice UX -->
                <button name="action_create_or_link_margin_transaction" type="object"
                        string="Crear/vincular operación de margen" class="btn-secondary"
                        invisible="1"/>
                <button name="action_relate_purchases" type="object"
                        string="Relacionar compras" class="btn-secondary"
                        invisible="1"/>
                <button name="action_add_purchase_orders" type="object"
                        string="Agregar órdenes de compra" class="btn-secondary"
                        invisible="1"/>
            </xpath>
            <xpath expr="//sheet/notebook" position="before">
                <group string="Control de Costos y Margen" name="margin_out_panel"
                       groups="justech_purchase_sale_margin_control.group_margin_readonly"
                       invisible="move_type not in ('out_invoice', 'out_refund') or margin_transaction_count == 0">
                    <group>
                        <field name="margin_control_cost"
                                 groups="justech_purchase_sale_margin_control.group_margin_purchase,justech_purchase_sale_margin_control.group_margin_finance,justech_purchase_sale_margin_control.group_margin_admin,justech_purchase_sale_margin_control.group_margin_auditor"/>
                        <field name="margin_control_margin"
                                 groups="justech_purchase_sale_margin_control.group_margin_sales,justech_purchase_sale_margin_control.group_margin_purchase,justech_purchase_sale_margin_control.group_margin_finance,justech_purchase_sale_margin_control.group_margin_admin,justech_purchase_sale_margin_control.group_margin_auditor"/>
                        <field name="margin_control_margin_pct"
                                 groups="justech_purchase_sale_margin_control.group_margin_sales,justech_purchase_sale_margin_control.group_margin_purchase,justech_purchase_sale_margin_control.group_margin_finance,justech_purchase_sale_margin_control.group_margin_admin,justech_purchase_sale_margin_control.group_margin_auditor"/>
                        <field name="margin_control_state"/>
                    </group>
                    <group>
                        <field name="jm_related_purchase_order_ids" widget="many2many_tags" readonly="1"/>
                        <field name="jm_related_vendor_bill_ids" widget="many2many_tags" readonly="1"
                                 groups="justech_purchase_sale_margin_control.group_margin_purchase,justech_purchase_sale_margin_control.group_margin_finance,justech_purchase_sale_margin_control.group_margin_admin,justech_purchase_sale_margin_control.group_margin_auditor"/>
                    </group>
                </group>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Costos, Márgenes y CxP" name="justech_margin_cxp"
                      invisible="move_type not in ('in_invoice', 'in_refund')"
                      groups="justech_purchase_sale_margin_control.group_margin_readonly">
                    <field name="has_payable_auxiliary" invisible="1"/>
                    <field name="margin_transaction_count" invisible="1"/>
                    <field name="related_sale_count" invisible="1"/>
                    <div class="alert alert-info" role="alert" invisible="not has_payable_auxiliary">
                        Estado operativo CxP: <field name="margin_operational_state" readonly="1" nolabel="1"/>
                    </div>
                    <group string="Ventas / operación">
                        <field name="jm_related_sale_order_ids" widget="many2many_tags" readonly="1"/>
                        <field name="jm_related_customer_invoice_ids" widget="many2many_tags" readonly="1"/>
                        <field name="margin_transaction_ids" widget="many2many_tags" readonly="1"/>
                        <field name="margin_control_margin"
                                 groups="justech_purchase_sale_margin_control.group_margin_purchase,justech_purchase_sale_margin_control.group_margin_finance,justech_purchase_sale_margin_control.group_margin_admin,justech_purchase_sale_margin_control.group_margin_auditor"/>
                        <field name="margin_control_state"/>
                    </group>
                    <group string="Acciones de Costos y Márgenes"
                           groups="justech_purchase_sale_margin_control.group_margin_purchase,justech_purchase_sale_margin_control.group_margin_finance,justech_purchase_sale_margin_control.group_margin_admin">
                        <div>
                            <button name="action_create_or_link_margin_transaction" type="object"
                                    string="Crear/vincular operación de margen" class="btn btn-secondary"
                                    invisible="margin_transaction_count &gt; 0"/>
                            <button name="action_view_margin_transactions" type="object"
                                    string="Ver operación de margen" class="btn btn-secondary"
                                    invisible="margin_transaction_count == 0"/>
                            <button name="action_relate_sales" type="object"
                                    string="Relacionar ventas" class="btn btn-secondary"/>
                            <button name="action_classify_costs" type="object"
                                    string="Clasificar costos" class="btn btn-secondary"/>
                            <button name="action_view_payable_auxiliary" type="object"
                                    string="Ver auxiliar CxP" class="btn btn-secondary"
                                    invisible="not has_payable_auxiliary"/>
                        </div>
                    </group>
                    <group>
                        <field name="payable_auxiliary_id" readonly="1"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
