<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_purchase_sale_prorate_wizard_form" model="ir.ui.view">
        <field name="name">purchase.sale.prorate.wizard.form</field>
        <field name="model">purchase.sale.prorate.wizard</field>
        <field name="arch" type="xml">
            <form string="Prorratear costo adicional">
                <sheet>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="vendor_bill_line_id"/>
                            <field name="purchase_order_id"/>
                        </group>
                        <group>
                            <field name="additional_cost_type"/>
                            <field name="prorate_method"/>
                            <field name="currency_id"/>
                            <field name="total_amount"/>
                        </group>
                    </group>
                    <button name="action_load_lines" type="object" string="Cargar líneas de la OC" class="btn-secondary"/>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="purchase_order_line_id" readonly="1"/>
                            <field name="sale_order_id"/>
                            <field name="sale_order_line_id" domain="[('order_id', '=', sale_order_id)]"/>
                            <field name="base_value"/>
                            <field name="share_pct" readonly="1"/>
                            <field name="proposed_amount" readonly="1" sum="Total"/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button name="action_apply" type="object" string="Aplicar prorrateo" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_purchase_sale_prorate_wizard" model="ir.actions.act_window">
        <field name="name">Prorratear costo adicional</field>
        <field name="res_model">purchase.sale.prorate.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
