<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="0">
    <record id="rule_justech_withholding_catalog_company" model="ir.rule">
        <field name="name">Withholding Catalog: multi-company (global + company)</field>
        <field name="model_id" ref="model_justech_do_withholding_catalog"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_justech_payment_withholding_line_company" model="ir.rule">
        <field name="name">Payment Withholding Line: multi-company</field>
        <field name="model_id" ref="model_justech_payment_withholding_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_justech_payment_application_line_company" model="ir.rule">
        <field name="name">Payment Application Line: multi-company</field>
        <field name="model_id" ref="model_justech_payment_application_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_justech_wh_company_config_company" model="ir.rule">
        <field name="name">Withholding Company Config: multi-company</field>
        <field name="model_id" ref="model_justech_do_withholding_company_config"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
