<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Modal / formulario Detalle por factura -->
    <record id="view_justech_payment_application_line_form" model="ir.ui.view">
        <field name="name">justech.payment.application.line.form</field>
        <field name="model">justech.payment.application.line</field>
        <field name="arch" type="xml">
            <form string="Detalle por factura" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group string="Aplicación">
                            <field name="payment_id" string="Pago"/>
                            <field name="invoice_name" string="Factura"/>
                            <field name="invoice_date" string="Fecha"/>
                            <field name="applied_amount" string="Monto aplicado"/>
                            <field name="withholding_amount" string="Monto retenido"/>
                            <field name="reconciliation_state" string="Estado de conciliación"/>
                            <field name="company_id" string="Empresa"/>
                            <field name="move_currency_id" string="Moneda de factura"/>
                            <field name="payment_state" string="Estado de pago" widget="badge"/>
                        </group>
                        <group string="Factura">
                            <field name="move_id" string="Factura enlazada"/>
                            <field name="ncf" string="NCF / e-CF"/>
                            <field name="invoice_total" string="Total factura"/>
                            <field name="withholding_labels" string="Retenciones"/>
                            <field name="net_amount" string="Neto"/>
                            <field name="currency_id" string="Moneda"/>
                            <field name="partner_id" string="Cliente / Proveedor"/>
                            <field name="amount_residual" string="Balance pendiente"/>
                        </group>
                    </group>
                    <footer>
                        <button name="action_justech_open_invoice" type="object"
                                string="Abrir factura" class="btn-primary"/>
                        <button name="action_justech_open_partner" type="object"
                                string="Abrir contacto" class="btn-secondary"/>
                        <button name="action_justech_open_payment" type="object"
                                string="Abrir pago" class="btn-secondary"/>
                        <button string="Cerrar" special="cancel" class="btn-secondary"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_account_payment_form_justech_wh" model="ir.ui.view">
        <field name="name">account.payment.form.justech.wh</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <div class="alert alert-warning" role="alert"
                     invisible="not justech_legacy_ret_journal">
                    <field name="justech_legacy_ret_warning" readonly="1" nolabel="1"/>
                </div>
                <field name="justech_legacy_ret_journal" invisible="1"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_justech_view_related_invoices"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-file-text-o"
                        invisible="justech_related_invoice_count == 0">
                    <field name="justech_related_invoice_count" widget="statinfo" string="Facturas"/>
                </button>
                <button name="action_justech_view_payment_move"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-book"
                        invisible="not move_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Asiento</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Facturas relacionadas" name="justech_related_invoices"
                      invisible="not reconciled_invoice_ids and not reconciled_bill_ids and not justech_application_line_ids">
                    <div class="mb-2">
                        <button name="action_justech_refresh_related_invoices"
                                type="object"
                                string="Actualizar detalle"
                                class="btn btn-secondary"
                                icon="fa-refresh"
                                invisible="state not in ('posted', 'in_process', 'paid')"/>
                    </div>
                    <field name="justech_application_line_ids"
                           readonly="1"
                           nolabel="1"
                           invisible="not justech_application_line_ids"
                           context="{'form_view_ref': 'justech_l10n_do_payments_withholding.view_justech_payment_application_line_form'}">
                        <list create="0"
                              delete="0"
                              edit="0"
                              open_form_view="1"
                              limit="10"
                              decoration-success="payment_state == 'paid'"
                              decoration-warning="payment_state == 'partial'"
                              decoration-muted="payment_state in ('not_paid', 'reversed')">
                            <field name="move_id" string="Factura"/>
                            <field name="invoice_name" column_invisible="1"/>
                            <field name="ncf" string="NCF / e-CF"/>
                            <field name="partner_id" string="Contacto"/>
                            <field name="invoice_total" string="Total"/>
                            <field name="applied_amount" string="Aplicado" sum="Aplicado"/>
                            <field name="amount_residual" string="Balance pendiente"/>
                            <field name="move_currency_id" column_invisible="1"/>
                            <field name="payment_state" string="Estado de pago" widget="badge"
                                      decoration-success="payment_state == 'paid'"
                                      decoration-warning="payment_state == 'partial'"
                                      decoration-info="payment_state == 'in_payment'"
                                      decoration-danger="payment_state == 'reversed'"/>
                            <field name="currency_id" column_invisible="1"/>
                            <button name="action_justech_open_invoice"
                                    type="object"
                                    string="Abrir factura"
                                    icon="fa-external-link"
                                    title="Abrir factura"/>
                            <button name="action_justech_open_partner"
                                    type="object"
                                    string="Contacto"
                                    icon="fa-user"
                                    title="Abrir cliente/proveedor"/>
                            <button name="action_justech_open_payment"
                                    type="object"
                                    string="Pago"
                                    icon="fa-money"
                                    title="Abrir pago"/>
                        </list>
                    </field>
                    <group invisible="justech_application_line_ids">
                        <field name="reconciled_invoice_ids"
                               string="Facturas de cliente"
                               readonly="1"
                               invisible="not reconciled_invoice_ids"
                               context="{'form_view_ref': 'account.view_move_form'}">
                            <list create="0" delete="0" edit="0" open_form_view="1" limit="10">
                                <field name="name" string="Factura"/>
                                <field name="justech_do_ncf" string="NCF / e-CF"/>
                                <field name="partner_id" string="Contacto"/>
                                <field name="amount_total" string="Total"/>
                                <field name="amount_residual" string="Balance pendiente"/>
                                <field name="payment_state" string="Estado de pago" widget="badge"/>
                            </list>
                        </field>
                        <field name="reconciled_bill_ids"
                               string="Facturas de proveedor"
                               readonly="1"
                               invisible="not reconciled_bill_ids"
                               context="{'form_view_ref': 'account.view_move_form'}">
                            <list create="0" delete="0" edit="0" open_form_view="1" limit="10">
                                <field name="name" string="Factura"/>
                                <field name="justech_do_ncf" string="NCF / e-CF"/>
                                <field name="partner_id" string="Contacto"/>
                                <field name="amount_total" string="Total"/>
                                <field name="amount_residual" string="Balance pendiente"/>
                                <field name="payment_state" string="Estado de pago" widget="badge"/>
                            </list>
                        </field>
                    </group>
                </page>
                <page string="Retenciones aplicadas" name="justech_withholding"
                      invisible="not justech_withholding_line_ids">
                    <group>
                        <field name="justech_applied_amount" readonly="1"/>
                        <field name="justech_withholding_total" readonly="1"/>
                        <field name="justech_net_transfer" readonly="1"/>
                    </group>
                    <field name="justech_withholding_line_ids" readonly="1">
                        <list>
                            <field name="move_id" string="Factura"/>
                            <field name="ncf"/>
                            <field name="label" string="Retención"/>
                            <field name="withholding_type" string="Tipo" optional="show"/>
                            <field name="base_amount" string="Base"/>
                            <field name="rate" string="%"/>
                            <field name="amount" string="Importe"/>
                            <field name="dgii_withholding_code" string="Código DGII"/>
                            <field name="fiscal_report_codes" string="Reportes"/>
                            <field name="date" string="Fecha"/>
                            <field name="account_id" optional="hide"/>
                            <field name="state" string="Estado"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_account_move_form_justech_wh" model="ir.ui.view">
        <field name="name">account.move.form.justech.wh</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_justech_view_withholdings"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-percent"
                        invisible="justech_withholding_count == 0">
                    <field name="justech_withholding_count" widget="statinfo" string="Retenciones"/>
                </button>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Retenciones" name="justech_withholding"
                      invisible="not justech_withholding_line_ids">
                    <field name="justech_withholding_line_ids" readonly="1">
                        <list>
                            <field name="payment_id" string="Pago"/>
                            <field name="label" string="Retención"/>
                            <field name="amount" string="Importe"/>
                            <field name="date" string="Fecha"/>
                            <field name="dgii_withholding_code" string="Código DGII"/>
                            <field name="fiscal_report_codes" string="Reporte DGII"/>
                            <field name="state" string="Estado"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
