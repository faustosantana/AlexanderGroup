<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_justech_do_report_606" model="ir.actions.act_window">
        <field name="name">606 — Compras</field>
        <field name="res_model">justech.do.fiscal.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_justech_do_fiscal_report_wizard"/>
        <field name="target">new</field>
        <field name="context">{'default_report_type': '606'}</field>
    </record>
    <record id="action_justech_do_report_607" model="ir.actions.act_window">
        <field name="name">607 — Ventas</field>
        <field name="res_model">justech.do.fiscal.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_justech_do_fiscal_report_wizard"/>
        <field name="target">new</field>
        <field name="context">{'default_report_type': '607'}</field>
    </record>
    <record id="action_justech_do_report_608" model="ir.actions.act_window">
        <field name="name">608 — Comprobantes Anulados</field>
        <field name="res_model">justech.do.fiscal.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_justech_do_fiscal_report_wizard"/>
        <field name="target">new</field>
        <field name="context">{'default_report_type': '608'}</field>
    </record>
    <record id="action_justech_do_report_609" model="ir.actions.act_window">
        <field name="name">609 — Pagos al Exterior</field>
        <field name="res_model">justech.do.fiscal.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_justech_do_fiscal_report_wizard"/>
        <field name="target">new</field>
        <field name="context">{'default_report_type': '609'}</field>
    </record>
    <record id="action_justech_do_report_623" model="ir.actions.act_window">
        <field name="name">623 — Retenciones del Estado</field>
        <field name="res_model">justech.do.fiscal.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_justech_do_fiscal_report_wizard"/>
        <field name="target">new</field>
        <field name="context">{'default_report_type': '623'}</field>
    </record>
    <record id="action_justech_do_ncf_voided" model="ir.actions.act_window">
        <field name="name">NCF Anulados</field>
        <field name="res_model">justech.do.ncf.consumption</field>
        <field name="view_mode">list</field>
        <field name="domain">[('state', '=', 'voided')]</field>
    </record>
    <record id="action_justech_do_audit_consumption" model="ir.actions.act_window">
        <field name="name">Consumo NCF</field>
        <field name="res_model">justech.do.ncf.consumption</field>
        <field name="view_mode">list</field>
        <field name="domain">[('state', '=', 'consumed')]</field>
    </record>
    <record id="action_justech_do_withholding_catalog" model="ir.actions.server">
        <field name="name">Administrar Retenciones</field>
        <field name="model_id" ref="base.model_res_company"/>
        <field name="state">code</field>
        <field name="code">action = env['justech.do.fiscal.audit.actions'].action_open_withholding_catalog()</field>
    </record>

    <!-- Parent: accountant.menu_accounting (Enterprise). Nunca account.menu_finance
         (queda vacío tras accountant y crearía un segundo icono Contabilidad). -->
    <menuitem id="menu_justech_do_audit_root"
              name="Auditoría Fiscal"
              parent="accountant.menu_accounting"
              sequence="80"
              groups="justech_l10n_do_base.group_justech_do_fiscal_user,account.group_account_manager,base.group_system"/>

    <menuitem id="menu_justech_do_fiscal_dashboard"
              name="Dashboard Fiscal"
              parent="menu_justech_do_audit_root"
              action="justech_l10n_do_ncf.action_justech_do_fiscal_dashboard"
              sequence="1"
              groups="justech_l10n_do_base.group_justech_do_fiscal_user,account.group_account_manager,base.group_system"/>

    <menuitem id="menu_justech_do_fiscal_historical_backfill"
              name="Sincronizar anulaciones históricas"
              parent="menu_justech_do_audit_root"
              action="justech_l10n_do_ncf.action_justech_do_fiscal_historical_backfill"
              sequence="2"
              groups="justech_l10n_do_base.group_justech_do_fiscal_user,account.group_account_manager,base.group_system"/>

    <menuitem id="menu_justech_do_fiscal_regularization_center_audit"
              name="Centro de Regularización"
              parent="menu_justech_do_audit_root"
              action="justech_l10n_do_ncf.action_justech_do_fiscal_regularization_center"
              sequence="3"
              groups="justech_l10n_do_base.group_justech_do_fiscal_manager,account.group_account_manager,base.group_system"/>

    <record id="menu_justech_do_report_606" model="ir.ui.menu">
        <field name="name">606 — Compras</field>
        <field name="parent_id" ref="menu_justech_do_audit_root"/>
        <field name="action" ref="action_justech_do_report_606"/>
        <field name="sequence">15</field>
        <field name="active" eval="True"/>
    </record>
    <record id="menu_justech_do_report_607" model="ir.ui.menu">
        <field name="name">Reportes 607</field>
        <field name="parent_id" ref="menu_justech_do_audit_root"/>
        <field name="action" ref="action_justech_do_report_607"/>
        <field name="sequence">20</field>
        <field name="active" eval="True"/>
    </record>
    <record id="menu_justech_do_report_608" model="ir.ui.menu">
        <field name="name">Reportes 608</field>
        <field name="parent_id" ref="menu_justech_do_audit_root"/>
        <field name="action" ref="action_justech_do_report_608"/>
        <field name="sequence">30</field>
        <field name="active" eval="True"/>
    </record>
    <record id="menu_justech_do_report_609" model="ir.ui.menu">
        <field name="name">609 — Pagos al Exterior</field>
        <field name="parent_id" ref="menu_justech_do_audit_root"/>
        <field name="action" ref="action_justech_do_report_609"/>
        <field name="sequence">40</field>
        <field name="active" eval="True"/>
    </record>
    <record id="menu_justech_do_report_623" model="ir.ui.menu">
        <field name="name">623 — Retenciones del Estado</field>
        <field name="parent_id" ref="menu_justech_do_audit_root"/>
        <field name="action" ref="action_justech_do_report_623"/>
        <field name="sequence">50</field>
        <field name="active" eval="True"/>
    </record>

    <record id="justech_l10n_do_base.menu_justech_do_document_types" model="ir.ui.menu">
        <field name="name">Tipos de Comprobante</field>
        <field name="parent_id" ref="menu_justech_do_audit_root"/>
        <field name="sequence">60</field>
        <field name="active" eval="True"/>
    </record>
    <record id="justech_l10n_do_ncf.menu_justech_do_ncf_ranges" model="ir.ui.menu">
        <field name="parent_id" ref="menu_justech_do_audit_root"/>
        <field name="sequence">70</field>
        <field name="active" eval="True"/>
    </record>

    <menuitem id="menu_justech_do_ncf_consumption_audit"
              name="Consumo NCF"
              parent="menu_justech_do_audit_root"
              action="justech_l10n_do_ncf.action_justech_do_ncf_consumption"
              sequence="80"/>

    <record id="menu_justech_do_withholding_catalog" model="ir.ui.menu">
        <field name="name">Administrar Retenciones</field>
        <field name="parent_id" ref="menu_justech_do_audit_root"/>
        <field name="action" ref="action_justech_do_withholding_catalog"/>
        <field name="sequence">90</field>
        <field name="active" eval="True"/>
        <field name="group_ids" eval="[(6, 0, [ref('account.group_account_manager')])]"/>
    </record>

    <record id="menu_justech_do_audit_consumption" model="ir.ui.menu">
        <field name="name">Consumo NCF (Auditoría)</field>
        <field name="parent_id" ref="menu_justech_do_audit_root"/>
        <field name="action" ref="action_justech_do_audit_consumption"/>
        <field name="sequence">100</field>
        <field name="active" eval="True"/>
    </record>
    <record id="menu_justech_do_audit_voided" model="ir.ui.menu">
        <field name="name">NCF Anulados</field>
        <field name="parent_id" ref="menu_justech_do_audit_root"/>
        <field name="action" ref="action_justech_do_ncf_voided"/>
        <field name="sequence">110</field>
        <field name="active" eval="True"/>
    </record>
    <record id="menu_justech_do_audit_history" model="ir.ui.menu">
        <field name="name">Historial Fiscal</field>
        <field name="parent_id" ref="menu_justech_do_audit_root"/>
        <field name="action" ref="action_justech_do_fiscal_report"/>
        <field name="sequence">120</field>
        <field name="active" eval="True"/>
    </record>
    <record id="menu_justech_do_fiscal_review" model="ir.ui.menu">
        <field name="name">Revisión Fiscal</field>
        <field name="parent_id" ref="menu_justech_do_audit_root"/>
        <field name="action" ref="action_justech_do_fiscal_review"/>
        <field name="sequence">130</field>
        <field name="active" eval="True"/>
    </record>
    <record id="menu_justech_do_fiscal_review_pending" model="ir.ui.menu">
        <field name="name">Pendientes de Aprobación</field>
        <field name="parent_id" ref="menu_justech_do_audit_root"/>
        <field name="action" ref="action_justech_do_fiscal_review_pending"/>
        <field name="sequence">140</field>
        <field name="active" eval="True"/>
        <field name="group_ids" eval="[(6, 0, [ref('justech_l10n_do_base.group_justech_do_fiscal_manager')])]"/>
    </record>
    <record id="menu_justech_fiscal_admin_center_audit" model="ir.ui.menu">
        <field name="name">Centro de Administración Fiscal</field>
        <field name="parent_id" ref="menu_justech_do_audit_root"/>
        <field name="action" ref="justech_fiscal_admin.action_justech_fiscal_admin_center_server"/>
        <field name="sequence">150</field>
        <field name="active" eval="True"/>
        <field name="group_ids" eval="[(6, 0, [ref('base.group_system'), ref('justech_fiscal_admin.group_justech_fiscal_admin_manager'), ref('justech_l10n_do_base.group_justech_do_fiscal_manager'), ref('justech_l10n_do_base.group_justech_do_fiscal_user')])]"/>
    </record>
</odoo>
