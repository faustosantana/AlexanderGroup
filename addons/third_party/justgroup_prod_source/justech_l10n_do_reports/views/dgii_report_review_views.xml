<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_justech_do_fiscal_report_line_review_tree" model="ir.ui.view">
        <field name="name">justech.do.fiscal.report.line.review.list</field>
        <field name="model">justech.do.fiscal.report.line</field>
        <field name="arch" type="xml">
            <list editable="bottom" create="0" delete="0"
                  decoration-success="fiscal_state == 'valid' and include_in_report"
                  decoration-warning="fiscal_state == 'incomplete'"
                  decoration-muted="fiscal_state in ('excluded', 'cancelled') or not include_in_report">
                <field name="include_in_report" readonly="1"/>
                <field name="fiscal_state" widget="badge"
                       decoration-success="fiscal_state == 'valid'"
                       decoration-warning="fiscal_state == 'incomplete'"
                       decoration-danger="fiscal_state == 'excluded'"
                       decoration-muted="fiscal_state == 'cancelled'"/>
                <field name="move_id" string="Factura"/>
                <field name="payment_id" string="Pago"/>
                <field name="document_type" string="Tipo comprobante"/>
                <field name="partner_name" string="Cliente / Entidad"/>
                <field name="partner_vat" string="RNC / Cédula"/>
                <field name="partner_id_type" string="Tipo identificación" optional="show"/>
                <field name="ncf"/>
                <field name="ncf_modified" string="NCF modificado" optional="hide"/>
                <field name="document_date" string="Fecha"/>
                <field name="withholding_base" string="Base" optional="show"/>
                <field name="withholding_rate" string="%" optional="show"/>
                <field name="amount_withholding" string="Monto retenido"/>
                <field name="dgii_withholding_code" string="Código DGII" optional="show"/>
                <field name="amount_total" string="Total factura" optional="hide"/>
                <field name="amount_tax" string="ITBIS" optional="hide"/>
                <field name="currency_id" string="Moneda" optional="hide"/>
                <field name="inclusion_reason" string="Motivo inclusión" optional="show"/>
                <field name="exclusion_reason" string="Motivo exclusión" optional="show"/>
                <field name="auto_exclusion" string="Excl. automática" optional="hide"/>
                <field name="excluded_by_id" string="Usuario que excluyó" optional="hide"/>
                <field name="excluded_at" string="Fecha de exclusión" optional="hide"/>
                <field name="line_approval_state" string="Estado aprobación" optional="show"/>
                <field name="approved_by_id" string="Aprobado por" optional="hide"/>
                <field name="approved_at" string="Fecha aprobación" optional="hide"/>
                <field name="manual_exclusion" column_invisible="1"/>
                <field name="error_message" optional="hide"/>
                <field name="move_name" column_invisible="1"/>
                <field name="partner_id" column_invisible="1"/>
                <field name="invoice_date_due" column_invisible="1"/>
                <field name="payment_method_code" column_invisible="1"/>
                <button name="action_open_move" type="object" icon="fa-external-link"
                        title="Abrir factura"/>
                <button name="action_open_partner" type="object" icon="fa-user"
                        title="Abrir contacto"/>
                <button name="action_open_payment" type="object" icon="fa-money"
                        title="Abrir pago"/>
                <button name="action_view_move_pdf" type="object" icon="fa-file-pdf-o"
                        title="Ver PDF"/>
                <button name="action_exclude_line" type="object" icon="fa-ban"
                        title="Excluir de DGII"
                        invisible="not include_in_report"/>
                <button name="action_approve_line" type="object" icon="fa-check"
                        title="Aprobar exclusión"
                        invisible="line_approval_state != 'pending'"
                        groups="justech_l10n_do_base.group_justech_do_fiscal_manager"/>
                <button name="action_reject_line" type="object" icon="fa-times"
                        title="Rechazar exclusión"
                        invisible="line_approval_state != 'pending'"
                        groups="justech_l10n_do_base.group_justech_do_fiscal_manager"/>
                <button name="action_request_correction_line" type="object" icon="fa-undo"
                        title="Solicitar corrección"
                        invisible="line_approval_state != 'pending'"
                        groups="justech_l10n_do_base.group_justech_do_fiscal_manager"/>
            </list>
        </field>
    </record>

    <record id="view_justech_do_fiscal_report_line_search" model="ir.ui.view">
        <field name="name">justech.do.fiscal.report.line.search</field>
        <field name="model">justech.do.fiscal.report.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="move_name"/>
                <field name="partner_name"/>
                <field name="ncf"/>
                <filter name="filter_valid" string="Válidos"
                        domain="[('fiscal_state', '=', 'valid'), ('include_in_report', '=', True)]"/>
                <filter name="filter_incomplete" string="Incompletos"
                        domain="[('fiscal_state', '=', 'incomplete')]"/>
                <filter name="filter_excluded" string="Excluidos"
                        domain="['|', ('fiscal_state', '=', 'excluded'), ('include_in_report', '=', False)]"/>
                <filter name="filter_cancelled" string="Anulados"
                        domain="[('fiscal_state', '=', 'cancelled')]"/>
                <filter name="filter_pending_approval" string="Pendientes aprobación"
                        domain="[('manual_exclusion', '=', True), ('line_approval_state', '=', 'pending')]"/>
                <filter name="filter_approved" string="Aprobados"
                        domain="[('manual_exclusion', '=', True), ('line_approval_state', '=', 'approved')]"/>
                <filter name="filter_manual" string="Exclusión manual"
                        domain="[('manual_exclusion', '=', True)]"/>
                <filter name="filter_auto" string="Exclusión automática"
                        domain="[('auto_exclusion', '=', True)]"/>
            </search>
        </field>
    </record>

    <record id="view_justech_do_fiscal_report_review_form" model="ir.ui.view">
        <field name="name">justech.do.fiscal.report.review.form</field>
        <field name="model">justech.do.fiscal.report</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <form string="Revisión fiscal DGII">
                <header>
                    <button name="action_load_review_lines" string="Cargar período" type="object"
                            invisible="state not in ('draft', 'rejected')"/>
                    <button name="action_validate_period" string="Validar período" type="object"
                            invisible="state not in ('draft', 'rejected') or not line_ids"/>
                    <button name="action_submit_for_approval" string="Enviar a aprobación" type="object"
                            invisible="state != 'validated' or manual_exclusion_count == 0"/>
                    <button name="action_approve_report" string="Aprobar exclusiones" type="object"
                            invisible="state != 'pending_approval'"
                            groups="justech_l10n_do_base.group_justech_do_fiscal_manager"/>
                    <button name="action_reject_report" string="Rechazar exclusiones" type="object"
                            invisible="state != 'pending_approval'"
                            groups="justech_l10n_do_base.group_justech_do_fiscal_manager"/>
                    <button name="action_generate_dgii_export" string="Generar Excel DGII" type="object"
                            class="btn-primary"
                            invisible="state not in ('validated', 'approved') or (state == 'validated' and manual_exclusion_count > 0)"
                            groups="justech_l10n_do_base.group_justech_do_fiscal_manager"/>
                    <button name="action_download_errors" string="Descargar errores (Excel)" type="object"
                            invisible="not error_report_file"/>
                    <button name="action_reopen_report" string="Reabrir" type="object"
                            invisible="state not in ('generated', 'done')"
                            groups="justech_l10n_do_base.group_justech_do_fiscal_manager"/>
                    <field name="state" widget="statusbar" readonly="1"
                           statusbar_visible="draft,validated,pending_approval,approved,generated"/>
                </header>
                <sheet>
                    <div class="oe_title mb-2">
                        <h1>
                            <field name="name" readonly="1" class="w-auto"/>
                        </h1>
                        <h3 class="text-muted">
                            <field name="report_type" readonly="1" class="w-auto"/>
                            ·
                            <field name="period_code" readonly="1" class="w-auto"/>
                        </h3>
                    </div>
                    <group string="Resumen del período" col="4">
                        <group>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                            <field name="date_from_display" string="Desde" readonly="1"/>
                            <field name="date_to_display" string="Hasta" readonly="1"/>
                        </group>
                        <group>
                            <field name="review_line_count" string="Total documentos" readonly="1"/>
                            <field name="review_valid_count" string="Válidos" readonly="1"/>
                            <field name="review_incomplete_count" string="Incompletos" readonly="1"/>
                        </group>
                        <group>
                            <field name="review_excluded_count" string="Excluidos" readonly="1"/>
                            <field name="review_cancelled_count" string="Anulados" readonly="1"/>
                            <field name="review_pending_approval_count" string="Pendientes de aprobación" readonly="1"/>
                        </group>
                        <group>
                            <field name="review_base_total" string="Base total" readonly="1"/>
                            <field name="review_withholding_total" string="Retención total" readonly="1"/>
                            <field name="validation_state" string="Estado de validación"
                                   widget="badge" invisible="report_type not in ('606', '607')" readonly="1"/>
                        </group>
                    </group>
                    <group string="Acciones requeridas" invisible="review_incomplete_count == 0 and review_pending_approval_count == 0">
                        <group>
                            <field name="review_incomplete_count" string="Documentos incompletos" readonly="1"/>
                            <field name="review_pending_approval_count" string="Exclusiones pendientes" readonly="1"/>
                        </group>
                        <group>
                            <field name="review_excluded_count" string="Excluidos / revisables" readonly="1"/>
                            <field name="review_approved_count" string="Exclusiones aprobadas" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Documentos">
                            <field name="line_ids" nolabel="1"
                                   context="{'list_view_ref': 'justech_l10n_do_reports.view_justech_do_fiscal_report_line_review_tree'}"/>
                        </page>
                        <page string="Válidos">
                            <field name="line_ids" nolabel="1"
                                   domain="[('fiscal_state', '=', 'valid'), ('include_in_report', '=', True)]"
                                   context="{'list_view_ref': 'justech_l10n_do_reports.view_justech_do_fiscal_report_line_review_tree'}"/>
                        </page>
                        <page string="Incompletos">
                            <field name="line_ids" nolabel="1"
                                   domain="[('fiscal_state', '=', 'incomplete')]"
                                   context="{'list_view_ref': 'justech_l10n_do_reports.view_justech_do_fiscal_report_line_review_tree'}"/>
                        </page>
                        <page string="Excluidos">
                            <field name="line_ids" nolabel="1"
                                   domain="['|', ('fiscal_state', '=', 'excluded'), ('include_in_report', '=', False)]"
                                   context="{'list_view_ref': 'justech_l10n_do_reports.view_justech_do_fiscal_report_line_review_tree'}"/>
                        </page>
                        <page string="Anulados">
                            <field name="line_ids" nolabel="1"
                                   domain="[('fiscal_state', '=', 'cancelled')]"
                                   context="{'list_view_ref': 'justech_l10n_do_reports.view_justech_do_fiscal_report_line_review_tree'}"/>
                        </page>
                        <page string="Pendientes aprobación">
                            <field name="line_ids" nolabel="1"
                                   domain="[('manual_exclusion', '=', True), ('line_approval_state', '=', 'pending')]"
                                   context="{'list_view_ref': 'justech_l10n_do_reports.view_justech_do_fiscal_report_line_review_tree'}"/>
                        </page>
                        <page string="Aprobados">
                            <field name="line_ids" nolabel="1"
                                   domain="[('manual_exclusion', '=', True), ('line_approval_state', '=', 'approved')]"
                                   context="{'list_view_ref': 'justech_l10n_do_reports.view_justech_do_fiscal_report_line_review_tree'}"/>
                        </page>
                        <page string="Aprobaciones" invisible="not approval_ids">
                            <field name="approval_ids" readonly="1">
                                <list>
                                    <field name="line_id"/>
                                    <field name="state"/>
                                    <field name="exclusion_reason"/>
                                    <field name="requested_by_id"/>
                                    <field name="reviewed_by_id"/>
                                    <field name="reviewed_at"/>
                                    <field name="comment"/>
                                </list>
                            </field>
                        </page>
                        <page string="Trazabilidad">
                            <group string="Auditoría del reporte">
                                <group>
                                    <field name="created_by_id" readonly="1"/>
                                    <field name="validated_by_id" readonly="1"/>
                                    <field name="validated_at" readonly="1"/>
                                </group>
                                <group>
                                    <field name="approved_by_id" readonly="1"/>
                                    <field name="approved_at" readonly="1"/>
                                    <field name="export_file_hash" readonly="1"/>
                                </group>
                            </group>
                            <field name="audit_ids" readonly="1">
                                <list>
                                    <field name="create_date" string="Fecha y hora"/>
                                    <field name="event_type" string="Evento"/>
                                    <field name="user_id" string="Usuario"/>
                                    <field name="move_id" string="Documento"/>
                                    <field name="description" string="Comentario"/>
                                    <field name="file_hash"/>
                                    <field name="file_name"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_justech_do_dgii_report_exclude_wizard" model="ir.ui.view">
        <field name="name">justech.do.dgii.report.exclude.wizard.form</field>
        <field name="model">justech.do.dgii.report.exclude.wizard</field>
        <field name="arch" type="xml">
            <form string="Excluir de DGII">
                <group>
                    <field name="report_id" readonly="1"/>
                    <field name="line_ids" widget="many2many_tags" readonly="1"/>
                    <field name="reason" placeholder="Motivo obligatorio de exclusión fiscal..."/>
                </group>
                <footer>
                    <button name="action_confirm_exclude" string="Confirmar exclusión" type="object" class="btn-primary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
