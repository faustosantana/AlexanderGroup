<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Bandeja global: lista de reportes con documentos pendientes -->
    <record id="view_justech_do_fiscal_report_pending_tray_tree" model="ir.ui.view">
        <field name="name">justech.do.fiscal.report.pending.tray.list</field>
        <field name="model">justech.do.fiscal.report</field>
        <field name="priority">30</field>
        <field name="arch" type="xml">
            <list string="Pendientes de aprobación" create="0" delete="0"
                  decoration-warning="state == 'pending_approval'">
                <field name="report_type" string="Tipo de reporte"/>
                <field name="period_code" string="Período"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="approval_submitted_by_id" string="Enviado por"/>
                <field name="approval_submitted_at" string="Fecha envío"/>
                <field name="pending_approval_count" string="Documentos pendientes"/>
                <field name="has_pending_approval" column_invisible="1"/>
                <field name="state" string="Estado" widget="badge"
                       decoration-warning="state == 'pending_approval'"
                       decoration-success="state == 'approved'"/>
                <field name="name" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Líneas pendientes de decisión (bandeja supervisor) -->
    <record id="view_justech_do_fiscal_report_line_pending_tray_tree" model="ir.ui.view">
        <field name="name">justech.do.fiscal.report.line.pending.tray.list</field>
        <field name="model">justech.do.fiscal.report.line</field>
        <field name="priority">30</field>
        <field name="arch" type="xml">
            <list string="Documentos pendientes de decisión" create="0" delete="0"
                  decoration-warning="line_approval_state == 'pending'">
                <field name="move_name" string="Factura"/>
                <field name="document_type" string="Tipo comprobante fiscal"/>
                <field name="partner_name" string="Cliente / Proveedor"/>
                <field name="partner_vat" string="RNC / Cédula"/>
                <field name="ncf"/>
                <field name="document_date" string="Fecha"/>
                <field name="amount_total" string="Total"/>
                <field name="exclusion_reason" string="Motivo exclusión"/>
                <field name="excluded_by_id" string="Propuesto por"/>
                <field name="excluded_at" string="Fecha propuesta"/>
                <field name="line_approval_state" string="Estado" widget="badge"
                       decoration-warning="line_approval_state == 'pending'"/>
                <field name="move_id" column_invisible="1"/>
                <field name="partner_id" column_invisible="1"/>
                <field name="manual_exclusion" column_invisible="1"/>
                <button name="action_approve_line" type="object" icon="fa-check"
                        title="Aprobar exclusión"
                        groups="justech_l10n_do_base.group_justech_do_fiscal_manager"/>
                <button name="action_reject_line" type="object" icon="fa-times"
                        title="Rechazar exclusión"
                        groups="justech_l10n_do_base.group_justech_do_fiscal_manager"/>
                <button name="action_request_correction_line" type="object" icon="fa-undo"
                        title="Solicitar corrección"
                        groups="justech_l10n_do_base.group_justech_do_fiscal_manager"/>
                <button name="action_open_move" type="object" icon="fa-external-link"
                        title="Abrir factura"/>
                <button name="action_open_partner" type="object" icon="fa-user"
                        title="Abrir proveedor"/>
                <button name="action_open_payment" type="object" icon="fa-money"
                        title="Abrir pago"/>
                <button name="action_view_move_pdf" type="object" icon="fa-file-pdf-o"
                        title="Ver PDF"/>
            </list>
        </field>
    </record>

    <!-- Formulario bandeja: solo documentos pendientes -->
    <record id="view_justech_do_fiscal_report_pending_tray_form" model="ir.ui.view">
        <field name="name">justech.do.fiscal.report.pending.tray.form</field>
        <field name="model">justech.do.fiscal.report</field>
        <field name="priority">30</field>
        <field name="arch" type="xml">
            <form string="Bandeja de aprobación DGII" create="0" delete="0">
                <header>
                    <button name="action_approve_report" string="Aprobar todas" type="object"
                            class="btn-primary"
                            invisible="pending_approval_count == 0"
                            groups="justech_l10n_do_base.group_justech_do_fiscal_manager"/>
                    <button name="action_reject_report" string="Rechazar todas" type="object"
                            invisible="pending_approval_count == 0"
                            groups="justech_l10n_do_base.group_justech_do_fiscal_manager"/>
                    <button name="action_open_full_review" string="Ver revisión completa" type="object"/>
                    <field name="state" widget="statusbar" readonly="1"
                           statusbar_visible="pending_approval,approved,validated"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="report_type" readonly="1"/> —
                            <field name="period_code" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                            <field name="date_from" invisible="1"/>
                            <field name="date_to" invisible="1"/>
                            <field name="date_from_display" readonly="1"/>
                            <field name="date_to_display" readonly="1"/>
                        </group>
                        <group>
                            <field name="approval_submitted_by_id" readonly="1"/>
                            <field name="approval_submitted_at" readonly="1"/>
                            <field name="pending_approval_count" readonly="1"/>
                            <field name="manual_exclusion_count" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Documentos pendientes de decisión">
                            <field name="line_ids" nolabel="1" readonly="1"
                                   domain="[('manual_exclusion', '=', True), ('line_approval_state', '=', 'pending')]"
                                   context="{'list_view_ref': 'justech_l10n_do_reports.view_justech_do_fiscal_report_line_pending_tray_tree'}"/>
                        </page>
                        <page string="Bitácora">
                            <field name="audit_ids" readonly="1">
                                <list>
                                    <field name="create_date" string="Fecha y hora"/>
                                    <field name="event_type" string="Evento"/>
                                    <field name="user_id" string="Usuario"/>
                                    <field name="move_id" string="Documento"/>
                                    <field name="description" string="Comentario"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_justech_do_dgii_report_reject_wizard" model="ir.ui.view">
        <field name="name">justech.do.dgii.report.reject.wizard.form</field>
        <field name="model">justech.do.dgii.report.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Decisión sobre exclusión">
                <group>
                    <field name="report_id" readonly="1"/>
                    <field name="action_mode" readonly="1"/>
                    <field name="line_ids" widget="many2many_tags" readonly="1"
                           invisible="not line_ids"/>
                    <field name="comment" placeholder="Indique el motivo de la decisión..."/>
                </group>
                <footer>
                    <button name="action_confirm_reject" string="Confirmar" type="object" class="btn-primary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_justech_do_fiscal_review_pending" model="ir.actions.act_window">
        <field name="name">Pendientes de aprobación</field>
        <field name="res_model">justech.do.fiscal.report</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('has_pending_approval', '=', True), ('active', '=', True)]</field>
        <field name="context">{'create': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No existen documentos pendientes de aprobación.
            </p>
            <p>
                Cuando un usuario fiscal envíe exclusiones manuales a aprobación,
                los reportes aparecerán aquí para que el supervisor las revise.
            </p>
        </field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('justech_l10n_do_reports.view_justech_do_fiscal_report_pending_tray_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('justech_l10n_do_reports.view_justech_do_fiscal_report_pending_tray_form')})]"/>
    </record>
</odoo>
