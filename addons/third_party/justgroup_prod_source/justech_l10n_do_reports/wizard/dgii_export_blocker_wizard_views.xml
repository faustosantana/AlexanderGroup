<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_justech_do_dgii_export_blocker_wizard" model="ir.ui.view">
        <field name="name">justech.do.dgii.export.blocker.wizard.form</field>
        <field name="model">justech.do.dgii.export.blocker.wizard</field>
        <field name="arch" type="xml">
            <form string="No es posible generar Excel">
                <sheet>
                    <field name="summary_html" nolabel="1" readonly="1"/>
                    <group invisible="1">
                        <field name="report_id"/>
                        <field name="report_state"/>
                        <field name="valid_count"/>
                        <field name="pending_approval_count"/>
                        <field name="incomplete_count"/>
                        <field name="not_loaded"/>
                        <field name="needs_approval"/>
                        <field name="no_valid"/>
                        <field name="wrong_state"/>
                        <field name="blocking_line_ids"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_go_fiscal_review" string="Ir a Revisión Fiscal"
                            type="object" class="btn-primary"/>
                    <button name="action_go_pending_tray" string="Ir a Pendientes de aprobación"
                            type="object"
                            invisible="not needs_approval and pending_approval_count == 0"/>
                    <button name="action_view_blocked_documents" string="Ver documentos bloqueados"
                            type="object"
                            invisible="not blocking_line_ids and not incomplete_count and not pending_approval_count and not no_valid"/>
                    <button string="Cerrar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
