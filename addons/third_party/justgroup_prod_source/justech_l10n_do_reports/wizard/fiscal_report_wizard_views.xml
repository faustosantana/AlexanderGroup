<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_justech_do_fiscal_report_wizard" model="ir.ui.view">
        <field name="name">justech.do.fiscal.report.wizard.form</field>
        <field name="model">justech.do.fiscal.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Reporte DGII">
                <group>
                    <field name="report_type"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                </group>
                <group string="Período">
                    <field name="period_mode" widget="radio"/>
                    <field name="period_year" invisible="period_mode != 'month'"/>
                    <field name="period_month" invisible="period_mode != 'month'"/>
                    <field name="period_code" readonly="1"
                           invisible="period_mode != 'month'"/>
                    <field name="date_from" readonly="period_mode == 'month'"
                           required="1"/>
                    <field name="date_to" readonly="period_mode == 'month'"
                           required="1"/>
                    <field name="date_from_display" invisible="1"/>
                    <field name="date_to_display" invisible="1"/>
                    <field name="period_official_hint" nolabel="1" readonly="1"
                           invisible="period_mode != 'custom'"
                           class="text-muted"/>
                    <field name="saved_report_id" invisible="1"/>
                </group>
                <group string="Resumen del período" invisible="validation_state == 'pending'">
                    <group>
                        <field name="validation_state" string="Estado de validación" widget="badge"
                               decoration-success="validation_state == 'ok'"
                               decoration-warning="validation_state == 'warning'"
                               decoration-danger="validation_state == 'error'"/>
                        <field name="count_all"/>
                        <field name="count_valid"/>
                        <field name="count_incomplete"/>
                    </group>
                    <group>
                        <field name="count_excluded"/>
                        <field name="count_cancelled"/>
                        <field name="count_partners_errors"/>
                    </group>
                </group>
                <group string="Resultado de validación" invisible="validation_state == 'pending'">
                    <field name="validation_log" nolabel="1" readonly="1"/>
                </group>
                <footer>
                    <button name="action_validate" string="Validar período" type="object"
                            invisible="report_type not in ('606', '607')"/>
                    <button name="action_save_review" string="Guardar revisión" type="object"
                            class="btn-primary"
                            invisible="report_type not in ('606', '607') or validation_state == 'pending'"/>
                    <button name="action_view_documents" string="Ver documentos" type="object"
                            invisible="report_type not in ('606', '607') or validation_state == 'pending'"/>
                    <button name="action_download_errors" string="Descargar errores (Excel)" type="object"
                            invisible="report_type not in ('606', '607') or validation_state == 'pending'"/>
                    <button name="action_generate" string="Generar Excel DGII" type="object"
                            invisible="report_type not in ('606', '607') or validation_state in ('pending', 'error')"
                            groups="justech_l10n_do_base.group_justech_do_fiscal_manager"/>
                    <button name="action_generate" string="Generar" type="object"
                            class="btn-primary" invisible="report_type in ('606', '607')"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_justech_do_fiscal_report_wizard" model="ir.actions.act_window">
        <field name="name">Generar reporte DGII</field>
        <field name="res_model">justech.do.fiscal.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <record id="action_justech_do_report_606_generate" model="ir.actions.act_window">
        <field name="name">Generar 606</field>
        <field name="res_model">justech.do.fiscal.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_report_type': '606'}</field>
    </record>
</odoo>
