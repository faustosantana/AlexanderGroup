<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="0">
    <record id="rule_justech_fiscal_feature_flag_company" model="ir.rule">
        <field name="name">Fiscal Feature Flag: multi-company</field>
        <field name="model_id" ref="model_justech_fiscal_feature_flag"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_justech_fiscal_admin_center_company" model="ir.rule">
        <field name="name">Fiscal Admin Center: multi-company</field>
        <field name="model_id" ref="model_justech_fiscal_admin_center"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
