<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_justech_fiscal_admin_center_form" model="ir.ui.view">
        <field name="name">justech.fiscal.admin.center.form</field>
        <field name="model">justech.fiscal.admin.center</field>
        <field name="arch" type="xml">
            <form string="Centro de Administración Fiscal Justech" create="0" delete="0" class="o_justech_fiscal_center_form">
                <header>
                    <button name="action_refresh" string="Actualizar" type="object" class="btn-primary"/>
                    <button name="action_run_health_check" string="Ejecutar diagnóstico" type="object"
                            class="btn-secondary" invisible="not can_revalidate_health"/>
                    <button name="action_open_diagnostic" string="Diagnóstico completo" type="object"
                            class="btn-secondary"/>
                </header>
                <sheet>
                    <div class="oe_title mb-2">
                        <h1>Centro Fiscal Justech</h1>
                        <h3 class="text-muted mb-0">
                            <field name="company_id" options="{'no_create': True, 'no_open': True}" readonly="1"/>
                        </h3>
                        <p class="text-muted small mb-0" invisible="access_mode != 'officer'">
                            Modo Responsable Fiscal — lectura y revalidación.
                        </p>
                        <p class="text-muted small mb-0" invisible="access_mode != 'user'">
                            Vista operativa — estado, rangos y alertas.
                        </p>
                    </div>

                    <div class="row g-2 mb-3 o_justech_fiscal_actions">
                        <div class="col-6 col-md-4 col-lg-2">
                            <button name="action_open_health_detail" type="object"
                                    string="Revisar pendientes" class="btn btn-primary w-100"/>
                        </div>
                        <div class="col-6 col-md-4 col-lg-2">
                            <button name="action_open_ncf_ranges" type="object"
                                    string="Administrar rangos" class="btn btn-secondary w-100"/>
                        </div>
                        <div class="col-6 col-md-4 col-lg-2">
                            <button name="action_open_withholding_catalog" type="object"
                                    string="Administrar retenciones" class="btn btn-secondary w-100"/>
                        </div>
                        <div class="col-6 col-md-4 col-lg-2">
                            <button name="action_open_dgii_reports" type="object"
                                    string="Reportes DGII" class="btn btn-secondary w-100"/>
                        </div>
                        <div class="col-6 col-md-4 col-lg-2" invisible="not can_manage_padron">
                            <button name="action_padron_history" type="object"
                                    string="Padrón DGII" class="btn btn-secondary w-100"/>
                        </div>
                        <div class="col-6 col-md-4 col-lg-2" invisible="not can_revalidate_health">
                            <button name="action_run_health_check" type="object"
                                    string="Ejecutar diagnóstico" class="btn btn-outline-secondary w-100"/>
                        </div>
                    </div>

                    <group class="o_justech_fiscal_kpi_strip" col="4">
                        <group>
                            <field name="motor_status" string="Motor fiscal"/>
                            <field name="reports_status" string="Reportes"/>
                        </group>
                        <group>
                            <field name="health_ok" widget="boolean" string="Salud OK"/>
                            <field name="issue_count" string="Errores"/>
                        </group>
                        <group>
                            <field name="warning_count" string="Advertencias"/>
                            <field name="last_refresh" string="Última validación"/>
                        </group>
                        <group>
                            <field name="provider_status" string="Provider" invisible="access_mode == 'user'"/>
                        </group>
                    </group>

                    <field name="dashboard_html" nolabel="1" widget="html"/>

                    <field name="can_manage_padron" invisible="1"/>
                    <field name="can_manage_users" invisible="1"/>
                    <field name="can_revalidate_health" invisible="1"/>
                    <field name="can_open_ncf_admin" invisible="1"/>
                    <field name="is_fiscal_admin" invisible="1"/>
                    <field name="is_system_admin" invisible="1"/>
                    <field name="is_fiscal_officer" invisible="1"/>
                    <field name="is_fiscal_user_only" invisible="1"/>
                    <field name="access_mode" invisible="1"/>

                    <notebook>
                        <page string="Compras">
                            <div class="alert alert-info" role="alert">
                                Administración fiscal de Compras de la empresa activa.
                                Documentos recibidos: NCF del proveedor (sin secuencia Justech).
                                Comprobantes emitidos B11/B13/B17: Motor Fiscal Justech al publicar.
                            </div>
                            <div class="d-flex flex-wrap gap-2 mb-2">
                                <button name="action_open_purchase_received_types" type="object"
                                        string="Documentos recibidos" class="btn btn-secondary"/>
                                <button name="action_open_purchase_emission_config" type="object"
                                        string="Comprobantes emitidos" class="btn btn-secondary"/>
                                <button name="action_open_purchase_expense_types" type="object"
                                        string="Tipos de costos y gastos" class="btn btn-secondary"/>
                                <button name="action_open_purchase_ncf_ranges" type="object"
                                        string="Rangos de Compras" class="btn btn-secondary"/>
                                <button name="action_open_purchase_incidents" type="object"
                                        string="Incidencias de Compras" class="btn btn-secondary"/>
                            </div>
                        </page>
                        <page string="Padrón DGII" invisible="not can_manage_padron">
                            <div class="d-flex flex-wrap gap-2 mb-2">
                                <button name="action_padron_import" type="object"
                                        string="Importar / actualizar" class="btn btn-primary"/>
                                <button name="action_padron_update_now" type="object"
                                        string="Actualizar ahora" class="btn btn-secondary"
                                        confirm="¿Descargar el padrón oficial DGII e importarlo ahora? Es global (todas las empresas)."/>
                                <button name="action_padron_retry_last" type="object"
                                        string="Reintentar última" class="btn btn-secondary"/>
                                <button name="action_padron_reimport_after_restore" type="object"
                                        string="Reimportar tras restore" class="btn btn-warning"
                                        confirm="¿Abrir importación del padrón global? Solo si la base quedó sin padrón tras un restore."/>
                                <button name="action_padron_history" type="object"
                                        string="Historial" class="btn btn-link"/>
                                <button name="action_padron_integrity" type="object"
                                        string="Verificar integridad" class="btn btn-link"/>
                                <button name="action_padron_config" type="object"
                                        string="Config. automática" class="btn btn-link"/>
                            </div>
                        </page>
                        <page string="Más" invisible="not is_fiscal_admin">
                            <group string="Técnico / avanzado">
                                <button name="action_open_feature_flags" type="object"
                                        string="Feature Flags" class="btn-link"/>
                                <button name="action_open_ncf_admin" type="object"
                                        string="Admin NCF (técnico)" class="btn-link"
                                        invisible="not can_open_ncf_admin"/>
                                <button name="action_sync_withholding_catalog" type="object"
                                        string="Sincronizar catálogo retenciones" class="btn-link"/>
                                <button name="action_open_fiscal_users" type="object"
                                        string="Usuarios fiscales" class="btn-link"
                                        invisible="not can_manage_users"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_justech_fiscal_admin_center" model="ir.actions.act_window">
        <field name="name">Centro Fiscal Justech</field>
        <field name="res_model">justech.fiscal.admin.center</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'create': False, 'delete': False}</field>
    </record>
    <record id="action_justech_fiscal_admin_center_server" model="ir.actions.server">
        <field name="name">Abrir Centro Fiscal Justech</field>
        <field name="model_id" ref="model_justech_fiscal_admin_center"/>
        <field name="state">code</field>
        <field name="code">action = env['justech.fiscal.admin.center'].with_company(env.company).open_for_user()</field>
    </record>
</odoo>
