<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_justech_fiscal_health_issue_list" model="ir.ui.view">
        <field name="name">justech.fiscal.health.issue.list</field>
        <field name="model">justech.fiscal.health.issue</field>
        <field name="arch" type="xml">
            <list string="Salud Fiscal — Detalle" create="0" delete="0" edit="0">
                <field name="severity"/>
                <field name="code"/>
                <field name="company_id"/>
                <field name="name"/>
                <field name="cause"/>
                <field name="impact"/>
                <field name="model_name"/>
                <field name="recommended_action"/>
                <field name="detected_at"/>
                <field name="state"/>
                <button name="action_open_record" type="object" string="Abrir" icon="fa-external-link"/>
            </list>
        </field>
    </record>
    <record id="view_justech_fiscal_health_issue_form" model="ir.ui.view">
        <field name="name">justech.fiscal.health.issue.form</field>
        <field name="model">justech.fiscal.health.issue</field>
        <field name="arch" type="xml">
            <form string="Hallazgo Salud Fiscal" create="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="severity"/>
                            <field name="company_id"/>
                            <field name="state"/>
                            <field name="category"/>
                        </group>
                        <group>
                            <field name="model_name"/>
                            <field name="res_model" invisible="1"/>
                            <field name="res_id"/>
                            <field name="detected_at"/>
                            <field name="impact"/>
                        </group>
                    </group>
                    <group>
                        <field name="name"/>
                        <field name="cause"/>
                        <field name="recommended_action"/>
                    </group>
                    <footer>
                        <button name="action_open_record" type="object" string="Abrir registro" class="btn-primary"/>
                        <button string="Cerrar" special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
