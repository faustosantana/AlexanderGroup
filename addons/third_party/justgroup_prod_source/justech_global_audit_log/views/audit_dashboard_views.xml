<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_justech_audit_dashboard_form" model="ir.ui.view">
        <field name="name">justech.audit.dashboard.form</field>
        <field name="model">justech.audit.dashboard</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <header>
                    <button name="action_open_logs" type="object" string="Histórico de Cambios" class="btn-primary"/>
                    <button name="action_open_unlinks_today" type="object" string="Eliminaciones hoy"/>
                    <button name="action_open_changes_today" type="object" string="Cambios hoy"/>
                    <button name="action_open_rules" type="object" string="Reglas"/>
                    <button name="action_open_retention" type="object" string="Retención"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>Panel de investigación</h1>
                    </div>
                    <field name="forensic_notice" nolabel="1"/>
                    <group>
                        <group string="Hoy">
                            <field name="logs_today"/>
                            <field name="writes_today"/>
                            <field name="unlinks_today"/>
                            <field name="after_hours_count"/>
                            <field name="bulk_change_count"/>
                        </group>
                        <group string="Investigación">
                            <field name="top_user_name"/>
                            <field name="top_user_count"/>
                            <field name="last_unlink_summary"/>
                            <field name="active_rules"/>
                            <field name="table_size_mb"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_justech_audit_dashboard" model="ir.actions.act_window">
        <field name="name">Panel de investigación</field>
        <field name="res_model">justech.audit.dashboard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>
</odoo>
