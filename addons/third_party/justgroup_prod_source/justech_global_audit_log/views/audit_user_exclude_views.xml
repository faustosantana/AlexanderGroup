<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_justech_audit_user_exclude_list" model="ir.ui.view">
        <field name="name">justech.audit.user.exclude.list</field>
        <field name="model">justech.audit.user.exclude</field>
        <field name="arch" type="xml">
            <list>
                <field name="user_id"/>
                <field name="reason"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_justech_audit_user_exclude" model="ir.actions.act_window">
        <field name="name">Usuarios excluidos</field>
        <field name="res_model">justech.audit.user.exclude</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
