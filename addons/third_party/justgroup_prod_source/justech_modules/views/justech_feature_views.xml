<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_justech_feature_list" model="ir.ui.view">
        <field name="name">justech.feature.list</field>
        <field name="model">justech.feature</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="module_id"/>
                <field name="license_required"/>
                <field name="always_on"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_justech_feature_form" model="ir.ui.view">
        <field name="name">justech.feature.form</field>
        <field name="model">justech.feature</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="name"/>
                        <field name="module_id"/>
                        <field name="license_required"/>
                        <field name="always_on"/>
                        <field name="default_active"/>
                        <field name="active"/>
                    </group>
                    <field name="description"/>
                    <field name="company_activation_ids"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_justech_feature" model="ir.actions.act_window">
        <field name="name">Features</field>
        <field name="res_model">justech.feature</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
