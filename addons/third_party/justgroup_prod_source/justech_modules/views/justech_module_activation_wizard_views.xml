<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_justech_module_activation_wizard_form" model="ir.ui.view">
        <field name="name">justech.module.activation.wizard.form</field>
        <field name="model">justech.module.activation.wizard</field>
        <field name="arch" type="xml">
            <form string="Justech Module Activation">
                <header>
                    <button name="action_refresh" type="object" string="Refresh" class="btn-secondary"/>
                    <button name="action_activate_selected" type="object" string="Activate Selected" class="btn-primary"/>
                    <button name="action_deactivate_selected" type="object" string="Deactivate Selected" class="btn-secondary"/>
                </header>
                <sheet>
                    <group>
                        <field name="company_id" options="{'no_create': True}"/>
                    </group>
                    <p class="text-muted">
                        Feature flags only — Odoo technical modules remain installed.
                        Uses the official <code>justech.license.service</code> API.
                    </p>
                    <field name="line_ids">
                        <list editable="bottom" create="false" delete="false">
                            <field name="selected"/>
                            <field name="line_type"/>
                            <field name="module_code"/>
                            <field name="feature_code" optional="hide"/>
                            <field name="display_name"/>
                            <field name="category"/>
                            <field name="country"/>
                            <field name="dependencies_text"/>
                            <field name="required_module"/>
                            <field name="license_required"/>
                            <field name="is_active"/>
                            <field name="activated_at"/>
                            <field name="activated_by_name"/>
                            <field name="description" optional="hide"/>
                            <field name="always_on" column_invisible="True"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_justech_module_activation_wizard" model="ir.actions.act_window">
        <field name="name">Module Activation</field>
        <field name="res_model">justech.module.activation.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
