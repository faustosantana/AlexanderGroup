<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_justech_license_audit_list" model="ir.ui.view">
        <field name="name">justech.license.audit.list</field>
        <field name="model">justech.license.audit</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="create_date"/>
                <field name="action"/>
                <field name="feature_id"/>
                <field name="license_id"/>
                <field name="company_id"/>
                <field name="user_id"/>
            </list>
        </field>
    </record>

    <record id="action_justech_license_audit" model="ir.actions.act_window">
        <field name="name">License Audit</field>
        <field name="res_model">justech.license.audit</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
