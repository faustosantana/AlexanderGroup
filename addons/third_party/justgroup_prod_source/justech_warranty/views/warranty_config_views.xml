<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============ Tipos de garantía ============ -->
    <record id="view_justech_warranty_type_list" model="ir.ui.view">
        <field name="name">justech.warranty.type.list</field>
        <field name="model">justech.warranty.type</field>
        <field name="arch" type="xml">
            <list string="Tipos de garantía" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="kind"/>
                <field name="default_months"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_justech_warranty_type_form" model="ir.ui.view">
        <field name="name">justech.warranty.type.form</field>
        <field name="model">justech.warranty.type</field>
        <field name="arch" type="xml">
            <form string="Tipo de garantía">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Ej. Garantía de tienda"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="kind"/>
                            <field name="default_months"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Descripción">
                        <field name="note" nolabel="1" placeholder="Descripción del tipo de garantía..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_justech_warranty_type" model="ir.actions.act_window">
        <field name="name">Tipos de Garantía</field>
        <field name="res_model">justech.warranty.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Defina los tipos de garantía</p>
            <p>Ej. Garantía de tienda, del fabricante o extendida.</p>
        </field>
    </record>

    <!-- ============ Motivos de reclamo ============ -->
    <record id="view_justech_warranty_claim_reason_list" model="ir.ui.view">
        <field name="name">justech.warranty.claim.reason.list</field>
        <field name="model">justech.warranty.claim.reason</field>
        <field name="arch" type="xml">
            <list string="Motivos de reclamo" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_justech_warranty_claim_reason_form" model="ir.ui.view">
        <field name="name">justech.warranty.claim.reason.form</field>
        <field name="model">justech.warranty.claim.reason</field>
        <field name="arch" type="xml">
            <form string="Motivo de reclamo">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Ej. Falla de fábrica"/></h1>
                    </div>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="active"/>
                    </group>
                    <group string="Descripción">
                        <field name="note" nolabel="1" placeholder="Descripción del motivo..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_justech_warranty_claim_reason" model="ir.actions.act_window">
        <field name="name">Motivos de Reclamo</field>
        <field name="res_model">justech.warranty.claim.reason</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Defina los motivos de reclamo</p>
            <p>Se usan para clasificar los reclamos (RMA).</p>
        </field>
    </record>
</odoo>
