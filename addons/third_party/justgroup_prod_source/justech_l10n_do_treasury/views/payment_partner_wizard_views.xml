<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_justech_payment_partner_wizard_form_treasury" model="ir.ui.view">
        <field name="name">justech.payment.partner.wizard.form.treasury</field>
        <field name="model">justech.payment.partner.wizard</field>
        <field name="inherit_id" ref="justech_l10n_do_payments_withholding.view_justech_payment_partner_wizard_form"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//form" position="attributes">
                <attribute name="class">o_treasury_wizard_xl</attribute>
            </xpath>

            <xpath expr="//field[@name='communication']" position="after">
                <field name="treasury_operation_type" widget="radio" options="{'horizontal': true}"/>
                <field name="treasury_amount_received"
                       string="Monto recibido"
                       invisible="partner_type != 'customer' or treasury_operation_type != 'open'"/>
                <field name="treasury_amount_received"
                       string="Monto a pagar"
                       invisible="partner_type != 'supplier' or treasury_operation_type != 'open'"/>
            </xpath>

            <xpath expr="//field[@name='line_ids']/.." position="attributes">
                <attribute name="invisible">treasury_operation_type == 'open'</attribute>
            </xpath>

            <xpath expr="//field[@name='withholding_line_ids']/.." position="attributes">
                <attribute name="invisible">treasury_operation_type == 'open' or not withholding_line_ids</attribute>
            </xpath>

            <xpath expr="//field[@name='payment_total']" position="attributes">
                <attribute name="invisible">treasury_operation_type == 'open'</attribute>
            </xpath>
            <xpath expr="//field[@name='withholding_total']" position="attributes">
                <attribute name="invisible">treasury_operation_type == 'open'</attribute>
            </xpath>
            <xpath expr="//field[@name='amount_after_withholding']" position="attributes">
                <attribute name="invisible">treasury_operation_type == 'open'</attribute>
            </xpath>
        </field>
    </record>
</odoo>
