<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_multi_invoice_manual_payment_wizard_form" model="ir.ui.view">
        <field name="name">multi.invoice.manual.payment.wizard.form</field>
        <field name="model">multi.invoice.manual.payment.wizard</field>
        <field name="arch" type="xml">
            <form string="Pago de Múltiples Facturas">
                <header>
                    <button name="action_load_open_moves" type="object" string="Cargar facturas pendientes" class="btn-secondary"/>
                    <button name="action_fill_full_balance" type="object" string="Rellenar saldo completo" class="btn-secondary"/>
                    <button name="action_clear_amounts" type="object" string="Borrar Montos" class="btn-secondary"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="alert" invisible="not duplicate_warning">
                        <field name="duplicate_warning" readonly="1" nolabel="1"/>
                    </div>
                    <div class="alert alert-info" role="alert" invisible="not check_warning">
                        <field name="check_warning" readonly="1" nolabel="1"/>
                    </div>
                    <group>
                        <group string="Transferencia">
                            <field name="partner_type"/>
                            <field name="partner_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="payment_date"/>
                            <field name="amount_received"/>
                            <field name="ref"/>
                        </group>
                        <group string="Banco">
                            <field name="journal_id"/>
                            <field name="payment_currency_id" readonly="1"/>
                            <field name="payment_method_line_id"/>
                            <field name="payment_receipt" widget="binary" filename="payment_receipt_filename"/>
                            <field name="payment_receipt_filename" invisible="1"/>
                            <field name="line_count" readonly="1"/>
                            <field name="amount_total_to_apply" readonly="1"/>
                            <field name="amount_difference" readonly="1"/>
                        </group>
                    </group>
                    <separator string="Documentos aplicados"/>
                    <field name="line_ids" nolabel="1">
                        <list editable="bottom" create="0" delete="0">
                            <field name="document_number" string="NCF / Documento" readonly="1"/>
                            <field name="move_id" column_invisible="1" invisible="1" force_save="1"/>
                            <field name="currency_id" readonly="1" force_save="1"/>
                            <field name="invoice_date" readonly="1" force_save="1"/>
                            <field name="due_date" readonly="1" force_save="1"/>
                            <field name="amount_total" readonly="1" force_save="1"/>
                            <field name="amount_residual" readonly="1" force_save="1"/>
                            <field name="amount_to_apply"/>
                            <field name="amount_to_apply_payment_currency" readonly="1"/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button name="action_create_payment" type="object" string="Confirmar pago" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_multi_invoice_manual_payment_wizard" model="ir.actions.act_window">
        <field name="name">Pago de Múltiples Facturas</field>
        <field name="res_model">multi.invoice.manual.payment.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Ensure menu is active (was inactive on DEV/PROD copies). -->
    <record id="menu_multi_invoice_manual_payment_root" model="ir.ui.menu">
        <field name="name">Pago de Múltiples Facturas</field>
        <field name="parent_id" ref="account.menu_finance"/>
        <field name="action" ref="action_multi_invoice_manual_payment_wizard"/>
        <field name="sequence">90</field>
        <field name="active" eval="True"/>
        <field name="group_ids" eval="[(6, 0, [ref('account.group_account_user'), ref('account.group_account_manager')])]"/>
    </record>
</odoo>
