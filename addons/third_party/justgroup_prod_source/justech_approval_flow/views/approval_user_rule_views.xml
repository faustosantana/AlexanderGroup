<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_justech_approval_user_rule_list" model="ir.ui.view">
        <field name="name">justech.approval.user.rule.list</field>
        <field name="model">justech.approval.user.rule</field>
        <field name="arch" type="xml">
            <list string="Configuración de aprobadores" editable="bottom">
                <field name="user_id" options="{'no_create': True}"/>
                <field name="company_id" options="{'no_create': True}"/>
                <field name="email" readonly="1"/>
                <field name="active"/>
                <field name="approve_sale" string="Ventas"
                       help="Puede aprobar la confirmación de cotizaciones."/>
                <field name="approve_purchase" string="Compras"
                       help="Puede aprobar órdenes de compra."/>
                <field name="approve_invoice" string="Facturas"
                       help="Puede aprobar facturas de cliente creadas directamente o sin una venta aprobada."/>
                <field name="allow_self_approval" string="Autoaprobar"
                       help="Puede confirmar cotizaciones sin solicitar aprobación a otro usuario."/>
            </list>
        </field>
    </record>

    <record id="view_justech_approval_user_rule_form" model="ir.ui.view">
        <field name="name">justech.approval.user.rule.form</field>
        <field name="model">justech.approval.user.rule</field>
        <field name="arch" type="xml">
            <form string="Aprobador">
                <sheet>
                    <group>
                        <field name="user_id" options="{'no_create': True}"/>
                        <field name="company_id" options="{'no_create': True}"/>
                        <field name="email" readonly="1"/>
                        <field name="active"/>
                    </group>
                    <group string="Tipos de documento">
                        <field name="approve_sale" string="Ventas"
                               help="Puede aprobar la confirmación de cotizaciones."/>
                        <field name="approve_purchase" string="Compras"
                               help="Puede aprobar órdenes de compra."/>
                        <field name="approve_invoice" string="Facturas"
                               help="Puede aprobar facturas de cliente creadas directamente o sin una venta aprobada."/>
                        <field name="allow_self_approval" string="Autoaprobar"
                               help="Puede confirmar cotizaciones sin solicitar aprobación a otro usuario."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_justech_approval_user_rule" model="ir.actions.act_window">
        <field name="name">Configuración de aprobaciones</field>
        <field name="res_model">justech.approval.user.rule</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Agregue usuarios que puedan aprobar cotizaciones, compras o facturas de cliente.
            </p>
        </field>
    </record>
</odoo>
