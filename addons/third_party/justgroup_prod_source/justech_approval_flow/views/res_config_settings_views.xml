<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_justech_approval" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.justech.approval</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Aprobaciones Justech" string="Aprobaciones Justech" name="justech_approval_flow">
                    <block title="Flujo simple de aprobaciones" name="justech_approval_block">
                        <setting id="justech_approval_purchase" string="Órdenes de compra"
                                 help="Reutiliza el estado nativo Pendiente de aprobación de Purchase.">
                            <field name="justech_approval_purchase_enabled"/>
                        </setting>
                        <setting id="justech_approval_sale" string="Cotizaciones"
                                 help="Se aplica a todas las empresas. Enviar al cliente no es aprobación.">
                            <field name="justech_approval_sale_enabled"/>
                        </setting>
                        <setting id="justech_approval_invoice" string="Facturas de cliente"
                                 help="No aplica a facturas de proveedor (Vendor Bill Control).">
                            <field name="justech_approval_invoice_enabled"/>
                        </setting>
                        <setting id="justech_approval_public_url" string="Approval Public Base URL"
                                 help="URL del entorno que contiene justech.approval.request. DEV: https://erp.justech.do — PROD: https://justgroup.app">
                            <field name="justech_approval_public_base_url" placeholder="https://erp.justech.do"/>
                        </setting>
                        <setting id="justech_approval_token" string="Validez del token (días)">
                            <field name="justech_approval_token_days"/>
                        </setting>
                        <div class="text-muted mt-2">
                            Configure los aprobadores en el menú Aprobaciones → Configuración.
                        </div>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
