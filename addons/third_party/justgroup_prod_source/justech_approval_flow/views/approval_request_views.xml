<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_justech_approval_request_list" model="ir.ui.view">
        <field name="name">justech.approval.request.list</field>
        <field name="model">justech.approval.request</field>
        <field name="arch" type="xml">
            <list string="Aprobaciones" create="false" delete="false">
                <field name="request_type"/>
                <field name="document_name" string="Documento"/>
                <field name="requester_id"/>
                <field name="partner_id" string="Cliente/Proveedor"/>
                <field name="requested_at"/>
                <field name="amount_total"/>
                <field name="currency_id" optional="show"/>
                <field name="request_note_preview" optional="show"/>
                <field name="attachment_count" string="Adjuntos" optional="show"/>
                <field name="state" widget="badge"
                       decoration-warning="state == 'pending'"
                       decoration-success="state == 'approved'"
                       decoration-danger="state in ('rejected', 'invalidated')"
                       decoration-muted="state == 'cancelled'"/>
                <button name="action_open_document" type="object" string="Abrir" icon="fa-external-link"/>
                <button name="action_open_approve_wizard" type="object" string="Aprobar"
                        class="btn-primary" icon="fa-check"
                        invisible="state != 'pending'"
                        groups="justech_approval_flow.group_approver"/>
                <button name="action_open_reject_wizard" type="object"
                        string="Rechazar" icon="fa-times"
                        invisible="state != 'pending'"
                        groups="justech_approval_flow.group_approver"/>
            </list>
        </field>
    </record>

    <record id="view_justech_approval_request_form" model="ir.ui.view">
        <field name="name">justech.approval.request.form</field>
        <field name="model">justech.approval.request</field>
        <field name="arch" type="xml">
            <form string="Solicitud de aprobación" create="false" delete="false">
                <header>
                    <button name="action_open_approve_wizard" type="object" string="Aprobar"
                            class="btn-primary" invisible="state != 'pending'"
                            groups="justech_approval_flow.group_approver"/>
                    <button name="action_open_reject_wizard" type="object" string="Rechazar"
                            invisible="state != 'pending'"
                            groups="justech_approval_flow.group_approver"/>
                    <button name="action_open_document" type="object" string="Ver documento"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="pending,approved,rejected"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="request_type"/>
                            <field name="document_name"/>
                            <field name="partner_id"/>
                            <field name="amount_untaxed"/>
                            <field name="amount_tax"/>
                            <field name="amount_total"/>
                            <field name="currency_id"/>
                            <field name="salesperson_id" invisible="not salesperson_id"/>
                            <field name="origin" invisible="not origin"/>
                        </group>
                        <group>
                            <field name="requester_id"/>
                            <field name="approver_id"/>
                            <field name="requested_at"/>
                            <field name="decided_by_id"/>
                            <field name="decided_at"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group>
                        <field name="request_note"/>
                        <field name="decision_note"/>
                        <field name="attachment_ids" widget="many2many_binary" readonly="1"/>
                    </group>
                    <field name="snapshot_html" nolabel="1" colspan="2"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_justech_approval_request_search" model="ir.ui.view">
        <field name="name">justech.approval.request.search</field>
        <field name="model">justech.approval.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="document_name"/>
                <field name="partner_id"/>
                <field name="requester_id"/>
                <filter string="Pendientes" name="pending" domain="[('state', '=', 'pending')]"/>
                <filter string="Pendientes de mí" name="my_pending"
                        domain="[('state', '=', 'pending'), ('approver_ids', 'in', uid)]"/>
                <filter string="Ventas" name="sale" domain="[('request_type', '=', 'sale_order')]"/>
                <filter string="Compras" name="purchase" domain="[('request_type', '=', 'purchase_order')]"/>
                <filter string="Facturas" name="invoice" domain="[('request_type', '=', 'out_invoice')]"/>
                <filter string="Aprobadas" name="approved" domain="[('state', '=', 'approved')]"/>
                <filter string="Rechazadas" name="rejected" domain="[('state', '=', 'rejected')]"/>
                <group>
                    <filter string="Tipo" name="group_type" context="{'group_by': 'request_type'}"/>
                    <filter string="Estado" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_justech_approval_pending" model="ir.actions.act_window">
        <field name="name">Pendientes</field>
        <field name="res_model">justech.approval.request</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'pending')]</field>
        <field name="context">{'search_default_pending': 1}</field>
    </record>

    <record id="action_justech_approval_all" model="ir.actions.act_window">
        <field name="name">Todas las solicitudes</field>
        <field name="res_model">justech.approval.request</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
