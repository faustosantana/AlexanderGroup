<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Internal RFQ / solicitud print: visible pending banner (not the final PO). -->
    <template id="report_purchasequotation_document_justech_pending_banner"
              inherit_id="purchase.report_purchasequotation_document">
        <xpath expr="//div[hasclass('page')]" position="inside">
            <t t-if="o.company_id.justech_approval_purchase_enabled and o.justech_approval_state != 'approved'">
                <div style="margin:12px 0 18px 0;padding:12px 14px;border:2px solid #b45309;background:#fffbeb;color:#92400e;font-weight:700;text-align:center;">
                    SOLICITUD DE ORDEN DE COMPRA — PENDIENTE DE APROBACIÓN<br/>
                    <span style="font-weight:600;font-size:12px;">
                        NO VÁLIDA COMO ORDEN DE COMPRA APROBADA
                    </span>
                </div>
            </t>
        </xpath>
    </template>
</odoo>
