<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dx_sale_print_wizard" model="ir.ui.view">
        <field name="name">dx.sale.print.wizard.form</field>
        <field name="model">dx.sale.print.wizard</field>
        <field name="arch" type="xml">
            <form string="Imprimir">
                <group>
                    <div class="text-muted">
                        La cotización oficial es el formato de la empresa. Factura Proforma y Formato Propet son opcionales.
                    </div>
                    <field name="order_id" readonly="1"/>
                </group>
                <footer>
                    <button name="action_print_quotation" type="object" string="Cotización en PDF" class="btn-primary"/>
                    <button name="action_print_proforma" type="object" string="Factura Proforma" class="btn-secondary"/>
                    <button name="action_print_propet" type="object" string="Formato Propet" class="btn-secondary"/>
                    <button string="Cerrar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_dx_invoice_print_wizard" model="ir.ui.view">
        <field name="name">dx.invoice.print.wizard.form</field>
        <field name="model">dx.invoice.print.wizard</field>
        <field name="arch" type="xml">
            <form string="Imprimir">
                <group>
                    <div class="text-muted">
                        La factura oficial es el formato de la empresa. Formato Propet es opcional y no sustituye el documento fiscal.
                    </div>
                    <field name="move_id" readonly="1"/>
                </group>
                <footer>
                    <button name="action_print_invoice" type="object" string="Factura en PDF" class="btn-primary"/>
                    <button name="action_print_propet" type="object" string="Formato Propet" class="btn-secondary"/>
                    <button string="Cerrar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
