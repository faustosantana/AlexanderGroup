<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Conduce is a logistics action. Print formats stay under Imprimir. -->
    <record id="view_sale_order_form_dx_print_buttons" model="ir.ui.view">
        <field name="name">sale.order.form.dx.conduce.button</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="priority">85</field>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="dx_outgoing_picking_count" invisible="1"/>
                <button name="action_dx_print_formats"
                        type="object"
                        string="Imprimir"
                        class="btn-secondary"
                        display="always"/>
                <button name="action_dx_open_conduce"
                        type="object"
                        string="Crear Conduce"
                        class="btn-primary"
                        display="always"
                        invisible="state not in ('sale', 'done') or dx_outgoing_picking_count"/>
                <button name="action_dx_open_conduce"
                        type="object"
                        string="Conduce"
                        class="btn-primary"
                        display="always"
                        invisible="state not in ('sale', 'done') or not dx_outgoing_picking_count"/>
            </xpath>
        </field>
    </record>
</odoo>
