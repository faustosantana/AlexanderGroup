<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Conduce is a logistics action. Print formats stay under Imprimir. -->
    <record id="view_sale_order_form_dx_print_buttons" model="ir.ui.view">
        <field name="name">sale.order.form.dx.conduce.button</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="priority">85</field>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="dx_outgoing_picking_count" invisible="1"/>
                <button name="action_dx_print_formats"
                        type="object"
                        string="Imprimir"
                        class="btn-secondary"
                        display="always"/>
                <button name="action_dx_open_conduce"
                        type="object"
                        string="Crear Conduce"
                        class="btn-primary"
                        display="always"
                        invisible="state not in ('sale', 'done') or dx_outgoing_picking_count"/>
                <button name="action_dx_open_conduce"
                        type="object"
                        string="Conduce"
                        class="btn-primary"
                        display="always"
                        invisible="state not in ('sale', 'done') or not dx_outgoing_picking_count"/>
            </xpath>
            <xpath expr="//button[@id='send_proforma_primary']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//button[@id='send_proforma']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_picking_form_dx_conduce_print" model="ir.ui.view">
        <field name="name">stock.picking.form.dx.conduce.print</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="priority">85</field>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='do_print_picking']" position="replace">
                <button name="%(stock.action_report_delivery)d"
                        string="Conduce"
                        type="action"
                        groups="stock.group_stock_user"
                        data-hotkey="o"
                        invisible="state != 'assigned' or picking_type_code != 'outgoing'"/>
                <button name="do_print_picking"
                        string="Print"
                        type="object"
                        groups="stock.group_stock_user"
                        data-hotkey="o"
                        invisible="state != 'assigned' or picking_type_code == 'outgoing'"/>
            </xpath>
            <xpath expr="//button[@type='action'][@data-hotkey='o'][@groups='base.group_user']" position="attributes">
                <attribute name="string">Conduce</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_account_move_form_dx_print_buttons" model="ir.ui.view">
        <field name="name">account.move.form.dx.print.button</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="priority">85</field>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_dx_print_formats"
                        type="object"
                        string="Imprimir"
                        class="btn-secondary"
                        display="always"
                        invisible="move_type not in ('out_invoice', 'out_refund')"/>
            </xpath>
        </field>
    </record>
</odoo>
