<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- V5: 6 mastheads distintos. Qt4 = tables. No [logo|empresa|título] compartido. -->

    <template id="dx_header_doralex">
        <table class="dx-h-dor" border="0" cellpadding="0" cellspacing="0">
            <tr>
                <td class="dx-h-dor-rail"/>
                <td class="dx-h-dor-brand">
                    <img t-if="company.dx_report_show_logo and company.logo"
                         t-att-src="company._dx_report_logo_src()"
                         t-att-style="company._dx_report_logo_style()"
                         t-att-alt="dx_legal"/>
                    <div class="dx-legal">
                        <t t-out="dx_legal"/>
                        <t t-if="company.vat"> · RNC <t t-out="company._dx_vat_display()"/></t>
                    </div>
                    <div class="dx-contact">
                        <t t-if="company.email" t-out="company.email"/>
                        <t t-if="company.phone"> · <t t-out="company.phone"/></t>
                    </div>
                </td>
                <td class="dx-h-dor-doc" t-if="dx_ident">
                    <div class="dx-head-title" t-out="dx_ident.get('title')"/>
                    <div class="dx-head-number">
                        <span t-if="dx_ident.get('badge')" class="dx-badge" t-out="dx_ident.get('badge')"/>
                        <span t-out="dx_ident.get('number')"/>
                    </div>
                    <div class="dx-h-dor-meta">
                        <table class="dx-h-dor-meta-row" border="0" cellpadding="0" cellspacing="0">
                            <tr>
                                <td>
                                    <div class="dx-meta-k">Fecha</div>
                                    <div class="dx-meta-v" t-out="dx_header_meta.get('date') or '—'"/>
                                </td>
                                <td>
                                    <div class="dx-meta-k">Validez</div>
                                    <div class="dx-meta-v" t-out="dx_header_meta.get('validity') or '—'"/>
                                </td>
                            </tr>
                        </table>
                        <table class="dx-h-dor-meta-row" border="0" cellpadding="0" cellspacing="0">
                            <tr>
                                <td>
                                    <div class="dx-meta-k">Vendedor</div>
                                    <div class="dx-meta-v" t-out="dx_header_meta.get('salesperson') or '—'"/>
                                </td>
                                <td>
                                    <div class="dx-meta-k">Moneda</div>
                                    <div class="dx-meta-v" t-out="dx_header_meta.get('currency') or '—'"/>
                                </td>
                            </tr>
                        </table>
                    </div>
                </td>
            </tr>
        </table>
        <div class="dx-h-dor-rule"/>
    </template>

    <template id="dx_header_pinaria">
        <div class="dx-h-pin-leaf"/>
        <table class="dx-h-pin" border="0" cellpadding="0" cellspacing="0">
            <tr>
                <td class="dx-h-pin-c">
                    <img t-if="company.dx_report_show_logo and company.logo"
                         t-att-src="company._dx_report_logo_src()"
                         t-att-style="company._dx_report_logo_style()"
                         t-att-alt="dx_legal"/>
                    <div class="dx-h-pin-legal" t-out="dx_legal"/>
                    <div class="dx-h-pin-contact">
                        <t t-if="company.vat">RNC <t t-out="company._dx_vat_display()"/></t>
                        <t t-if="company.phone"> · <t t-out="company.phone"/></t>
                        <t t-if="company.email"> · <t t-out="company.email"/></t>
                    </div>
                </td>
            </tr>
        </table>
        <div class="dx-h-pin-band"/>
    </template>

    <template id="dx_header_dominion">
        <table class="dx-h-dom" border="0" cellpadding="0" cellspacing="0">
            <tr>
                <td class="dx-h-dom-left">
                    <img t-if="company.dx_report_show_logo and company.logo"
                         t-att-src="company._dx_report_logo_src()"
                         t-att-style="company._dx_report_logo_style()"
                         t-att-alt="dx_legal"/>
                    <div class="dx-h-dom-legal" t-out="dx_legal"/>
                    <div t-if="company.vat" class="dx-rnc">RNC <t t-out="company._dx_vat_display()"/></div>
                    <div class="dx-contact">
                        <t t-if="company.email" t-out="company.email"/>
                        <t t-if="company.phone"> · <t t-out="company.phone"/></t>
                    </div>
                </td>
                <td class="dx-h-dom-rail" t-if="dx_ident">
                    <div class="dx-head-title" t-out="dx_ident.get('title')"/>
                    <div class="dx-head-number">
                        <span t-if="dx_ident.get('badge')" class="dx-badge" t-out="dx_ident.get('badge')"/>
                        <span t-out="dx_ident.get('number')"/>
                    </div>
                </td>
            </tr>
        </table>
    </template>

    <template id="dx_header_mayuma">
        <table class="dx-h-may" border="0" cellpadding="0" cellspacing="0">
            <tr>
                <td class="dx-h-may-logo">
                    <img t-if="company.dx_report_show_logo and company.logo"
                         t-att-src="company._dx_report_logo_src()"
                         t-att-style="company._dx_report_logo_style()"
                         t-att-alt="dx_legal"/>
                    <div class="dx-h-may-line1" t-out="dx_legal"/>
                    <div class="dx-h-may-line2">
                        <t t-if="company.vat">RNC <t t-out="company._dx_vat_display()"/></t>
                        <t t-if="dx_street"> · <t t-out="dx_street"/></t>
                    </div>
                </td>
                <td class="dx-h-may-title" t-if="dx_ident">
                    <div class="dx-head-title" t-out="dx_ident.get('title')"/>
                    <div class="dx-h-may-rule"/>
                    <div class="dx-head-number">
                        <span t-if="dx_ident.get('badge')" class="dx-badge" t-out="dx_ident.get('badge')"/>
                        <span t-out="dx_ident.get('number')"/>
                    </div>
                </td>
            </tr>
        </table>
    </template>

    <template id="dx_header_rempart">
        <table class="dx-h-rem" border="0" cellpadding="0" cellspacing="0">
            <tr>
                <td class="dx-h-rem-logo">
                    <img t-if="company.dx_report_show_logo and company.logo"
                         t-att-src="company._dx_report_logo_src()"
                         t-att-style="company._dx_report_logo_style()"
                         t-att-alt="dx_legal"/>
                </td>
                <td class="dx-h-rem-id">
                    <div class="dx-h-rem-legal" t-out="dx_legal"/>
                    <div t-if="company.vat" class="dx-rnc">RNC <t t-out="company._dx_vat_display()"/></div>
                    <div class="dx-contact" t-if="company.email" t-out="company.email"/>
                    <div class="dx-contact" t-if="company.phone" t-out="company.phone"/>
                </td>
                <td class="dx-h-rem-doc" t-if="dx_ident">
                    <div class="dx-head-title" t-out="dx_ident.get('title')"/>
                    <div class="dx-head-number">
                        <span t-if="dx_ident.get('badge')" class="dx-badge" t-out="dx_ident.get('badge')"/>
                        <span t-out="dx_ident.get('number')"/>
                    </div>
                </td>
            </tr>
        </table>
        <div class="dx-h-rem-rule"/>
    </template>

    <template id="dx_header_blueelite">
        <table class="dx-h-blu" border="0" cellpadding="0" cellspacing="0">
            <tr>
                <td class="dx-h-blu-doc" t-if="dx_ident">
                    <div class="dx-head-title" t-out="dx_ident.get('title')"/>
                    <div class="dx-head-number">
                        <span t-if="dx_ident.get('badge')" class="dx-badge" t-out="dx_ident.get('badge')"/>
                        <span t-out="dx_ident.get('number')"/>
                    </div>
                    <div class="dx-h-blu-legal" t-out="dx_legal"/>
                    <div t-if="company.vat" class="dx-rnc">RNC <t t-out="company._dx_vat_display()"/></div>
                    <div class="dx-contact" t-if="company.email" t-out="company.email"/>
                    <div class="dx-contact" t-if="company.phone" t-out="company.phone"/>
                </td>
                <td class="dx-h-blu-logo">
                    <img t-if="company.dx_report_show_logo and company.logo"
                         t-att-src="company._dx_report_logo_src()"
                         t-att-style="company._dx_report_logo_style()"
                         t-att-alt="dx_legal"/>
                </td>
            </tr>
        </table>
        <div class="dx-h-blu-rule"/>
    </template>

    <template id="dx_footer_doralex">
        <div class="dx-f-dor-rule"/>
        <table class="dx-foot-table" border="0" cellpadding="0" cellspacing="0">
            <tr>
                <td class="dx-foot-text">
                    <t t-if="company.vat">RNC <t t-out="company._dx_vat_display()"/></t>
                    <t t-if="company.email"> · <t t-out="company.email"/></t>
                    <t t-if="company.phone"> · <t t-out="company.phone"/></t>
                </td>
                <td class="dx-foot-page">
                    <t t-if="report_type == 'pdf'">Página <span class="page"/> / <span class="topage"/></t>
                </td>
            </tr>
        </table>
    </template>

    <template id="dx_footer_pinaria">
        <div class="dx-f-pin-rule"/>
        <div class="dx-f-pin-c">
            <t t-out="dx_legal"/>
            <t t-if="company.vat"> · RNC <t t-out="company._dx_vat_display()"/></t>
            <t t-if="report_type == 'pdf'"> · Página <span class="page"/> / <span class="topage"/></t>
        </div>
    </template>

    <template id="dx_footer_dominion">
        <table class="dx-foot-table dx-f-dom" border="0" cellpadding="0" cellspacing="0">
            <tr>
                <td class="dx-foot-text">
                    <t t-out="dx_legal"/>
                    <t t-if="company.email"> · <t t-out="company.email"/></t>
                </td>
                <td class="dx-foot-page">
                    <t t-if="report_type == 'pdf'"><span class="page"/> / <span class="topage"/></t>
                </td>
            </tr>
        </table>
    </template>

    <template id="dx_footer_mayuma">
        <div class="dx-f-may-geo"/>
        <table class="dx-foot-table" border="0" cellpadding="0" cellspacing="0">
            <tr>
                <td class="dx-foot-text">
                    <t t-if="company.vat">RNC <t t-out="company._dx_vat_display()"/></t>
                    <t t-if="company.email"> · <t t-out="company.email"/></t>
                    <t t-if="company.phone"> · <t t-out="company.phone"/></t>
                </td>
                <td class="dx-foot-page">
                    <t t-if="report_type == 'pdf'">Página <span class="page"/> / <span class="topage"/></t>
                </td>
            </tr>
        </table>
    </template>

    <template id="dx_footer_rempart">
        <div class="dx-f-rem-rule"/>
        <table class="dx-foot-table" border="0" cellpadding="0" cellspacing="0">
            <tr>
                <td class="dx-foot-text">
                    <t t-out="dx_legal"/>
                    <t t-if="company.vat"> · RNC <t t-out="company._dx_vat_display()"/></t>
                    <t t-if="company.email"> · <t t-out="company.email"/></t>
                </td>
                <td class="dx-foot-page">
                    <t t-if="report_type == 'pdf'">Página <span class="page"/> / <span class="topage"/></t>
                </td>
            </tr>
        </table>
    </template>

    <template id="dx_footer_blueelite">
        <div class="dx-f-blu-rule"/>
        <table class="dx-foot-table" border="0" cellpadding="0" cellspacing="0">
            <tr>
                <td class="dx-foot-text">
                    <t t-if="company.email" t-out="company.email"/>
                    <t t-if="company.phone"> · <t t-out="company.phone"/></t>
                    <t t-if="company.vat"> · RNC <t t-out="company._dx_vat_display()"/></t>
                </td>
                <td class="dx-foot-page">
                    <t t-if="report_type == 'pdf'"><span class="page"/> / <span class="topage"/></t>
                </td>
            </tr>
        </table>
    </template>
</odoo>
