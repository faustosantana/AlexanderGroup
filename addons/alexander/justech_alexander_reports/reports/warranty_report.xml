<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_warranty_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="o" t-value="doc"/>
                <t t-set="company" t-value="doc.company_id"/>
                <t t-set="dx_header_identity" t-value="{'title': 'CERTIFICADO DE GARANTÍA', 'number': doc.name or '', 'badge': ''}"/>
                <t t-call="web.external_layout">
                    <div class="page dx-page">
                        <div class="dx-composition dx-warranty">
                            <div class="dx-warranty-row">
                                <div class="dx-warranty-k">Cliente</div>
                                <div class="dx-warranty-v"><span t-field="doc.partner_id"/></div>
                            </div>
                            <div class="dx-warranty-row">
                                <div class="dx-warranty-k">Producto</div>
                                <div class="dx-warranty-v"><span t-field="doc.product_id"/></div>
                            </div>
                            <div class="dx-warranty-row">
                                <div class="dx-warranty-k">Inicio</div>
                                <div class="dx-warranty-v"><span t-field="doc.date_start"/></div>
                            </div>
                            <div class="dx-warranty-row">
                                <div class="dx-warranty-k">Cobertura</div>
                                <div class="dx-warranty-v"><span t-field="doc.warranty_months"/> meses</div>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_warranty" model="ir.actions.report">
        <field name="name">Certificado de Garantía</field>
        <field name="model">justech.warranty</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">justech_alexander_reports.report_warranty_document</field>
        <field name="report_file">justech_alexander_reports.report_warranty_document</field>
        <field name="binding_model_id" ref="justech_warranty.model_justech_warranty"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_doralex_a4"/>
    </record>
</odoo>
