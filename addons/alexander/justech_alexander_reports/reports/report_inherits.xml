<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="sale_document_dx" inherit_id="sale.report_saleorder_document">
        <xpath expr="//div[hasclass('page')]" position="attributes">
            <attribute name="class">page dx-page dx-v2</attribute>
        </xpath>
        <xpath expr="//div[hasclass('page')]" position="inside">
            <div class="dx-composition-wrap">
                <t t-set="dx" t-value="doc._dx_sale_compose()"/>
                <t t-call="justech_alexander_reports.dx_sale_composition"/>
            </div>
        </xpath>
        <xpath expr="//div[@id='informations']" position="attributes">
            <attribute name="style">display:none;height:0;overflow:hidden;</attribute>
        </xpath>
        <xpath expr="//table[hasclass('o_main_table')]" position="attributes">
            <attribute name="style">display:none;height:0;overflow:hidden;</attribute>
        </xpath>
        <xpath expr="//table[hasclass('o_total_table')]" position="attributes">
            <attribute name="style">display:none;height:0;overflow:hidden;</attribute>
        </xpath>
        <xpath expr="//div[hasclass('page')]/div[not(contains(@class, 'dx-composition-wrap'))]" position="attributes">
            <attribute name="style">display:none;height:0;overflow:hidden;</attribute>
        </xpath>
    </template>

    <template id="invoice_document_dx" inherit_id="account.report_invoice_document">
        <xpath expr="//div[hasclass('page')]" position="attributes">
            <attribute name="class">page dx-page dx-v2</attribute>
        </xpath>
        <xpath expr="//div[hasclass('page')]" position="inside">
            <div class="dx-composition-wrap">
                <t t-set="dx" t-value="o._dx_invoice_compose()"/>
                <t t-call="justech_alexander_reports.dx_invoice_composition"/>
            </div>
        </xpath>
    </template>

    <template id="purchase_order_dx" inherit_id="purchase.report_purchaseorder_document">
        <xpath expr="//div[hasclass('page')]" position="attributes">
            <attribute name="class">page dx-page dx-v2</attribute>
        </xpath>
        <xpath expr="//div[hasclass('page')]" position="inside">
            <div class="dx-composition-wrap">
                <t t-set="dx" t-value="o._dx_purchase_compose()"/>
                <t t-call="justech_alexander_reports.dx_purchase_composition"/>
            </div>
        </xpath>
    </template>

    <template id="purchase_rfq_dx" inherit_id="purchase.report_purchasequotation_document">
        <xpath expr="//div[hasclass('page')]" position="attributes">
            <attribute name="class">page dx-page dx-v2</attribute>
        </xpath>
        <xpath expr="//div[hasclass('page')]" position="inside">
            <div class="dx-composition-wrap">
                <t t-set="dx" t-value="o._dx_purchase_compose()"/>
                <t t-call="justech_alexander_reports.dx_purchase_composition"/>
            </div>
        </xpath>
    </template>

    <template id="delivery_document_dx" inherit_id="stock.report_delivery_document">
        <xpath expr="//div[hasclass('page')]" position="attributes">
            <attribute name="class">page dx-page dx-v2</attribute>
        </xpath>
        <xpath expr="//div[hasclass('page')]/h2" position="before">
            <style>
                .dx-page.dx-v2 table.table,
                .dx-page.dx-v2 #informations,
                .dx-page.dx-v2 h2 { display: none; }
            </style>
            <div class="dx-composition-wrap">
                <t t-set="dx" t-value="o._dx_picking_compose()"/>
                <t t-call="justech_alexander_reports.dx_picking_composition"/>
            </div>
        </xpath>
        <xpath expr="//div[hasclass('page')]/h2" position="attributes">
            <attribute name="style">display:none;height:0;margin:0;padding:0;overflow:hidden;</attribute>
        </xpath>
        <xpath expr="//div[@id='informations']" position="attributes">
            <attribute name="style">display:none;height:0;margin:0;padding:0;overflow:hidden;</attribute>
        </xpath>
        <xpath expr="//table[@name='stock_move_table']" position="attributes">
            <attribute name="style">display:none;height:0;overflow:hidden;</attribute>
        </xpath>
        <xpath expr="//table[@name='stock_move_line_table']" position="attributes">
            <attribute name="style">display:none;height:0;overflow:hidden;</attribute>
        </xpath>
    </template>

    <template id="payment_receipt_dx" inherit_id="account.report_payment_receipt_document">
        <xpath expr="//div[hasclass('page')]" position="attributes">
            <attribute name="class">page dx-page dx-v2</attribute>
        </xpath>
        <xpath expr="//div[hasclass('page')]" position="inside">
            <div class="dx-composition-wrap">
                <t t-set="dx" t-value="o._dx_payment_compose()"/>
                <t t-call="justech_alexander_reports.dx_payment_composition"/>
            </div>
        </xpath>
    </template>

    <template id="picking_document_dx" inherit_id="stock.report_picking">
        <xpath expr="//div[hasclass('page')]" position="attributes">
            <attribute name="class">page o_report_stockpicking_operations dx-page dx-v2</attribute>
        </xpath>
        <xpath expr="//div[hasclass('o_report_stockpicking_operations')]/div[hasclass('row')][1]" position="before">
            <style>
                .o_report_stockpicking_operations table.table,
                .o_report_stockpicking_operations .oe_structure,
                .o_report_stockpicking_operations .o_stock_report_header_row { display: none; }
            </style>
            <div class="dx-composition-wrap">
                <t t-set="dx" t-value="o._dx_picking_compose()"/>
                <t t-call="justech_alexander_reports.dx_picking_composition"/>
            </div>
        </xpath>
        <xpath expr="//div[hasclass('o_report_stockpicking_operations')]/div[hasclass('row')][1]" position="attributes">
            <attribute name="style">display:none;height:0;overflow:hidden;</attribute>
        </xpath>
        <xpath expr="//div[hasclass('o_report_stockpicking_operations')]/div[hasclass('row')][2]" position="attributes">
            <attribute name="style">display:none;height:0;overflow:hidden;</attribute>
        </xpath>
        <xpath expr="//div[hasclass('o_stock_report_header_row')]" position="attributes">
            <attribute name="style">display:none;height:0;overflow:hidden;</attribute>
        </xpath>
    </template>

    <template id="return_document_dx" inherit_id="stock.report_return_slip">
        <xpath expr="//div[hasclass('page')]" position="attributes">
            <attribute name="class">page dx-page dx-v2</attribute>
        </xpath>
        <xpath expr="//div[hasclass('page')]" position="inside">
            <div class="dx-composition-wrap">
                <t t-set="dx" t-value="o._dx_picking_compose()"/>
                <t t-call="justech_alexander_reports.dx_picking_composition"/>
            </div>
        </xpath>
    </template>
</odoo>
