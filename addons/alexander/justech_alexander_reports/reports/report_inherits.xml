<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="sale_document_dx" inherit_id="sale.report_saleorder_document">
        <xpath expr="//div[@id='informations']" position="before">
            <table class="dx-party-table" t-if="doc.partner_id">
                <tr>
                    <td>
                        <div class="dx-block-title">Cliente</div>
                        <div t-field="doc.partner_id"/>
                        <div t-if="doc.partner_id.vat">RNC / Cédula: <span t-field="doc.partner_id.vat"/></div>
                        <div t-field="doc.partner_id"
                             t-options='{"widget": "contact", "fields": ["address", "phone"], "no_marker": True}'/>
                    </td>
                </tr>
            </table>
        </xpath>
        <xpath expr="//span[@name='order_note']" position="after">
            <t t-call="justech_alexander_reports.dx_report_extras">
                <t t-set="company" t-value="doc.company_id"/>
            </t>
        </xpath>
    </template>

    <template id="invoice_document_dx" inherit_id="account.report_invoice_document">
        <xpath expr="//div[@id='informations']" position="before">
            <table class="dx-party-table" t-if="o.partner_id">
                <tr>
                    <td>
                        <div class="dx-block-title">Cliente</div>
                        <div t-field="o.partner_id"/>
                        <div t-if="o.partner_id.vat">RNC / Cédula: <span t-field="o.partner_id.vat"/></div>
                        <div t-field="o.partner_id"
                             t-options='{"widget": "contact", "fields": ["address", "phone"], "no_marker": True}'/>
                    </td>
                    <td t-if="o.move_type in ('out_refund', 'in_refund')" class="dx-intro-title">
                        <div class="dx-badge-refund">Nota de crédito</div>
                        <div t-if="'l10n_do_origin_ncf' in o and o.l10n_do_origin_ncf">NCF afectado: <span t-field="o.l10n_do_origin_ncf"/></div>
                        <div t-if="o.ref">Referencia: <span t-field="o.ref"/></div>
                    </td>
                </tr>
            </table>
        </xpath>
        <xpath expr="//div[@id='payment_term']" position="after">
            <t t-call="justech_alexander_reports.dx_report_extras">
                <t t-set="company" t-value="o.company_id"/>
            </t>
        </xpath>
    </template>

    <template id="invoice_l10n_do_dx" inherit_id="l10n_do_accounting.l10n_do_report_invoice_document">
        <xpath expr="//div[@id='do_informations']/div[hasclass('col-6')][1]" position="attributes">
            <attribute name="style">display:none</attribute>
        </xpath>
    </template>

    <template id="purchase_order_dx" inherit_id="purchase.report_purchaseorder_document">
        <xpath expr="//div[@id='total']" position="after">
            <t t-call="justech_alexander_reports.dx_report_extras">
                <t t-set="company" t-value="o.company_id"/>
            </t>
        </xpath>
    </template>

    <template id="purchase_rfq_dx" inherit_id="purchase.report_purchasequotation_document">
        <xpath expr="//table" position="after">
            <t t-call="justech_alexander_reports.dx_report_extras">
                <t t-set="company" t-value="o.company_id"/>
            </t>
        </xpath>
    </template>

    <template id="delivery_document_dx" inherit_id="stock.report_delivery_document">
        <xpath expr="//div[hasclass('page')]" position="inside">
            <t t-call="justech_alexander_reports.dx_report_extras">
                <t t-set="company" t-value="o.company_id"/>
            </t>
        </xpath>
    </template>

    <template id="payment_receipt_dx" inherit_id="account.report_payment_receipt_document">
        <xpath expr="//div[hasclass('page')]" position="inside">
            <t t-call="justech_alexander_reports.dx_report_extras">
                <t t-set="company" t-value="o.company_id"/>
            </t>
        </xpath>
    </template>

    <template id="picking_document_dx" inherit_id="stock.report_picking">
        <xpath expr="//div[hasclass('page')]" position="inside">
            <t t-call="justech_alexander_reports.dx_report_extras">
                <t t-set="company" t-value="o.company_id"/>
            </t>
        </xpath>
    </template>

    <template id="return_document_dx" inherit_id="stock.report_return_slip">
        <xpath expr="//div[hasclass('page')]" position="inside">
            <t t-call="justech_alexander_reports.dx_report_extras">
                <t t-set="company" t-value="o.company_id"/>
            </t>
        </xpath>
    </template>
</odoo>
