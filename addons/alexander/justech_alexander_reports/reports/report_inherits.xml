<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="sale_document_dx" inherit_id="sale.report_saleorder_document">
        <xpath expr="//div[hasclass('page')]" position="replace">
            <div class="page dx-page">
                <t t-set="dx" t-value="doc._dx_sale_compose()"/>
                <t t-call="justech_alexander_reports.dx_sale_composition"/>
                <div id="informations" style="display:none"/>
                <span name="order_note" style="display:none"/>
            </div>
        </xpath>
    </template>

    <template id="invoice_document_dx" inherit_id="account.report_invoice_document">
        <xpath expr="//div[hasclass('page')]" position="replace">
            <div class="page dx-page">
                <t t-set="dx" t-value="o._dx_invoice_compose()"/>
                <t t-call="justech_alexander_reports.dx_invoice_composition"/>
                <div id="informations" style="display:none"/>
                <div id="do_informations" style="display:none">
                    <div class="col-6"/>
                    <div class="col-6"/>
                </div>
                <div id="total" style="display:none"/>
                <div id="payment_term" style="display:none"/>
            </div>
        </xpath>
    </template>

    <template id="purchase_order_dx" inherit_id="purchase.report_purchaseorder_document">
        <xpath expr="//div[@id='total']" position="after">
            <div t-if="o.dest_address_id" class="dx-block">
                <div class="dx-block-title">Entrega</div>
                <div t-field="o.dest_address_id"
                     t-options='{"widget": "contact", "fields": ["address", "phone"], "no_marker": True}'/>
            </div>
            <t t-call="justech_alexander_reports.dx_report_extras">
                <t t-set="company" t-value="o.company_id"/>
                <t t-set="dx_extras_mode" t-value="'purchase'"/>
            </t>
        </xpath>
    </template>

    <template id="purchase_rfq_dx" inherit_id="purchase.report_purchasequotation_document">
        <xpath expr="//div[hasclass('page')]/table" position="after">
            <t t-call="justech_alexander_reports.dx_report_extras">
                <t t-set="company" t-value="o.company_id"/>
                <t t-set="dx_extras_mode" t-value="'purchase'"/>
            </t>
        </xpath>
    </template>

    <template id="delivery_document_dx" inherit_id="stock.report_delivery_document">
        <xpath expr="//div[hasclass('page')]" position="inside">
            <t t-call="justech_alexander_reports.dx_report_extras">
                <t t-set="company" t-value="o.company_id"/>
                <t t-set="dx_extras_mode" t-value="'stock'"/>
            </t>
        </xpath>
    </template>

    <template id="payment_receipt_dx" inherit_id="account.report_payment_receipt_document">
        <xpath expr="//div[hasclass('page')]" position="replace">
            <div class="page dx-page">
                <t t-set="dx" t-value="o._dx_payment_compose()"/>
                <t t-call="justech_alexander_reports.dx_payment_composition"/>
                <table name="invoices" style="display:none"/>
            </div>
        </xpath>
    </template>

    <template id="picking_document_dx" inherit_id="stock.report_picking">
        <xpath expr="//div[hasclass('page')]" position="inside">
            <t t-call="justech_alexander_reports.dx_report_extras">
                <t t-set="company" t-value="o.company_id"/>
                <t t-set="dx_extras_mode" t-value="'stock'"/>
            </t>
        </xpath>
    </template>

    <template id="return_document_dx" inherit_id="stock.report_return_slip">
        <xpath expr="//div[hasclass('page')]" position="inside">
            <t t-call="justech_alexander_reports.dx_report_extras">
                <t t-set="company" t-value="o.company_id"/>
                <t t-set="dx_extras_mode" t-value="'stock'"/>
            </t>
        </xpath>
    </template>
</odoo>
