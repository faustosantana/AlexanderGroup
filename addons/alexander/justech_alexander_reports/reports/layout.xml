<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="external_layout_force_document_company" inherit_id="web.external_layout">
        <xpath expr="//t[@t-if='not company']" position="before">
            <t t-if="o and 'company_id' in o._fields and o.company_id">
                <t t-set="company" t-value="o.company_id.sudo()"/>
            </t>
            <t t-elif="doc and 'company_id' in doc._fields and doc.company_id">
                <t t-set="company" t-value="doc.company_id.sudo()"/>
            </t>
        </xpath>
    </template>

    <template id="internal_layout_force_document_company" inherit_id="web.internal_layout">
        <xpath expr="//t[@t-if='not company']" position="before">
            <t t-if="o and 'company_id' in o._fields and o.company_id">
                <t t-set="company" t-value="o.company_id.sudo()"/>
            </t>
            <t t-elif="doc and 'company_id' in doc._fields and doc.company_id">
                <t t-set="company" t-value="doc.company_id.sudo()"/>
            </t>
        </xpath>
    </template>

    <template id="external_layout_doralex" name="Doralex">
        <t t-if="o and 'company_id' in o._fields and o.company_id">
            <t t-set="company" t-value="o.company_id.sudo()"/>
        </t>
        <t t-elif="doc and 'company_id' in doc._fields and doc.company_id">
            <t t-set="company" t-value="doc.company_id.sudo()"/>
        </t>
        <t t-set="dx_theme" t-value="company._dx_report_theme()"/>
        <t t-set="dx_record" t-value="o if o else doc"/>
        <t t-set="dx_ident" t-value="dx_header_identity or company._dx_header_identity_for(dx_record)"/>
        <div t-attf-class="header o_company_#{company.id}_layout dx-report-header dx-theme-#{dx_theme['code']}">
            <table class="dx-head-table">
                <tr>
                    <td t-attf-class="dx-head-logo #{'dx-logo-panel' if dx_theme.get('logo_on_dark') else ''}">
                        <img t-if="company.dx_report_show_logo and company.logo"
                             t-att-src="image_data_uri(company.logo)"
                             t-att-style="company._dx_report_logo_style()"
                             t-att-alt="company.dx_trade_name or company.name"/>
                    </td>
                    <td class="dx-head-identity">
                        <div class="dx-trade" t-out="company.dx_trade_name or company.name"/>
                        <div t-if="company.dx_report_show_legal_name" class="dx-legal" t-out="company.name"/>
                        <div t-if="company.dx_report_show_rnc and company.vat" class="dx-rnc">
                            RNC <t t-out="company._dx_vat_display()"/>
                        </div>
                        <div t-if="company.dx_report_show_address" class="dx-meta">
                            <t t-if="company.street" t-out="company.street"/>
                            <t t-if="company.city">, <t t-out="company.city"/></t>
                        </div>
                        <div class="dx-meta">
                            <t t-if="company.dx_report_show_phone and company.phone" t-out="company.phone"/>
                            <t t-if="company.dx_report_show_email and company.email">
                                <t t-if="company.phone"> · </t>
                                <t t-out="company.email"/>
                            </t>
                        </div>
                    </td>
                    <td class="dx-head-doc" t-if="dx_ident">
                        <div class="dx-head-title" t-out="dx_ident.get('title')"/>
                        <div class="dx-head-number">
                            <span t-if="dx_ident.get('badge')" class="dx-badge" t-out="dx_ident.get('badge')"/>
                            <span t-out="dx_ident.get('number')"/>
                        </div>
                    </td>
                </tr>
            </table>
            <div class="dx-head-rule"/>
        </div>

        <div t-attf-class="article o_company_#{company.id}_layout dx-report-body dx-theme-#{dx_theme['code']} #{'dx-is-refund' if o and o._name == 'account.move' and o.move_type in ('out_refund', 'in_refund') else ''} #{'dx-doc-payment' if o and o._name == 'account.payment' else ''} #{'dx-doc-purchase' if o and o._name == 'purchase.order' else ''} #{'dx-doc-stock' if o and o._name == 'stock.picking' else ''}"
             t-att-data-oe-model="o and o._name"
             t-att-data-oe-id="o and o.id">
            <t t-out="0"/>
        </div>

        <div t-attf-class="footer o_company_#{company.id}_layout dx-report-footer dx-theme-#{dx_theme['code']}">
            <div class="dx-foot-rule"/>
            <table class="dx-foot-table">
                <tr>
                    <td class="dx-foot-text">
                        <t t-out="company.dx_report_footer_text or (company.dx_trade_name or company.name)"/>
                        <t t-if="company.country_id"> · <t t-out="company.country_id.name"/></t>
                        <t t-if="company.email"> · <t t-out="company.email"/></t>
                        <t t-if="company.phone"> · <t t-out="company.phone"/></t>
                        <t t-if="company.website"> · <t t-out="company.website"/></t>
                    </td>
                    <td class="dx-foot-page">
                        <t t-if="report_type == 'pdf'">Página <span class="page"/> / <span class="topage"/></t>
                    </td>
                </tr>
            </table>
        </div>
    </template>

    <record id="report_layout_doralex" model="report.layout">
        <field name="name">Doralex</field>
        <field name="sequence">1</field>
        <field name="view_id" ref="external_layout_doralex"/>
    </record>
</odoo>
