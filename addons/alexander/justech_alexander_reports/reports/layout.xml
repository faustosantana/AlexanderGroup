<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="external_layout_force_document_company" inherit_id="web.external_layout">
        <xpath expr="//t[@t-if='not company']" position="before">
            <t t-if="o and 'company_id' in o._fields and o.company_id">
                <t t-set="company" t-value="o.company_id.sudo()"/>
            </t>
            <t t-elif="doc and 'company_id' in doc._fields and doc.company_id">
                <t t-set="company" t-value="doc.company_id.sudo()"/>
            </t>
        </xpath>
    </template>

    <template id="internal_layout_force_document_company" inherit_id="web.internal_layout">
        <xpath expr="//t[@t-if='not company']" position="before">
            <t t-if="o and 'company_id' in o._fields and o.company_id">
                <t t-set="company" t-value="o.company_id.sudo()"/>
            </t>
            <t t-elif="doc and 'company_id' in doc._fields and doc.company_id">
                <t t-set="company" t-value="doc.company_id.sudo()"/>
            </t>
        </xpath>
    </template>

    <template id="external_layout_doralex" name="Doralex">
        <t t-if="o and 'company_id' in o._fields and o.company_id">
            <t t-set="company" t-value="o.company_id.sudo()"/>
        </t>
        <t t-elif="doc and 'company_id' in doc._fields and doc.company_id">
            <t t-set="company" t-value="doc.company_id.sudo()"/>
        </t>
        <t t-set="dx_theme" t-value="company._dx_report_theme()"/>
        <t t-set="dx_record" t-value="o if o else doc"/>
        <t t-set="dx_ident" t-value="dx_header_identity or company._dx_header_identity_for(dx_record)"/>
        <t t-set="dx_header_meta" t-value="company._dx_header_meta_for(dx_record)"/>
        <t t-set="dx_legal" t-value="company._dx_legal_display()"/>
        <t t-set="dx_street" t-value="company._dx_street_display()"/>
        <t t-set="dx_city" t-value="company._dx_city_display()"/>
        <div t-attf-class="header o_company_#{company.id}_layout dx-report-header dx-theme-#{dx_theme['code']} dx-layout-#{dx_theme.get('layout') or 'dor'}">
            <t t-if="dx_theme.get('layout') == 'pin'">
                <t t-call="justech_alexander_reports.dx_header_pinaria"/>
            </t>
            <t t-elif="dx_theme.get('layout') == 'dom'">
                <t t-call="justech_alexander_reports.dx_header_dominion"/>
            </t>
            <t t-elif="dx_theme.get('layout') == 'may'">
                <t t-call="justech_alexander_reports.dx_header_mayuma"/>
            </t>
            <t t-elif="dx_theme.get('layout') == 'rem'">
                <t t-call="justech_alexander_reports.dx_header_rempart"/>
            </t>
            <t t-elif="dx_theme.get('layout') == 'blu'">
                <t t-call="justech_alexander_reports.dx_header_blueelite"/>
            </t>
            <t t-else="">
                <t t-call="justech_alexander_reports.dx_header_doralex"/>
            </t>
        </div>
        <div t-attf-class="article o_company_#{company.id}_layout dx-report-body dx-theme-#{dx_theme['code']} #{'dx-is-refund' if o and o._name == 'account.move' and o.move_type in ('out_refund', 'in_refund') else ''} #{'dx-doc-payment' if o and o._name == 'account.payment' else ''} #{'dx-doc-purchase' if o and o._name == 'purchase.order' else ''} #{'dx-doc-stock' if o and o._name == 'stock.picking' else ''}"
             t-att-data-oe-model="o and o._name"
             t-att-data-oe-id="o and o.id">
            <t t-out="0"/>
        </div>
        <div t-attf-class="footer o_company_#{company.id}_layout dx-report-footer dx-theme-#{dx_theme['code']} dx-layout-#{dx_theme.get('layout') or 'dor'}">
            <t t-if="dx_theme.get('layout') == 'pin'">
                <t t-call="justech_alexander_reports.dx_footer_pinaria"/>
            </t>
            <t t-elif="dx_theme.get('layout') == 'dom'">
                <t t-call="justech_alexander_reports.dx_footer_dominion"/>
            </t>
            <t t-elif="dx_theme.get('layout') == 'may'">
                <t t-call="justech_alexander_reports.dx_footer_mayuma"/>
            </t>
            <t t-elif="dx_theme.get('layout') == 'rem'">
                <t t-call="justech_alexander_reports.dx_footer_rempart"/>
            </t>
            <t t-elif="dx_theme.get('layout') == 'blu'">
                <t t-call="justech_alexander_reports.dx_footer_blueelite"/>
            </t>
            <t t-else="">
                <t t-call="justech_alexander_reports.dx_footer_doralex"/>
            </t>
        </div>
    </template>

    <record id="report_layout_doralex" model="report.layout">
        <field name="name">Doralex</field>
        <field name="sequence">1</field>
        <field name="view_id" ref="external_layout_doralex"/>
    </record>
</odoo>
