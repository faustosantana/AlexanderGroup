<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="dx_customer_card">
        <div class="dx-card-title" t-out="dx.get('party_title') or 'Cliente'"/>
        <div class="dx-card-name" t-out="dx['partner']['name']"/>
        <div t-if="dx['partner'].get('vat')">RNC <t t-out="dx['partner']['vat']"/></div>
        <div t-if="dx['partner'].get('street')" t-out="dx['partner']['street']"/>
        <div t-if="dx['partner'].get('city')" t-out="dx['partner']['city']"/>
        <div t-if="dx['partner'].get('phone')" t-out="dx['partner']['phone']"/>
        <div t-if="dx['partner'].get('email')" t-out="dx['partner']['email']"/>
    </template>

    <template id="dx_commercial_meta">
        <table class="dx-meta-grid">
            <tr t-if="dx.get('date') or dx.get('validity') or dx.get('due')">
                <td t-if="dx.get('date')">
                    <div class="dx-meta-k">Fecha</div>
                    <div class="dx-meta-v" t-out="dx['date']"/>
                </td>
                <td t-if="dx.get('validity')">
                    <div class="dx-meta-k">Validez</div>
                    <div class="dx-meta-v" t-out="dx['validity']"/>
                </td>
                <td t-if="not dx.get('validity') and dx.get('due')">
                    <div class="dx-meta-k">Vencimiento</div>
                    <div class="dx-meta-v" t-out="dx['due']"/>
                </td>
            </tr>
            <tr t-if="dx.get('validity') and dx.get('due')">
                <td>
                    <div class="dx-meta-k">Vencimiento</div>
                    <div class="dx-meta-v" t-out="dx['due']"/>
                </td>
                <td/>
            </tr>
            <tr t-if="dx.get('salesperson') or dx.get('payment_term')">
                <td t-if="dx.get('salesperson')">
                    <div class="dx-meta-k">Vendedor</div>
                    <div class="dx-meta-v" t-out="dx['salesperson']"/>
                </td>
                <td t-if="dx.get('payment_term')">
                    <div class="dx-meta-k">Condición</div>
                    <div class="dx-meta-v" t-out="dx['payment_term']"/>
                </td>
            </tr>
            <tr t-if="dx.get('currency') or dx.get('ncf')">
                <td t-if="dx.get('currency')">
                    <div class="dx-meta-k">Moneda</div>
                    <div class="dx-meta-v" t-out="dx['currency']"/>
                </td>
                <td t-if="dx.get('ncf')">
                    <div class="dx-meta-k" t-out="dx.get('ncf_label') or 'Número de Comprobante Fiscal'"/>
                    <div class="dx-meta-v" t-out="dx['ncf']"/>
                </td>
            </tr>
            <tr t-if="dx.get('origin_ncf') or dx.get('origin_move')">
                <td t-if="dx.get('origin_ncf')">
                    <div class="dx-meta-k" t-out="dx.get('origin_ncf_label') or 'Comprobante afectado'"/>
                    <div class="dx-meta-v" t-out="dx['origin_ncf']"/>
                </td>
                <td t-if="dx.get('origin_move')">
                    <div class="dx-meta-k">Factura afectada</div>
                    <div class="dx-meta-v" t-out="dx['origin_move']"/>
                </td>
            </tr>
            <tr>
                <td t-if="dx.get('origin')">
                    <div class="dx-meta-k">Origen</div>
                    <div class="dx-meta-v" t-out="dx['origin']"/>
                </td>
                <td>
                    <div class="dx-meta-k" t-out="dx.get('client_ref_label') or 'OC / PO'"/>
                    <div class="dx-meta-v" t-out="dx.get('client_ref') or '—'"/>
                </td>
            </tr>
        </table>
    </template>

    <template id="dx_oc_po">
        <div t-if="dx.get('client_ref')" class="dx-oc-po">
            <span class="dx-meta-k">OC / PO</span>
            <span class="dx-meta-v">: <t t-out="dx.get('client_ref')"/></span>
        </div>
    </template>

    <template id="dx_body_lines">
        <t t-if="dx.get('logistic')">
            <t t-call="justech_alexander_reports.dx_picking_lines"/>
        </t>
        <t t-else="">
            <t t-call="justech_alexander_reports.dx_line_table"/>
        </t>
    </template>

    <template id="dx_line_table">
        <table t-attf-class="dx-lines dx-table-{{ dx.get('layout') or 'dor' }}" border="0" cellpadding="0" cellspacing="0" frame="void" rules="none">
            <thead>
                <tr>
                    <th class="dx-col-desc">Descripción</th>
                    <th class="dx-col-qty">Cant.</th>
                    <th class="dx-col-uom">Ud.</th>
                    <th class="dx-col-price">Precio</th>
                    <th class="dx-col-tax">Imp.</th>
                    <th class="dx-col-amt">Importe</th>
                </tr>
            </thead>
            <tbody>
                <t t-foreach="dx['lines']" t-as="line">
                    <tr t-if="line['kind'] == 'section'" class="dx-line-section">
                        <td colspan="6" t-out="line['name']"/>
                    </tr>
                    <tr t-elif="line['kind'] == 'note'" class="dx-line-note">
                        <td colspan="6" t-out="line['name']"/>
                    </tr>
                    <tr t-else="">
                        <td class="dx-col-desc" t-out="line['name']"/>
                        <td class="dx-col-qty" t-out="line['qty']"/>
                        <td class="dx-col-uom" t-out="line['uom']"/>
                        <td class="dx-col-price dx-money" t-out="line['price']"/>
                        <td class="dx-col-tax" t-out="line['tax']"/>
                        <td class="dx-col-amt dx-money" t-out="line['amount']"/>
                    </tr>
                </t>
            </tbody>
        </table>
    </template>

    <template id="dx_propet_line_table">
        <table t-attf-class="dx-lines dx-propet dx-table-{{ dx.get('layout') or 'dor' }}" border="0" cellpadding="0" cellspacing="0" frame="void" rules="none">
            <thead>
                <tr>
                    <th class="dx-col-product">Producto</th>
                    <th class="dx-col-desc">Descripción</th>
                    <th class="dx-col-qty">Cant.</th>
                    <th class="dx-col-price">P. unit. sin ITBIS</th>
                    <th class="dx-col-price">ITBIS</th>
                    <th class="dx-col-price">P. unit. con ITBIS</th>
                    <th class="dx-col-qty">Dto.</th>
                    <th class="dx-col-amt">Subtotal</th>
                    <th class="dx-col-amt">Total línea</th>
                </tr>
            </thead>
            <tbody>
                <t t-foreach="dx.get('propet_lines') or dx['lines']" t-as="line">
                    <tr t-if="line['kind'] == 'section'" class="dx-line-section">
                        <td colspan="9" t-out="line['name']"/>
                    </tr>
                    <tr t-elif="line['kind'] == 'note'" class="dx-line-note">
                        <td colspan="9" t-out="line['name']"/>
                    </tr>
                    <tr t-else="">
                        <td class="dx-col-product" t-out="line.get('product') or ''"/>
                        <td class="dx-col-desc" t-out="line['name']"/>
                        <td class="dx-col-qty" t-out="line['qty']"/>
                        <td class="dx-col-price dx-money" t-out="line.get('unit_excl')"/>
                        <td class="dx-col-price dx-money" t-out="line.get('tax')"/>
                        <td class="dx-col-price dx-money" t-out="line.get('unit_incl')"/>
                        <td class="dx-col-qty" t-out="line.get('discount') or '—'"/>
                        <td class="dx-col-amt dx-money" t-out="line.get('subtotal')"/>
                        <td class="dx-col-amt dx-money" t-out="line.get('total')"/>
                    </tr>
                </t>
            </tbody>
        </table>
    </template>

    <template id="dx_sale_propet_composition">
        <div t-attf-class="dx-composition dx-comp-sale dx-comp-propet dx-comp-{{ dx.get('layout') or 'dor' }} dx-page-stack">
            <t t-call="justech_alexander_reports.dx_pin_doc_title"/>
            <div class="dx-inv-top">
                <div t-attf-class="dx-inv-party dx-inv-party-{{ dx.get('layout') or 'dor' }}">
                    <t t-call="justech_alexander_reports.dx_customer_card"/>
                </div>
                <div class="dx-inv-meta">
                    <t t-call="justech_alexander_reports.dx_commercial_meta"/>
                </div>
            </div>
            <t t-call="justech_alexander_reports.dx_propet_line_table"/>
            <t t-call="justech_alexander_reports.dx_document_end"/>
            <t t-call="justech_alexander_reports.dx_signature_panel"/>
        </div>
    </template>

    <template id="dx_picking_lines">
        <table t-attf-class="dx-lines dx-table-{{ dx.get('layout') or 'dor' }}" border="0" cellpadding="0" cellspacing="0" frame="void" rules="none">
            <thead>
                <tr t-if="dx.get('incoming')">
                    <th class="dx-col-desc">Producto</th>
                    <th class="dx-col-qty">Esperada</th>
                    <th class="dx-col-qty">Recibida</th>
                    <th class="dx-col-uom">Ud.</th>
                </tr>
                <tr t-else="">
                    <th class="dx-col-product">Producto</th>
                    <th class="dx-col-desc">Descripción</th>
                    <th class="dx-col-qty">Cantidad pedida</th>
                    <th class="dx-col-qty">Cantidad entregada</th>
                    <th class="dx-col-uom">Ud.</th>
                </tr>
            </thead>
            <tbody>
                <tr t-foreach="dx['lines']" t-as="line">
                    <td class="dx-col-product" t-out="line.get('product') or line['name']"/>
                    <td t-if="not dx.get('incoming')" class="dx-col-desc" t-out="line['name']"/>
                    <td class="dx-col-qty" t-out="line['qty']"/>
                    <td class="dx-col-qty" t-out="line.get('done')"/>
                    <td class="dx-col-uom" t-out="line['uom']"/>
                </tr>
            </tbody>
        </table>
    </template>

    <template id="dx_pin_doc_title">
        <t t-if="dx.get('layout') == 'pin'">
            <div class="dx-pin-split">
                <div class="dx-pin-titlecell">
                    <div class="dx-head-title" t-out="dx['ident'].get('title')"/>
                    <div class="dx-head-number">
                        <span t-if="dx['ident'].get('badge')" class="dx-badge" t-out="dx['ident'].get('badge')"/>
                        <span t-out="dx['ident'].get('number')"/>
                    </div>
                </div>
            </div>
        </t>
        <t t-else="">
            <div class="dx-doc-title-block">
                <div class="dx-head-title" t-out="dx['ident'].get('title')"/>
                <div class="dx-head-number">
                    <span t-if="dx['ident'].get('badge')" class="dx-badge" t-out="dx['ident'].get('badge')"/>
                    <span t-out="dx['ident'].get('number')"/>
                </div>
            </div>
        </t>
    </template>

    <template id="dx_document_end">
        <t t-if="dx.get('layout') == 'pin'">
            <div class="dx-pin-terms-full">
                <t t-call="justech_alexander_reports.dx_terms_text"/>
            </div>
            <div class="dx-end-clear dx-pin-end">
                <div class="dx-pin-bank">
                    <t t-call="justech_alexander_reports.dx_banks_text"/>
                </div>
                <div class="dx-pin-totals-wrap">
                    <t t-call="justech_alexander_reports.dx_totals_panel"/>
                </div>
            </div>
        </t>
        <t t-elif="dx.get('layout') == 'dom'">
            <div class="dx-dom-terms">
                <t t-call="justech_alexander_reports.dx_terms_panel"/>
            </div>
            <div class="dx-dom-totals-shift">
                <t t-call="justech_alexander_reports.dx_totals_panel"/>
            </div>
        </t>
        <t t-elif="dx.get('layout') == 'may'">
            <div class="dx-may-terms-wide">
                <t t-call="justech_alexander_reports.dx_terms_panel"/>
            </div>
            <div class="dx-may-totals">
                <t t-call="justech_alexander_reports.dx_totals_panel"/>
            </div>
        </t>
        <t t-elif="dx.get('layout') == 'rem'">
            <div class="dx-end-clear dx-rem-end">
                <div class="dx-rem-terms">
                    <t t-call="justech_alexander_reports.dx_terms_panel"/>
                </div>
                <div class="dx-rem-totals-box">
                    <t t-call="justech_alexander_reports.dx_totals_panel"/>
                </div>
            </div>
        </t>
        <t t-elif="dx.get('layout') == 'blu'">
            <div class="dx-end-clear dx-blu-end">
                <div class="dx-blu-terms">
                    <t t-call="justech_alexander_reports.dx_terms_panel"/>
                </div>
                <div class="dx-blu-totals-box">
                    <t t-call="justech_alexander_reports.dx_totals_panel"/>
                </div>
            </div>
        </t>
        <t t-else="">
            <div class="dx-end-clear dx-dor-end">
                <div class="dx-dor-terms">
                    <t t-call="justech_alexander_reports.dx_terms_text"/>
                    <div class="dx-dor-bank">
                        <t t-call="justech_alexander_reports.dx_banks_text"/>
                    </div>
                </div>
                <div class="dx-dor-totals">
                    <t t-call="justech_alexander_reports.dx_totals_panel"/>
                </div>
            </div>
        </t>
    </template>

    <template id="dx_totals_panel">
        <div t-if="not dx.get('logistic')" t-attf-class="dx-totals dx-totals-{{ dx.get('layout') or 'dor' }}">
            <t t-foreach="dx['totals']" t-as="row">
                <div t-att-class="'dx-total-row dx-total-grand' if row.get('grand') else 'dx-total-row'">
                    <span class="dx-total-k" t-out="row['label']"/>
                    <span class="dx-total-v dx-money" t-out="row['value']"/>
                </div>
            </t>
        </div>
    </template>

    <template id="dx_terms_text">
        <t t-if="not dx.get('logistic') and (dx.get('terms') or dx.get('note'))">
            <div class="dx-block-title">Términos y observaciones</div>
            <div t-if="dx.get('terms')" class="dx-terms" t-out="dx['terms']"/>
            <div t-if="dx.get('note')" class="dx-terms" t-out="dx['note']"/>
        </t>
    </template>

    <template id="dx_banks_text">
        <t t-if="not dx.get('logistic') and dx.get('banks')">
            <div class="dx-block-title dx-bank-title">Cuentas para pago</div>
            <t t-foreach="dx['banks']" t-as="bank">
                <div class="dx-bank-line">
                    <t t-out="bank['bank']"/>
                    <t t-if="bank.get('account')"> · <t t-out="bank['account']"/></t>
                    <t t-if="bank.get('holder')"> · <t t-out="bank['holder']"/></t>
                </div>
            </t>
        </t>
    </template>

    <template id="dx_terms_panel">
        <t t-call="justech_alexander_reports.dx_terms_text"/>
        <t t-call="justech_alexander_reports.dx_banks_text"/>
    </template>

    <template id="dx_signature_panel">
        <t t-if="dx.get('show_signature')">
            <div t-if="dx.get('spacer_chunks')" class="dx-sign-spacer">
                <t t-foreach="dx['spacer_chunks']" t-as="chunk">
                    <img t-att-src="chunk['src']" t-att-style="chunk['style']" alt=""/>
                </t>
            </div>
            <div t-attf-class="dx-sign-wrap dx-sign-{{ dx.get('layout') or 'dor' }}">
                <div class="dx-sign-col">
                    <div class="dx-sign-space"/>
                    <div class="dx-sign-rule"/>
                    <div class="dx-sign-cap" t-out="dx.get('sign_left') or 'Elaborado por'"/>
                </div>
                <div class="dx-sign-col">
                    <div class="dx-sign-space"/>
                    <div class="dx-sign-rule"/>
                    <div class="dx-sign-cap" t-out="dx.get('sign_right') or 'Aceptado'"/>
                </div>
            </div>
        </t>
    </template>

    <template id="dx_sale_doralex">
        <div class="dx-composition dx-comp-sale dx-comp-dor dx-page-stack">
            <div class="dx-dor-client">
                <div class="dx-card-title">Cliente</div>
                <div class="dx-card-name" t-out="dx['partner']['name']"/>
                <div class="dx-dor-client-line">
                    <t t-if="dx['partner'].get('vat')">RNC <t t-out="dx['partner']['vat']"/></t>
                    <t t-if="dx['partner'].get('street')"> · <t t-out="dx['partner']['street']"/></t>
                </div>
                <div class="dx-dor-client-line">
                    <t t-if="dx['partner'].get('city')" t-out="dx['partner']['city']"/>
                    <t t-if="dx['partner'].get('phone')"> · <t t-out="dx['partner']['phone']"/></t>
                </div>
                <t t-call="justech_alexander_reports.dx_oc_po"/>
            </div>
            <t t-call="justech_alexander_reports.dx_body_lines"/>
            <div class="dx-end-clear dx-dor-end">
                <div class="dx-dor-terms">
                    <t t-call="justech_alexander_reports.dx_terms_text"/>
                    <div class="dx-dor-bank">
                        <t t-call="justech_alexander_reports.dx_banks_text"/>
                    </div>
                </div>
                <div class="dx-dor-totals">
                    <t t-call="justech_alexander_reports.dx_totals_panel"/>
                </div>
            </div>
            <t t-call="justech_alexander_reports.dx_signature_panel"/>
        </div>
    </template>

    <template id="dx_sale_pinaria">
        <div class="dx-composition dx-comp-sale dx-comp-pin dx-page-stack">
            <div class="dx-pin-split">
                <div class="dx-pin-titlecell">
                    <div class="dx-head-title" t-out="dx['ident'].get('title')"/>
                    <div class="dx-head-number">
                        <span t-if="dx['ident'].get('badge')" class="dx-badge" t-out="dx['ident'].get('badge')"/>
                        <span t-out="dx['ident'].get('number')"/>
                    </div>
                </div>
                <div class="dx-pin-metacell">
                    <div class="dx-pin-meta-col">
                        <div class="dx-meta-k">Fecha</div>
                        <div class="dx-meta-v" t-out="dx['date']"/>
                        <div t-if="dx.get('salesperson')">
                            <div class="dx-meta-k">Vendedor</div>
                            <div class="dx-meta-v" t-out="dx['salesperson']"/>
                        </div>
                    </div>
                    <div class="dx-pin-meta-col">
                        <div class="dx-meta-k" t-out="dx.get('date2_label') or 'Validez'"/>
                        <div class="dx-meta-v" t-out="dx.get('validity') or '—'"/>
                        <div t-if="dx.get('currency')">
                            <div class="dx-meta-k">Moneda</div>
                            <div class="dx-meta-v" t-out="dx['currency']"/>
                        </div>
                    </div>
                </div>
            </div>
            <div class="dx-pin-client">
                <div class="dx-card-title"><span class="dx-pin-mark"/>Cliente</div>
                <div class="dx-card-name" t-out="dx['partner']['name']"/>
                <div t-if="dx['partner'].get('vat')">RNC <t t-out="dx['partner']['vat']"/></div>
                <div t-if="dx['partner'].get('street')" t-out="dx['partner']['street']"/>
                <div t-if="dx['partner'].get('city')" t-out="dx['partner']['city']"/>
                <t t-call="justech_alexander_reports.dx_oc_po"/>
            </div>
            <t t-call="justech_alexander_reports.dx_body_lines"/>
            <div class="dx-pin-terms-full">
                <t t-call="justech_alexander_reports.dx_terms_text"/>
            </div>
            <div class="dx-end-clear dx-pin-end">
                <div class="dx-pin-bank">
                    <t t-if="dx.get('banks')">
                        <div class="dx-meta-k">Cuenta para pago</div>
                        <t t-foreach="dx['banks']" t-as="bank">
                            <div class="dx-pin-bank-line">
                                <t t-out="bank['bank']"/>
                                <t t-if="bank.get('account')"> · <t t-out="bank['account']"/></t>
                                <t t-if="bank.get('holder')"> · <t t-out="bank['holder']"/></t>
                            </div>
                        </t>
                    </t>
                </div>
                <div class="dx-pin-totals-wrap">
                    <t t-call="justech_alexander_reports.dx_totals_panel"/>
                </div>
            </div>
            <t t-call="justech_alexander_reports.dx_signature_panel"/>
        </div>
    </template>

    <template id="dx_sale_dominion">
        <div class="dx-composition dx-comp-sale dx-comp-dom dx-page-stack">
            <div class="dx-dom-float">
                <div class="dx-dom-client">
                    <div class="dx-card-title">Cliente</div>
                    <div class="dx-card-name" t-out="dx['partner']['name']"/>
                    <div t-if="dx['partner'].get('vat')">RNC <t t-out="dx['partner']['vat']"/></div>
                    <div t-if="dx['partner'].get('street')" t-out="dx['partner']['street']"/>
                    <t t-call="justech_alexander_reports.dx_oc_po"/>
                </div>
                <div class="dx-dom-meta">
                    <div class="dx-meta-item">
                        <div class="dx-meta-k">Fecha</div>
                        <div class="dx-meta-v" t-out="dx['date']"/>
                    </div>
                    <div class="dx-meta-item">
                        <div class="dx-meta-k" t-out="dx.get('date2_label') or 'Validez'"/>
                        <div class="dx-meta-v" t-out="dx.get('validity') or '—'"/>
                    </div>
                    <div class="dx-meta-item" t-if="dx.get('salesperson')">
                        <div class="dx-meta-k">Vendedor</div>
                        <div class="dx-meta-v" t-out="dx['salesperson']"/>
                    </div>
                    <div class="dx-meta-item" t-if="dx.get('currency')">
                        <div class="dx-meta-k">Moneda</div>
                        <div class="dx-meta-v" t-out="dx['currency']"/>
                    </div>
                </div>
            </div>
            <t t-call="justech_alexander_reports.dx_body_lines"/>
            <div class="dx-dom-terms">
                <t t-call="justech_alexander_reports.dx_terms_panel"/>
            </div>
            <div class="dx-dom-totals-shift">
                <t t-call="justech_alexander_reports.dx_totals_panel"/>
            </div>
            <t t-call="justech_alexander_reports.dx_signature_panel"/>
        </div>
    </template>

    <template id="dx_sale_mayuma">
        <div class="dx-composition dx-comp-sale dx-comp-may dx-page-stack">
            <div class="dx-may-client">
                <div class="dx-card-title">Cliente</div>
                <div class="dx-card-name" t-out="dx['partner']['name']"/>
                <div t-if="dx['partner'].get('vat')">RNC <t t-out="dx['partner']['vat']"/></div>
                <div t-if="dx['partner'].get('street')" t-out="dx['partner']['street']"/>
                <div t-if="dx['partner'].get('city')" t-out="dx['partner']['city']"/>
                <t t-call="justech_alexander_reports.dx_oc_po"/>
            </div>
            <div class="dx-may-meta">
                <div class="dx-may-meta-col">
                    <div class="dx-meta-k">Fecha</div>
                    <div class="dx-meta-v" t-out="dx['date']"/>
                </div>
                <div class="dx-may-meta-col">
