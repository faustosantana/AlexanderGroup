    <template id="dx_conduce_close">
        <div t-attf-class="dx-sign-wrap dx-sign-{{ dx.get('layout') or 'dor' }}">
            <div class="dx-sign-col">
                <div class="dx-sign-space"/>
                <div class="dx-sign-rule"/>
                <div class="dx-sign-cap" t-out="dx.get('sign_left') or 'Entregado por'"/>
            </div>
            <div class="dx-sign-col">
                <div class="dx-sign-space"/>
                <div class="dx-sign-rule"/>
                <div class="dx-sign-cap" t-out="dx.get('sign_right') or 'Recibido por'"/>
            </div>
            <div class="dx-sign-col">
                <div class="dx-sign-space"/>
                <div class="dx-sign-rule"/>
                <div class="dx-sign-cap">Firma</div>
            </div>
        </div>
        <div class="dx-pick-received">
            <div class="dx-meta-k">Fecha de recibido</div>
            <div class="dx-sign-rule"/>
        </div>
        <div class="dx-pick-notes">
            <div class="dx-meta-k">Observaciones</div>
            <div t-if="dx.get('note')" class="dx-meta-v" t-out="dx['note']"/>
            <div t-else="" class="dx-sign-rule"/>
