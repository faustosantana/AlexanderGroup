<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="dx_customer_card">
        <div class="dx-card-title" t-out="dx.get('party_title') or 'Cliente'"/>
        <div class="dx-card-name" t-out="dx['partner']['name']"/>
        <div t-if="dx['partner'].get('vat')">RNC <t t-out="dx['partner']['vat']"/></div>
        <div t-if="dx['partner'].get('street')" t-out="dx['partner']['street']"/>
        <div t-if="dx['partner'].get('city')" t-out="dx['partner']['city']"/>
        <div t-if="dx['partner'].get('phone')" t-out="dx['partner']['phone']"/>
    </template>

    <template id="dx_commercial_meta">
        <table class="dx-meta-grid">
            <tr t-if="dx.get('date') or dx.get('validity') or dx.get('due')">
                <td t-if="dx.get('date')">
                    <div class="dx-meta-k">Fecha</div>
                    <div class="dx-meta-v" t-out="dx['date']"/>
                </td>
                <td t-if="dx.get('validity')">
                    <div class="dx-meta-k">Validez</div>
                    <div class="dx-meta-v" t-out="dx['validity']"/>
                </td>
                <td t-if="not dx.get('validity') and dx.get('due')">
                    <div class="dx-meta-k">Vencimiento</div>
                    <div class="dx-meta-v" t-out="dx['due']"/>
                </td>
            </tr>
            <tr t-if="dx.get('validity') and dx.get('due')">
                <td>
                    <div class="dx-meta-k">Vencimiento</div>
                    <div class="dx-meta-v" t-out="dx['due']"/>
                </td>
                <td/>
            </tr>
            <tr t-if="dx.get('salesperson') or dx.get('payment_term')">
                <td t-if="dx.get('salesperson')">
                    <div class="dx-meta-k">Vendedor</div>
                    <div class="dx-meta-v" t-out="dx['salesperson']"/>
                </td>
                <td t-if="dx.get('payment_term')">
                    <div class="dx-meta-k">Condición</div>
                    <div class="dx-meta-v" t-out="dx['payment_term']"/>
                </td>
            </tr>
            <tr t-if="dx.get('currency') or dx.get('ncf')">
                <td t-if="dx.get('currency')">
                    <div class="dx-meta-k">Moneda</div>
                    <div class="dx-meta-v" t-out="dx['currency']"/>
                </td>
                <td t-if="dx.get('ncf')">
                    <div class="dx-meta-k">NCF</div>
                    <div class="dx-meta-v" t-out="dx['ncf']"/>
                </td>
            </tr>
            <tr t-if="dx.get('origin_ncf') or dx.get('origin_move')">
                <td t-if="dx.get('origin_ncf')">
                    <div class="dx-meta-k">NCF afectado</div>
                    <div class="dx-meta-v" t-out="dx['origin_ncf']"/>
                </td>
                <td t-if="dx.get('origin_move')">
                    <div class="dx-meta-k">Factura afectada</div>
                    <div class="dx-meta-v" t-out="dx['origin_move']"/>
                </td>
            </tr>
            <tr t-if="dx.get('origin') or dx.get('client_ref')">
                <td t-if="dx.get('origin')">
                    <div class="dx-meta-k">Origen</div>
                    <div class="dx-meta-v" t-out="dx['origin']"/>
                </td>
                <td t-if="dx.get('client_ref')">
                    <div class="dx-meta-k">Referencia</div>
                    <div class="dx-meta-v" t-out="dx['client_ref']"/>
                </td>
            </tr>
        </table>
    </template>

    <template id="dx_line_table">
        <table t-attf-class="dx-lines dx-table-{{ dx.get('layout') or 'dor' }}" border="0" cellpadding="0" cellspacing="0">
            <thead>
                <tr>
                    <th class="dx-col-desc">Descripción</th>
                    <th class="dx-col-qty">Cant.</th>
                    <th class="dx-col-uom">Ud.</th>
                    <th class="dx-col-price">Precio</th>
                    <th class="dx-col-tax">Imp.</th>
                    <th class="dx-col-amt">Importe</th>
                </tr>
            </thead>
            <tbody>
                <t t-foreach="dx['lines']" t-as="line">
                    <tr t-if="line['kind'] == 'section'" class="dx-line-section">
                        <td colspan="6" t-out="line['name']"/>
                    </tr>
                    <tr t-elif="line['kind'] == 'note'" class="dx-line-note">
                        <td colspan="6" t-out="line['name']"/>
                    </tr>
                    <tr t-else="">
                        <td class="dx-col-desc" t-out="line['name']"/>
                        <td class="dx-col-qty" t-out="line['qty']"/>
                        <td class="dx-col-uom" t-out="line['uom']"/>
                        <td class="dx-col-price dx-money" t-out="line['price']"/>
                        <td class="dx-col-tax" t-out="line['tax']"/>
                        <td class="dx-col-amt dx-money" t-out="line['amount']"/>
                    </tr>
                </t>
            </tbody>
        </table>
    </template>

    <template id="dx_picking_lines">
        <table class="dx-lines">
            <thead>
                <tr>
                    <th class="dx-col-desc">Producto</th>
                    <th class="dx-col-qty">Demandado</th>
                    <th class="dx-col-qty">Hecho</th>
                    <th class="dx-col-uom">Ud.</th>
                </tr>
            </thead>
            <tbody>
                <tr t-foreach="dx['lines']" t-as="line">
                    <td class="dx-col-desc" t-out="line['name']"/>
                    <td class="dx-col-qty" t-out="line['qty']"/>
                    <td class="dx-col-qty" t-out="line.get('done')"/>
                    <td class="dx-col-uom" t-out="line['uom']"/>
                </tr>
            </tbody>
        </table>
    </template>

    <template id="dx_totals_panel">
        <table t-attf-class="dx-totals dx-totals-{{ dx.get('layout') or 'dor' }}" border="0" cellpadding="0" cellspacing="0">
            <t t-foreach="dx['totals']" t-as="row">
                <tr t-att-class="'dx-total-grand' if row.get('grand') else ''">
                    <th t-out="row['label']"/>
                    <td class="dx-money" t-out="row['value']"/>
                </tr>
            </t>
        </table>
    </template>

    <template id="dx_terms_panel">
        <t t-if="dx.get('terms') or dx.get('note')">
            <div class="dx-block-title">Términos y observaciones</div>
            <div t-if="dx.get('terms')" class="dx-terms" t-out="dx['terms']"/>
            <div t-if="dx.get('note')" class="dx-terms" t-out="dx['note']"/>
        </t>
        <t t-if="dx.get('banks')">
            <div class="dx-block-title dx-bank-title">Cuentas para pago</div>
            <t t-foreach="dx['banks']" t-as="bank">
                <div class="dx-bank-line">
                    <t t-out="bank['bank']"/>
                    <t t-if="bank.get('account')"> · <t t-out="bank['account']"/></t>
                    <t t-if="bank.get('holder')"> · <t t-out="bank['holder']"/></t>
                </div>
            </t>
        </t>
    </template>

    <template id="dx_signature_panel">
        <t t-if="dx.get('show_signature')">
            <div t-if="dx.get('spacer_chunks')" class="dx-sign-spacer">
                <t t-foreach="dx['spacer_chunks']" t-as="chunk">
                    <img t-att-src="chunk['src']" t-att-style="chunk['style']" alt=""/>
                </t>
            </div>
            <table t-attf-class="dx-sign-table dx-sign-{{ dx.get('layout') or 'dor' }}" border="0" cellpadding="0" cellspacing="0">
                <tr>
                    <td>
                        <div class="dx-sign-space"/>
                        <div class="dx-sign-line" t-out="dx.get('sign_left') or 'Elaborado por'"/>
                    </td>
                    <td>
                        <div class="dx-sign-space"/>
                        <div class="dx-sign-line" t-out="dx.get('sign_right') or 'Aceptado'"/>
                    </td>
                </tr>
            </table>
        </t>
    </template>

    <template id="dx_sale_doralex">
        <div class="dx-composition dx-comp-sale dx-comp-dor dx-page-stack">
            <div class="dx-dor-client">
                <div class="dx-card-title">Cliente</div>
                <div class="dx-card-name" t-out="dx['partner']['name']"/>
                <div class="dx-dor-client-line">
                    <t t-if="dx['partner'].get('vat')">RNC <t t-out="dx['partner']['vat']"/></t>
                    <t t-if="dx['partner'].get('street')"> · <t t-out="dx['partner']['street']"/></t>
                </div>
                <div class="dx-dor-client-line">
                    <t t-if="dx['partner'].get('city')" t-out="dx['partner']['city']"/>
                    <t t-if="dx['partner'].get('phone')"> · <t t-out="dx['partner']['phone']"/></t>
                </div>
            </div>
            <t t-call="justech_alexander_reports.dx_line_table"/>
            <table class="dx-zone-bottom dx-keep-end" border="0" cellpadding="0" cellspacing="0">
                <tr>
                    <td class="dx-zone-terms">
                        <t t-call="justech_alexander_reports.dx_terms_panel"/>
                    </td>
                    <td class="dx-zone-totals">
                        <t t-call="justech_alexander_reports.dx_totals_panel"/>
                    </td>
                </tr>
            </table>
            <t t-call="justech_alexander_reports.dx_signature_panel"/>
        </div>
    </template>

    <template id="dx_sale_pinaria">
        <div class="dx-composition dx-comp-sale dx-comp-pin dx-page-stack">
            <table class="dx-pin-split" border="0" cellpadding="0" cellspacing="0">
                <tr>
                    <td class="dx-pin-titlecell">
                        <div class="dx-head-title" t-out="dx['ident'].get('title')"/>
                        <div class="dx-head-number">
                            <span t-if="dx['ident'].get('badge')" class="dx-badge" t-out="dx['ident'].get('badge')"/>
                            <span t-out="dx['ident'].get('number')"/>
                        </div>
                    </td>
                    <td class="dx-pin-metacell">
                        <table class="dx-meta-grid" border="0" cellpadding="0" cellspacing="0">
                            <tr>
                                <td>
                                    <div class="dx-meta-k">Fecha</div>
                                    <div class="dx-meta-v" t-out="dx['date']"/>
                                </td>
                                <td>
                                    <div class="dx-meta-k">Validez</div>
                                    <div class="dx-meta-v" t-out="dx['validity']"/>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <div class="dx-meta-k">Vendedor</div>
                                    <div class="dx-meta-v" t-out="dx['salesperson']"/>
                                </td>
                                <td>
                                    <div class="dx-meta-k">Moneda</div>
                                    <div class="dx-meta-v" t-out="dx['currency']"/>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>
            <div class="dx-pin-client">
                <div class="dx-card-title"><span class="dx-pin-mark"/>Cliente</div>
                <div class="dx-card-name" t-out="dx['partner']['name']"/>
                <div t-if="dx['partner'].get('vat')">RNC <t t-out="dx['partner']['vat']"/></div>
                <div t-if="dx['partner'].get('street')" t-out="dx['partner']['street']"/>
                <div t-if="dx['partner'].get('city')" t-out="dx['partner']['city']"/>
            </div>
            <t t-call="justech_alexander_reports.dx_line_table"/>
            <div class="dx-pin-terms-full">
                <t t-if="dx.get('terms') or dx.get('note')">
                    <div class="dx-block-title">Términos y observaciones</div>
                    <div t-if="dx.get('terms')" class="dx-terms" t-out="dx['terms']"/>
                    <div t-if="dx.get('note')" class="dx-terms" t-out="dx['note']"/>
                </t>
                <div t-if="dx.get('banks')" class="dx-pin-bank">
                    <span class="dx-meta-k">Cuenta para pago</span>
                    <t t-foreach="dx['banks']" t-as="bank">
                        <span class="dx-pin-bank-line">
                            <t t-out="bank['bank']"/>
                            <t t-if="bank.get('account')"> · <t t-out="bank['account']"/></t>
                            <t t-if="bank.get('holder')"> · <t t-out="bank['holder']"/></t>
                        </span>
                    </t>
                </div>
            </div>
            <div class="dx-pin-totals-wrap">
                <t t-call="justech_alexander_reports.dx_totals_panel"/>
            </div>
            <t t-call="justech_alexander_reports.dx_signature_panel"/>
        </div>
    </template>

    <template id="dx_sale_dominion">
        <div class="dx-composition dx-comp-sale dx-comp-dom dx-page-stack">
            <table class="dx-dom-float" border="0" cellpadding="0" cellspacing="0">
                <tr>
                    <td class="dx-dom-client">
                        <div class="dx-card-title">Cliente</div>
                        <div class="dx-card-name" t-out="dx['partner']['name']"/>
                        <div t-if="dx['partner'].get('vat')">RNC <t t-out="dx['partner']['vat']"/></div>
                        <div t-if="dx['partner'].get('street')" t-out="dx['partner']['street']"/>
                    </td>
                    <td class="dx-dom-meta">
                        <div class="dx-meta-item">
                            <div class="dx-meta-k">Fecha</div>
                            <div class="dx-meta-v" t-out="dx['date']"/>
                        </div>
                        <div class="dx-meta-item">
                            <div class="dx-meta-k">Validez</div>
                            <div class="dx-meta-v" t-out="dx['validity']"/>
                        </div>
                        <div class="dx-meta-item">
                            <div class="dx-meta-k">Vendedor</div>
                            <div class="dx-meta-v" t-out="dx['salesperson']"/>
                        </div>
                        <div class="dx-meta-item">
                            <div class="dx-meta-k">Moneda</div>
                            <div class="dx-meta-v" t-out="dx['currency']"/>
                        </div>
                    </td>
                </tr>
            </table>
            <t t-call="justech_alexander_reports.dx_line_table"/>
            <table class="dx-zone-bottom dx-keep-end" border="0" cellpadding="0" cellspacing="0">
                <tr>
                    <td class="dx-zone-terms">
                        <t t-call="justech_alexander_reports.dx_terms_panel"/>
                    </td>
                    <td class="dx-zone-totals">
                        <t t-call="justech_alexander_reports.dx_totals_panel"/>
                    </td>
                </tr>
            </table>
            <t t-call="justech_alexander_reports.dx_signature_panel"/>
        </div>
    </template>

    <template id="dx_sale_mayuma">
        <div class="dx-composition dx-comp-sale dx-comp-may dx-page-stack">
            <div class="dx-may-client">
                <div class="dx-card-title">Cliente</div>
                <div class="dx-card-name" t-out="dx['partner']['name']"/>
                <div t-if="dx['partner'].get('vat')">RNC <t t-out="dx['partner']['vat']"/></div>
                <div t-if="dx['partner'].get('street')" t-out="dx['partner']['street']"/>
                <div t-if="dx['partner'].get('city')" t-out="dx['partner']['city']"/>
            </div>
            <table class="dx-may-meta" border="0" cellpadding="0" cellspacing="0">
                <tr>
                    <td>
                        <div class="dx-meta-k">Fecha</div>
                        <div class="dx-meta-v" t-out="dx['date']"/>
                    </td>
                    <td>
                        <div class="dx-meta-k">Validez</div>
                        <div class="dx-meta-v" t-out="dx['validity']"/>
                    </td>
                    <td>
                        <div class="dx-meta-k">Vendedor</div>
                        <div class="dx-meta-v" t-out="dx['salesperson']"/>
                    </td>
                    <td>
                        <div class="dx-meta-k">Moneda</div>
                        <div class="dx-meta-v" t-out="dx['currency']"/>
                    </td>
                </tr>
            </table>
            <t t-call="justech_alexander_reports.dx_line_table"/>
            <table class="dx-zone-bottom dx-keep-end" border="0" cellpadding="0" cellspacing="0">
                <tr>
                    <td class="dx-zone-terms">
                        <t t-call="justech_alexander_reports.dx_terms_panel"/>
                    </td>
                    <td class="dx-zone-totals">
                        <t t-call="justech_alexander_reports.dx_totals_panel"/>
                    </td>
                </tr>
            </table>
            <t t-call="justech_alexander_reports.dx_signature_panel"/>
        </div>
    </template>

    <template id="dx_sale_rempart">
        <div class="dx-composition dx-comp-sale dx-comp-rem dx-page-stack">
            <table class="dx-rem-split" border="0" cellpadding="0" cellspacing="0">
                <tr>
                    <td class="dx-rem-client">
                        <div class="dx-card-title">Cliente</div>
                        <div class="dx-card-name" t-out="dx['partner']['name']"/>
                        <div t-if="dx['partner'].get('vat')">RNC <t t-out="dx['partner']['vat']"/></div>
                        <div t-if="dx['partner'].get('street')" t-out="dx['partner']['street']"/>
                        <div t-if="dx['partner'].get('city')" t-out="dx['partner']['city']"/>
                        <div t-if="dx['partner'].get('phone')" t-out="dx['partner']['phone']"/>
                    </td>
                    <td class="dx-rem-meta">
                        <div class="dx-meta-item">
                            <div class="dx-meta-k">Fecha</div>
                            <div class="dx-meta-v dx-meta-big" t-out="dx['date']"/>
                        </div>
                        <div class="dx-meta-item">
                            <div class="dx-meta-k">Validez</div>
                            <div class="dx-meta-v dx-meta-big" t-out="dx['validity']"/>
                        </div>
                        <div class="dx-meta-item">
                            <div class="dx-meta-k">Vendedor</div>
                            <div class="dx-meta-v dx-meta-big" t-out="dx['salesperson']"/>
                        </div>
                        <div class="dx-meta-item">
                            <div class="dx-meta-k">Moneda</div>
                            <div class="dx-meta-v dx-meta-big" t-out="dx['currency']"/>
                        </div>
                    </td>
                </tr>
            </table>
            <t t-call="justech_alexander_reports.dx_line_table"/>
            <table class="dx-zone-bottom dx-keep-end" border="0" cellpadding="0" cellspacing="0">
                <tr>
                    <td class="dx-zone-terms">
                        <t t-call="justech_alexander_reports.dx_terms_panel"/>
                    </td>
                    <td class="dx-zone-totals">
                        <t t-call="justech_alexander_reports.dx_totals_panel"/>
                    </td>
                </tr>
            </table>
            <t t-call="justech_alexander_reports.dx_signature_panel"/>
        </div>
    </template>

    <template id="dx_sale_blueelite">
        <div class="dx-composition dx-comp-sale dx-comp-blu dx-page-stack">
            <table class="dx-blu-asym" border="0" cellpadding="0" cellspacing="0">
                <tr>
                    <td class="dx-blu-client" rowspan="2">
                        <div class="dx-card-title">Cliente</div>
                        <div class="dx-card-name" t-out="dx['partner']['name']"/>
                        <div t-if="dx['partner'].get('vat')">RNC <t t-out="dx['partner']['vat']"/></div>
                        <div t-if="dx['partner'].get('street')" t-out="dx['partner']['street']"/>
                    </td>
                    <td class="dx-blu-meta">
                        <div class="dx-blu-pair">
                            <div class="dx-meta-k">Fecha</div>
                            <div class="dx-meta-v" t-out="dx['date']"/>
                        </div>
                        <div class="dx-blu-pair">
                            <div class="dx-meta-k">Validez</div>
                            <div class="dx-meta-v" t-out="dx['validity']"/>
                        </div>
                    </td>
                </tr>
                <tr>
                    <td class="dx-blu-meta2">
                        <div class="dx-blu-stack">
                            <div class="dx-meta-k">Vendedor</div>
                            <div class="dx-meta-v" t-out="dx['salesperson']"/>
                        </div>
                        <div class="dx-blu-stack">
                            <div class="dx-meta-k">Moneda</div>
                            <div class="dx-meta-v" t-out="dx['currency']"/>
                        </div>
                    </td>
                </tr>
            </table>
            <t t-call="justech_alexander_reports.dx_line_table"/>
            <table class="dx-zone-bottom dx-keep-end" border="0" cellpadding="0" cellspacing="0">
                <tr>
                    <td class="dx-zone-terms">
                        <t t-call="justech_alexander_reports.dx_terms_panel"/>
                    </td>
                    <td class="dx-zone-totals">
                        <t t-call="justech_alexander_reports.dx_totals_panel"/>
                    </td>
                </tr>
            </table>
            <t t-call="justech_alexander_reports.dx_signature_panel"/>
        </div>
    </template>

    <template id="dx_sale_composition">
        <t t-if="dx.get('layout') == 'pin'">
            <t t-call="justech_alexander_reports.dx_sale_pinaria"/>
        </t>
        <t t-elif="dx.get('layout') == 'dom'">
            <t t-call="justech_alexander_reports.dx_sale_dominion"/>
        </t>
        <t t-elif="dx.get('layout') == 'may'">
            <t t-call="justech_alexander_reports.dx_sale_mayuma"/>
        </t>
        <t t-elif="dx.get('layout') == 'rem'">
            <t t-call="justech_alexander_reports.dx_sale_rempart"/>
        </t>
        <t t-elif="dx.get('layout') == 'blu'">
            <t t-call="justech_alexander_reports.dx_sale_blueelite"/>
        </t>
        <t t-else="">
            <t t-call="justech_alexander_reports.dx_sale_doralex"/>
        </t>
    </template>

    <template id="dx_invoice_composition">
        <div t-attf-class="dx-composition dx-comp-invoice dx-page-stack #{'dx-comp-refund' if dx.get('is_refund') else ''}">
            <table class="dx-zone-party">
                <tr>
                    <td class="dx-zone-customer">
                        <t t-call="justech_alexander_reports.dx_customer_card"/>
                        <div t-if="dx.get('reason')" class="dx-reason">
                            <div class="dx-block-title">Motivo</div>
                            <div t-out="dx['reason']"/>
                        </div>
                    </td>
                    <td class="dx-zone-meta">
                        <t t-call="justech_alexander_reports.dx_commercial_meta"/>
                    </td>
                </tr>
            </table>
            <table t-if="dx.get('is_refund')" class="dx-refund-banner">
                <tr>
                    <td>
                        <div class="dx-block-title">Importe acreditado</div>
                        <div class="dx-credited" t-out="dx.get('credited')"/>
                    </td>
                    <td>
                        <div class="dx-block-title">Documento afectado</div>
                        <div t-if="dx.get('origin_ncf')">NCF <t t-out="dx['origin_ncf']"/></div>
                        <div t-if="dx.get('origin_move')" t-out="dx['origin_move']"/>
                    </td>
                </tr>
            </table>
            <t t-call="justech_alexander_reports.dx_line_table"/>
            <table class="dx-zone-bottom dx-keep-end" border="0" cellpadding="0" cellspacing="0">
                <tr>
                    <td class="dx-zone-terms">
                        <t t-call="justech_alexander_reports.dx_terms_panel"/>
                    </td>
                    <td class="dx-zone-totals">
                        <t t-call="justech_alexander_reports.dx_totals_panel"/>
                    </td>
                </tr>
            </table>
            <t t-call="justech_alexander_reports.dx_signature_panel"/>
        </div>
    </template>

    <template id="dx_payment_composition">
        <div class="dx-composition dx-comp-payment dx-page-stack">
                        <table class="dx-amount-box">
                            <tr>
                                <td>
                                    <div class="dx-amount-label">Monto recibido</div>
                                    <div class="dx-amount-hero" t-out="dx['amount']"/>
                                    <div t-if="dx.get('amount_words')" class="dx-amount-words">Son: <t t-out="dx['amount_words']"/></div>
                                </td>
                            </tr>
                        </table>
                        <table class="dx-zone-party">
                            <tr>
                                <td class="dx-zone-customer">
                                    <div class="dx-card-title">Recibido de</div>
                                    <div class="dx-card-name" t-out="dx['partner']['name']"/>
                                    <div t-if="dx['partner'].get('vat')">RNC <t t-out="dx['partner']['vat']"/></div>
                                    <div t-if="dx['partner'].get('street')" t-out="dx['partner']['street']"/>
                                </td>
                                <td class="dx-zone-meta">
                                    <div class="dx-card-title">Detalle del pago</div>
                                    <table class="dx-meta-grid">
                                        <tr>
                                            <td>
                                                <div class="dx-meta-k">Fecha</div>
                                                <div class="dx-meta-v" t-out="dx['date']"/>
                                            </td>
                                            <td>
                                                <div class="dx-meta-k">Método</div>
                                                <div class="dx-meta-v" t-out="dx['method']"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>
                                                <div class="dx-meta-k">Banco / diario</div>
                                                <div class="dx-meta-v" t-out="dx['bank']"/>
                                            </td>
                                            <td>
                                                <div class="dx-meta-k">Moneda</div>
                                                <div class="dx-meta-v" t-out="dx['currency']"/>
                                            </td>
                                        </tr>
                                        <tr t-if="dx.get('reference')">
                                            <td colspan="2">
                                                <div class="dx-meta-k">Referencia</div>
                                                <div class="dx-meta-v" t-out="dx['reference']"/>
                                            </td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>
                        </table>
                        <t t-if="dx.get('unapplied')">
                            <div class="dx-unapplied">PAGO NO APLICADO / ANTICIPO</div>
                            <p class="dx-unapplied-help">Este cobro no está aplicado a facturas. Queda como anticipo a favor del cliente.</p>
                        </t>
                        <t t-else="">
                            <div class="dx-block-title">Facturas aplicadas</div>
                            <table class="dx-lines dx-applied">
                                <thead>
                                    <tr>
                                        <th>Documento</th>
                                        <th>NCF</th>
                                        <th>Fecha</th>
                                        <th class="dx-col-amt">Monto factura</th>
                                        <th class="dx-col-amt">Monto aplicado</th>
                                        <th class="dx-col-amt">Saldo restante</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="dx['applied']" t-as="row">
                                        <td t-out="row['document']"/>
                                        <td t-out="row['ncf']"/>
                                        <td t-out="row['date']"/>
                                        <td class="dx-money" t-out="row['invoice_amount']"/>
                                        <td class="dx-money" t-out="row['applied']"/>
                                        <td class="dx-money" t-out="row['residual']"/>
                                    </tr>
                                </tbody>
                            </table>
                        </t>
                        <t t-if="dx.get('banks') or dx.get('terms')">
                            <div class="dx-receipt-note">
                                <t t-call="justech_alexander_reports.dx_terms_panel"/>
                            </div>
                        </t>
            <t t-call="justech_alexander_reports.dx_signature_panel"/>
        </div>
    </template>

    <template id="dx_purchase_composition">
        <div class="dx-composition dx-comp-purchase dx-page-stack">
            <table class="dx-zone-party">
                <tr>
                    <td class="dx-zone-customer">
                        <t t-call="justech_alexander_reports.dx_customer_card"/>
                    </td>
                    <td class="dx-zone-meta">
                        <t t-call="justech_alexander_reports.dx_commercial_meta"/>
                    </td>
                </tr>
            </table>
            <t t-call="justech_alexander_reports.dx_line_table"/>
            <table class="dx-zone-bottom dx-keep-end" border="0" cellpadding="0" cellspacing="0">
                <tr>
                    <td class="dx-zone-terms">
                        <t t-call="justech_alexander_reports.dx_terms_panel"/>
                    </td>
                    <td class="dx-zone-totals">
                        <t t-call="justech_alexander_reports.dx_totals_panel"/>
                    </td>
                </tr>
            </table>
            <t t-call="justech_alexander_reports.dx_signature_panel"/>
        </div>
    </template>

    <template id="dx_picking_composition">
        <div class="dx-composition dx-comp-picking dx-page-stack">
            <table class="dx-zone-party">
                <tr>
                    <td class="dx-zone-customer">
                        <t t-call="justech_alexander_reports.dx_customer_card"/>
                    </td>
                    <td class="dx-zone-meta">
                        <t t-call="justech_alexander_reports.dx_commercial_meta"/>
                    </td>
                </tr>
            </table>
            <t t-call="justech_alexander_reports.dx_picking_lines"/>
            <t t-if="dx.get('note')">
                <div class="dx-terms" t-out="dx['note']"/>
            </t>
            <t t-call="justech_alexander_reports.dx_signature_panel"/>
        </div>
    </template>

    <template id="dx_report_extras" name="Bloques extra Doralex">
        <t t-set="dx_mode" t-value="dx_extras_mode or 'customer'"/>
        <t t-set="dx_terms" t-value="company.dx_report_terms or company.invoice_terms"/>
        <div t-if="dx_mode == 'customer' and dx_terms" class="dx-block dx-terms">
            <div class="dx-block-title">Términos y condiciones</div>
            <p t-out="dx_terms"/>
        </div>
        <t t-if="dx_mode == 'customer' and company.dx_report_show_bank">
            <t t-set="dx_banks" t-value="company._dx_report_banks()"/>
            <div t-if="dx_banks" class="dx-block dx-banks">
                <div class="dx-block-title">Información de pago</div>
                <t t-foreach="dx_banks" t-as="bank">
                    <div class="dx-bank-line">
                        <t t-out="bank.bank_id.name or 'Banco'"/>
                        <t t-if="bank.acc_number"> · <t t-out="bank.acc_number"/></t>
                        <t t-if="company.name"> · <t t-out="company._dx_legal_display()"/></t>
                    </div>
                </t>
            </div>
        </t>
        <div t-if="dx_mode == 'purchase'" class="dx-block dx-purchase-note">
            <div class="dx-block-title">Instrucciones</div>
            <p>Documento de compra. No es una factura. Confirmar cantidades y condiciones al recibir.</p>
        </div>
    </template>
</odoo>
