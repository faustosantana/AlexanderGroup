<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="dx_customer_card">
        <div class="dx-card-title" t-out="dx.get('party_title') or 'Cliente'"/>
        <div class="dx-card-name" t-out="dx['partner']['name']"/>
        <div t-if="dx['partner'].get('vat')">RNC <t t-out="dx['partner']['vat']"/></div>
        <div t-if="dx['partner'].get('street')" t-out="dx['partner']['street']"/>
        <div t-if="dx['partner'].get('city')" t-out="dx['partner']['city']"/>
        <div t-if="dx['partner'].get('phone')" t-out="dx['partner']['phone']"/>
    </template>

    <template id="dx_commercial_meta">
        <table class="dx-meta-table">
            <tr t-if="dx.get('date')">
                <th>Fecha</th>
                <td t-out="dx['date']"/>
            </tr>
            <tr t-if="dx.get('validity')">
                <th>Validez</th>
                <td t-out="dx['validity']"/>
            </tr>
            <tr t-if="dx.get('due')">
                <th>Vencimiento</th>
                <td t-out="dx['due']"/>
            </tr>
            <tr t-if="dx.get('ncf')">
                <th>NCF</th>
                <td t-out="dx['ncf']"/>
            </tr>
            <tr t-if="dx.get('origin_ncf')">
                <th>NCF afectado</th>
                <td t-out="dx['origin_ncf']"/>
            </tr>
            <tr t-if="dx.get('origin_move')">
                <th>Factura afectada</th>
                <td t-out="dx['origin_move']"/>
            </tr>
            <tr t-if="dx.get('origin')">
                <th>Origen</th>
                <td t-out="dx['origin']"/>
            </tr>
            <tr t-if="dx.get('salesperson')">
                <th>Vendedor</th>
                <td t-out="dx['salesperson']"/>
            </tr>
            <tr t-if="dx.get('payment_term')">
                <th>Condición</th>
                <td t-out="dx['payment_term']"/>
            </tr>
            <tr t-if="dx.get('currency')">
                <th>Moneda</th>
                <td t-out="dx['currency']"/>
            </tr>
            <tr t-if="dx.get('client_ref')">
                <th>Referencia</th>
                <td t-out="dx['client_ref']"/>
            </tr>
        </table>
    </template>

    <template id="dx_line_table">
        <table class="dx-lines">
            <thead>
                <tr>
                    <th class="dx-col-desc">Descripción</th>
                    <th class="dx-col-qty">Cant.</th>
                    <th class="dx-col-uom">Ud.</th>
                    <th class="dx-col-price">Precio</th>
                    <th class="dx-col-tax">Imp.</th>
                    <th class="dx-col-amt">Importe</th>
                </tr>
            </thead>
            <tbody>
                <t t-foreach="dx['lines']" t-as="line">
                    <tr t-if="line['kind'] == 'section'" class="dx-line-section">
                        <td colspan="6" t-out="line['name']"/>
                    </tr>
                    <tr t-elif="line['kind'] == 'note'" class="dx-line-note">
                        <td colspan="6" t-out="line['name']"/>
                    </tr>
                    <tr t-else="">
                        <td class="dx-col-desc" t-out="line['name']"/>
                        <td class="dx-col-qty" t-out="line['qty']"/>
                        <td class="dx-col-uom" t-out="line['uom']"/>
                        <td class="dx-col-price dx-money" t-out="line['price']"/>
                        <td class="dx-col-tax" t-out="line['tax']"/>
                        <td class="dx-col-amt dx-money" t-out="line['amount']"/>
                    </tr>
                </t>
            </tbody>
        </table>
    </template>

    <template id="dx_picking_lines">
        <table class="dx-lines">
            <thead>
                <tr>
                    <th class="dx-col-desc">Producto</th>
                    <th class="dx-col-qty">Demandado</th>
                    <th class="dx-col-qty">Hecho</th>
                    <th class="dx-col-uom">Ud.</th>
                </tr>
            </thead>
            <tbody>
                <tr t-foreach="dx['lines']" t-as="line">
                    <td class="dx-col-desc" t-out="line['name']"/>
                    <td class="dx-col-qty" t-out="line['qty']"/>
                    <td class="dx-col-qty" t-out="line.get('done')"/>
                    <td class="dx-col-uom" t-out="line['uom']"/>
                </tr>
            </tbody>
        </table>
    </template>

    <template id="dx_totals_panel">
        <table class="dx-totals">
            <t t-foreach="dx['totals']" t-as="row">
                <tr t-att-class="'dx-total-grand' if row.get('grand') else ''">
                    <th t-out="row['label']"/>
                    <td class="dx-money" t-out="row['value']"/>
                </tr>
            </t>
        </table>
    </template>

    <template id="dx_terms_panel">
        <t t-if="dx.get('terms') or dx.get('note')">
            <div class="dx-block-title">Términos y observaciones</div>
            <div t-if="dx.get('terms')" class="dx-terms" t-out="dx['terms']"/>
            <div t-if="dx.get('note')" class="dx-terms" t-out="dx['note']"/>
        </t>
        <t t-if="dx.get('banks')">
            <div class="dx-block-title dx-bank-title">Cuentas para pago</div>
            <t t-foreach="dx['banks']" t-as="bank">
                <div class="dx-bank-line">
                    <t t-out="bank['bank']"/>
                    <t t-if="bank.get('account')"> · <t t-out="bank['account']"/></t>
                    <t t-if="bank.get('holder')"> · <t t-out="bank['holder']"/></t>
                </div>
            </t>
        </t>
    </template>

    <template id="dx_signature_panel">
        <t t-if="dx.get('show_signature')">
            <table t-if="dx.get('spacer_px')" class="dx-sign-spacer">
                <tr>
                    <td t-att-height="dx.get('spacer_px')" t-att-style="dx.get('spacer_td_style')">
                        <img t-att-src="dx.get('spacer_src')"
                             t-att-style="dx.get('spacer_style')"
                             alt=""/>
                    </td>
                </tr>
            </table>
            <table class="dx-sign-table">
                <tr>
                    <td>
                        <div class="dx-sign-space"/>
                        <div class="dx-sign-line" t-out="dx.get('sign_left') or 'Elaborado por'"/>
                    </td>
                    <td>
                        <div class="dx-sign-space"/>
                        <div class="dx-sign-line" t-out="dx.get('sign_right') or 'Aceptado'"/>
                    </td>
                </tr>
            </table>
        </t>
    </template>

    <template id="dx_sale_composition">
        <div class="dx-composition dx-comp-sale">
            <table class="dx-page-stack">
                <tr>
                    <td class="dx-stack-main" valign="top">
                        <table class="dx-zone-party">
                            <tr>
                                <td class="dx-zone-customer">
                                    <t t-call="justech_alexander_reports.dx_customer_card"/>
                                </td>
                                <td class="dx-zone-meta">
                                    <t t-call="justech_alexander_reports.dx_commercial_meta"/>
                                </td>
                            </tr>
                        </table>
                        <t t-call="justech_alexander_reports.dx_line_table"/>
                        <table class="dx-zone-bottom dx-keep-end">
                            <tr>
                                <td class="dx-zone-terms">
                                    <t t-call="justech_alexander_reports.dx_terms_panel"/>
                                </td>
                                <td class="dx-zone-totals">
                                    <t t-call="justech_alexander_reports.dx_totals_panel"/>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
                <tr>
                    <td class="dx-stack-sign" valign="bottom">
                        <t t-call="justech_alexander_reports.dx_signature_panel"/>
                    </td>
                </tr>
            </table>
        </div>
    </template>

    <template id="dx_invoice_composition">
        <div t-attf-class="dx-composition dx-comp-invoice #{'dx-comp-refund' if dx.get('is_refund') else ''}">
            <table class="dx-page-stack">
                <tr>
                    <td class="dx-stack-main" valign="top">
                        <table class="dx-zone-party">
                            <tr>
                                <td class="dx-zone-customer">
                                    <t t-call="justech_alexander_reports.dx_customer_card"/>
                                    <div t-if="dx.get('reason')" class="dx-reason">
                                        <div class="dx-block-title">Motivo</div>
                                        <div t-out="dx['reason']"/>
                                    </div>
                                </td>
                                <td class="dx-zone-meta">
                                    <t t-call="justech_alexander_reports.dx_commercial_meta"/>
                                </td>
                            </tr>
                        </table>
                        <table t-if="dx.get('is_refund')" class="dx-refund-banner">
                            <tr>
                                <td>
                                    <div class="dx-block-title">Importe acreditado</div>
                                    <div class="dx-credited" t-out="dx.get('credited')"/>
                                </td>
                                <td>
                                    <div class="dx-block-title">Documento afectado</div>
                                    <div t-if="dx.get('origin_ncf')">NCF <t t-out="dx['origin_ncf']"/></div>
                                    <div t-if="dx.get('origin_move')" t-out="dx['origin_move']"/>
                                </td>
                            </tr>
                        </table>
                        <t t-call="justech_alexander_reports.dx_line_table"/>
                        <table class="dx-zone-bottom dx-keep-end">
                            <tr>
                                <td class="dx-zone-terms">
                                    <t t-call="justech_alexander_reports.dx_terms_panel"/>
                                </td>
                                <td class="dx-zone-totals">
                                    <t t-call="justech_alexander_reports.dx_totals_panel"/>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
                <tr>
                    <td class="dx-stack-sign" valign="bottom">
                        <t t-call="justech_alexander_reports.dx_signature_panel"/>
                    </td>
                </tr>
            </table>
        </div>
    </template>

    <template id="dx_payment_composition">
        <div class="dx-composition dx-comp-payment">
            <table class="dx-page-stack">
                <tr>
                    <td class="dx-stack-main" valign="top">
                        <table class="dx-amount-box">
                            <tr>
                                <td>
                                    <div class="dx-amount-label">Monto recibido</div>
                                    <div class="dx-amount-hero" t-out="dx['amount']"/>
                                    <div t-if="dx.get('amount_words')" class="dx-amount-words">Son: <t t-out="dx['amount_words']"/></div>
                                </td>
                            </tr>
                        </table>
                        <table class="dx-zone-party">
                            <tr>
                                <td class="dx-zone-customer">
                                    <div class="dx-card-title">Recibido de</div>
                                    <div class="dx-card-name" t-out="dx['partner']['name']"/>
                                    <div t-if="dx['partner'].get('vat')">RNC <t t-out="dx['partner']['vat']"/></div>
                                    <div t-if="dx['partner'].get('street')" t-out="dx['partner']['street']"/>
                                </td>
                                <td class="dx-zone-meta">
                                    <div class="dx-card-title">Detalle del pago</div>
                                    <table class="dx-meta-table">
                                        <tr><th>Fecha</th><td t-out="dx['date']"/></tr>
                                        <tr><th>Método</th><td t-out="dx['method']"/></tr>
                                        <tr><th>Banco / diario</th><td t-out="dx['bank']"/></tr>
                                        <tr t-if="dx.get('reference')"><th>Referencia</th><td t-out="dx['reference']"/></tr>
                                        <tr><th>Moneda</th><td t-out="dx['currency']"/></tr>
                                    </table>
                                </td>
                            </tr>
                        </table>
                        <t t-if="dx.get('unapplied')">
                            <div class="dx-unapplied">PAGO NO APLICADO / ANTICIPO</div>
                            <p class="dx-unapplied-help">Este cobro no está aplicado a facturas. Queda como anticipo a favor del cliente.</p>
                        </t>
                        <t t-else="">
                            <div class="dx-block-title">Facturas aplicadas</div>
                            <table class="dx-lines dx-applied">
                                <thead>
                                    <tr>
                                        <th>Documento</th>
                                        <th>NCF</th>
                                        <th>Fecha</th>
                                        <th class="dx-col-amt">Monto factura</th>
                                        <th class="dx-col-amt">Monto aplicado</th>
                                        <th class="dx-col-amt">Saldo restante</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="dx['applied']" t-as="row">
                                        <td t-out="row['document']"/>
                                        <td t-out="row['ncf']"/>
                                        <td t-out="row['date']"/>
                                        <td class="dx-money" t-out="row['invoice_amount']"/>
                                        <td class="dx-money" t-out="row['applied']"/>
                                        <td class="dx-money" t-out="row['residual']"/>
                                    </tr>
                                </tbody>
                            </table>
                        </t>
                        <t t-if="dx.get('banks') or dx.get('terms')">
                            <div class="dx-receipt-note">
                                <t t-call="justech_alexander_reports.dx_terms_panel"/>
                            </div>
                        </t>
                    </td>
                </tr>
                <tr>
                    <td class="dx-stack-sign" valign="bottom">
                        <t t-call="justech_alexander_reports.dx_signature_panel"/>
                    </td>
                </tr>
            </table>
        </div>
    </template>

    <template id="dx_purchase_composition">
        <div class="dx-composition dx-comp-purchase">
            <table class="dx-page-stack">
                <tr>
                    <td class="dx-stack-main" valign="top">
                        <table class="dx-zone-party">
                            <tr>
                                <td class="dx-zone-customer">
                                    <t t-call="justech_alexander_reports.dx_customer_card"/>
                                </td>
                                <td class="dx-zone-meta">
                                    <t t-call="justech_alexander_reports.dx_commercial_meta"/>
                                </td>
                            </tr>
                        </table>
                        <t t-call="justech_alexander_reports.dx_line_table"/>
                        <table class="dx-zone-bottom dx-keep-end">
                            <tr>
                                <td class="dx-zone-terms">
                                    <t t-call="justech_alexander_reports.dx_terms_panel"/>
                                </td>
                                <td class="dx-zone-totals">
                                    <t t-call="justech_alexander_reports.dx_totals_panel"/>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
                <tr>
                    <td class="dx-stack-sign" valign="bottom">
                        <t t-call="justech_alexander_reports.dx_signature_panel"/>
                    </td>
                </tr>
            </table>
        </div>
    </template>

    <template id="dx_picking_composition">
        <div class="dx-composition dx-comp-picking">
            <table class="dx-page-stack">
                <tr>
                    <td class="dx-stack-main" valign="top">
                        <table class="dx-zone-party">
                            <tr>
                                <td class="dx-zone-customer">
                                    <t t-call="justech_alexander_reports.dx_customer_card"/>
                                </td>
                                <td class="dx-zone-meta">
                                    <t t-call="justech_alexander_reports.dx_commercial_meta"/>
                                </td>
                            </tr>
                        </table>
                        <t t-call="justech_alexander_reports.dx_picking_lines"/>
                        <t t-if="dx.get('note')">
                            <div class="dx-terms" t-out="dx['note']"/>
                        </t>
                    </td>
                </tr>
                <tr>
                    <td class="dx-stack-sign" valign="bottom">
                        <t t-call="justech_alexander_reports.dx_signature_panel"/>
                    </td>
                </tr>
            </table>
        </div>
    </template>

    <template id="dx_report_extras" name="Bloques extra Doralex">
        <t t-set="dx_mode" t-value="dx_extras_mode or 'customer'"/>
        <t t-set="dx_terms" t-value="company.dx_report_terms or company.invoice_terms"/>
        <div t-if="dx_mode == 'customer' and dx_terms" class="dx-block dx-terms">
            <div class="dx-block-title">Términos y condiciones</div>
            <p t-out="dx_terms"/>
        </div>
        <t t-if="dx_mode == 'customer' and company.dx_report_show_bank">
            <t t-set="dx_banks" t-value="company._dx_report_banks()"/>
            <div t-if="dx_banks" class="dx-block dx-banks">
                <div class="dx-block-title">Información de pago</div>
                <t t-foreach="dx_banks" t-as="bank">
                    <div class="dx-bank-line">
                        <t t-out="bank.bank_id.name or 'Banco'"/>
                        <t t-if="bank.acc_number"> · <t t-out="bank.acc_number"/></t>
                        <t t-if="company.name"> · <t t-out="company._dx_legal_display()"/></t>
                    </div>
                </t>
            </div>
        </t>
        <div t-if="dx_mode == 'purchase'" class="dx-block dx-purchase-note">
            <div class="dx-block-title">Instrucciones</div>
            <p>Documento de compra. No es una factura. Confirmar cantidades y condiciones al recibir.</p>
        </div>
    </template>
</odoo>
