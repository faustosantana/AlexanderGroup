    <template id="dx_invoice_composition">
        <div t-attf-class="dx-composition dx-comp-invoice dx-comp-{{ dx.get('layout') or 'dor' }} dx-page-stack #{'dx-comp-refund' if dx.get('is_refund') else ''}">
            <t t-call="justech_alexander_reports.dx_pin_doc_title"/>
            <div class="dx-ncf-hero">
                <div class="dx-ncf-k" t-out="dx.get('ncf_label') or 'Número de Comprobante Fiscal'"/>
                <div t-if="dx.get('ncf')" class="dx-ncf-v" t-out="dx['ncf']"/>
                <div t-else="" class="dx-ncf-pending" t-out="dx.get('ncf_pending_label') or 'Pendiente de número de comprobante fiscal'"/>
            </div>
            <div t-if="dx.get('is_refund')" class="dx-refund-open">
                <div class="dx-refund-col">
                    <div class="dx-block-title">Total acreditado</div>
                    <div class="dx-credited" t-out="dx.get('credited')"/>
                </div>
                <div class="dx-refund-col">
                    <div class="dx-block-title">Documento afectado</div>
                    <div t-if="dx.get('origin_ncf')"><t t-out="dx.get('origin_ncf_label') or 'Comprobante afectado'"/> · <t t-out="dx['origin_ncf']"/></div>
                    <div t-if="dx.get('origin_move')" t-out="dx['origin_move']"/>
                    <div t-if="dx.get('origin')">Factura · <t t-out="dx['origin']"/></div>
                </div>
            </div>
            <div class="dx-inv-top">
                <div t-attf-class="dx-inv-party dx-inv-party-{{ dx.get('layout') or 'dor' }}">
                    <t t-call="justech_alexander_reports.dx_customer_card"/>
                    <div t-if="dx.get('reason')" class="dx-inv-reason">
                        <div class="dx-block-title">Motivo</div>
                        <div t-out="dx['reason']"/>
                    </div>
                </div>
                <div class="dx-inv-meta">
                    <div class="dx-inv-meta-col">
                        <div class="dx-meta-k">Fecha</div>
                        <div class="dx-meta-v" t-out="dx['date']"/>
                    </div>
                    <div class="dx-inv-meta-col">
                        <div class="dx-meta-k">Vencimiento</div>
                        <div class="dx-meta-v" t-out="dx.get('due') or '—'"/>
                    </div>
                    <div class="dx-inv-meta-col">
                        <div class="dx-meta-k">Moneda</div>
                        <div class="dx-meta-v" t-out="dx.get('currency') or '—'"/>
                    </div>
                    <div class="dx-inv-meta-col" t-if="dx.get('payment_term')">
                        <div class="dx-meta-k">Condición</div>
                        <div class="dx-meta-v" t-out="dx['payment_term']"/>
                    </div>
                    <div class="dx-inv-meta-col">
                        <div class="dx-meta-k" t-out="dx.get('client_ref_label') or 'OC / PO'"/>
                        <div class="dx-meta-v" t-out="dx.get('client_ref') or '—'"/>
                    </div>
                </div>
            </div>
            <t t-call="justech_alexander_reports.dx_line_table"/>
            <t t-call="justech_alexander_reports.dx_document_end"/>
            <t t-call="justech_alexander_reports.dx_signature_panel"/>
        </div>
    </template>

    <template id="dx_payment_composition">
        <div t-attf-class="dx-composition dx-comp-payment dx-comp-{{ dx.get('layout') or 'dor' }} dx-page-stack">
            <t t-call="justech_alexander_reports.dx_pin_doc_title"/>
            <div class="dx-amount-hero-wrap">
                <div class="dx-amount-label" t-out="dx.get('amount_label') or 'Monto recibido'"/>
                <div class="dx-amount-hero" t-out="dx['amount']"/>
                <div t-if="dx.get('amount_words')" class="dx-amount-words">Son: <t t-out="dx['amount_words']"/></div>
            </div>
            <div class="dx-pay-detail">
                <div class="dx-pay-who">
                    <div class="dx-card-title" t-out="dx.get('party_title') or 'Recibido de'"/>
                    <div class="dx-card-name" t-out="dx['partner']['name']"/>
                    <div t-if="dx['partner'].get('vat')">RNC <t t-out="dx['partner']['vat']"/></div>
                    <div t-if="dx['partner'].get('street')" t-out="dx['partner']['street']"/>
                </div>
                <div class="dx-pay-meta">
                    <div class="dx-pay-meta-col">
                        <div class="dx-meta-k">Fecha</div>
                        <div class="dx-meta-v" t-out="dx['date']"/>
                    </div>
                    <div class="dx-pay-meta-col">
                        <div class="dx-meta-k">Método</div>
                        <div class="dx-meta-v" t-out="dx['method']"/>
                    </div>
                    <div class="dx-pay-meta-col">
                        <div class="dx-meta-k">Banco / diario</div>
                        <div class="dx-meta-v" t-out="dx['bank']"/>
                    </div>
                    <div class="dx-pay-meta-col">
                        <div class="dx-meta-k">Moneda</div>
                        <div class="dx-meta-v" t-out="dx['currency']"/>
                    </div>
                    <div class="dx-pay-meta-col" t-if="dx.get('reference')">
                        <div class="dx-meta-k">Referencia</div>
                        <div class="dx-meta-v" t-out="dx['reference']"/>
                    </div>
                    <div class="dx-pay-meta-col" t-if="dx.get('gross_amount')">
                        <div class="dx-meta-k">Monto bruto</div>
                        <div class="dx-meta-v" t-out="dx['gross_amount']"/>
                    </div>
                    <div class="dx-pay-meta-col" t-if="dx.get('isr_withheld')">
                        <div class="dx-meta-k">ISR retenido</div>
                        <div class="dx-meta-v" t-out="dx['isr_withheld']"/>
                    </div>
                    <div class="dx-pay-meta-col" t-if="dx.get('itbis_withheld')">
                        <div class="dx-meta-k">ITBIS retenido</div>
                        <div class="dx-meta-v" t-out="dx['itbis_withheld']"/>
                    </div>
                    <div class="dx-pay-meta-col" t-if="dx.get('other_withheld')">
                        <div class="dx-meta-k">Otras retenciones</div>
                        <div class="dx-meta-v" t-out="dx['other_withheld']"/>
                    </div>
                    <div class="dx-pay-meta-col" t-if="dx.get('net_paid')">
                        <div class="dx-meta-k">Neto pagado</div>
                        <div class="dx-meta-v" t-out="dx['net_paid']"/>
                    </div>
                    <div class="dx-pay-meta-col" t-if="dx.get('total_applied')">
                        <div class="dx-meta-k">Total aplicado</div>
                        <div class="dx-meta-v" t-out="dx['total_applied']"/>
                    </div>
                </div>
            </div>
            <t t-if="dx.get('withholding_rows')">
                <div class="dx-block-title">Retenciones</div>
                <table t-attf-class="dx-lines dx-applied dx-table-{{ dx.get('layout') or 'dor' }}" border="0" cellpadding="0" cellspacing="0" frame="void" rules="none">
                    <thead>
                        <tr>
                            <th>Tipo</th>
                            <th>Regla</th>
                            <th>Base</th>
                            <th class="dx-col-amt">Tasa</th>
                            <th class="dx-col-amt">Retención</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="dx['withholding_rows']" t-as="wh">
                            <td t-out="wh['kind']"/>
                            <td><t t-out="wh['code']"/> <t t-out="wh['label']"/></td>
                            <td><t t-out="wh['base_label']"/> <t t-out="wh['base']"/></td>
                            <td class="dx-money" t-out="wh['rate']"/>
                            <td class="dx-money" t-out="wh['amount']"/>
                        </tr>
                    </tbody>
                </table>
            </t>
            <t t-if="dx.get('unapplied')">
                <div class="dx-unapplied">PAGO NO APLICADO / ANTICIPO</div>
                <p class="dx-unapplied-help">Este cobro no está aplicado a facturas. Queda como anticipo a favor del cliente.</p>
            </t>
            <t t-else="">
                <div class="dx-block-title">Facturas aplicadas</div>
                <table t-attf-class="dx-lines dx-applied dx-table-{{ dx.get('layout') or 'dor' }}" border="0" cellpadding="0" cellspacing="0" frame="void" rules="none">
                    <thead>
                        <tr>
                            <th>Factura</th>
                            <th>Comprobante</th>
                            <th>Fecha</th>
                            <th class="dx-col-amt">Monto factura</th>
                            <th class="dx-col-amt">Monto aplicado</th>
                            <th class="dx-col-amt">Saldo restante</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="dx['applied']" t-as="row">
                            <td t-out="row['document']"/>
                            <td t-out="row['ncf']"/>
                            <td t-out="row['date']"/>
                            <td class="dx-money" t-out="row['invoice_amount']"/>
                            <td class="dx-money" t-out="row['applied']"/>
                            <td class="dx-money" t-out="row['residual']"/>
                        </tr>
                    </tbody>
                </table>
            </t>
            <t t-if="dx.get('terms')">
                <div class="dx-receipt-note">
                    <t t-call="justech_alexander_reports.dx_terms_text"/>
                </div>
            </t>
            <t t-call="justech_alexander_reports.dx_signature_panel"/>
        </div>
    </template>

    <template id="dx_purchase_composition">
        <div t-attf-class="dx-composition dx-comp-purchase dx-comp-{{ dx.get('layout') or 'dor' }} dx-page-stack">
            <t t-call="justech_alexander_reports.dx_pin_doc_title"/>
