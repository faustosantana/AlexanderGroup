<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_partner_statement_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="partner">
                <t t-set="bundles" t-value="partner._dx_statement_bundles()"/>
                <t t-foreach="bundles" t-as="bundle">
                    <t t-set="o" t-value="bundle['anchor']"/>
                    <t t-set="company" t-value="bundle['company']"/>
                    <t t-set="layout_document_title">Estado de cuenta</t>
                    <t t-call="web.external_layout">
                        <div class="dx-block">
                            <strong t-out="partner.commercial_partner_id.name"/>
                            <div t-if="partner.vat">RNC / Cédula: <t t-out="partner.vat"/></div>
                            <div>Corte: <t t-out="bundle['cutoff']"/></div>
                        </div>
                        <table class="dx-lines">
                            <thead>
                                <tr>
                                    <th>Fecha</th>
                                    <th>Documento</th>
                                    <th>Vence</th>
                                    <th>Estado</th>
                                    <th class="text-end">Cargo</th>
                                    <th class="text-end">Abono</th>
                                    <th class="text-end">Saldo</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="bundle['rows']" t-as="row">
                                    <td t-out="row['date']"/>
                                    <td t-out="row['document']"/>
                                    <td t-out="row['due']"/>
                                    <td t-out="row['state']"/>
                                    <td class="text-end" t-out="row['debit']"/>
                                    <td class="text-end" t-out="row['credit']"/>
                                    <td class="text-end" t-out="row['balance']"/>
                                </tr>
                            </tbody>
                        </table>
                        <div id="total">
                            <table>
                                <tr>
                                    <td>Total vencido</td>
                                    <td class="text-end" t-out="bundle['overdue']"/>
                                </tr>
                                <tr>
                                    <td>0–30</td>
                                    <td class="text-end" t-out="bundle['age_30']"/>
                                </tr>
                                <tr>
                                    <td>31–60</td>
                                    <td class="text-end" t-out="bundle['age_60']"/>
                                </tr>
                                <tr>
                                    <td>61–90</td>
                                    <td class="text-end" t-out="bundle['age_90']"/>
                                </tr>
                                <tr>
                                    <td>90+</td>
                                    <td class="text-end" t-out="bundle['age_90p']"/>
                                </tr>
                                <tr>
                                    <td><strong>Saldo</strong></td>
                                    <td class="text-end">
                                        <strong class="dx-totals-grand" t-out="bundle['balance_disp']"/>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </t>
                </t>
                <t t-if="not bundles">
                    <t t-set="o" t-value="False"/>
                    <t t-set="company" t-value="partner.company_id or company"/>
                    <t t-set="layout_document_title">Estado de cuenta</t>
                    <t t-call="web.external_layout">
                        <p>No hay documentos de cliente para este contacto.</p>
                    </t>
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_partner_statement" model="ir.actions.report">
        <field name="name">Estado de cuenta</field>
        <field name="model">res.partner</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">justech_alexander_reports.report_partner_statement_document</field>
        <field name="report_file">justech_alexander_reports.report_partner_statement_document</field>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_doralex_a4"/>
    </record>
</odoo>
