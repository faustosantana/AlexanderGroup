<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="justech_alexander_ux.EnterpriseNavBar" t-inherit="web_enterprise.EnterpriseNavBar" t-inherit-mode="extension">
        <xpath expr="//a[hasclass('o_menu_toggle')]" position="attributes">
            <attribute name="title">Inicio</attribute>
            <attribute name="aria-label">Inicio</attribute>
            <attribute name="t-on-click.prevent">() => { if (this.env.isSmall) { this._openAppMenuSidebar(); } else { (this.hm || this.env.services.home_menu)?.toggle(true); } }</attribute>
        </xpath>
    </t>
</templates>
