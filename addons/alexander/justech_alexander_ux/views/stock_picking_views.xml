<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Delivery operations: match Conduce wording. Demand/Quantity → pedida / a entregar. -->
    <record id="view_picking_form_dx_qty_labels" model="ir.ui.view">
        <field name="name">stock.picking.form.dx.qty.labels</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="priority">80</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='move_ids']/list/field[@name='product_uom_qty']" position="attributes">
                <attribute name="string">Cantidad pedida</attribute>
            </xpath>
            <xpath expr="//field[@name='move_ids']/list/field[@name='quantity']" position="attributes">
                <attribute name="string">Cantidad a entregar</attribute>
            </xpath>
        </field>
    </record>
</odoo>
