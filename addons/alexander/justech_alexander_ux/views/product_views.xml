<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Native tracking is gated by stock.group_production_lot. Keep the field
         on the model; show lot/serial options whenever the product is storable. -->
    <record id="view_product_template_form_dx_tracking" model="ir.ui.view">
        <field name="name">product.template.form.dx.tracking</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="stock.view_template_property_form"/>
        <field name="priority">80</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='tracking']" position="attributes">
                <attribute name="groups"/>
                <attribute name="invisible">not is_storable</attribute>
            </xpath>
        </field>
    </record>
</odoo>
