<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Fiscal Dominicana visible bajo Contabilidad, no solo en Configuración. -->
    <record id="justech_l10n_do_base.menu_justech_do_fiscal_root" model="ir.ui.menu">
        <field name="parent_id" ref="accountant.menu_accounting"/>
        <field name="name">Fiscal Dominicana</field>
        <field name="sequence">35</field>
    </record>

    <!-- DGII deja de ser app raíz; la funcionalidad queda bajo Fiscal Dominicana. -->
    <record id="l10n_do_ecf_connector.ecf_documents_root" model="ir.ui.menu">
        <field name="parent_id" ref="justech_l10n_do_base.menu_justech_do_fiscal_root"/>
        <field name="name">DGII</field>
        <field name="sequence">40</field>
    </record>

    <!-- e-CF deja Facturación Community y entra al mismo área fiscal. -->
    <record id="justech_ecf_core.menu_justech_ecf_root" model="ir.ui.menu">
        <field name="parent_id" ref="justech_l10n_do_base.menu_justech_do_fiscal_root"/>
        <field name="name">e-CF</field>
        <field name="sequence">30</field>
    </record>

    <record id="justech_warranty.menu_justech_warranty_root" model="ir.ui.menu">
        <field name="name">Garantías</field>
    </record>

    <record id="justech_admin_center.menu_justech_admin_center_root" model="ir.ui.menu">
        <field name="name">Administración técnica</field>
    </record>

    <record id="justech_alexander_admin.menu_doralex_modules" model="ir.ui.menu">
        <field name="name">Módulos</field>
    </record>

    <record id="justech_l10n_do_ncf.menu_justech_do_ncf_motor_root" model="ir.ui.menu">
        <field name="name">NCF</field>
        <field name="sequence">20</field>
    </record>

    <!-- Reportes 606/607 y retenciones: misma área fiscal, no app suelta. -->
    <record id="justech_l10n_do_reports.menu_justech_do_audit_root" model="ir.ui.menu">
        <field name="parent_id" ref="justech_l10n_do_base.menu_justech_do_fiscal_root"/>
        <field name="name">Reportes fiscales</field>
        <field name="sequence">50</field>
    </record>
</odoo>
