<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_approval_request_own" model="ir.rule">
        <field name="name">Aprobaciones: propias</field>
        <field name="model_id" ref="justech_approval_flow.model_justech_approval_request"/>
        <field name="domain_force">[('requester_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="rule_approval_request_approver" model="ir.rule">
        <field name="name">Aprobaciones: asignadas al aprobador</field>
        <field name="model_id" ref="justech_approval_flow.model_justech_approval_request"/>
        <field name="domain_force">['|', ('approver_ids', 'in', [user.id]), ('approver_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('justech_approval_flow.group_approver'))]"/>
    </record>
    <record id="rule_approval_request_manager" model="ir.rule">
        <field name="name">Aprobaciones: administrador ve todas</field>
        <field name="model_id" ref="justech_approval_flow.model_justech_approval_request"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('justech_approval_flow.group_manager'))]"/>
    </record>
</odoo>
