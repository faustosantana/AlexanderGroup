<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dx_ms_inbox_tree" model="ir.ui.view">
        <field name="name">dx.ms.functional.inbox.tree</field>
        <field name="model">dx.ms.functional.inbox</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="company_id"/>
                <field name="role"/>
                <field name="alias_name"/>
            </list>
        </field>
    </record>
    <record id="view_dx_ms_inbox_form" model="ir.ui.view">
        <field name="name">dx.ms.functional.inbox.form</field>
        <field name="model">dx.ms.functional.inbox</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="company_id"/>
                        <field name="role"/>
                        <field name="alias_name"/>
                        <field name="alias_id"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_dx_ms_inbox" model="ir.actions.act_window">
        <field name="name">Buzones funcionales</field>
        <field name="res_model">dx.ms.functional.inbox</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem
        id="menu_dx_ms_inbox"
        name="Correo Microsoft"
        parent="justech_alexander_admin.menu_doralex_root"
        action="action_dx_ms_inbox"
        groups="base.group_system"
        sequence="40"
    />
</odoo>
