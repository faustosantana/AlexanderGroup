<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_justech_approval_reject_wizard_form" model="ir.ui.view">
        <field name="name">justech.approval.reject.wizard.form</field>
        <field name="model">justech.approval.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Rechazar aprobación">
                <group>
                    <field name="request_id" invisible="1"/>
                    <field name="reason" placeholder="Indique el motivo del rechazo"/>
                </group>
                <footer>
                    <button name="action_confirm_reject"
                            type="object"
                            string="Confirmar rechazo"
                            class="btn-primary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
