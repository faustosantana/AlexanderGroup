<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_justech_approval_approve_wizard_form" model="ir.ui.view">
        <field name="name">justech.approval.approve.wizard.form</field>
        <field name="model">justech.approval.approve.wizard</field>
        <field name="arch" type="xml">
            <form string="Aprobar solicitud">
                <group>
                    <field name="request_id" invisible="1"/>
                    <field name="request_note" readonly="1"
                           placeholder="Sin comentario del solicitante"/>
                    <field name="attachment_ids" widget="many2many_binary" readonly="1"/>
                    <field name="note"
                           placeholder="Comentario opcional para el solicitante"/>
                </group>
                <footer>
                    <button name="action_confirm_approve"
                            type="object"
                            string="Aprobar"
                            class="btn-primary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
