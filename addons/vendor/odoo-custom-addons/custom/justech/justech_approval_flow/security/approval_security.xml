<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_justech_approval">
        <field name="name">Aprobaciones Justech</field>
        <field name="sequence">46</field>
    </record>

    <record id="group_approver" model="res.groups">
        <field name="name">Aprobador</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_justech_approval"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Puede aprobar o rechazar solicitudes del flujo simple Justech.</field>
    </record>

    <record id="group_self_approve" model="res.groups">
        <field name="name">Puede autoaprobar</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_justech_approval"/>
        <field name="implied_ids" eval="[(4, ref('justech_approval_flow.group_approver'))]"/>
        <field name="comment">Permite aprobar una solicitud que el mismo usuario creó.</field>
    </record>

    <record id="group_manager" model="res.groups">
        <field name="name">Administrador de aprobaciones</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_justech_approval"/>
        <field name="implied_ids" eval="[(4, ref('justech_approval_flow.group_approver'))]"/>
        <field name="comment">Administra el flujo y ve todas las solicitudes.</field>
    </record>

    <record id="rule_justech_approval_request_company" model="ir.rule">
        <field name="name">Aprobaciones: multiempresa</field>
        <field name="model_id" ref="model_justech_approval_request"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
