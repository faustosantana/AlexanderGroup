<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_move_form_justech_approval" model="ir.ui.view">
        <field name="name">account.move.form.justech.approval</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_justech_approve"
                        type="object"
                        string="Aprobar"
                        class="btn-primary"
                        groups="justech_approval_flow.group_approver"
                        invisible="not justech_approval_invoice_enabled or move_type not in ('out_invoice', 'out_refund') or justech_approval_state != 'pending'"/>
                <button name="action_justech_reject_wizard"
                        type="object"
                        string="Rechazar"
                        groups="justech_approval_flow.group_approver"
                        invisible="not justech_approval_invoice_enabled or move_type not in ('out_invoice', 'out_refund') or justech_approval_state != 'pending'"/>
            </xpath>
            <xpath expr="//field[@name='state']" position="before">
                <field name="justech_approval_invoice_enabled" invisible="1"/>
                <field name="justech_invoice_requires_approval" invisible="1"/>
                <field name="justech_approval_state" widget="badge"
                       decoration-info="justech_approval_state == 'none'"
                       decoration-warning="justech_approval_state in ('pending', 'invalidated')"
                       decoration-success="justech_approval_state == 'approved'"
                       decoration-danger="justech_approval_state == 'rejected'"
                       invisible="not justech_approval_invoice_enabled or move_type not in ('out_invoice', 'out_refund') or (not justech_invoice_requires_approval and justech_approval_state == 'none')"/>
            </xpath>
        </field>
    </record>
</odoo>
