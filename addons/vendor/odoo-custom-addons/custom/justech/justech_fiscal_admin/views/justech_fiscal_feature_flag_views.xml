<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_justech_fiscal_feature_flag_list" model="ir.ui.view">
        <field name="name">justech.fiscal.feature.flag.list</field>
        <field name="model">justech.fiscal.feature.flag</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="category"/>
                <field name="company_id"/>
                <field name="enabled"/>
                <field name="readonly_flag" column_invisible="1"/>
            </list>
        </field>
    </record>
    <record id="view_justech_fiscal_feature_flag_form" model="ir.ui.view">
        <field name="name">justech.fiscal.feature.flag.form</field>
        <field name="model">justech.fiscal.feature.flag</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="category"/>
                        <field name="company_id"/>
                        <field name="enabled"/>
                        <field name="readonly_flag"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_justech_fiscal_feature_flags" model="ir.actions.act_window">
        <field name="name">Feature Flags Fiscales</field>
        <field name="res_model">justech.fiscal.feature.flag</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
