<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_vendor_bill_po" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.vendor.bill.po</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']" position="inside">
                <block title="Control de Facturas de Proveedor" name="vendor_bill_po_setting">
                    <setting string="Exigir Orden de Compra en facturas de proveedor"
                             help="Desactivado / Advertencia / Bloqueo. No afecta borradores.">
                        <field name="vendor_bill_po_policy"/>
                    </setting>
                    <setting string="Control estricto de aprobación"
                             help="Sin OC válida (salvo regla) → Pendiente de Validación. Bloquea post, pago, Tesorería y retenciones.">
                        <field name="vendor_bill_strict_approval"/>
                    </setting>
                    <setting string="Vigencia del control (hacia adelante)"
                             help="Aplica solo a facturas creadas desde esta fecha/hora. Históricos conservan flujo original.">
                        <field name="vendor_bill_approval_effective_from"/>
                    </setting>
                    <setting string="Permitir autoaprobación"
                             help="Si está desactivado, solo Administrador de Contabilidad / sistema pueden autoaprobar.">
                        <field name="vendor_bill_allow_self_approval"/>
                    </setting>
                    <setting string="Exigir Tipo de costos y gastos al validar"
                             help="Obliga el campo fiscal existente. No decide si se requiere OC.">
                        <field name="vendor_bill_require_classification"/>
                    </setting>
                    <setting string="Bloquear pagos si no aprobada">
                        <field name="vendor_bill_block_payment"/>
                    </setting>
                    <setting string="Bloquear Tesorería si no aprobada">
                        <field name="vendor_bill_block_treasury"/>
                    </setting>
                    <setting string="Bloquear retenciones si no aprobada">
                        <field name="vendor_bill_block_withholding"/>
                    </setting>
                    <setting string="Tope Finanzas / Gerencia (moneda compañía)">
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="vendor_bill_amount_finance_limit" class="col-lg-4"/>
                                <field name="vendor_bill_amount_finance_limit" class="col-lg-4"/>
                            </div>
                            <div class="row">
                                <label for="vendor_bill_amount_management_limit" class="col-lg-4"/>
                                <field name="vendor_bill_amount_management_limit" class="col-lg-4"/>
                            </div>
                        </div>
                    </setting>
                    <setting string="Aprobadores predeterminados">
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="vendor_bill_default_finance_approver_id" class="col-lg-4"/>
                                <field name="vendor_bill_default_finance_approver_id" class="col-lg-4"/>
                            </div>
                            <div class="row">
                                <label for="vendor_bill_default_mgmt_approver_id" class="col-lg-4"/>
                                <field name="vendor_bill_default_mgmt_approver_id" class="col-lg-4"/>
                            </div>
                            <div class="row">
                                <label for="vendor_bill_default_substitute_id" class="col-lg-4"/>
                                <field name="vendor_bill_default_substitute_id" class="col-lg-4"/>
                            </div>
                            <div class="row">
                                <label for="vendor_bill_approval_deadline_hours" class="col-lg-4"/>
                                <field name="vendor_bill_approval_deadline_hours" class="col-lg-4"/>
                            </div>
                        </div>
                    </setting>
                    <setting string="Notificación interna al aprobador">
                        <field name="vendor_bill_notify_internal"/>
                    </setting>
                    <setting string="Correo al aprobador"
                              help="En DEV use catchall/mailhog. No bloquea si falta email.">
                        <field name="vendor_bill_notify_email"/>
                    </setting>
                    <setting string="Permitir reasignación">
                        <field name="vendor_bill_allow_reassign"/>
                    </setting>
                    <setting string="Administrador puede decidir cualquier solicitud">
                        <field name="vendor_bill_allow_admin_override"/>
                    </setting>
                    <setting string="Exigir separación de funciones (doble aprobación)">
                        <field name="vendor_bill_require_sod"/>
                    </setting>
                    <setting string="Clasificación automática sin OC"
                              help="Compra directa o Gasto interno al aprobar sin Orden de Compra.">
                        <field name="vendor_bill_no_po_auto_classification"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
