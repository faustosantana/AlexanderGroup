<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Config / OC control -->
    <menuitem id="menu_vendor_bill_po_root"
              name="Control OC Proveedor"
              parent="account.menu_finance_configuration"
              sequence="90"
              groups="account.group_account_manager,justech_vendor_bill_po_control.group_vendor_bill_approver_management,base.group_system"/>
    <menuitem id="menu_po_exception_rules"
              name="Excepciones / Reglas OC"
              parent="menu_vendor_bill_po_root"
              action="action_po_exception_rule"
              sequence="10"/>

    <record id="action_vendor_bills_without_po" model="ir.actions.act_window">
        <field name="name">Facturas proveedor sin OC</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('move_type', '=', 'in_invoice'), ('has_valid_purchase_order', '=', False)]</field>
    </record>
    <record id="action_vendor_bills_draft_without_po" model="ir.actions.act_window">
        <field name="name">Borradores pendientes de OC</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('move_type', '=', 'in_invoice'), ('state', '=', 'draft'), ('has_valid_purchase_order', '=', False)]</field>
    </record>
    <record id="action_vendor_bills_blocked_po" model="ir.actions.act_window">
        <field name="name">Facturas bloqueables sin OC</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('move_type', '=', 'in_invoice'), ('po_control_state', '=', 'blocked')]</field>
    </record>
    <record id="action_vendor_bills_po_exceptions" model="ir.actions.act_window">
        <field name="name">Excepciones OC aprobadas</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('move_type', 'in', ('in_invoice', 'in_refund')), ('po_requirement_exception', '=', True)]</field>
    </record>
    <record id="action_vendor_bills_multi_po" model="ir.actions.act_window">
        <field name="name">Facturas con varias OC</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('move_type', '=', 'in_invoice'), ('related_purchase_order_count', '&gt;', 1)]</field>
    </record>

    <!-- Única bandeja en Contabilidad → Proveedores -->
    <record id="action_vendor_bills_approval_inbox" model="ir.actions.act_window">
        <field name="name">Facturas pendientes de aprobación</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[
            ('move_type', 'in', ('in_invoice', 'in_refund', 'in_receipt')),
            ('state', '!=', 'cancel'),
            ('vendor_bill_approval_state', 'in', ('pending_validation', 'returned', 'rejected', 'approved', 'legacy_approved'))
        ]</field>
        <field name="view_id" ref="view_vendor_bill_approval_inbox_list"/>
        <field name="search_view_id" ref="view_vendor_bill_approval_search"/>
        <field name="context">{'search_default_pending': 1}</field>
    </record>

    <!-- Kept for filters / KPIs under Configuration (not shown as Vendors submenus) -->
    <record id="action_vendor_bills_my_pending_approval" model="ir.actions.act_window">
        <field name="name">Mis facturas pendientes de aprobación</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[
            ('move_type', 'in', ('in_invoice', 'in_refund', 'in_receipt')),
            ('state', '!=', 'cancel'),
            ('vendor_bill_approval_state', '=', 'pending_validation'),
            ('vendor_bill_approver_id', '=', uid)
        ]</field>
        <field name="view_id" ref="view_vendor_bill_approval_inbox_list"/>
        <field name="search_view_id" ref="view_vendor_bill_approval_search"/>
        <field name="context">{'search_default_my_pending': 1}</field>
    </record>
    <record id="action_vendor_bills_pending_validation" model="ir.actions.act_window">
        <field name="name">Pendientes de Validación</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('move_type', 'in', ('in_invoice', 'in_refund', 'in_receipt')), ('vendor_bill_approval_state', '=', 'pending_validation')]</field>
        <field name="view_id" ref="view_vendor_bill_approval_inbox_list"/>
    </record>
    <record id="action_vendor_bills_pending_finance" model="ir.actions.act_window">
        <field name="name">Pendientes Finanzas</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('vendor_bill_approval_state', '=', 'pending_validation'), ('vendor_bill_approval_level_required', 'in', ('finance', 'dual')), ('vendor_bill_finance_approved_by', '=', False)]</field>
        <field name="view_id" ref="view_vendor_bill_approval_inbox_list"/>
    </record>
    <record id="action_vendor_bills_pending_management" model="ir.actions.act_window">
        <field name="name">Pendientes Gerencia</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('vendor_bill_approval_state', '=', 'pending_validation'), '|', ('vendor_bill_approval_level_required', '=', 'management'), '&amp;', ('vendor_bill_approval_level_required', '=', 'dual'), ('vendor_bill_finance_approved_by', '!=', False)]</field>
        <field name="view_id" ref="view_vendor_bill_approval_inbox_list"/>
    </record>
    <record id="action_vendor_bills_overdue_approval" model="ir.actions.act_window">
        <field name="name">Aprobaciones vencidas</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('vendor_bill_approval_state', '=', 'pending_validation'), ('vendor_bill_approval_overdue', '=', True)]</field>
        <field name="view_id" ref="view_vendor_bill_approval_inbox_list"/>
        <field name="search_view_id" ref="view_vendor_bill_approval_search"/>
        <field name="context">{'search_default_overdue': 1}</field>
    </record>
    <record id="action_vendor_bills_returned" model="ir.actions.act_window">
        <field name="name">Facturas devueltas</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('vendor_bill_approval_state', '=', 'returned')]</field>
        <field name="view_id" ref="view_vendor_bill_approval_inbox_list"/>
    </record>
    <record id="action_vendor_bills_reassigned" model="ir.actions.act_window">
        <field name="name">Reasignadas</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('vendor_bill_reassign_count', '&gt;', 0)]</field>
        <field name="view_id" ref="view_vendor_bill_approval_inbox_list"/>
    </record>
    <record id="action_vendor_bills_approved_payable" model="ir.actions.act_window">
        <field name="name">Cuentas por Pagar Aprobadas</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('move_type', 'in', ('in_invoice', 'in_refund')), ('vendor_bill_approval_state', 'in', ('approved', 'legacy_approved')), ('state', '=', 'posted')]</field>
        <field name="view_id" ref="view_vendor_bill_po_control_list"/>
    </record>

    <!-- Contabilidad → Proveedores: solo una bandeja -->
    <menuitem id="menu_vendors_approval_inbox"
              name="Facturas pendientes de aprobación"
              parent="account.menu_finance_payables"
              action="action_vendor_bills_approval_inbox"
              sequence="25"
              groups="justech_vendor_bill_po_control.group_vendor_bill_approver,justech_vendor_bill_po_control.group_vendor_bill_approver_finance,justech_vendor_bill_po_control.group_vendor_bill_approver_management,account.group_account_manager,base.group_system"/>

    <!-- Menús obsoletos: desactivados (XMLIDs conservados) -->
    <menuitem id="menu_vendors_my_approvals"
              name="Mis facturas pendientes de aprobación"
              parent="account.menu_finance_payables"
              action="action_vendor_bills_my_pending_approval"
              sequence="26"
              active="False"
              groups="base.group_no_one"/>
    <menuitem id="menu_vendors_approved_to_post"
              name="Aprobadas pendientes de contabilizar"
              parent="account.menu_finance_payables"
              action="action_vendor_bills_approved_payable"
              sequence="27"
              active="False"
              groups="base.group_no_one"/>

    <!-- Indicadores under Configuration (restricted) -->
    <menuitem id="menu_vendor_bill_po_dashboard"
              name="Indicadores OC"
              parent="menu_vendor_bill_po_root"
              sequence="20"/>
    <menuitem id="menu_vb_without_po" name="Sin OC" parent="menu_vendor_bill_po_dashboard" action="action_vendor_bills_without_po" sequence="1"/>
    <menuitem id="menu_vb_draft_po" name="Borradores sin OC" parent="menu_vendor_bill_po_dashboard" action="action_vendor_bills_draft_without_po" sequence="2"/>
    <menuitem id="menu_vb_blocked_po" name="Bloqueables" parent="menu_vendor_bill_po_dashboard" action="action_vendor_bills_blocked_po" sequence="3"/>
    <menuitem id="menu_vb_exc_po" name="Excepciones" parent="menu_vendor_bill_po_dashboard" action="action_vendor_bills_po_exceptions" sequence="4"/>
    <menuitem id="menu_vb_multi_po" name="Varias OC" parent="menu_vendor_bill_po_dashboard" action="action_vendor_bills_multi_po" sequence="5"/>
    <menuitem id="menu_vb_pending_validation" name="Pendientes de Validación" parent="menu_vendor_bill_po_dashboard" action="action_vendor_bills_pending_validation" sequence="6"/>
    <menuitem id="menu_vb_pending_finance" name="Pendientes Finanzas" parent="menu_vendor_bill_po_dashboard" action="action_vendor_bills_pending_finance" sequence="7"/>
    <menuitem id="menu_vb_pending_mgmt" name="Pendientes Gerencia" parent="menu_vendor_bill_po_dashboard" action="action_vendor_bills_pending_management" sequence="8"/>
    <menuitem id="menu_vb_overdue" name="Vencidas" parent="menu_vendor_bill_po_dashboard" action="action_vendor_bills_overdue_approval" sequence="9"/>
    <menuitem id="menu_vb_returned" name="Devueltas" parent="menu_vendor_bill_po_dashboard" action="action_vendor_bills_returned" sequence="10"/>
    <menuitem id="menu_vb_reassigned" name="Reasignadas" parent="menu_vendor_bill_po_dashboard" action="action_vendor_bills_reassigned" sequence="11"/>
    <menuitem id="menu_vb_approved_payable" name="CxP Aprobadas" parent="menu_vendor_bill_po_dashboard" action="action_vendor_bills_approved_payable" sequence="12"/>
</odoo>
