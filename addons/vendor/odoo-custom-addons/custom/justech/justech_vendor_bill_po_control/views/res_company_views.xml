<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_company_form_vendor_bill_po" model="ir.ui.view">
        <field name="name">res.company.form.vendor.bill.po</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Facturas de Proveedor" name="vendor_bill_po">
                    <group>
                        <field name="vendor_bill_po_policy"/>
                        <field name="vendor_bill_strict_approval"/>
                        <field name="vendor_bill_approval_effective_from"/>
                        <field name="vendor_bill_allow_self_approval"/>
                        <field name="vendor_bill_require_classification"/>
                        <field name="vendor_bill_block_payment"/>
                        <field name="vendor_bill_block_treasury"/>
                        <field name="vendor_bill_block_withholding"/>
                        <field name="vendor_bill_amount_finance_limit"/>
                        <field name="vendor_bill_amount_management_limit"/>
                        <field name="vendor_bill_default_finance_approver_id"/>
                        <field name="vendor_bill_default_mgmt_approver_id"/>
                        <field name="vendor_bill_default_substitute_id"/>
                        <field name="vendor_bill_approval_deadline_hours"/>
                        <field name="vendor_bill_notify_internal"/>
                        <field name="vendor_bill_notify_email"/>
                        <field name="vendor_bill_allow_reassign"/>
                        <field name="vendor_bill_allow_admin_override"/>
                        <field name="vendor_bill_require_sod"/>
                        <field name="vendor_bill_no_po_auto_classification"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
