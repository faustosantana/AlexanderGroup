<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_vendor_bill_approval_request_wizard_form" model="ir.ui.view">
        <field name="name">vendor.bill.approval.request.wizard.form</field>
        <field name="model">vendor.bill.approval.request.wizard</field>
        <field name="arch" type="xml">
            <form string="Enviar a aprobación">
                <group>
                    <group string="Factura">
                        <field name="move_id" string="Factura"/>
                        <field name="company_id" string="Empresa"/>
                        <field name="partner_id" string="Proveedor"/>
                        <field name="amount_total" string="Total"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="expense_type_id"/>
                        <field name="related_purchase_order_ids" widget="many2many_tags"/>
                        <field name="has_valid_purchase_order" invisible="1"/>
                        <field name="approval_level_required" string="Nivel requerido"/>
                        <field name="show_dual_approvers" invisible="1"/>
                    </group>
                    <group string="Justificación">
                        <field name="approver_id"
                                 string="Aprobador"
                                 required="1"
                                 invisible="show_dual_approvers"
                                 options="{'no_create': True, 'no_open': True}"/>
                        <field name="finance_approver_id"
                                 invisible="not show_dual_approvers"
                                 required="show_dual_approvers"
                                 options="{'no_create': True, 'no_open': True}"/>
                        <field name="management_approver_id"
                                 invisible="not show_dual_approvers"
                                 required="show_dual_approvers"
                                 options="{'no_create': True, 'no_open': True}"/>
                        <field name="po_missing_reason"
                                 required="1"
                                 placeholder="Explique por qué esta factura no tiene Orden de Compra..."/>
                        <field name="purchase_justification"
                                 placeholder="Describa el gasto o compra (opcional)"/>
                        <field name="additional_comment"/>
                        <field name="attachment_ids" widget="many2many_binary"/>
                    </group>
                </group>
                <footer>
                    <button name="action_submit" type="object" string="Enviar a aprobación" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_vendor_bill_approval_request_wizard" model="ir.actions.act_window">
        <field name="name">Enviar a aprobación</field>
        <field name="res_model">vendor.bill.approval.request.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_vendor_bill_approval_decision_wizard_form" model="ir.ui.view">
        <field name="name">vendor.bill.approval.decision.wizard.form</field>
        <field name="model">vendor.bill.approval.decision.wizard</field>
        <field name="arch" type="xml">
            <form string="Decisión de aprobación">
                <group>
                    <field name="move_id" string="Factura"/>
                    <field name="decision" string="Decisión"/>
                    <field name="comment"
                             placeholder="Motivo o comentario..."
                             required="decision in ('reject', 'return')"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Confirmar" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_vendor_bill_approval_reassign_wizard_form" model="ir.ui.view">
        <field name="name">vendor.bill.approval.reassign.wizard.form</field>
        <field name="model">vendor.bill.approval.reassign.wizard</field>
        <field name="arch" type="xml">
            <form string="Reasignar aprobación">
                <group>
                    <field name="move_id" string="Factura"/>
                    <field name="current_approver_id"/>
                    <field name="new_approver_id" options="{'no_create': True}"/>
                    <field name="reason" placeholder="Indique el motivo de la reasignación..."/>
                </group>
                <footer>
                    <button name="action_reassign" type="object" string="Reasignar" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Readonly consultation form for approval history on the bill -->
    <record id="view_move_form_vendor_bill_approval_consult" model="ir.ui.view">
        <field name="name">account.move.form.vendor.bill.approval.consult</field>
        <field name="model">account.move</field>
        <field name="priority">999</field>
        <field name="arch" type="xml">
            <form string="Aprobación" create="0" edit="0" delete="0">
                <sheet>
                    <group string="Estado">
                        <field name="vendor_bill_approval_state" readonly="1"/>
                        <field name="has_valid_purchase_order" readonly="1"/>
                        <field name="vendor_bill_approved_without_po" readonly="1"/>
                        <field name="vendor_bill_approval_level_required" readonly="1"/>
                        <field name="vendor_bill_approver_id" readonly="1"/>
                        <field name="vendor_bill_approval_deadline" readonly="1"/>
                    </group>
                    <group string="Solicitud">
                        <field name="po_missing_reason" readonly="1"
                                 string="Motivo de no tener Orden de Compra"/>
                        <field name="vendor_bill_approval_notes" readonly="1"/>
                        <field name="vendor_bill_submitted_by" readonly="1" string="Solicitado por"/>
                        <field name="vendor_bill_submitted_at" readonly="1" string="Fecha de solicitud"/>
                        <field name="vendor_bill_finance_approver_id" readonly="1"/>
                        <field name="vendor_bill_mgmt_approver_id" readonly="1"/>
                        <field name="vendor_bill_reassign_count" readonly="1"/>
                        <field name="vendor_bill_reassign_reason" readonly="1"/>
                    </group>
                    <group string="Decisión">
                        <field name="vendor_bill_approved_by" readonly="1"/>
                        <field name="vendor_bill_approved_at" readonly="1"/>
                        <field name="vendor_bill_finance_approved_by" readonly="1"/>
                        <field name="vendor_bill_mgmt_approved_by" readonly="1"/>
                        <field name="vendor_bill_reject_reason" readonly="1"/>
                        <field name="vendor_bill_return_reason" readonly="1"/>
                    </group>
                    <group string="Órdenes de Compra">
                        <field name="related_purchase_order_ids" widget="many2many_tags" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
