<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_vendor_bill_control">
        <field name="name">Control Facturas Proveedor</field>
        <field name="sequence">45</field>
    </record>

    <record id="group_vendor_bill_approver" model="res.groups">
        <field name="name">Aprobador de Facturas de Proveedor</field>
        <field name="sequence">5</field>
        <field name="privilege_id" ref="res_groups_privilege_vendor_bill_control"/>
        <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
        <field name="comment">Grupo técnico de aprobadores autorizados para facturas sin OC. El administrador puede añadir o retirar usuarios.</field>
    </record>

    <record id="group_vendor_bill_approver_finance" model="res.groups">
        <field name="name">Aprobador Finanzas</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_vendor_bill_control"/>
        <field name="implied_ids" eval="[(4, ref('group_vendor_bill_approver'))]"/>
        <field name="comment">Puede aprobar/rechazar facturas proveedor pendientes (nivel Finanzas).</field>
    </record>

    <record id="group_vendor_bill_approver_management" model="res.groups">
        <field name="name">Aprobador Gerencia</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_vendor_bill_control"/>
        <field name="implied_ids" eval="[(4, ref('group_vendor_bill_approver_finance'))]"/>
        <field name="comment">Puede aprobar excepciones y montos de Gerencia / doble aprobación.</field>
    </record>

    <record id="group_vendor_bill_reassign" model="res.groups">
        <field name="name">Reasignar aprobaciones de facturas</field>
        <field name="sequence">25</field>
        <field name="privilege_id" ref="res_groups_privilege_vendor_bill_control"/>
        <field name="implied_ids" eval="[(4, ref('group_vendor_bill_approver_finance'))]"/>
        <field name="comment">Puede reasignar solicitudes de aprobación a otro aprobador autorizado.</field>
    </record>

    <record id="group_vendor_bill_auditor" model="res.groups">
        <field name="name">Auditor</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_vendor_bill_control"/>
        <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
        <field name="comment">Consulta completa de historial y reportes sin modificar.</field>
    </record>
</odoo>
