<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_users_form_justech_admin_center" model="ir.ui.view">
        <field name="name">res.users.form.justech.admin.center</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='access_rights']" position="inside">
                <group string="Permisos Justech" name="justech_admin_center_perms"
                       groups="base.group_system,justech_admin_center.group_justech_admin_center_manager">
                    <group string="Fiscal">
                        <field name="justech_fiscal_role" widget="radio"/>
                        <field name="justech_fiscal_role_explanation" readonly="1"/>
                    </group>
                    <group string="e-CF">
                        <field name="justech_ecf_role" widget="radio"/>
                        <field name="justech_ecf_role_explanation" readonly="1"/>
                    </group>
                    <group string="Finanzas">
                        <field name="justech_finance_role" widget="radio"/>
                        <field name="justech_finance_role_explanation" readonly="1"/>
                    </group>
                    <group string="Garantías">
                        <field name="justech_warranty_role" widget="radio"/>
                        <field name="justech_warranty_role_explanation" readonly="1"/>
                    </group>
                    <group string="Administración Justech">
                        <field name="justech_admin_center_role" widget="radio"/>
                        <field name="justech_role_explanation" readonly="1"/>
                        <field name="justech_cap_admin_console"/>
                        <field name="justech_cap_install_modules"/>
                    </group>
                    <p class="text-muted">
                        Los roles usan los grupos reales de Odoo. No se crean permisos paralelos.
                        El Administrador del Sistema hereda Administrador Justech y Administrador e-CF.
                    </p>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Evitar duplicar el bloque fiscal: se unifica en Permisos Justech -->
    <record id="view_users_form_justech_fiscal_perms_hide_duplicate" model="ir.ui.view">
        <field name="name">res.users.form.justech.fiscal.perms.hide</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="justech_fiscal_admin.view_users_form_justech_fiscal_perms"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='justech_fiscal_perms']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>
