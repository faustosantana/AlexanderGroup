<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_justech_admin_operation_list" model="ir.ui.view">
        <field name="name">justech.admin.operation.list</field>
        <field name="model">justech.admin.operation</field>
        <field name="arch" type="xml">
            <list create="0">
                <field name="name"/>
                <field name="operation_type"/>
                <field name="module_id"/>
                <field name="state"/>
                <field name="executed_by"/>
                <field name="started_at"/>
                <field name="finished_at"/>
            </list>
        </field>
    </record>
    <record id="view_justech_admin_operation_form" model="ir.ui.view">
        <field name="name">justech.admin.operation.form</field>
        <field name="model">justech.admin.operation</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="operation_type"/>
                        <field name="module_id"/>
                        <field name="state"/>
                        <field name="company_ids" widget="many2many_tags"/>
                        <field name="backup_path"/>
                        <field name="preview_before"/>
                        <field name="preview_after"/>
                        <field name="risks"/>
                        <field name="rollback_notes"/>
                        <field name="result_message"/>
                        <field name="error_message"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_justech_admin_operation" model="ir.actions.act_window">
        <field name="name">Operaciones</field>
        <field name="res_model">justech.admin.operation</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
