<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_justech_admin_health_kanban" model="ir.ui.view">
        <field name="name">justech.admin.health.finding.kanban</field>
        <field name="model">justech.admin.health.finding</field>
        <field name="arch" type="xml">
            <kanban class="o_jac_module_kanban o_jac_module_grid" create="0" records_draggable="0">
                <field name="name"/>
                <field name="severity"/>
                <field name="state"/>
                <field name="company_id"/>
                <field name="product_id"/>
                <field name="module_id"/>
                <field name="impact"/>
                <field name="recommendation"/>
                <field name="action_label"/>
                <field name="responsible_hint"/>
                <field name="detected_at"/>
                <templates>
                    <t t-name="card">
                        <div class="o_jac_card o_jac_pending_card"
                             t-attf-class="o_jac_tone_#{record.severity.raw_value == 'warning' ? 'yellow' : (record.severity.raw_value == 'info' ? 'blue' : 'red')}">
                            <div class="o_jac_card_head">
                                <strong><field name="name"/></strong>
                                <span class="o_jac_estado_pill"><field name="severity"/></span>
                            </div>
                            <div class="o_jac_card_meta">
                                <span><field name="company_id"/></span>
                                <span><field name="product_id"/></span>
                                <span><field name="module_id"/></span>
                            </div>
                            <div class="o_jac_card_body">
                                <field name="impact"/>
                            </div>
                            <div class="o_jac_card_meta">
                                <span><field name="recommendation"/></span>
                            </div>
                            <div class="o_jac_card_meta">
                                <span><field name="responsible_hint"/></span>
                                <span><field name="detected_at"/></span>
                                <span><field name="state"/></span>
                            </div>
                            <div class="o_jac_card_actions">
                                <button name="action_resolve" type="object"
                                        class="btn btn-primary btn-sm">
                                    <field name="action_label"/>
                                </button>
                                <button name="action_open_config" type="object"
                                        class="btn btn-link btn-sm"
                                        title="Abrir configuración">
                                    Abrir configuración
                                </button>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_justech_admin_health_list" model="ir.ui.view">
        <field name="name">justech.admin.health.finding.list</field>
        <field name="model">justech.admin.health.finding</field>
        <field name="arch" type="xml">
            <list create="0" decoration-danger="severity in ('error','critical')"
                  decoration-warning="severity == 'warning'">
                <field name="severity" widget="badge"/>
                <field name="name"/>
                <field name="company_id"/>
                <field name="product_id"/>
                <field name="module_id"/>
                <field name="impact"/>
                <field name="state" widget="badge"/>
                <field name="detected_at"/>
                <field name="owner_id"/>
                <button name="action_resolve" type="object" string="Resolver" class="btn-link"/>
                <button name="action_open_config" type="object" string="Configurar" class="btn-link"/>
                <button name="action_mark_resolved" type="object" string="Resuelto" icon="fa-check"/>
            </list>
        </field>
    </record>

    <record id="view_justech_admin_health_form" model="ir.ui.view">
        <field name="name">justech.admin.health.finding.form</field>
        <field name="model">justech.admin.health.finding</field>
        <field name="arch" type="xml">
            <form class="o_justech_admin_center" create="0" delete="0">
                <header>
                    <button name="action_resolve" type="object" string="Resolver ahora" class="btn-primary"
                            title="Abre la pantalla correcta para corregir este pendiente"/>
                    <button name="action_open_config" type="object" string="Abrir configuración" class="btn-secondary"/>
                    <button name="action_mark_in_progress" type="object" string="En proceso" class="btn-secondary"
                            invisible="state != 'open'"/>
                    <button name="action_mark_resolved" type="object" string="Marcar resuelto" class="btn-secondary"/>
                    <button name="action_mark_ignored" type="object" string="Ignorar" class="btn-secondary"
                            invisible="state == 'ignored'"/>
                    <field name="state" widget="statusbar"
                             statusbar_visible="open,in_progress,resolved,ignored"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Contexto">
                            <field name="company_id"/>
                            <field name="product_id"/>
                            <field name="module_id"/>
                            <field name="severity"/>
                            <field name="detected_at"/>
                            <field name="owner_id"/>
                            <field name="responsible_hint"/>
                        </group>
                        <group string="Acción">
                            <field name="impact"/>
                            <field name="recommendation"/>
                            <field name="action_label"/>
                            <field name="ignore_reason" invisible="state != 'ignored' and not ignore_reason"/>
                        </group>
                    </group>
                    <group string="Detalle">
                        <field name="detail" nolabel="1" colspan="2"/>
                    </group>
                    <group string="Información técnica" groups="base.group_system">
                        <field name="code"/>
                        <field name="res_model"/>
                        <field name="res_id"/>
                        <field name="resolve_xmlid"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_justech_admin_health_search" model="ir.ui.view">
        <field name="name">justech.admin.health.finding.search</field>
        <field name="model">justech.admin.health.finding</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="company_id"/>
                <field name="product_id"/>
                <field name="module_id"/>
                <field name="owner_id"/>
                <filter name="open" string="Pendiente / En proceso"
                        domain="[('state', 'in', ['open', 'in_progress'])]"/>
                <filter name="pending" string="Pendiente" domain="[('state', '=', 'open')]"/>
                <filter name="in_progress" string="En proceso" domain="[('state', '=', 'in_progress')]"/>
                <filter name="resolved" string="Resuelto" domain="[('state', '=', 'resolved')]"/>
                <filter name="ignored" string="Ignorado" domain="[('state', '=', 'ignored')]"/>
                <separator/>
                <filter name="sev_error" string="Errores" domain="[('severity', 'in', ['error', 'critical'])]"/>
                <filter name="sev_warn" string="Advertencias" domain="[('severity', '=', 'warning')]"/>
                <group>
                    <filter name="group_company" string="Empresa" context="{'group_by': 'company_id'}"/>
                    <filter name="group_product" string="Producto" context="{'group_by': 'product_id'}"/>
                    <filter name="group_severity" string="Severidad" context="{'group_by': 'severity'}"/>
                    <filter name="group_state" string="Estado" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_justech_admin_health" model="ir.actions.act_window">
        <field name="name">Centro de pendientes</field>
        <field name="res_model">justech.admin.health.finding</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('severity', 'in', ['warning', 'error', 'critical'])]</field>
        <field name="context">{'search_default_open': 1}</field>
    </record>
</odoo>
