<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_justech_admin_padron_hub_form" model="ir.ui.view">
        <field name="name">justech.admin.padron.hub.form</field>
        <field name="model">justech.admin.padron.hub</field>
        <field name="arch" type="xml">
            <form class="o_justech_admin_center o_jac_hub_form" create="0" delete="0">
                <header>
                    <button name="action_open_import" type="object" string="Importar" class="btn-primary"/>
                    <button name="action_update_now" type="object" string="Actualizar ahora" class="btn-secondary"/>
                    <button name="action_open_cron" type="object" string="Configurar cron 45 días" class="btn-secondary"/>
                    <button name="action_open_history" type="object" string="Historial" class="btn-secondary"/>
                    <button name="action_verify" type="object" string="Verificar integridad" class="btn-secondary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Alcance">
                            <field name="scope_note"/>
                            <field name="company_count"/>
                        </group>
                        <group string="Estado del padrón">
                            <field name="record_count"/>
                            <field name="last_success_at"/>
                            <field name="next_run_at"/>
                            <field name="frequency_days"/>
                            <field name="cron_active"/>
                        </group>
                    </group>
                    <group string="Fuente e integridad">
                        <field name="official_url"/>
                        <field name="last_status"/>
                        <field name="last_message"/>
                    </group>
                    <div class="o_jac_action_row">
                        <button name="action_open_records" type="object" class="btn btn-secondary" string="Ver registros"/>
                        <button name="action_open_history" type="object" class="btn btn-secondary" string="Historial de importaciones"/>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_justech_admin_padron_hub" model="ir.actions.server">
        <field name="name">Padrón DGII</field>
        <field name="model_id" ref="model_justech_admin_padron_hub"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open()</field>
    </record>

    <record id="view_justech_admin_fiscal_hub_form" model="ir.ui.view">
        <field name="name">justech.admin.fiscal.hub.form</field>
        <field name="model">justech.admin.fiscal.hub</field>
        <field name="arch" type="xml">
            <form class="o_justech_admin_center o_jac_hub_form" create="0" delete="0">
                <header>
                    <button name="action_open_health" type="object" string="Estado del sistema" class="btn-secondary"/>
                    <button name="action_open_companies" type="object" string="Empresas" class="btn-secondary"/>
                    <button name="action_open_users" type="object" string="Usuarios y permisos" class="btn-secondary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <field name="summary_note" readonly="1" string="Resumen"/>
                        <field name="status_label" readonly="1"/>
                        <field name="open_alert_count" readonly="1"/>
                    </group>
                    <separator string="Capacidades fiscales"/>
                    <div class="o_jac_action_row">
                        <button name="action_open_padron" type="object" class="btn btn-primary" string="Padrón DGII"/>
                        <button name="action_open_ncf" type="object" class="btn btn-secondary" string="Motor Fiscal NCF"/>
                        <button name="action_open_reports" type="object" class="btn btn-secondary" string="Reportes DGII"/>
                        <button name="action_open_ecf" type="object" class="btn btn-secondary" string="Justech e-CF"/>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_justech_admin_fiscal_hub" model="ir.actions.server">
        <field name="name">Centro Fiscal</field>
        <field name="model_id" ref="model_justech_admin_fiscal_hub"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open()</field>
    </record>

    <record id="view_justech_admin_treasury_hub_form" model="ir.ui.view">
        <field name="name">justech.admin.treasury.hub.form</field>
        <field name="model">justech.admin.treasury.hub</field>
        <field name="arch" type="xml">
            <form class="o_justech_admin_center o_jac_hub_form" create="0" delete="0">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <field name="summary_note" readonly="1" string="Resumen"/>
                    </group>
                    <separator string="Funciones"/>
                    <div class="o_jac_action_row">
                        <button name="action_open_customer_payments" type="object" class="btn btn-secondary" string="Cobros"/>
                        <button name="action_open_vendor_payments" type="object" class="btn btn-secondary" string="Pagos"/>
                        <button name="action_open_register_customer" type="object" class="btn btn-secondary" string="Registrar cobro"/>
                        <button name="action_open_open_customer" type="object" class="btn btn-secondary" string="Pagos abiertos clientes"/>
                        <button name="action_open_open_vendor" type="object" class="btn btn-secondary" string="Pagos abiertos proveedores"/>
                        <button name="action_open_reconciliation" type="object" class="btn btn-primary" string="Conciliación bancaria"/>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_justech_admin_treasury_hub" model="ir.actions.server">
        <field name="name">Tesorería</field>
        <field name="model_id" ref="model_justech_admin_treasury_hub"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open()</field>
    </record>

    <record id="view_justech_admin_uat_archive_wizard_form" model="ir.ui.view">
        <field name="name">justech.admin.uat.archive.wizard.form</field>
        <field name="model">justech.admin.uat.archive.wizard</field>
        <field name="arch" type="xml">
            <form string="Archivar usuarios de prueba">
                <group>
                    <field name="user_ids" widget="many2many_tags"/>
                </group>
                <field name="preview_html" nolabel="1" widget="html"/>
                <group>
                    <field name="confirmation"/>
                </group>
                <footer>
                    <button name="action_archive" type="object" string="Archivar" class="btn-primary"
                            groups="justech_admin_center.group_justech_admin_center_manager"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
