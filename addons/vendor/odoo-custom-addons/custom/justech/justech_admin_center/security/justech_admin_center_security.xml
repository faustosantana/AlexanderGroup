<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_justech_admin_center" model="res.groups.privilege">
        <field name="name">Administración Justech</field>
        <field name="sequence">36</field>
        <field name="category_id" ref="base.module_category_administration"/>
    </record>

    <record id="group_justech_admin_center_user" model="res.groups">
        <field name="name">Usuario consola Justech</field>
        <field name="privilege_id" ref="res_groups_privilege_justech_admin_center"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Puede ver la consola Administración Justech en modo lectura.</field>
    </record>

    <record id="group_justech_admin_center_manager" model="res.groups">
        <field name="name">Administrador Justech</field>
        <field name="privilege_id" ref="res_groups_privilege_justech_admin_center"/>
        <field name="implied_ids" eval="[(4, ref('group_justech_admin_center_user'))]"/>
        <field name="comment">Puede instalar, activar, desactivar y administrar roles Justech.</field>
    </record>

    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_justech_admin_center_manager'))]"/>
    </record>
</odoo>
