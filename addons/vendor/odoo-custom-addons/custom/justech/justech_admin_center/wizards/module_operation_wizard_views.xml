<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_jac_module_operation_wizard_form" model="ir.ui.view">
        <field name="name">justech.admin.module.operation.wizard.form</field>
        <field name="model">justech.admin.module.operation.wizard</field>
        <field name="arch" type="xml">
            <form string="Confirmar operación">
                <sheet>
                    <div class="alert alert-warning" role="alert">
                        Revise el antes/después, dependencias y riesgos antes de aplicar. Esta acción no es silenciosa.
                    </div>
                    <group>
                        <field name="module_id" readonly="1"/>
                        <field name="operation_type" readonly="1"/>
                        <field name="company_ids" widget="many2many_tags"/>
                        <field name="estimated_minutes"/>
                    </group>
                    <group string="Antes">
                        <field name="preview_before" nolabel="1"/>
                    </group>
                    <group string="Después">
                        <field name="preview_after" nolabel="1"/>
                    </group>
                    <group string="Dependencias">
                        <field name="dependencies" nolabel="1"/>
                    </group>
                    <group string="Riesgos">
                        <field name="risks" nolabel="1"/>
                    </group>
                    <group string="Rollback">
                        <field name="rollback_notes" nolabel="1"/>
                    </group>
                    <group>
                        <field name="confirmation"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_apply" type="object" string="Aplicar" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
