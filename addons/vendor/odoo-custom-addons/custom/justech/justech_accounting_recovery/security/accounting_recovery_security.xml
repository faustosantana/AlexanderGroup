<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
      Privilege dedicado (UI Odoo 19): bajo la categoría Contabilidad, como
      selector independiente «No / Recuperación Contable».

      NO reutilizar account.res_groups_privilege_accounting: ese privilege
      agrupa Facturación/Administrador en un selection excluyente; meter el
      SoD ahí impediría combinar Facturación + Recuperación Contable.

      XMLID del grupo (estable): justech_accounting_recovery.group_accounting_recovery
      Sin implied_ids. Sin user_ids automáticos.
    -->
    <record id="res_groups_privilege_accounting_recovery" model="res.groups.privilege">
        <field name="name">Recuperación Contable</field>
        <field name="category_id" ref="base.module_category_accounting"/>
        <field name="sequence">92</field>
        <field name="placeholder">No</field>
        <field name="description">Autoriza restablecer, cancelar, revertir y eliminar asientos/pagos (SoD).</field>
    </record>

    <record id="group_accounting_recovery" model="res.groups">
        <field name="name">Recuperación Contable</field>
        <field name="comment">Usuarios autorizados para ejecutar acciones de recuperación y reversión de movimientos contables.</field>
        <field name="privilege_id" ref="res_groups_privilege_accounting_recovery"/>
        <field name="sequence">10</field>
    </record>
</odoo>
