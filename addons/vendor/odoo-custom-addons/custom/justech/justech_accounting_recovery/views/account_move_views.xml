<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
      Restringe visibilidad de botones de recuperación al grupo SoD.
      La denegación real está en los métodos Python (también vía RPC/shell).
    -->
    <record id="view_move_form_accounting_recovery" model="ir.ui.view">
        <field name="name">account.move.form.accounting.recovery</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='button_draft']" position="attributes">
                <attribute name="groups">justech_accounting_recovery.group_accounting_recovery</attribute>
            </xpath>
            <xpath expr="//button[@name='button_cancel'][1]" position="attributes">
                <attribute name="groups">justech_accounting_recovery.group_accounting_recovery</attribute>
            </xpath>
            <xpath expr="//button[@name='button_cancel'][2]" position="attributes">
                <attribute name="groups">justech_accounting_recovery.group_accounting_recovery</attribute>
            </xpath>
            <xpath expr="//button[@name='button_request_cancel']" position="attributes">
                <attribute name="groups">justech_accounting_recovery.group_accounting_recovery</attribute>
            </xpath>
            <xpath expr="//button[@name='action_reverse']" position="attributes">
                <attribute name="groups">justech_accounting_recovery.group_accounting_recovery</attribute>
            </xpath>
            <!-- Reverse Entry: action window (data-hotkey z); no @string selector in Odoo 19 -->
            <xpath expr="//button[@name='action_reverse']/preceding-sibling::button[@type='action'][1]" position="attributes">
                <attribute name="groups">justech_accounting_recovery.group_accounting_recovery</attribute>
            </xpath>
        </field>
    </record>
</odoo>
