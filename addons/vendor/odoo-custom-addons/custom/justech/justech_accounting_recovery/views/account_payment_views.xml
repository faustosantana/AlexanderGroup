<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_form_accounting_recovery" model="ir.ui.view">
        <field name="name">account.payment.form.accounting.recovery</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_draft']" position="attributes">
                <attribute name="groups">justech_accounting_recovery.group_accounting_recovery</attribute>
            </xpath>
            <xpath expr="//button[@name='action_cancel']" position="attributes">
                <attribute name="groups">justech_accounting_recovery.group_accounting_recovery</attribute>
            </xpath>
            <xpath expr="//button[@name='button_request_cancel']" position="attributes">
                <attribute name="groups">justech_accounting_recovery.group_accounting_recovery</attribute>
            </xpath>
        </field>
    </record>
</odoo>
