<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_justech_activation_key_list" model="ir.ui.view">
        <field name="name">justech.activation.key.list</field>
        <field name="model">justech.activation.key</field>
        <field name="arch" type="xml">
            <list>
                <field name="key"/>
                <field name="tier"/>
                <field name="state"/>
                <field name="license_id"/>
                <field name="used_at"/>
            </list>
        </field>
    </record>

    <record id="action_justech_activation_key" model="ir.actions.act_window">
        <field name="name">Activation Keys</field>
        <field name="res_model">justech.activation.key</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
