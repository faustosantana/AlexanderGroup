<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_justech_admin_key_wizard_form" model="ir.ui.view">
        <field name="name">justech.admin.key.wizard.form</field>
        <field name="model">justech.admin.key.wizard</field>
        <field name="arch" type="xml">
            <form string="Clave Administrativa Justech">
                <sheet>
                    <field name="prompt_message" nolabel="1" readonly="1" class="text-muted mb-2"/>
                    <group>
                        <field name="scope" invisible="1"/>
                        <field name="target_action_xmlid" invisible="1"/>
                        <field name="target_method" invisible="1"/>
                        <field name="admin_key" password="True" placeholder="Ingrese Clave Administrativa Justech"/>
                    </group>
                    <p class="text-muted">
                        Esta clave es exclusiva de Justech. No es su contraseña de Odoo.
                    </p>
                </sheet>
                <footer>
                    <button name="action_verify" type="object" string="Validar" class="btn-primary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_justech_admin_key_setup_wizard_form" model="ir.ui.view">
        <field name="name">justech.admin.key.setup.wizard.form</field>
        <field name="model">justech.admin.key.setup.wizard</field>
        <field name="arch" type="xml">
            <form string="Crear Clave Administrativa Justech">
                <sheet>
                    <p class="text-warning">
                        Debe crear una Clave Administrativa Justech antes de continuar.
                        La clave se mostrará solo una vez.
                    </p>
                    <group>
                        <field name="target_action_xmlid" invisible="1"/>
                        <field name="scope" invisible="1"/>
                        <field name="admin_key" password="True"/>
                        <field name="admin_key_confirm" password="True"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_create_key" type="object" string="Crear clave" class="btn-primary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_justech_admin_key_display_wizard_form" model="ir.ui.view">
        <field name="name">justech.admin.key.display.wizard.form</field>
        <field name="model">justech.admin.key.display.wizard</field>
        <field name="arch" type="xml">
            <form string="Clave creada">
                <sheet>
                    <field name="one_time_message" readonly="1"/>
                    <field name="one_time_key" readonly="1"/>
                    <field name="key_fingerprint" readonly="1"/>
                    <field name="target_action_xmlid" invisible="1"/>
                    <field name="scope" invisible="1"/>
                </sheet>
                <footer>
                    <button name="action_continue" type="object" string="Continuar" class="btn-primary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_justech_admin_key_rotate_wizard_form" model="ir.ui.view">
        <field name="name">justech.admin.key.rotate.wizard.form</field>
        <field name="model">justech.admin.key.rotate.wizard</field>
        <field name="arch" type="xml">
            <form string="Rotar Clave Administrativa">
                <sheet>
                    <group>
                        <field name="access_id" invisible="1"/>
                        <field name="current_key" password="True"/>
                        <field name="new_key" password="True"/>
                        <field name="new_key_confirm" password="True"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_rotate" type="object" string="Rotar clave" class="btn-primary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_justech_admin_stepup_wizard_form" model="ir.ui.view">
        <field name="name">justech.admin.stepup.wizard.form</field>
        <field name="model">justech.admin.stepup.wizard</field>
        <field name="arch" type="xml">
            <form string="Confirmar acción crítica">
                <sheet>
                    <p class="text-muted">Esta acción requiere su Clave Administrativa Justech.</p>
                    <group>
                        <field name="res_model" invisible="1"/>
                        <field name="res_id" invisible="1"/>
                        <field name="method_name" invisible="1"/>
                        <field name="critical_action" invisible="1"/>
                        <field name="admin_key" password="True"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm" type="object" string="Confirmar" class="btn-primary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_justech_admin_access_list" model="ir.ui.view">
        <field name="name">justech.admin.access.list</field>
        <field name="model">justech.admin.access</field>
        <field name="arch" type="xml">
            <list>
                <field name="user_id"/>
                <field name="company_id"/>
                <field name="access_level"/>
                <field name="has_key"/>
                <field name="key_fingerprint"/>
                <field name="active"/>
                <field name="last_verified_at"/>
                <field name="failed_attempts"/>
                <field name="locked_until"/>
            </list>
        </field>
    </record>

    <record id="view_justech_admin_access_form" model="ir.ui.view">
        <field name="name">justech.admin.access.form</field>
        <field name="model">justech.admin.access</field>
        <field name="arch" type="xml">
            <form string="Justech Administrative Access">
                <header>
                    <button name="action_open_rotate_wizard" type="object" string="Rotar clave" invisible="not has_key"/>
                    <button name="action_revoke_key" type="object" string="Revocar clave" confirm="Revoca la clave y cierra sesiones."/>
                    <button name="action_revoke_sessions" type="object" string="Revocar sesiones"/>
                    <button name="action_block_access" type="object" string="Bloquear acceso" confirm="Desactiva el acceso administrativo."/>
                </header>
                <sheet>
                    <group>
                        <field name="user_id"/>
                        <field name="company_id"/>
                        <field name="access_level"/>
                        <field name="active"/>
                        <field name="has_key" readonly="1"/>
                        <field name="key_fingerprint" readonly="1"/>
                        <field name="allowed_modules"/>
                        <field name="notes"/>
                    </group>
                    <group string="Security">
                        <field name="last_verified_at" readonly="1"/>
                        <field name="failed_attempts" readonly="1"/>
                        <field name="locked_until" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_justech_admin_access" model="ir.actions.act_window">
        <field name="name">Administrative Access</field>
        <field name="res_model">justech.admin.access</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_justech_admin_access_audit_list" model="ir.ui.view">
        <field name="name">justech.admin.access.audit.list</field>
        <field name="model">justech.admin.access.audit</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false">
                <field name="create_date"/>
                <field name="user_id"/>
                <field name="action"/>
                <field name="scope"/>
                <field name="success"/>
                <field name="ip_address"/>
            </list>
        </field>
    </record>

    <record id="action_justech_admin_access_audit" model="ir.actions.act_window">
        <field name="name">Admin Key Audit</field>
        <field name="res_model">justech.admin.access.audit</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
