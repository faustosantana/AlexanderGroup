        <field name="name">Audit Log</field>
        <field name="model_id" ref="model_justech_admin_access_service"/>
        <field name="state">code</field>
        <field name="code">action = env["justech.admin.access.service"].action_open_license_audit()</field>
    </record>
</odoo>
