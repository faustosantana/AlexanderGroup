<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_justech_module_activation_protected" model="ir.actions.server">
        <field name="name">Module Activation</field>
        <field name="model_id" ref="model_justech_admin_access_service"/>
        <field name="state">code</field>
        <field name="code">action = env["justech.admin.access.service"].action_open_module_activation()</field>
    </record>

    <record id="action_justech_license_protected" model="ir.actions.server">
        <field name="name">Licenses</field>
        <field name="model_id" ref="model_justech_admin_access_service"/>
