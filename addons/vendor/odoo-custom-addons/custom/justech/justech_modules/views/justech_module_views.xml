<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_justech_module_list" model="ir.ui.view">
        <field name="name">justech.module.list</field>
        <field name="model">justech.module</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="version"/>
                <field name="category"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_justech_module_form" model="ir.ui.view">
        <field name="name">justech.module.form</field>
        <field name="model">justech.module</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="name"/>
                        <field name="version"/>
                        <field name="category"/>
                        <field name="license_required"/>
                        <field name="tier_minimum"/>
                        <field name="state"/>
                        <field name="ir_module_id"/>
                    </group>
                    <field name="description"/>
                    <field name="feature_ids"/>
                    <field name="dependency_ids">
                        <list editable="bottom">
                            <field name="depends_on_module_id"/>
                            <field name="dependency_type"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_justech_module" model="ir.actions.act_window">
        <field name="name">Justech Modules</field>
        <field name="res_model">justech.module</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
