<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_justech" model="res.groups.privilege">
        <field name="name">Justech Platform</field>
        <field name="category_id" ref="base.module_category_administration"/>
    </record>

    <record id="group_justech_license_user" model="res.groups">
        <field name="name">Justech License User</field>
        <field name="privilege_id" ref="res_groups_privilege_justech"/>
    </record>

    <record id="group_justech_license_manager" model="res.groups">
        <field name="name">Justech License Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_justech"/>
        <field name="implied_ids" eval="[(4, ref('group_justech_license_user'))]"/>
    </record>

    <record id="group_justech_internal_admin" model="res.groups">
        <field name="name">Justech Internal Admin</field>
        <field name="privilege_id" ref="res_groups_privilege_justech"/>
        <field name="implied_ids" eval="[(4, ref('group_justech_license_manager'))]"/>
    </record>

    <record id="group_justech_support" model="res.groups">
        <field name="name">Justech Support</field>
        <field name="privilege_id" ref="res_groups_privilege_justech"/>
        <field name="implied_ids" eval="[(4, ref('group_justech_license_user'))]"/>
    </record>

    <record id="justech_feature_company_company_rule" model="ir.rule">
        <field name="name">Justech feature company: multi-company</field>
        <field name="model_id" ref="model_justech_feature_company"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="justech_license_company_company_rule" model="ir.rule">
        <field name="name">Justech license company: multi-company</field>
        <field name="model_id" ref="model_justech_license_company"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="justech_license_audit_company_rule" model="ir.rule">
        <field name="name">Justech license audit: multi-company</field>
        <field name="model_id" ref="model_justech_license_audit"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="justech_license_company_scope_rule" model="ir.rule">
        <field name="name">Justech license: company scope (user)</field>
        <field name="model_id" ref="model_justech_license"/>
        <field name="domain_force">[('company_line_ids.company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_justech_license_user'))]"/>
    </record>
</odoo>
