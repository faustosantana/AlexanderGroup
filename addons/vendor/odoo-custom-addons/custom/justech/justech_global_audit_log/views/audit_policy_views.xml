<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_justech_audit_policy_list" model="ir.ui.view">
        <field name="name">justech.audit.policy.list</field>
        <field name="model">justech.audit.policy</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="company_id"/>
                <field name="active"/>
                <field name="audit_create"/>
                <field name="audit_write"/>
                <field name="audit_unlink"/>
                <field name="audit_events"/>
            </list>
        </field>
    </record>

    <record id="view_justech_audit_policy_form" model="ir.ui.view">
        <field name="name">justech.audit.policy.form</field>
        <field name="model">justech.audit.policy</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <field name="active" widget="boolean_button" options="{'terminology': 'active'}"/>
                    </div>
                    <group>
                        <field name="name"/>
                        <field name="company_id"/>
                    </group>
                    <group string="Operaciones">
                        <field name="audit_create"/>
                        <field name="audit_write"/>
                        <field name="audit_unlink"/>
                        <field name="audit_events"/>
                    </group>
                    <group string="Usuarios excluidos">
                        <field name="excluded_user_ids" widget="many2many_tags"/>
                    </group>
                    <group>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_justech_audit_policy" model="ir.actions.act_window">
        <field name="name">Políticas de auditoría</field>
        <field name="res_model">justech.audit.policy</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
