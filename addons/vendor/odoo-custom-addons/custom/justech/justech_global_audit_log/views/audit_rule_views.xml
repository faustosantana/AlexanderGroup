<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_justech_audit_rule_list" model="ir.ui.view">
        <field name="name">justech.audit.rule.list</field>
        <field name="model">justech.audit.rule</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="model_description"/>
                <field name="model_name"/>
                <field name="active"/>
                <field name="audit_create"/>
                <field name="audit_write"/>
                <field name="audit_unlink"/>
            </list>
        </field>
    </record>

    <record id="view_justech_audit_rule_form" model="ir.ui.view">
        <field name="name">justech.audit.rule.form</field>
        <field name="model">justech.audit.rule</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <field name="active" widget="boolean_button" options="{'terminology': 'active'}"/>
                    </div>
                    <group>
                        <field name="name"/>
                        <field name="model_id"/>
                        <field name="model_name" readonly="1"/>
                        <field name="model_description" readonly="1"/>
                    </group>
                    <group string="Operaciones">
                        <field name="audit_create"/>
                        <field name="audit_write"/>
                        <field name="audit_unlink"/>
                    </group>
                    <group string="Alcance">
                        <field name="company_ids" widget="many2many_tags"/>
                        <field name="field_exclude_ids" widget="many2many_tags"/>
                    </group>
                    <group>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_justech_audit_rule_search" model="ir.ui.view">
        <field name="name">justech.audit.rule.search</field>
        <field name="model">justech.audit.rule</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="model_name"/>
                <field name="model_description"/>
                <filter string="Activas" name="filter_active" domain="[('active', '=', True)]"/>
                <filter string="Inactivas" name="filter_inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_justech_audit_rule" model="ir.actions.act_window">
        <field name="name">Reglas de auditoría</field>
        <field name="res_model">justech.audit.rule</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_justech_audit_rule_search"/>
        <field name="context">{'search_default_filter_inactive': 1}</field>
    </record>
</odoo>
