<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_justech_audit_retention_form" model="ir.ui.view">
        <field name="name">justech.audit.retention.form</field>
        <field name="model">justech.audit.retention</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active"/>
                        <field name="retention_days"/>
                        <field name="batch_size"/>
                        <field name="last_run_at" readonly="1"/>
                        <field name="last_purged_count" readonly="1"/>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_justech_audit_retention" model="ir.actions.act_window">
        <field name="name">Retención</field>
        <field name="res_model">justech.audit.retention</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
