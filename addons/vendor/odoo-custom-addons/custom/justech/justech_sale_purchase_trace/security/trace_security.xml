<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_justech_trace_user" model="res.groups">
        <field name="name">Trazabilidad venta-compra: Usuario</field>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    </record>
    <record id="group_justech_trace_purchase" model="res.groups">
        <field name="name">Trazabilidad venta-compra: Compras</field>
        <field name="implied_ids" eval="[(4, ref('purchase.group_purchase_user')), (4, ref('justech_sale_purchase_trace.group_justech_trace_user'))]"/>
    </record>
    <record id="group_justech_trace_manager" model="res.groups">
        <field name="name">Trazabilidad venta-compra: Administrador</field>
        <field name="implied_ids" eval="[(4, ref('justech_sale_purchase_trace.group_justech_trace_purchase'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="rule_qty_assignment_company" model="ir.rule">
        <field name="name">Asignación qty multiempresa</field>
        <field name="model_id" ref="model_justech_purchase_sale_qty_assignment"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
