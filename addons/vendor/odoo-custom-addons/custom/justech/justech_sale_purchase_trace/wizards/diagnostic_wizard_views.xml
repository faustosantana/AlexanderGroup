<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_justech_trace_diagnostic_wizard_form" model="ir.ui.view">
        <field name="name">justech.trace.diagnostic.wizard.form</field>
        <field name="model">justech.trace.diagnostic.wizard</field>
        <field name="arch" type="xml">
            <form string="Diagnóstico trazabilidad">
                <group>
                    <field name="sale_order_id"/>
                    <button name="action_run" type="object" string="Analizar" class="btn-primary"/>
                </group>
                <field name="line_ids">
                    <list create="0" delete="0">
                        <field name="relation_type"/>
                        <field name="confidence"/>
                        <field name="sale_line_id"/>
                        <field name="purchase_order_id"/>
                        <field name="purchase_line_id"/>
                        <field name="note"/>
                    </list>
                </field>
                <footer>
                    <button string="Cerrar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_justech_trace_diagnostic" model="ir.actions.act_window">
        <field name="name">Diagnóstico trazabilidad venta-compra</field>
        <field name="res_model">justech.trace.diagnostic.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_justech_trace_diagnostic"
              name="Diagnóstico trazabilidad"
              parent="sale.sale_menu_root"
              action="action_justech_trace_diagnostic"
              sequence="95"
              groups="justech_sale_purchase_trace.group_justech_trace_user"/>
</odoo>
