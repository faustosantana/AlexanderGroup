<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_warranty" model="ir.ui.view">
        <field name="name">account.move.form.warranty</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="attributes">
                <attribute name="class" add="o_justech_warranty_compact_form" separator=" "/>
            </xpath>

            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_warranties" type="object"
                        class="oe_stat_button" icon="fa-shield"
                        invisible="warranty_count == 0">
                    <field name="warranty_count" widget="statinfo" string="Garantías"/>
                </button>
                <button name="action_view_warranty_units" type="object"
                        class="oe_stat_button" icon="fa-barcode"
                        invisible="warranty_unit_count == 0">
                    <field name="warranty_unit_count" widget="statinfo" string="Unidades"/>
                </button>
            </xpath>

            <xpath expr="//field[@name='invoice_line_ids']/list[@name='journal_items']/field[@name='name']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/list[@name='journal_items']/field[@name='analytic_distribution']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/list[@name='journal_items']/field[@name='product_uom_id'][@optional='conditional']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/list[@name='journal_items']/field[@name='account_id'][@groups='account.group_account_readonly']" position="attributes">
                <attribute name="column_invisible">parent.move_type in ('out_invoice', 'out_refund', 'out_receipt')</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/list[@name='journal_items']/field[@name='discount']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>

            <xpath expr="//field[@name='invoice_line_ids']/list[@name='journal_items']/field[@name='discount']" position="after">
                <field name="display_type" column_invisible="1"/>
                <field name="warranty_apply" column_invisible="1"/>
                <field name="warranty_months" column_invisible="1"/>
                <field name="warranty_notes" column_invisible="1"/>
                <field name="warranty_type_id" column_invisible="1"/>
                <field name="warranty_expected_units" column_invisible="1"/>
                <field name="warranty_vendor_id" column_invisible="1"/>
                <field name="warranty_planned_serials" column_invisible="1"/>
                <field name="warranty_status" column_invisible="1"/>
                <field name="warranty_units_label" optional="hide"/>
                <field name="warranty_config_btn" string="Garantía"
                       widget="warranty_config_button"/>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="Garantías" name="warranties"
                      invisible="move_type != 'out_invoice'">
                    <div class="alert alert-info" role="alert">
                        Use el icono <b>🛡 Garantía</b> en cada línea para configurar meses,
                        tipo y condiciones. Las garantías reales se crean al registrar la factura.
                    </div>
                    <field name="warranty_ids" readonly="1">
                        <list string="Garantías generadas">
                            <field name="name"/>
                            <field name="product_id"/>
                            <field name="warranty_months"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="state" widget="badge"
                                   decoration-success="state == 'active'"
                                   decoration-info="state == 'pending_serial'"
                                   decoration-warning="state == 'claimed'"
                                   decoration-danger="state == 'expired'"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
