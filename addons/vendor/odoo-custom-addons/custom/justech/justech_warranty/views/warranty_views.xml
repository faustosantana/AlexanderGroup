<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_justech_warranty_list" model="ir.ui.view">
        <field name="name">justech.warranty.list</field>
        <field name="model">justech.warranty</field>
        <field name="arch" type="xml">
            <list string="Garantías" decoration-success="state == 'active'"
                  decoration-muted="state in ('void', 'expired')"
                  decoration-info="state == 'pending_serial'"
                  decoration-warning="state == 'claimed'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="days_to_expire" optional="hide"/>
                    <field name="type_id" optional="hide"/>
                    <field name="warranty_type" optional="hide"/>
                <field name="claim_count" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-info="state == 'pending_serial'"
                       decoration-warning="state == 'claimed'"
                       decoration-danger="state == 'expired'"/>
            </list>
        </field>
    </record>

    <record id="view_justech_warranty_form" model="ir.ui.view">
        <field name="name">justech.warranty.form</field>
        <field name="model">justech.warranty</field>
        <field name="arch" type="xml">
            <form string="Garantía">
                <header>
                    <button name="action_activate" type="object" string="Activar"
                            class="btn-primary" invisible="state not in ('draft', 'expired', 'pending_serial')"/>
                    <button name="action_set_expired" type="object" string="Marcar vencida"
                            invisible="state != 'active'"/>
                    <button name="action_void" type="object" string="Anular"
                            invisible="state in ('void',)"/>
                    <button name="action_reset_to_draft" type="object" string="A borrador"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,pending_serial,active,expired,claimed"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="alert"
                         invisible="state != 'pending_serial'">
                        Esta garantía está <b>pendiente de número de serie</b>. Regístrelo
                        aquí o desde Inventario (Fase 2). Al completar la serie, la garantía
                        pasará automáticamente a <b>Activa</b> y podrá emitirse el certificado
                        PDF (Fase 2).
                    </div>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_claims" type="object" class="oe_stat_button"
                                icon="fa-wrench">
                            <field name="claim_count" widget="statinfo" string="Reclamos"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="product_id"/>
                            <field name="tracking" invisible="1"/>
                            <field name="quantity"/>
                            <field name="type_id"/>
                            <field name="warranty_type"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="warranty_months"/>
                            <field name="date_end" readonly="1"/>
                            <field name="days_to_expire" readonly="1"/>
                            <field name="certificate_ready" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Origen">
                        <group>
                            <field name="invoice_id" readonly="1"/>
                            <field name="sale_order_id" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Términos" name="terms">
                            <field name="terms" placeholder="Términos y condiciones de la garantía..."/>
                        </page>
                        <page string="Reclamos" name="claims">
                            <field name="claim_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="claim_date"/>
                                    <field name="description"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notas" name="notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_justech_warranty_search" model="ir.ui.view">
        <field name="name">justech.warranty.search</field>
        <field name="model">justech.warranty</field>
        <field name="arch" type="xml">
            <search string="Buscar garantías">
                <field name="name"/>
                <field name="partner_id" string="Cliente"/>
                <field name="product_id" string="Producto"/>
                <field name="invoice_id" string="Factura"/>
                <separator/>
                <filter name="active" string="Activas" domain="[('state', '=', 'active')]"/>
                <filter name="pending_serial" string="Pendiente de serie"
                        domain="[('state', '=', 'pending_serial')]"/>
                <filter name="expired" string="Vencidas" domain="[('state', '=', 'expired')]"/>
                <filter name="claimed" string="Reclamadas" domain="[('state', '=', 'claimed')]"/>
                <separator/>
                <filter name="expiring_soon" string="Vencen en 30 días"
                        domain="[('state', '=', 'active'), ('date_end', '&gt;=', context_today().strftime('%Y-%m-%d')), ('date_end', '&lt;=', (context_today() + relativedelta(days=30)).strftime('%Y-%m-%d'))]"/>
                <filter name="expiring_90" string="Vencen en 90 días"
                        domain="[('state', '=', 'active'), ('date_end', '&gt;=', context_today().strftime('%Y-%m-%d')), ('date_end', '&lt;=', (context_today() + relativedelta(days=90)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="group_partner" string="Por cliente"
                        context="{'group_by': 'partner_id'}"/>
                <filter name="group_invoice" string="Por factura"
                        context="{'group_by': 'invoice_id'}"/>
                <filter name="group_product" string="Por producto"
                        context="{'group_by': 'product_id'}"/>
                <filter name="group_state" string="Por estado"
                        context="{'group_by': 'state'}"/>
                <filter name="group_date_end" string="Por vencimiento"
                        context="{'group_by': 'date_end:month'}"/>
            </search>
        </field>
    </record>

    <record id="action_justech_warranty" model="ir.actions.act_window">
        <field name="name">Garantías</field>
        <field name="res_model">justech.warranty</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_justech_warranty_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aún no hay garantías registradas</p>
            <p>Las garantías se generan al validar facturas de cliente con productos
               que tienen meses de garantía, o puede crearlas manualmente.</p>
        </field>
    </record>
</odoo>
