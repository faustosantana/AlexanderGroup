<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_justech_warranty_unit_list" model="ir.ui.view">
        <field name="name">justech.warranty.unit.list</field>
        <field name="model">justech.warranty.unit</field>
        <field name="arch" type="xml">
            <list string="Unidades de garantía"
                  decoration-success="state == 'active'"
                  decoration-info="state == 'pending_serial'"
                  decoration-warning="state == 'claimed'"
                  decoration-muted="state in ('void', 'expired')">
                <field name="name"/>
                <field name="unit_number"/>
                <field name="product_id"/>
                <field name="serial_manufacturer"/>
                <field name="serial_state" widget="badge"
                       decoration-success="serial_state == 'confirmed'"
                       decoration-warning="serial_state == 'planned'"
                       decoration-info="serial_state == 'pending'"/>
                <field name="warranty_id" optional="show"/>
                <field name="partner_id" optional="show"/>
                <field name="vendor_id" optional="hide"/>
                <field name="delivery_mode" optional="show"/>
                <field name="customer_date_end" optional="show"/>
                <field name="coverage_gap_months" optional="hide"/>
                <field name="coverage_risk" optional="hide" widget="badge"
                       decoration-success="coverage_risk == 'low'"
                       decoration-warning="coverage_risk == 'medium'"
                       decoration-danger="coverage_risk == 'high'"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-info="state == 'pending_serial'"
                       decoration-warning="state == 'claimed'"
                       decoration-danger="state == 'expired'"/>
            </list>
        </field>
    </record>

    <record id="view_justech_warranty_unit_form" model="ir.ui.view">
        <field name="name">justech.warranty.unit.form</field>
        <field name="model">justech.warranty.unit</field>
        <field name="arch" type="xml">
            <form string="Unidad de garantía">
                <header>
                    <button name="action_confirm_serial" type="object"
                            string="Confirmar serial" class="btn-primary"
                            invisible="serial_state == 'confirmed' or state in ('void', 'expired')"/>
                    <button name="action_mark_claimed" type="object"
                            string="Marcar reclamada"
                            invisible="state not in ('active', 'pending_serial')"/>
                    <button name="action_void" type="object"
                            string="Anular" invisible="state == 'void'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,planned,pending_serial,active,claimed,expired"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_claims" type="object"
                                class="oe_stat_button" icon="fa-wrench">
                            <field name="claim_count" widget="statinfo" string="Reclamos"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Identificación">
                            <field name="warranty_id"/>
                            <field name="unit_number"/>
                            <field name="product_id"/>
                            <field name="product_description"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Serial">
                            <field name="serial_manufacturer"/>
                            <field name="serial_internal"/>
                            <field name="serial_state"/>
                        </group>
                    </group>
                    <group>
                        <group string="Cliente y cobertura">
                            <field name="partner_id"/>
                            <field name="customer_warranty_months"/>
                            <field name="customer_date_start"/>
                            <field name="customer_date_end" readonly="1"/>
                        </group>
                        <group string="Proveedor / Fabricante">
                            <field name="vendor_id" options="{'no_create_edit': True}"/>
                            <field name="vendor_warranty_months"/>
                            <field name="vendor_date_start"/>
                            <field name="vendor_date_end" readonly="1"/>
                            <field name="coverage_gap_months" readonly="1"/>
                            <field name="coverage_risk" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Entrega" name="delivery">
                            <group>
                                <group>
                                    <field name="delivery_mode"/>
                                    <field name="delivery_date"/>
                                    <field name="delivered_by"/>
                                    <field name="received_by"/>
                                </group>
                                <group>
                                    <field name="purchase_date"/>
                                </group>
                            </group>
                            <group string="Notas de entrega">
                                <field name="delivery_notes" nolabel="1"
                                       placeholder="Detalles de la entrega, incidencias, etc."/>
                            </group>
                        </page>
                        <page string="Origen comercial" name="origin_sales">
                            <group>
                                <group>
                                    <field name="sale_order_id" options="{'no_create': True}"/>
                                    <field name="sale_line_id" options="{'no_create': True}"/>
                                </group>
                                <group>
                                    <field name="invoice_id" options="{'no_create': True}"/>
                                    <field name="invoice_line_id" options="{'no_create': True}"/>
                                </group>
                            </group>
                        </page>
                        <page string="Origen compra" name="origin_purchase">
                            <group>
                                <group>
                                    <field name="purchase_order_id" options="{'no_create': True}"/>
                                    <field name="purchase_line_id" options="{'no_create': True}"/>
                                </group>
                                <group>
                                    <field name="vendor_bill_id" options="{'no_create': True}"/>
                                    <field name="vendor_bill_line_id" options="{'no_create': True}"/>
                                </group>
                            </group>
                        </page>
                        <page string="Reclamos" name="claims">
                            <field name="claim_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="claim_date"/>
                                    <field name="description"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notas" name="notes">
                            <field name="note" placeholder="Notas internas..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_justech_warranty_unit_search" model="ir.ui.view">
        <field name="name">justech.warranty.unit.search</field>
        <field name="model">justech.warranty.unit</field>
        <field name="arch" type="xml">
            <search string="Buscar unidades">
                <field name="name"/>
                <field name="serial_manufacturer" string="Serial fabricante"/>
                <field name="serial_internal" string="Serial interno"/>
                <field name="warranty_id"/>
                <field name="product_id"/>
                <field name="partner_id"/>
                <field name="vendor_id"/>
                <field name="invoice_id"/>
                <separator/>
                <filter name="active" string="Activas" domain="[('state', '=', 'active')]"/>
                <filter name="pending_serial" string="Pendientes de serial"
                        domain="[('state', '=', 'pending_serial')]"/>
                <filter name="claimed" string="Reclamadas"
                        domain="[('state', '=', 'claimed')]"/>
                <separator/>
                <filter name="gap_high" string="Riesgo alto"
                        domain="[('coverage_risk', '=', 'high')]"/>
                <filter name="gap_medium" string="Riesgo medio"
                        domain="[('coverage_risk', '=', 'medium')]"/>
                <separator/>
                <filter name="group_state" string="Por estado"
                        context="{'group_by': 'state'}"/>
                <filter name="group_warranty" string="Por garantía"
                        context="{'group_by': 'warranty_id'}"/>
                <filter name="group_partner" string="Por cliente"
                        context="{'group_by': 'partner_id'}"/>
                <filter name="group_vendor" string="Por proveedor"
                        context="{'group_by': 'vendor_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_justech_warranty_unit" model="ir.actions.act_window">
        <field name="name">Unidades / seriales</field>
        <field name="res_model">justech.warranty.unit</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_justech_warranty_unit_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aún no hay unidades registradas</p>
            <p>Las unidades se crean al postear la factura de cliente cuando la línea
               tiene garantía. Cada unidad es trazable de forma independiente por
               su serial de fabricante.</p>
        </field>
    </record>

    <!-- Extender el formulario de la garantía para exponer unidades y proveedor -->
    <record id="view_justech_warranty_form_units" model="ir.ui.view">
        <field name="name">justech.warranty.form.units</field>
        <field name="model">justech.warranty</field>
        <field name="inherit_id" ref="justech_warranty.view_justech_warranty_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_units" type="object"
                        class="oe_stat_button" icon="fa-barcode">
                    <field name="unit_count" widget="statinfo" string="Unidades"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="vendor_id" options="{'no_create_edit': True}"/>
            </xpath>
            <xpath expr="//field[@name='warranty_months']" position="after">
                <field name="vendor_warranty_months"/>
                <field name="vendor_date_start"/>
                <field name="vendor_date_end" readonly="1"/>
                <field name="coverage_gap_months" readonly="1"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Unidades" name="units">
                    <field name="unit_ids">
                        <list editable="bottom">
                            <field name="unit_number"/>
                            <field name="serial_manufacturer"/>
                            <field name="serial_state" widget="badge"/>
                            <field name="delivery_mode"/>
                            <field name="delivery_date"/>
                            <field name="vendor_id" optional="hide"/>
                            <field name="state" widget="badge"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Extender lista de garantías con contador de unidades -->
    <record id="view_justech_warranty_list_units" model="ir.ui.view">
        <field name="name">justech.warranty.list.units</field>
        <field name="model">justech.warranty</field>
        <field name="inherit_id" ref="justech_warranty.view_justech_warranty_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='claim_count']" position="before">
                <field name="unit_count" optional="show"/>
                <field name="serial_registered_count" optional="hide"/>
                <field name="serial_pending_count" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Reclamo: seleccionar unidades específicas del header -->
    <record id="view_justech_warranty_claim_form_units" model="ir.ui.view">
        <field name="name">justech.warranty.claim.form.units</field>
        <field name="model">justech.warranty.claim</field>
        <field name="inherit_id" ref="justech_warranty.view_justech_warranty_claim_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="serial_manufacturer" readonly="1"/>
                <field name="unit_count" readonly="1"/>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <group string="Unidades reclamadas">
                    <field name="unit_ids" nolabel="1"
                           options="{'no_create': True, 'no_create_edit': True}">
                        <list>
                            <field name="unit_number"/>
                            <field name="serial_manufacturer"/>
                            <field name="serial_state" widget="badge"/>
                            <field name="state" widget="badge"/>
                        </list>
                    </field>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
