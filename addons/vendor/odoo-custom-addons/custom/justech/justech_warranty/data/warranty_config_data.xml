<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Tipos de garantía por defecto (globales, editables por el cliente) -->
    <record id="warranty_type_store" model="justech.warranty.type">
        <field name="name">Garantía de tienda</field>
        <field name="code">STORE</field>
        <field name="kind">store</field>
        <field name="sequence">10</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="warranty_type_manufacturer" model="justech.warranty.type">
        <field name="name">Garantía del fabricante</field>
        <field name="code">MANUF</field>
        <field name="kind">manufacturer</field>
        <field name="sequence">20</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="warranty_type_extended" model="justech.warranty.type">
        <field name="name">Garantía extendida</field>
        <field name="code">EXT</field>
        <field name="kind">extended</field>
        <field name="default_months">12</field>
        <field name="sequence">30</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Motivos de reclamo por defecto (globales, editables por el cliente) -->
    <record id="claim_reason_factory" model="justech.warranty.claim.reason">
        <field name="name">Falla de fábrica</field>
        <field name="sequence">10</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="claim_reason_malfunction" model="justech.warranty.claim.reason">
        <field name="name">Defecto de funcionamiento</field>
        <field name="sequence">20</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="claim_reason_transport" model="justech.warranty.claim.reason">
        <field name="name">Daño en transporte</field>
        <field name="sequence">30</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="claim_reason_other" model="justech.warranty.claim.reason">
        <field name="name">Otro</field>
        <field name="sequence">90</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
