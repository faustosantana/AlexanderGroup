<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_justech_do_fiscal_dashboard_form" model="ir.ui.view">
        <field name="name">justech.do.fiscal.dashboard.form</field>
        <field name="model">justech.do.fiscal.dashboard</field>
        <field name="arch" type="xml">
            <form string="Dashboard Fiscal" create="0" delete="0">
                <header>
                    <button name="action_refresh" type="object" string="Actualizar"
                            class="btn-secondary"/>
                    <button name="action_open_historical_backfill" type="object"
                            string="Sincronizar anulaciones históricas"
                            class="btn-warning"
                            groups="justech_l10n_do_base.group_justech_do_fiscal_manager,account.group_account_manager,base.group_system,justech_l10n_do_base.group_justech_do_fiscal_user"/>
                    <button name="action_open_fiscal_activities" type="object"
                            string="Abrir actividades fiscales"/>
                    <button name="action_filter_responsible_configured" type="object"
                            string="Filtrar responsable configurado"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>Dashboard Fiscal</h1>
                        <h3>
                            <field name="responsible_display" readonly="1"
                                   class="text-muted"/>
                        </h3>
                    </div>
                    <group>
                        <group>
                            <field name="company_id" options="{'no_create': True}"/>
                            <field name="filter_all_allowed_companies"/>
                            <field name="filter_period" placeholder="YYYYMM"/>
                            <field name="filter_responsible_id"
                                   options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="last_refresh" readonly="1"/>
                            <field name="notes" readonly="1" nolabel="1"
                                   colspan="2"/>
                        </group>
                    </group>

                    <group string="Indicadores" col="4">
                        <button name="action_open_pending_608" type="object"
                                class="btn-warning"
                                string="Pendientes 608"
                                help="NCF anulados pendientes de incluir/rectificar 608"/>
                        <div class="o_cell">
                            <field name="kpi_pending_608" readonly="1"
                                   class="oe_inline" style="font-size: 1.6em; font-weight: bold; color: #c27c0e;"/>
                        </div>
                        <button name="action_open_pending_607" type="object"
                                class="btn-warning"
                                string="Rectificar 607"/>
                        <div>
                            <field name="kpi_pending_607" readonly="1"
                                   style="font-size: 1.6em; font-weight: bold; color: #c27c0e;"/>
                        </div>
                        <button name="action_open_pending_it1" type="object"
                                class="btn-warning"
                                string="IT-1 pendiente"/>
                        <div>
                            <field name="kpi_pending_it1" readonly="1"
                                   style="font-size: 1.6em; font-weight: bold; color: #c27c0e;"/>
                        </div>
                        <button name="action_open_overdue_activities" type="object"
                                class="btn-danger"
                                string="Actividades vencidas"/>
                        <div>
                            <field name="kpi_overdue_activities" readonly="1"
                                   style="font-size: 1.6em; font-weight: bold; color: #c00;"/>
                        </div>
                        <button name="action_open_in_progress" type="object"
                                class="btn-primary"
                                string="En proceso"/>
                        <div>
                            <field name="kpi_in_progress" readonly="1"
                                   style="font-size: 1.6em; font-weight: bold; color: #1a6fb5;"/>
                        </div>
                        <button name="action_open_regularized" type="object"
                                class="btn-success"
                                string="Regularizados"/>
                        <div>
                            <field name="kpi_regularized" readonly="1"
                                   style="font-size: 1.6em; font-weight: bold; color: #2e7d32;"/>
                        </div>
                        <button name="action_open_observations" type="object"
                                class="btn-danger"
                                string="Observaciones"/>
                        <div>
                            <field name="kpi_observations" readonly="1"
                                   style="font-size: 1.6em; font-weight: bold; color: #c00;"/>
                        </div>
                        <button name="action_open_my_activities" type="object"
                                class="btn-secondary"
                                string="Mis actividades"/>
                        <div>
                            <field name="kpi_my_activities" readonly="1"
                                   style="font-size: 1.6em; font-weight: bold;"/>
                        </div>
                        <button name="action_open_historical_mismatch" type="object"
                                class="btn-secondary"
                                string="Históricos por revisar"/>
                        <div>
                            <field name="kpi_historical_review" readonly="1"
                                   style="font-size: 1.6em; font-weight: bold; color: #c27c0e;"/>
                        </div>
                    </group>

                    <separator string="Regularizaciones por período (período fiscal original)"/>
                    <field name="period_line_ids" readonly="1" nolabel="1">
                        <list create="0" delete="0" edit="0">
                            <field name="period_label" string="Período"/>
                            <field name="period_code" column_invisible="1"/>
                            <field name="count_total" string="NCF anulados"/>
                            <field name="count_pending_608" string="Pendientes 608"
                                   decoration-warning="count_pending_608 &gt; 0"/>
                            <field name="count_pending_607" string="Rectificar 607"
                                   decoration-warning="count_pending_607 &gt; 0"/>
                            <field name="count_pending_it1" string="IT-1 pendiente"
                                   decoration-warning="count_pending_it1 &gt; 0"/>
                            <field name="count_in_progress" string="En proceso"
                                   decoration-info="count_in_progress &gt; 0"/>
                            <field name="count_regularized" string="Regularizados"
                                   decoration-success="count_regularized &gt; 0"/>
                            <button name="action_open_period_regs" type="object"
                                    string="Ver detalle" class="btn-link"/>
                            <button name="action_open_608" type="object"
                                    string="Ver 608" class="btn-primary"/>
                        </list>
                    </field>
                    <field name="company_ids" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_justech_do_fiscal_dashboard_audit_tree" model="ir.ui.view">
        <field name="name">justech.do.fiscal.dashboard.audit.list</field>
        <field name="model">justech.do.fiscal.dashboard.audit</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" edit="0" export_xlsx="1">
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="move_id"/>
                <field name="ncf"/>
                <field name="invoice_date"/>
                <field name="void_date"/>
                <field name="previous_period"/>
                <field name="correct_period"/>
                <field name="has_regularization"/>
                <field name="current_state"/>
                <field name="suggested_action"/>
                <button name="action_open_move" type="object" string="Abrir documento"/>
                <button name="action_open_regularization" type="object"
                        string="Abrir regularización"
                        invisible="not has_regularization"/>
            </list>
        </field>
    </record>

    <record id="view_justech_do_fiscal_dashboard_audit_form" model="ir.ui.view">
        <field name="name">justech.do.fiscal.dashboard.audit.form</field>
        <field name="model">justech.do.fiscal.dashboard.audit</field>
        <field name="arch" type="xml">
            <form create="0" delete="0" edit="0">
                <header>
                    <button name="action_open_move" type="object" string="Abrir documento"
                            class="btn-primary"/>
                    <button name="action_open_regularization" type="object"
                            string="Abrir regularización"
                            invisible="not has_regularization"/>
                </header>
                <sheet>
                    <group>
                        <field name="company_id"/>
                        <field name="move_id"/>
                        <field name="ncf"/>
                        <field name="invoice_date"/>
                        <field name="void_date"/>
                        <field name="previous_period"/>
                        <field name="correct_period"/>
                        <field name="has_regularization"/>
                        <field name="regularization_id"/>
                        <field name="current_state"/>
                        <field name="suggested_action"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_justech_do_fiscal_dashboard" model="ir.actions.server">
        <field name="name">Dashboard Fiscal</field>
        <field name="model_id" ref="model_justech_do_fiscal_dashboard"/>
        <field name="state">code</field>
        <field name="code">action = env['justech.do.fiscal.dashboard'].action_open_dashboard()</field>
    </record>
</odoo>
