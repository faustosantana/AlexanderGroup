<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_move_reversal_justech" model="ir.ui.view">
        <field name="name">account.move.reversal.form.justech</field>
        <field name="model">account.move.reversal</field>
        <field name="inherit_id" ref="account.view_account_move_reversal"/>
        <field name="arch" type="xml">
            <xpath expr="//group" position="inside">
                <field name="justech_needs_vendor_cn_data" invisible="1"/>
                <field name="justech_replace_mode" invisible="1"/>
                <field name="justech_vendor_cn_ncf"
                       invisible="not justech_needs_vendor_cn_data"
                       required="justech_needs_vendor_cn_data"
                       placeholder="Ej. B0400000123"/>
                <field name="justech_vendor_cn_date"
                       invisible="not justech_needs_vendor_cn_data"
                       required="justech_needs_vendor_cn_data"/>
            </xpath>
            <xpath expr="//button[@name='refund_moves']" position="attributes">
                <attribute name="invisible">justech_replace_mode</attribute>
                <attribute name="string">Revertir</attribute>
            </xpath>
            <xpath expr="//button[@name='modify_moves']" position="attributes">
                <attribute name="class">btn-primary</attribute>
                <attribute name="string">Revertir y crear factura nueva</attribute>
                <attribute name="invisible">move_type == 'entry'</attribute>
            </xpath>
        </field>
    </record>
</odoo>
