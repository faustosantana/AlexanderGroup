<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Centro: líneas de regularización fiscal (período original) -->
    <record id="view_justech_do_fiscal_regularization_tree" model="ir.ui.view">
        <field name="name">justech.do.fiscal.regularization.list</field>
        <field name="model">justech.do.fiscal.regularization</field>
        <field name="arch" type="xml">
            <list string="Centro de regularización fiscal" create="0"
                  decoration-danger="general_status == 'pending'"
                  decoration-warning="general_status in ('in_progress','review_required')"
                  decoration-success="general_status == 'regularized'">
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="move_id" string="Documento"/>
                <field name="ncf"/>
                <field name="invoice_date" string="Fecha factura"/>
                <field name="cancellation_execution_date" string="Cancelación interna"/>
                <field name="original_fiscal_period" string="Período original"/>
                <field name="rectification_607_period" string="607 a rectificar"/>
                <field name="reporting_period_608" string="Período 608"/>
                <field name="rectification_it1_period" string="IT-1"/>
                <field name="annulment_type_608" string="Tipo 608"/>
                <field name="responsible_user_id"/>
                <field name="activity_id"/>
                <field name="deadline"/>
                <field name="status_607" widget="badge"/>
                <field name="status_608" widget="badge"/>
                <field name="status_it1" widget="badge"/>
                <field name="general_status" widget="badge"/>
                <field name="treatment_summary"/>
            </list>
        </field>
    </record>

    <record id="view_justech_do_fiscal_regularization_form" model="ir.ui.view">
        <field name="name">justech.do.fiscal.regularization.form</field>
        <field name="model">justech.do.fiscal.regularization</field>
        <field name="arch" type="xml">
            <form string="Regularización fiscal" create="0">
                <header>
                    <button name="action_mark_608_prepared" type="object"
                            string="608 preparado" class="btn-secondary"
                            invisible="status_608 not in ('pending','rectification_required')"/>
                    <button name="action_mark_608_presented" type="object"
                            string="608 presentado"
                            invisible="status_608 not in ('prepared','exported','pending','rectification_required')"/>
                    <button name="action_mark_608_accepted" type="object"
                            string="608 aceptado / cerrar"
                            class="btn-primary"
                            confirm="¿Confirma acuse/evidencia DGII adjunto? No presentar automáticamente."
                            invisible="status_608 not in ('presented','exported','prepared')"/>
                    <button name="action_mark_607_presented" type="object"
                            string="607 rectificativa presentada"
                            invisible="status_607 not in ('pending','prepared')"/>
                    <button name="action_mark_607_accepted" type="object"
                            string="607 aceptado"
                            invisible="status_607 != 'presented'"/>
                    <button name="action_mark_it1_rectified" type="object"
                            string="IT-1 rectificado"
                            invisible="status_it1 not in ('validation_required','pending')"/>
                    <field name="general_status" widget="statusbar"
                           statusbar_visible="pending,in_progress,review_required,regularized"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="treatment_summary" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Documento">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="move_id"/>
                            <field name="ncf"/>
                            <field name="document_type"/>
                            <field name="partner_id"/>
                            <field name="invoice_date"/>
                            <field name="original_invoice_date"/>
                            <field name="amount_total"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Períodos (regla original)">
                            <field name="original_fiscal_period"/>
                            <field name="reporting_period_608"/>
                            <field name="cancellation_execution_date"/>
                            <field name="regularization_creation_date"/>
                            <field name="annulment_type_608"/>
                            <field name="source_operation"/>
                            <field name="cancellation_reason"/>
                        </group>
                    </group>
                    <group>
                        <group string="608">
                            <field name="required_608"/>
                            <field name="status_608"/>
                        </group>
                        <group string="607">
                            <field name="rectification_607_required"/>
                            <field name="rectification_607_period"/>
                            <field name="status_607"/>
                        </group>
                        <group string="IT-1">
                            <field name="rectification_it1_required"/>
                            <field name="rectification_it1_period"/>
                            <field name="status_it1"/>
                        </group>
                        <group string="Seguimiento">
                            <field name="responsible_user_id"/>
                            <field name="activity_id"/>
                            <field name="deadline"/>
                            <field name="cancelled_by_user_id"/>
                            <field name="linked_regularization_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <group string="Evidencia">
                        <field name="evidence_attachment_ids" widget="many2many_binary"/>
                        <field name="notes"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_justech_do_fiscal_regularization_search" model="ir.ui.view">
        <field name="name">justech.do.fiscal.regularization.search</field>
        <field name="model">justech.do.fiscal.regularization</field>
        <field name="arch" type="xml">
            <search string="Regularización fiscal">
                <field name="ncf"/>
                <field name="move_id"/>
                <field name="partner_id"/>
                <field name="company_id"/>
                <field name="original_fiscal_period"/>
                <separator/>
                <filter name="pending_608" string="Pendientes de 608"
                        domain="[('status_608','in',('pending','rectification_required'))]"/>
                <filter name="pending_607" string="Pendientes de rectificar 607"
                        domain="[('status_607','=','pending')]"/>
                <filter name="pending_it1" string="Pendientes de rectificar IT-1"
                        domain="[('status_it1','in',('validation_required','pending'))]"/>
                <filter name="pending_all_three" string="Pendientes de los tres"
                        domain="[('status_608','in',('pending','rectification_required')),
                                 ('status_607','=','pending'),
                                 ('status_it1','in',('validation_required','pending'))]"/>
                <filter name="prepared" string="Preparados"
                        domain="[('status_608','=','prepared')]"/>
                <filter name="presented" string="Presentados"
                        domain="[('status_608','=','presented')]"/>
                <filter name="regularized" string="Regularizados"
                        domain="[('general_status','=','regularized')]"/>
                <separator/>
                <filter name="group_company" string="Empresa" context="{'group_by': 'company_id'}"/>
                <filter name="group_period" string="Período original" context="{'group_by': 'original_fiscal_period'}"/>
                <filter name="group_608" string="Estado 608" context="{'group_by': 'status_608'}"/>
            </search>
        </field>
    </record>

    <record id="action_justech_do_fiscal_regularization_center" model="ir.actions.act_window">
        <field name="name">Centro de regularización fiscal</field>
        <field name="res_model">justech.do.fiscal.regularization</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_pending_608': 1}</field>
        <field name="search_view_id" ref="view_justech_do_fiscal_regularization_search"/>
    </record>

    <!-- Legacy: movimientos pendientes (se mantiene) -->
    <record id="view_account_move_fiscal_regularization_tree" model="ir.ui.view">
        <field name="name">account.move.fiscal.regularization.list</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <list string="Documentos con regularización" create="0" delete="0"
                  decoration-danger="justech_do_fiscal_regularization_state == 'pending_regularization'"
                  decoration-warning="justech_do_fiscal_regularization_state in ('rectificative_pending','voided_internal')"
                  decoration-success="justech_do_fiscal_regularization_state in ('reported_608','regularized_dgii')">
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="name" string="Factura"/>
                <field name="justech_do_ncf" string="NCF"/>
                <field name="partner_id" string="Cliente"/>
                <field name="invoice_date" string="Fecha"/>
                <field name="justech_do_original_fiscal_period" string="Período original"/>
                <field name="justech_do_608_reporting_period" string="Período 608"/>
                <field name="justech_do_cancellation_execution_date" string="Cancelación interna"/>
                <field name="amount_total" string="Total"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="justech_do_regularization_treatment_summary" string="Acción"/>
                <field name="justech_do_direct_cancel_reason" string="Motivo"/>
                <field name="justech_do_fiscal_treatment_planned" string="Tratamiento"/>
                <field name="justech_do_regularization_responsible_id" string="Responsable"/>
                <field name="justech_do_fiscal_regularization_state" string="Estado" widget="badge"/>
                <field name="justech_do_regularization_deadline" string="Fecha límite"/>
                <field name="state" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_account_move_fiscal_regularization_form" model="ir.ui.view">
        <field name="name">account.move.fiscal.regularization.form</field>
        <field name="model">account.move</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <form string="Regularización fiscal" create="0" delete="0">
                <header>
                    <button name="action_mark_reported_608" type="object" string="Marcar incluido en 608"
                            class="btn-primary"
                            invisible="justech_do_fiscal_regularization_state not in ('pending_regularization','voided_internal','rectificative_pending')"/>
                    <button name="action_mark_607_rectified" type="object" string="Marcar 607 rectificado"
                            invisible="justech_do_fiscal_regularization_state not in ('pending_regularization','voided_internal')"/>
                    <button name="action_mark_declaration_rectified" type="object" string="Marcar declaración rectificada"
                            invisible="justech_do_fiscal_regularization_state not in ('pending_regularization','voided_internal','rectificative_pending')"/>
                    <button name="action_mark_regularized_dgii" type="object" string="Marcar regularizado"
                            class="btn-secondary"
                            confirm="¿Confirma que existe evidencia/acuse DGII adjunto? No automatizar sin evidencia."
                            invisible="justech_do_fiscal_regularization_state not in ('reported_608','rectificative_pending')"/>
                    <field name="justech_do_fiscal_regularization_state" widget="statusbar"
                           statusbar_visible="pending_regularization,voided_internal,reported_608,rectificative_pending,regularized_dgii"/>
                </header>
                <sheet>
                    <group>
                        <group string="Documento">
                            <field name="name"/>
                            <field name="partner_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="justech_do_ncf"/>
                            <field name="invoice_date"/>
                            <field name="amount_total"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="state"/>
                        </group>
                        <group string="Cancelación / regularización">
                            <field name="justech_do_cancellation_method"/>
                            <field name="justech_do_direct_cancel_reason"/>
                            <field name="justech_do_fiscal_treatment_planned"/>
                            <field name="justech_do_fiscal_treatment_other"/>
                            <field name="justech_do_direct_cancel_user_id"/>
                            <field name="justech_do_direct_cancel_datetime"/>
                            <field name="justech_do_cancellation_execution_date"/>
                            <field name="justech_do_original_fiscal_period"/>
                            <field name="justech_do_608_reporting_period"/>
                            <field name="justech_do_fiscal_regularization_id"/>
                            <field name="justech_do_regularization_treatment_summary"/>
                            <field name="justech_do_not_delivered_declared"/>
                            <field name="justech_do_customer_delivery_state"/>
                            <field name="justech_do_regularization_responsible_id"/>
                            <field name="justech_do_regularization_deadline"/>
                            <field name="justech_do_included_in_607"/>
                        </group>
                    </group>
                    <group string="Adjuntos / evidencia">
                        <field name="message_main_attachment_id" string="Acuse DGII / evidencia" widget="many2one_binary"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_account_move_fiscal_regularization_search" model="ir.ui.view">
        <field name="name">account.move.fiscal.regularization.search</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <search string="Regularización fiscal">
                <field name="name"/>
                <field name="justech_do_ncf"/>
                <field name="partner_id"/>
                <field name="company_id"/>
                <separator/>
                <filter name="pending" string="Pendiente de regularización"
                        domain="[('justech_do_fiscal_regularization_state','=','pending_regularization')]"/>
                <filter name="rectificative" string="Rectificativa pendiente"
                        domain="[('justech_do_fiscal_regularization_state','=','rectificative_pending')]"/>
                <filter name="reported_608" string="Reportado 608"
                        domain="[('justech_do_fiscal_regularization_state','=','reported_608')]"/>
                <separator/>
                <filter name="direct_cancel" string="Cancelación directa"
                        domain="[('justech_do_cancellation_method','=','direct_cancel')]"/>
                <separator/>
                <filter name="group_company" string="Empresa" context="{'group_by': 'company_id'}"/>
                <filter name="group_state" string="Estado" context="{'group_by': 'justech_do_fiscal_regularization_state'}"/>
                <filter name="group_treatment" string="Tratamiento" context="{'group_by': 'justech_do_fiscal_treatment_planned'}"/>
                <filter name="group_period" string="Período original" context="{'group_by': 'justech_do_original_fiscal_period'}"/>
            </search>
        </field>
    </record>

    <record id="action_justech_do_fiscal_regularization" model="ir.actions.act_window">
        <field name="name">Documentos pendientes de regularización</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('justech_do_fiscal_regularization_state','in',('pending_regularization','voided_internal','reported_608','rectificative_pending'))]</field>
        <field name="context">{'search_default_pending': 1}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_account_move_fiscal_regularization_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_account_move_fiscal_regularization_form')})]"/>
        <field name="search_view_id" ref="view_account_move_fiscal_regularization_search"/>
    </record>

    <record id="view_justech_do_fiscal_regularization_log_tree" model="ir.ui.view">
        <field name="name">justech.do.fiscal.regularization.log.list</field>
        <field name="model">justech.do.fiscal.regularization.log</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" edit="0">
                <field name="event_datetime"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="move_name"/>
                <field name="ncf"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <field name="method"/>
                <field name="fiscal_treatment"/>
                <field name="fiscal_state_after"/>
                <field name="not_delivered_declared"/>
            </list>
        </field>
    </record>

    <record id="action_justech_do_fiscal_regularization_log" model="ir.actions.act_window">
        <field name="name">Auditoría cancelación / regularización</field>
        <field name="res_model">justech.do.fiscal.regularization.log</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
