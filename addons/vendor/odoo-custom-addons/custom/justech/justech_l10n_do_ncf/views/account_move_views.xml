<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
      Cadena inherit auditada:
      - account.view_move_form (base)
      - l10n_do_accounting.view_move_form (prio 16)
      - studio account.move.form (prio 160) — reescribe invisible de l10n_latam_document_number
      - este archivo (prio 200): gana a Studio; Compras recibidas LATAM vs emisión B11/B13/B17
    -->
    <record id="view_move_form_justech_do_ncf" model="ir.ui.view">
        <field name="name">account.move.form.justech.ncf</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="priority">200</field>
        <field name="arch" type="xml">
            <xpath expr="//group[@id='header_left_group']/field[@name='l10n_latam_document_type_id']" position="before">
                <field name="justech_do_purchase_registration_mode"
                       widget="radio"
                       invisible="state != 'draft' or move_type not in ('in_invoice', 'in_refund')"
                       required="state == 'draft' and move_type in ('in_invoice', 'in_refund')"/>

                <!-- Ventas: tipos de venta -->
                <field name="justech_do_document_type_id"
                       string="Tipo de comprobante"
                       invisible="state != 'draft' or move_type not in ('out_invoice', 'out_refund')"
                       readonly="0"
                       domain="[('is_sale_document', '=', True)]"
                       options="{'no_create': True, 'no_open': True}"/>
                <!-- Compras emitidas: solo B11/B13/B17 -->
                <field name="justech_do_document_type_id"
                       string="Tipo de comprobante"
                       invisible="state != 'draft' or move_type not in ('in_invoice', 'in_refund') or justech_do_purchase_registration_mode != 'issued'"
                       readonly="0"
                       domain="[('is_purchase_document', '=', True)]"
                       options="{'no_create': True, 'no_open': True}"/>
                <field name="justech_do_purchase_emission_status"
                       string="Estado del rango"
                       readonly="1"
                       invisible="state != 'draft' or move_type not in ('in_invoice', 'in_refund') or justech_do_purchase_registration_mode != 'issued'"/>
                <field name="justech_do_purchase_next_ncf"
                       string="Próximo NCF"
                       readonly="1"
                       invisible="state != 'draft' or move_type not in ('in_invoice', 'in_refund') or justech_do_purchase_registration_mode != 'issued' or not justech_do_purchase_next_ncf"/>
                <field name="justech_do_ncf"
                       string="NCF"
                       invisible="state != 'draft' or (
                            move_type not in ('out_invoice', 'out_refund')
                            and not (move_type in ('in_invoice', 'in_refund') and justech_do_purchase_registration_mode == 'issued')
                       )"
                       placeholder="Se asigna al publicar"/>

                <field name="fiscal_document_type_display"
                       string="Tipo de comprobante"
                       readonly="1"
                       invisible="state == 'draft' or move_type not in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund')"/>
                <field name="fiscal_ncf_display"
                       string="NCF"
                       readonly="1"
                       invisible="state == 'draft' or move_type not in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund')"/>
                <field name="fiscal_income_expense_type_display"
                       string="Tipo de ingreso"
                       readonly="1"
                       invisible="move_type != 'out_invoice'"/>

                <!-- Compras: clasificación 606 editable en borrador (por factura). -->
                <field name="justech_do_include_in_dgii" invisible="1"/>
                <field name="justech_do_expense_type_id"
                       string="Tipo de costos y gastos"
                       invisible="move_type not in ('in_invoice', 'in_refund') or state != 'draft'"
                       readonly="0"
                       required="move_type in ('in_invoice', 'in_refund') and justech_do_include_in_dgii"
                       options="{'no_create': True, 'no_open': True}"/>
                <!-- Campo interno conservado; oculto: no sugerir en UI. -->
                <field name="justech_do_expense_type_suggestion_label" invisible="1"/>
                <field name="justech_do_expense_type_manual" invisible="1"/>
                <field name="fiscal_income_expense_type_display"
                       string="Tipo de costos y gastos"
                       readonly="1"
                       invisible="move_type not in ('in_invoice', 'in_refund') or state == 'draft'"/>
            </xpath>

            <xpath expr="//field[@name='l10n_latam_document_type_id']" position="attributes">
                <attribute name="invisible">state != 'draft' or move_type not in ('in_invoice', 'in_refund') or justech_do_purchase_registration_mode != 'received'</attribute>
                <attribute name="readonly">0</attribute>
                <attribute name="force_save">1</attribute>
                <attribute name="domain">[('doc_code_prefix', 'in', ('B01','B02','B03','B04','B14','B15','B16','E31','E32','E33','E34','E41','E43','E44','E45','E46','E47'))]</attribute>
                <attribute name="options">{"no_create": true}</attribute>
                <attribute name="string">Tipo de comprobante (recibido)</attribute>
            </xpath>
            <!--
              Campo histórico real del NCF recibido: l10n_latam_document_number.
              priority 200 supera Studio (160), que ocultaba el campo cuando
              l10n_latam_use_documents=False en borradores de proveedor.
            -->
            <xpath expr="//field[@name='l10n_latam_document_number']" position="attributes">
                <attribute name="invisible">state != 'draft' or move_type not in ('in_invoice', 'in_refund') or justech_do_purchase_registration_mode != 'received'</attribute>
                <attribute name="readonly">0</attribute>
                <attribute name="force_save">1</attribute>
                <attribute name="required">state == 'draft' and move_type in ('in_invoice', 'in_refund') and justech_do_purchase_registration_mode == 'received'</attribute>
                <attribute name="string">NCF del proveedor</attribute>
            </xpath>

            <xpath expr="//page[@id='other_tab']" position="inside">
                <group string="Administración fiscal"
                       groups="justech_l10n_do_base.group_justech_do_fiscal_manager"
                       invisible="move_type not in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund')">
                    <field name="justech_do_fiscal_ui_status" string="Estado fiscal (UI)" readonly="1"/>
                    <field name="justech_do_operational_ui_status" string="Estado operativo" readonly="1"/>
                    <field name="justech_do_customer_delivery_state"/>
                    <field name="justech_do_cancellation_method" readonly="1"/>
                    <field name="justech_do_fiscal_regularization_state" readonly="1"
                           invisible="justech_do_fiscal_regularization_state in (False, 'none')"/>
                    <field name="justech_do_included_in_607"/>
                    <field name="fiscal_status_display" string="Estado fiscal (detalle)" readonly="1"/>
                    <field name="justech_do_origin_ncf" readonly="state != 'draft'"/>
                    <field name="justech_do_ncf_modified" readonly="state != 'draft'"/>
                    <field name="justech_do_include_in_dgii" readonly="state != 'draft'"/>
                    <field name="justech_do_dgii_line_status" readonly="1"/>
                    <field name="justech_do_dgii_fiscal_state" string="Estado DGII interno" readonly="1"/>
                    <field name="justech_do_ncf_voided" readonly="1"/>
                    <field name="justech_do_ncf_void_reason" readonly="justech_do_ncf_voided"
                           invisible="not justech_do_ncf_voided"/>
                    <field name="justech_do_ncf_cancel_type" readonly="justech_do_ncf_voided"
                           invisible="not justech_do_ncf_voided"/>
                    <field name="justech_do_replacement_move_id" readonly="1"
                           invisible="not justech_do_replacement_move_id"/>
                </group>
            </xpath>

            <xpath expr="//header" position="inside">
                <field name="justech_do_can_void_ncf" invisible="1"/>
                <field name="justech_do_ncf_voided" invisible="1"/>
                <field name="amount_residual" invisible="1"/>
                <button name="action_open_correct_invoice_wizard"
                        string="Corregir o Anular"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'posted' or move_type not in ('out_invoice', 'in_invoice', 'out_refund', 'in_refund')"
                        groups="account.group_account_invoice,justech_l10n_do_base.group_justech_do_fiscal_manager"
                        title="Único flujo oficial: anular, corregir o NC parcial. El ERP ejecuta NC, anulación NCF y conciliación."/>
                <button name="action_open_void_ncf_wizard" string="Anular NCF" type="object"
                        class="btn-secondary"
                        invisible="not justech_do_can_void_ncf"
                        groups="justech_l10n_do_base.group_justech_do_fiscal_manager"
                        title="Solo anula el número fiscal para 608. No revierte la factura."/>
                <!-- UX fiscal final: ocultos en UI. Métodos internos se mantienen
                     para el wizard unificado «Corregir o Anular» y el servicio atómico. -->
                <button name="action_justech_reverse_invoice" string="Revertir factura" type="object"
                        class="btn-secondary"
                        invisible="1"
                        groups="justech_l10n_do_ncf.group_justech_reverse_invoice,justech_accounting_recovery.group_accounting_recovery"
                        title="Interno: usar Corregir o Anular."/>
                <button name="action_justech_reverse_and_replace" string="Revertir y crear factura nueva" type="object"
                        class="btn-secondary"
                        invisible="1"
                        groups="justech_l10n_do_ncf.group_justech_reverse_and_replace,justech_accounting_recovery.group_accounting_recovery"
                        title="Interno: usar Corregir o Anular."/>
            </xpath>

            <!-- Alerta visible: NCF anulado + residual abierto -->
            <xpath expr="//sheet" position="before">
                <div class="alert alert-danger mb-0" role="alert"
                     invisible="not justech_do_ncf_voided or amount_residual &lt;= 0 or state != 'posted'">
                    El NCF está anulado, pero la factura mantiene un saldo contable abierto.
                    Use <strong>Corregir o Anular</strong> → Anular completamente: el ERP
                    emitirá la Nota de Crédito, conciliará y cerrará CxC automáticamente.
                    No cree la Nota de Crédito ni anule el NCF a mano.
                </div>
            </xpath>

            <!-- Herencia Justech: corrige fórmula rota de l10n_do_accounting (sin modificar el módulo). -->
            <xpath expr="//button[@name='button_cancel']" position="attributes">
                <attribute name="invisible">not id or state != 'draft' or justech_do_ncf_voided</attribute>
                <attribute name="string">Cancelar asiento</attribute>
            </xpath>
        </field>
    </record>

    <!--
      HOTFIX 2026.1.1 — Lista de facturas:
      Con dual-write OFF, l10n_latam_document_number queda vacío en emisión Justech.
      Mostrar fiscal_ncf_display (FDP: Justech → LATAM) en la misma columna
      "Número de documento" sin inventar una segunda fuente de verdad.
    -->
    <record id="view_out_invoice_tree_justech_fiscal_ncf" model="ir.ui.view">
        <field name="name">account.move.tree.out.invoice.justech.fiscal.ncf</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="l10n_do_accounting.invoice_tree_inherited_out_invoice"/>
        <field name="priority">200</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='l10n_latam_document_number']" position="replace">
                <field name="fiscal_ncf_display" string="Número de documento" readonly="1"/>
            </xpath>
        </field>
    </record>
    <record id="view_in_invoice_tree_justech_fiscal_ncf" model="ir.ui.view">
        <field name="name">account.move.tree.in.invoice.justech.fiscal.ncf</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="l10n_do_accounting.invoice_tree_inherited_in_invoice"/>
        <field name="priority">200</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='l10n_latam_document_number']" position="replace">
                <field name="fiscal_ncf_display" string="Número de documento" readonly="1"/>
            </xpath>
        </field>
    </record>
    <record id="view_out_credit_note_tree_justech_fiscal_ncf" model="ir.ui.view">
        <field name="name">account.move.tree.out.credit.note.justech.fiscal.ncf</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="l10n_do_accounting.view_out_credit_note_tree_inherit"/>
        <field name="priority">200</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='l10n_latam_document_number']" position="replace">
                <field name="fiscal_ncf_display" string="Número de documento" readonly="1"/>
            </xpath>
        </field>
    </record>

    <!--
      Dos indicadores separados (Opción C):
      - status_in_payment = estado contable/pago (Odoo estándar, sin override fiscal)
      - justech_do_fiscal_ui_status = estado fiscal (NCF anulado, e-CF, etc.)
    -->
    <record id="view_invoice_list_justech_fiscal_status" model="ir.ui.view">
        <field name="name">account.invoice.list.justech.fiscal.status</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="priority">210</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='status_in_payment']" position="after">
                <field name="justech_do_fiscal_ui_status" string="Estado fiscal" optional="show"
                       widget="badge"
                       decoration-danger="justech_do_fiscal_ui_status in ('voided_608', 'pending_regularization', 'voided_internal')"
                       decoration-warning="justech_do_fiscal_ui_status in ('ecf_pending', 'ecf_rejected', 'rectificative_pending')"
                       decoration-success="justech_do_fiscal_ui_status in ('issued', 'credit_note_issued', 'ecf_accepted', 'reported_608', 'regularized_dgii')"
                       decoration-muted="justech_do_fiscal_ui_status in ('none', 'assigned', 'cancelled_via_credit_note')"/>
                <field name="justech_do_operational_ui_status" string="Estado operativo" optional="hide"
                       widget="badge"
                       decoration-danger="justech_do_operational_ui_status == 'cancelled'"
                       decoration-info="justech_do_operational_ui_status == 'active'"
                       decoration-success="justech_do_operational_ui_status in ('reversed', 'replaced')"
                       decoration-warning="justech_do_operational_ui_status in ('partial_reversed', 'refund_pending', 'credit_available')"/>
            </xpath>
            <xpath expr="//field[@name='status_in_payment']" position="attributes">
                <attribute name="decoration-info">status_in_payment == 'draft'</attribute>
                <attribute name="decoration-danger">status_in_payment == 'cancel'</attribute>
                <attribute name="decoration-muted">status_in_payment in ('posted', 'sent', 'partial')</attribute>
                <attribute name="decoration-success">status_in_payment in ('in_payment', 'paid', 'reversed')</attribute>
            </xpath>
        </field>
    </record>
</odoo>
