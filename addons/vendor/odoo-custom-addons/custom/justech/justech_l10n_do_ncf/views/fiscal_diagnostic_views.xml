<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_justech_do_fiscal_diagnostic_wizard_form" model="ir.ui.view">
        <field name="name">justech.do.fiscal.diagnostic.wizard.form</field>
        <field name="model">justech.do.fiscal.diagnostic.wizard</field>
        <field name="arch" type="xml">
            <form string="Diagnóstico Fiscal">
                <header>
                    <button name="action_run_scan" string="Volver a escanear" type="object" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <field name="company_id" readonly="1"/>
                        <field name="scan_date" readonly="1"/>
                    </group>
                    <group string="Resultados">
                        <field name="error_count" string="Errores"/>
                        <field name="warning_count" string="Advertencias"/>
                        <field name="info_count" string="Información"/>
                    </group>
                    <field name="line_ids" nolabel="1" readonly="1">
                        <list decoration-danger="severity == 'error'"
                              decoration-warning="severity == 'warning'">
                            <field name="severity"/>
                            <field name="title"/>
                            <field name="detail"/>
                            <button name="action_open_records" type="object" string="Ver" icon="fa-external-link"
                                    invisible="not action_model"/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button string="Cerrar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_justech_do_fiscal_diagnostic" model="ir.actions.server">
        <field name="name">Diagnóstico Fiscal</field>
        <field name="model_id" ref="model_justech_do_fiscal_diagnostic_wizard"/>
        <field name="state">code</field>
        <field name="code">
wizard = env['justech.do.fiscal.diagnostic.wizard'].create({'company_id': env.company.id})
action = wizard.action_run_scan()
        </field>
    </record>
</odoo>
