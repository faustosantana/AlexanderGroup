<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_purchase_order_form_justech_ux" model="ir.ui.view">
        <field name="name">purchase.order.form.justech.ux</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="priority">30</field>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='print_quotation']" position="attributes">
                <attribute name="string">Imprimir Solicitud de Orden</attribute>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_justech_reference_sale_orders"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-pencil-square-o"
                        invisible="justech_reference_sale_order_count &lt; 2">
                    <field name="justech_reference_sale_order_count" widget="statinfo"
                           string="Cotizaciones"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='partner_ref']" position="before">
                <field name="justech_reference_sale_order_count" invisible="1"/>
                <field name="justech_reference_sale_order_ids" invisible="1"/>
                <field name="justech_reference_sale_order_id"
                       string="Cotización de referencia"
                       readonly="1"
                       options="{'no_create': True, 'no_open': False}"
                       invisible="justech_reference_sale_order_count != 1"/>
            </xpath>
            <xpath expr="//field[@name='partner_ref']" position="attributes">
                <attribute name="string">Referencia del proveedor</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_purchase_order_tree_justech_ux" model="ir.ui.view">
        <field name="name">purchase.order.list.justech.ux</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_tree"/>
        <field name="priority">30</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_ref']" position="attributes">
                <attribute name="string">Referencia del proveedor</attribute>
            </xpath>
        </field>
    </record>

    <record id="purchase.purchase_rfq" model="ir.actions.act_window">
        <field name="name">Solicitudes de Orden</field>
    </record>

</odoo>
