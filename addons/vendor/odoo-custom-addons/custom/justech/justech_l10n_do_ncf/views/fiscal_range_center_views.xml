<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- LISTA UNIFICADA (Centro + lista avanzada) — Release 2026.2 UX -->
    <!-- ============================================================ -->
    <record id="view_justech_do_fiscal_range_center_line_list" model="ir.ui.view">
        <field name="name">justech.do.fiscal.range.center.line.list</field>
        <field name="model">justech.do.fiscal.range.center.line</field>
        <field name="priority">10</field>
        <field name="arch" type="xml">
            <list string="Centro de Rangos NCF" create="0" delete="0" edit="0"
                  class="o_justech_ncf_range_center_list"
                  decoration-success="ux_status == 'active'"
                  decoration-muted="ux_status in ('inactive', 'cancelled', 'no_range')"
                  decoration-danger="ux_status == 'expired'"
                  decoration-warning="ux_status == 'depleted'"
                  decoration-info="ux_status == 'draft'">
                <field name="company_display" string="Empresa" width="140"/>
                <field name="company_id" column_invisible="1"/>
                <field name="prefix" string="Código" width="70"/>
                <field name="name" string="Nombre legal" width="220"/>
                <field name="flow" string="Uso" widget="badge" width="160"
                       class="o_justech_ncf_uso"
                       decoration-primary="flow == 'sale'"
                       decoration-warning="flow == 'purchase_issued'"
                       decoration-info="flow == 'purchase_received'"/>
                <field name="ux_status" string="Estado" widget="badge" width="100"
                       decoration-success="ux_status == 'active'"
                       decoration-muted="ux_status in ('inactive', 'cancelled', 'no_range')"
                       decoration-danger="ux_status == 'expired'"
                       decoration-warning="ux_status == 'depleted'"
                       decoration-info="ux_status == 'draft'"/>
                <field name="document_medium" string="Tipo" width="90"/>
                <field name="date_from" string="Fecha inicio" width="110"/>
                <field name="date_to" string="Fecha vencimiento" width="120"/>
                <field name="sequence_start" string="Secuencia inicial" width="120"/>
                <field name="next_sequence" string="Secuencia actual" width="120"/>
                <field name="sequence_end" string="Secuencia final" width="120"/>
                <field name="remaining_count" string="Disponibles" width="100"/>
                <field name="next_ncf" string="Próximo NCF" optional="show"/>
                <field name="status_label" string="Detalle estado" optional="hide"/>
                <field name="consumes_sequence" column_invisible="1"/>
                <field name="range_id" column_invisible="1"/>
                <button name="action_open_range" type="object"
                        string="Configurar rango"
                        class="btn-primary"
                        invisible="flow == 'purchase_received' or not consumes_sequence or range_id"
                        groups="justech_l10n_do_base.group_justech_do_fiscal_manager,base.group_system"/>
                <button name="action_view_range" type="object"
                        string="Ver"
                        class="btn-link"
                        invisible="flow == 'purchase_received' or not consumes_sequence or not range_id"
                        groups="justech_l10n_do_base.group_justech_do_fiscal_user,account.group_account_invoice,justech_l10n_do_base.group_justech_do_fiscal_manager,base.group_system"/>
                <button name="action_edit_range" type="object"
                        string="Editar"
                        class="btn-link"
                        invisible="flow == 'purchase_received' or not consumes_sequence or not range_id"
                        groups="justech_l10n_do_base.group_justech_do_fiscal_manager,base.group_system"/>
                <button name="action_renew_range" type="object"
                        string="Renovar"
                        class="btn-link"
                        invisible="flow == 'purchase_received' or not consumes_sequence or not range_id"
                        groups="justech_l10n_do_base.group_justech_do_fiscal_manager,base.group_system"/>
                <button name="action_view_history" type="object"
                        string="Histórico"
                        class="btn-link"
                        invisible="flow == 'purchase_received' or not consumes_sequence"
                        groups="justech_l10n_do_base.group_justech_do_fiscal_user,justech_l10n_do_base.group_justech_do_fiscal_manager,base.group_system"/>
                <button name="action_view_dgii_validations" type="object"
                        string="DGII"
                        class="btn-link"
                        invisible="flow == 'purchase_received' or not consumes_sequence"
                        groups="justech_l10n_do_base.group_justech_do_fiscal_user,justech_l10n_do_base.group_justech_do_fiscal_manager,base.group_system"/>
            </list>
        </field>
    </record>

    <!-- Compat: refs antiguas apuntan a la lista unificada -->
    <record id="view_justech_do_fiscal_range_center_line_list_company" model="ir.ui.view">
        <field name="name">justech.do.fiscal.range.center.line.list.company</field>
        <field name="model">justech.do.fiscal.range.center.line</field>
        <field name="inherit_id" ref="view_justech_do_fiscal_range_center_line_list"/>
        <field name="mode">primary</field>
        <field name="priority">15</field>
        <field name="arch" type="xml">
            <list position="attributes">
                <attribute name="string">Rangos propios</attribute>
            </list>
        </field>
    </record>

    <record id="view_justech_do_fiscal_range_center_line_list_all" model="ir.ui.view">
        <field name="name">justech.do.fiscal.range.center.line.list.all</field>
        <field name="model">justech.do.fiscal.range.center.line</field>
        <field name="inherit_id" ref="view_justech_do_fiscal_range_center_line_list"/>
        <field name="mode">primary</field>
        <field name="priority">16</field>
        <field name="arch" type="xml">
            <list position="attributes">
                <attribute name="string">Todos</attribute>
            </list>
        </field>
    </record>

    <record id="view_justech_do_fiscal_range_center_line_list_sale" model="ir.ui.view">
        <field name="name">justech.do.fiscal.range.center.line.list.sale</field>
        <field name="model">justech.do.fiscal.range.center.line</field>
        <field name="inherit_id" ref="view_justech_do_fiscal_range_center_line_list"/>
        <field name="mode">primary</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <list position="attributes">
                <attribute name="string">Ventas</attribute>
            </list>
        </field>
    </record>

    <record id="view_justech_do_fiscal_range_center_line_list_issued" model="ir.ui.view">
        <field name="name">justech.do.fiscal.range.center.line.list.issued</field>
        <field name="model">justech.do.fiscal.range.center.line</field>
        <field name="inherit_id" ref="view_justech_do_fiscal_range_center_line_list"/>
        <field name="mode">primary</field>
        <field name="priority">21</field>
        <field name="arch" type="xml">
            <list position="attributes">
                <attribute name="string">Compras Emitidas</attribute>
            </list>
        </field>
    </record>

    <record id="view_justech_do_fiscal_range_center_line_list_received" model="ir.ui.view">
        <field name="name">justech.do.fiscal.range.center.line.list.received</field>
        <field name="model">justech.do.fiscal.range.center.line</field>
        <field name="inherit_id" ref="view_justech_do_fiscal_range_center_line_list"/>
        <field name="mode">primary</field>
        <field name="priority">22</field>
        <field name="arch" type="xml">
            <list position="attributes">
                <attribute name="string">Compras Recibidas</attribute>
            </list>
        </field>
    </record>

    <!-- SEARCH VIEW -->
    <record id="view_justech_do_fiscal_range_center_line_search" model="ir.ui.view">
        <field name="name">justech.do.fiscal.range.center.line.search</field>
        <field name="model">justech.do.fiscal.range.center.line</field>
        <field name="arch" type="xml">
            <search string="Buscar rangos / tipos">
                <field name="prefix" string="Código"/>
                <field name="name" string="Nombre legal"/>
                <field name="company_id" string="Empresa"/>
                <field name="flow" string="Uso"/>
                <field name="ux_status" string="Estado"/>
                <field name="document_medium" string="Físico / Electrónico"/>
                <field name="year" string="Año"/>
                <separator/>
                <filter name="filter_all_sale" string="Ventas"
                        domain="[('flow', '=', 'sale')]"/>
                <filter name="filter_purchase_received" string="Compras Recibidas"
                        domain="[('flow', '=', 'purchase_received')]"/>
                <filter name="filter_purchase_issued" string="Compras Emitidas"
                        domain="[('flow', '=', 'purchase_issued')]"/>
                <separator/>
                <filter name="filter_active" string="Activos"
                        domain="[('ux_status', '=', 'active')]"/>
                <filter name="filter_inactive" string="Inactivos"
                        domain="[('ux_status', 'in', ('inactive', 'cancelled', 'no_range'))]"/>
                <filter name="filter_expired" string="Vencidos"
                        domain="[('ux_status', '=', 'expired')]"/>
                <filter name="filter_depleted" string="Agotados"
                        domain="[('ux_status', '=', 'depleted')]"/>
                <filter name="filter_draft" string="Borrador"
                        domain="[('ux_status', '=', 'draft')]"/>
                <separator/>
                <filter name="filter_physical" string="Físicos"
                        domain="[('document_medium', '=', 'physical')]"/>
                <filter name="filter_electronic" string="Electrónicos"
                        domain="[('document_medium', '=', 'electronic')]"/>
                <separator/>
                <filter name="filter_company_group" string="Empresa"
                        context="{'group_by': 'company_id'}"/>
                <group>
                    <filter name="group_company" string="Empresa"
                            context="{'group_by': 'company_id'}"/>
                    <filter name="group_status" string="Estado"
                            context="{'group_by': 'ux_status'}"/>
                    <filter name="group_uso" string="Uso"
                            context="{'group_by': 'flow'}"/>
                    <filter name="group_prefix" string="Tipo de comprobante"
                            context="{'group_by': 'prefix'}"/>
                    <filter name="group_medium" string="Físico / Electrónico"
                            context="{'group_by': 'document_medium'}"/>
                    <filter name="group_year" string="Año"
                            context="{'group_by': 'year'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- FORM LÍNEA — encabezado claro -->
    <record id="view_justech_do_fiscal_range_center_line_form" model="ir.ui.view">
        <field name="name">justech.do.fiscal.range.center.line.form</field>
        <field name="model">justech.do.fiscal.range.center.line</field>
        <field name="arch" type="xml">
            <form string="Tipo fiscal" create="0" delete="0">
                <header>
                    <button name="action_open_range" type="object" string="Configurar rango"
                            class="btn-primary"
                            invisible="flow == 'purchase_received' or not consumes_sequence or range_id"
                            groups="justech_l10n_do_base.group_justech_do_fiscal_manager,base.group_system"/>
                    <button name="action_view_range" type="object" string="Ver rango"
                            class="btn-secondary"
                            invisible="flow == 'purchase_received' or not consumes_sequence or not range_id"/>
                    <button name="action_edit_range" type="object" string="Editar rango"
                            class="btn-primary"
                            invisible="flow == 'purchase_received' or not consumes_sequence or not range_id"
                            groups="justech_l10n_do_base.group_justech_do_fiscal_manager,base.group_system"/>
                    <button name="action_renew_range" type="object" string="Renovar rango"
                            class="btn-secondary"
                            invisible="flow == 'purchase_received' or not consumes_sequence or not range_id"
                            groups="justech_l10n_do_base.group_justech_do_fiscal_manager,base.group_system"/>
                    <field name="ux_status" widget="statusbar"
                           statusbar_visible="draft,active,depleted,expired,inactive"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="prefix" readonly="1" class="oe_inline"/>
                        </h1>
                        <h2>
                            <field name="name" readonly="1"/>
                        </h2>
                        <div class="o_row">
                            <field name="flow" widget="badge" readonly="1"
                                   decoration-primary="flow == 'sale'"
                                   decoration-warning="flow == 'purchase_issued'"
                                   decoration-info="flow == 'purchase_received'"/>
                            <field name="ux_status" widget="badge" readonly="1"
                                   decoration-success="ux_status == 'active'"
                                   decoration-muted="ux_status in ('inactive', 'cancelled', 'no_range')"
                                   decoration-danger="ux_status == 'expired'"
                                   decoration-warning="ux_status == 'depleted'"
                                   decoration-info="ux_status == 'draft'"/>
                            <field name="availability_label" readonly="1"/>
                        </div>
                    </div>
                    <group>
                        <group string="Clasificación">
                            <field name="flow" string="Uso" readonly="1"/>
                            <field name="document_medium" readonly="1"/>
                            <field name="document_category" readonly="1"/>
                            <field name="help_text" readonly="1"
                                   invisible="not help_text"/>
                            <field name="origin" readonly="1" groups="base.group_no_one"/>
                            <field name="consumes_sequence_label" readonly="1"/>
                        </group>
                        <group string="Empresa y vigencia">
                            <field name="company_display" readonly="1"/>
                            <field name="company_id" readonly="1"
                                   invisible="not company_id"/>
                            <field name="date_from" readonly="1"
                                   invisible="flow == 'purchase_received'"/>
                            <field name="date_to" readonly="1"
                                   invisible="flow == 'purchase_received'"/>
                            <field name="year" readonly="1"/>
                            <field name="journal_names" readonly="1"
                                   invisible="flow == 'purchase_received'"/>
                            <field name="range_id" readonly="1"
                                   invisible="flow == 'purchase_received'"/>
                        </group>
                    </group>
                    <group string="Secuencia" invisible="flow == 'purchase_received'">
                        <group>
                            <field name="sequence_start" readonly="1"/>
                            <field name="next_sequence" readonly="1"/>
                            <field name="sequence_end" readonly="1"/>
                        </group>
                        <group>
                            <field name="next_ncf" readonly="1"/>
                            <field name="remaining_count" readonly="1"/>
                            <field name="status_label" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Histórico">
                            <group>
                                <field name="last_used" readonly="1"/>
                                <field name="usage_count" readonly="1"/>
                            </group>
                        </page>
                        <page string="Validaciones DGII">
                            <group>
                                <field name="participates_606" readonly="1"/>
                                <field name="participates_607" readonly="1"/>
                                <field name="participates_608" readonly="1"/>
                                <field name="participates_609" readonly="1"/>
                                <field name="participates_623" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- FORM CENTRO -->
    <record id="view_justech_do_fiscal_range_center_form" model="ir.ui.view">
        <field name="name">justech.do.fiscal.range.center.form</field>
        <field name="model">justech.do.fiscal.range.center</field>
        <field name="arch" type="xml">
            <form string="Centro de Rangos NCF" create="0" delete="0" class="o_justech_fiscal_range_center">
                <header>
                    <button name="action_refresh" type="object" string="Actualizar vista" class="btn-primary"/>
                    <button name="action_open_advanced_list" type="object"
                            string="Lista avanzada (filtros / agrupar)" class="btn-secondary"
                            groups="justech_l10n_do_base.group_justech_do_fiscal_manager,base.group_system"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                        <p class="text-muted">Clasificación, estado y filtros — sin alterar emisión ni secuencias.</p>
                    </div>

                    <group string="Filtros rápidos">
                        <group>
                            <field name="flow_filter" widget="radio" options="{'horizontal': true}"
                                   string="Uso"/>
                            <field name="status_filter" widget="radio" options="{'horizontal': true}"
                                   string="Estado"/>
                        </group>
                        <group>
                            <field name="medium_filter" widget="radio" options="{'horizontal': true}"
                                   string="Físico / Electrónico"/>
                            <field name="filter_company_id"
                                   options="{'no_create': True, 'no_open': True}"/>
                        </group>
                    </group>

                    <group col="3" string="Resumen (empresas activas)"
                           invisible="flow_filter == 'purchase_received'">
                        <group string="Ventas">
                            <field name="sale_types_count" string="Tipos"/>
                            <field name="sale_active_count" string="Activos"/>
                            <field name="sale_pending_count" string="Pendientes"/>
                            <field name="sale_no_range_count" string="Sin rango"/>
                        </group>
                        <group string="Compras Emitidas">
                            <field name="issued_types_count" string="Tipos"/>
                            <field name="issued_active_count" string="Activos"/>
                            <field name="issued_pending_count" string="Pendientes"/>
                            <field name="issued_no_range_count" string="Sin rango"/>
                        </group>
                        <group string="Compras Recibidas">
                            <field name="received_types_count" string="Tipos"/>
                            <field name="received_active_count" string="Activos (catálogo)"/>
                            <field name="received_pending_count" string="Inactivos"/>
                        </group>
                    </group>

                    <field name="filtered_line_ids"
                           nolabel="1"
                           mode="list"
                           context="{'tree_view_ref': 'justech_l10n_do_ncf.view_justech_do_fiscal_range_center_line_list',
                                     'form_view_ref': 'justech_l10n_do_ncf.view_justech_do_fiscal_range_center_line_form'}"/>

                    <div class="alert alert-info" role="alert">
                        <p><strong>Ventas / Compras Emitidas:</strong> rangos propios. Consumen secuencia al publicar.</p>
                        <p><strong>Compras Recibidas:</strong> tipos LATAM del proveedor. NCF manual; no consumen secuencia Justech.</p>
                        <p><strong>Badges:</strong> Activo=verde · Inactivo=gris · Vencido=rojo · Agotado=naranja · Borrador=azul.</p>
                        <p>Use <em>Lista con filtros / agrupar</em> para búsqueda y group-by. <em>Actualizar vista</em> solo recalcula esta pantalla.</p>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_justech_do_fiscal_range_center" model="ir.actions.server">
        <field name="name">Rangos</field>
        <field name="model_id" ref="model_justech_do_fiscal_range_center"/>
        <field name="state">code</field>
        <field name="code">action = env['justech.do.fiscal.range.center'].action_open()</field>
    </record>

    <record id="action_justech_do_fiscal_range_center_line" model="ir.actions.act_window">
        <field name="name">Centro de Rangos — Lista</field>
        <field name="res_model">justech.do.fiscal.range.center.line</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_justech_do_fiscal_range_center_line_search"/>
        <field name="context">{}</field>
    </record>
</odoo>
