<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_justech_do_purchase_emission_config_list" model="ir.ui.view">
        <field name="name">justech.do.purchase.emission.config.list</field>
        <field name="model">justech.do.purchase.emission.config</field>
        <field name="arch" type="xml">
            <list string="Comprobantes emitidos desde Compras" create="0" delete="0">
                <field name="company_id"/>
                <field name="prefix"/>
                <field name="name_full"/>
                <field name="status_label"/>
                <field name="emission_enabled"/>
                <field name="next_ncf"/>
                <field name="sequence_start"/>
                <field name="sequence_end"/>
                <field name="expiration_date"/>
                <field name="range_id"/>
            </list>
        </field>
    </record>

    <record id="view_justech_do_purchase_emission_config_form" model="ir.ui.view">
        <field name="name">justech.do.purchase.emission.config.form</field>
        <field name="model">justech.do.purchase.emission.config</field>
        <field name="arch" type="xml">
            <form string="Comprobante emitido desde Compras" create="0" delete="0">
                <header>
                    <button name="action_open_range"
                            type="object"
                            string="Administrar rango"
                            class="btn-primary"
                            groups="justech_l10n_do_base.group_justech_do_fiscal_manager,base.group_system"/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="alert">
                        Emisión Justech (B11 / B13 / B17). El NCF se asigna al publicar
                        solo si existe rango autorizado de la empresa. Sin rango: visible
                        e inactivo; no se inventa próximo NCF.
                    </div>
                    <group>
                        <group string="Empresa y tipo">
                            <field name="company_id" readonly="1"/>
                            <field name="document_type_id" readonly="1"/>
                            <field name="prefix" readonly="1"/>
                            <field name="name_full" readonly="1"/>
                            <field name="allows_purchase_emission"
                                   groups="justech_l10n_do_base.group_justech_do_fiscal_manager,base.group_system"/>
                        </group>
                        <group string="Rango y secuencia">
                            <field name="status_label" readonly="1"/>
                            <field name="emission_enabled" readonly="1"/>
                            <field name="range_id" readonly="1"/>
                            <field name="authorization_date" readonly="1"/>
                            <field name="expiration_date" readonly="1"/>
                            <field name="sequence_start" readonly="1"/>
                            <field name="sequence_end" readonly="1"/>
                            <field name="next_ncf" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_justech_do_purchase_emission_config" model="ir.actions.act_window">
        <field name="name">Comprobantes emitidos desde Compras</field>
        <field name="res_model">justech.do.purchase.emission.config</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p>
                Configuración por empresa de B11, B13 y B17.
                Consume secuencia Justech únicamente al publicar con rango activo.
            </p>
        </field>
    </record>

    <record id="action_justech_do_purchase_ncf_ranges" model="ir.actions.act_window">
        <field name="name">Rangos de Compras</field>
        <field name="res_model">justech.do.ncf.range</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('prefix', 'in', ('B11', 'B13', 'B17'))]</field>
        <field name="context">{'default_prefix': 'B11'}</field>
        <field name="help" type="html">
            <p>
                Rangos NCF autorizados para emisión desde Compras (B11/B13/B17).
                Separados por empresa. No se crean rangos ficticios automáticamente.
            </p>
        </field>
    </record>
</odoo>
