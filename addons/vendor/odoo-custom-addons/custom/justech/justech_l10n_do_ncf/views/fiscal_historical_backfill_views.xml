<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_justech_do_fiscal_historical_backfill_form" model="ir.ui.view">
        <field name="name">justech.do.fiscal.historical.backfill.wizard.form</field>
        <field name="model">justech.do.fiscal.historical.backfill.wizard</field>
        <field name="arch" type="xml">
            <form string="Sincronizar anulaciones históricas">
                <header>
                    <button name="action_preview" type="object" string="Vista previa"
                            class="btn-primary"
                            invisible="state == 'done'"/>
                    <button name="action_execute" type="object"
                            string="Crear regularizaciones faltantes"
                            class="btn-warning"
                            invisible="state != 'preview'"
                            groups="justech_l10n_do_base.group_justech_do_fiscal_manager,account.group_account_manager,base.group_system"
                            confirm="¿Crear solo las regularizaciones seleccionadas/elegibles? No modifica asientos, NCF ni presenta reportes DGII."/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="company_id" options="{'no_create': True}"/>
                            <field name="filter_all_allowed_companies"/>
                        </group>
                        <group>
                            <field name="count_analyzed"/>
                            <field name="count_to_create"/>
                            <field name="count_to_review"/>
                            <field name="count_existing"/>
                            <field name="count_skipped"/>
                            <field name="count_created" invisible="state != 'done'"/>
                            <field name="count_omitted" invisible="state != 'done'"/>
                        </group>
                    </group>
                    <field name="notes" readonly="1" nolabel="1"/>
                    <field name="execution_log" readonly="1" nolabel="1"
                           invisible="not execution_log"/>
                    <separator string="Vista previa"/>
                    <field name="line_ids" nolabel="1">
                        <list create="0" delete="0" editable="bottom">
                            <field name="selected"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="move_id"/>
                            <field name="ncf"/>
                            <field name="document_type"/>
                            <field name="invoice_date"/>
                            <field name="void_date"/>
                            <field name="original_fiscal_period"/>
                            <field name="reporting_period_608"/>
                            <field name="was_in_607"/>
                            <field name="rectify_607"/>
                            <field name="evaluate_it1"/>
                            <field name="annulment_type_608"/>
                            <field name="existing_regularization_id"/>
                            <field name="proposed_action"/>
                            <field name="warnings"/>
                            <field name="period_source" optional="hide"/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button string="Cerrar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_justech_do_fiscal_historical_backfill" model="ir.actions.server">
        <field name="name">Sincronizar anulaciones históricas</field>
        <field name="model_id" ref="model_justech_do_fiscal_historical_backfill_wizard"/>
        <field name="state">code</field>
        <field name="code">action = env['justech.do.fiscal.historical.backfill.wizard'].action_open_wizard()</field>
        <field name="group_ids" eval="[(4, ref('justech_l10n_do_base.group_justech_do_fiscal_user')), (4, ref('account.group_account_manager')), (4, ref('base.group_system'))]"/>
    </record>
</odoo>
