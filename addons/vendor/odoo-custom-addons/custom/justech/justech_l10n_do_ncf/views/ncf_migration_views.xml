<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Migración -->
    <record id="view_justech_do_ncf_migration_wizard_form" model="ir.ui.view">
        <field name="name">justech.do.ncf.migration.wizard.form</field>
        <field name="model">justech.do.ncf.migration.wizard</field>
        <field name="arch" type="xml">
            <form string="Migrar numeración fiscal al Motor Justech">
                <header>
                    <button name="action_preview" type="object" string="Previsualizar"
                            class="btn-primary" invisible="state == 'done'"/>
                    <button name="action_apply_selected" type="object"
                            string="Crear rangos Justech seleccionados"
                            class="btn-primary"
                            invisible="state != 'preview'"
                            confirm="¿Crear/activar rangos Justech para las líneas seleccionadas? No se modificarán facturas históricas ni secuencias legacy."/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="alert" invisible="state != 'draft'">
                        Calcula el siguiente NCF seguro a partir del máximo publicado,
                        legacy y Justech. No aplica cambios hasta confirmar tras la previsualización.
                    </div>
                    <group>
                        <field name="company_ids" widget="many2many_tags"
                                 options="{'no_create': True}"
                                 readonly="state != 'draft'"/>
                        <field name="ready_count"/>
                        <field name="blocked_count"/>
                        <field name="skip_count"/>
                    </group>
                    <field name="line_ids" nolabel="1" readonly="state == 'done'">
                        <list editable="bottom" decoration-danger="status == 'blocked'"
                              decoration-success="status == 'ready'"
                              decoration-muted="status == 'skip'"
                              decoration-warning="status == 'reconcile'">
                            <field name="selected" readonly="status not in ('ready', 'reconcile')"/>
                            <field name="company_id"/>
                            <field name="prefix"/>
                            <field name="document_type_name"/>
                            <field name="max_published_ncf"/>
                            <field name="legacy_number_next"/>
                            <field name="legacy_end"/>
                            <field name="justech_next"/>
                            <field name="proposed_next_ncf"/>
                            <field name="proposed_end"/>
                            <field name="status"/>
                            <field name="block_reasons"/>
                            <field name="proposal_json" column_invisible="1"/>
                        </list>
                    </field>
                    <group invisible="not result_summary">
                        <field name="result_summary" nolabel="1"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Cerrar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_justech_do_ncf_migration_wizard" model="ir.actions.server">
        <field name="name">Migrar numeración fiscal al Motor Justech</field>
        <field name="model_id" ref="model_justech_do_ncf_migration_wizard"/>
        <field name="state">code</field>
        <field name="group_ids" eval="[(4, ref('base.group_system')), (4, ref('justech_l10n_do_base.group_justech_do_fiscal_manager'))]"/>
        <field name="code">
action = model.action_open_wizard()
        </field>
    </record>

    <!-- Reconciliación -->
    <record id="view_justech_do_ncf_reconcile_wizard_form" model="ir.ui.view">
        <field name="name">justech.do.ncf.reconcile.wizard.form</field>
        <field name="model">justech.do.ncf.reconcile.wizard</field>
        <field name="arch" type="xml">
            <form string="Reconciliar numeración fiscal">
                <header>
                    <button name="action_preview" type="object" string="Previsualizar"
                            class="btn-primary" invisible="state == 'done'"/>
                    <button name="action_apply_selected" type="object"
                            string="Avanzar secuencias seleccionadas"
                            class="btn-primary"
                            invisible="state != 'preview'"
                            confirm="¿Avanzar next_sequence Justech? Nunca retrocede. No modifica documentos."/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="alert">
                        Usar después de sincronizar transacciones desde Producción.
                        Solo avanza el Motor Justech si quedó por detrás del último NCF publicado.
                    </div>
                    <group>
                        <field name="company_ids" widget="many2many_tags"
                                 options="{'no_create': True}"
                                 readonly="state != 'draft'"/>
                    </group>
                    <field name="line_ids" nolabel="1" readonly="state == 'done'">
                        <list editable="bottom" decoration-danger="status == 'blocked'"
                              decoration-success="status == 'ok'"
                              decoration-warning="status == 'advance'">
                            <field name="selected" readonly="status != 'advance'"/>
                            <field name="company_id"/>
                            <field name="prefix"/>
                            <field name="range_id"/>
                            <field name="current_next"/>
                            <field name="max_published_ncf"/>
                            <field name="safe_next"/>
                            <field name="status"/>
                            <field name="block_reasons"/>
                            <field name="proposal_json" column_invisible="1"/>
                        </list>
                    </field>
                    <group invisible="not result_summary">
                        <field name="result_summary" nolabel="1"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Cerrar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_justech_do_ncf_reconcile_wizard" model="ir.actions.server">
        <field name="name">Reconciliar numeración fiscal</field>
        <field name="model_id" ref="model_justech_do_ncf_reconcile_wizard"/>
        <field name="state">code</field>
        <field name="group_ids" eval="[(4, ref('base.group_system')), (4, ref('justech_l10n_do_base.group_justech_do_fiscal_manager'))]"/>
        <field name="code">
action = model.action_open_wizard()
        </field>
    </record>

    <record id="view_justech_do_ncf_migration_log_list" model="ir.ui.view">
        <field name="name">justech.do.ncf.migration.log.list</field>
        <field name="model">justech.do.ncf.migration.log</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false">
                <field name="create_date"/>
                <field name="company_id"/>
                <field name="prefix"/>
                <field name="source"/>
                <field name="last_published_ncf"/>
                <field name="safe_next"/>
                <field name="range_id"/>
                <field name="user_id"/>
                <field name="evidence_hash"/>
            </list>
        </field>
    </record>

    <record id="action_justech_do_ncf_migration_log" model="ir.actions.act_window">
        <field name="name">Auditoría migración NCF</field>
        <field name="res_model">justech.do.ncf.migration.log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
