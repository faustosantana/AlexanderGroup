<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_justech_do" model="ir.ui.view">
        <field name="name">res.company.form.justech.do</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_info']" position="after">
                <page string="Localización Dominicana" name="justech_do_fiscal">
                    <group>
                        <field name="justech_do_fiscal_enabled"/>
                        <field name="justech_do_ncf_alert_threshold_preventive"/>
                        <field name="justech_do_ncf_alert_threshold_critical"/>
                        <field name="justech_do_ncf_alert_expiry_days"/>
                        <field name="justech_do_ncf_alert_days" invisible="1"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
