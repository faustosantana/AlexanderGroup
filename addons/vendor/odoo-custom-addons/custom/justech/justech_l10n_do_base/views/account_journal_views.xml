<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_journal_form_justech_do" model="ir.ui.view">
        <field name="name">account.journal.form.justech.do</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='advanced_settings']" position="inside">
                <group string="Dominican NCF">
                    <field name="justech_do_use_ncf"/>
                    <field name="justech_do_default_document_type_id"/>
                    <field name="justech_do_document_type_ids" widget="many2many_tags"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
