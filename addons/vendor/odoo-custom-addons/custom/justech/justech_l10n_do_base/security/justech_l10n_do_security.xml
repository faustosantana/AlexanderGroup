<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Roles fiscales Justech (nombres de negocio; XMLIDs estables) -->
    <record id="group_justech_do_fiscal_user" model="res.groups">
        <field name="name">Usuario Fiscal</field>
        <field name="comment">Consulta, validación RNC, comprobantes y operación fiscal básica.</field>
        <field name="privilege_id" ref="account.res_groups_privilege_accounting"/>
        <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
    </record>
    <record id="group_justech_do_fiscal_manager" model="res.groups">
        <field name="name">Responsable Fiscal</field>
        <field name="comment">Revisión DGII, Centro Fiscal en lectura, rangos, consumo, alertas y revalidación. Sin configuración crítica, padrón, feature flags ni permisos.</field>
        <field name="privilege_id" ref="account.res_groups_privilege_accounting"/>
        <field name="implied_ids" eval="[(4, ref('group_justech_do_fiscal_user'))]"/>
    </record>
    <!-- Contable estándar: NO hereda acceso fiscal automáticamente.
         El acceso fiscal se asigna explícitamente (Usuario/Responsable/Administrador). -->
    <record id="account.group_account_manager" model="res.groups">
        <field name="implied_ids" eval="[(3, ref('group_justech_do_fiscal_user'))]"/>
    </record>
    <record id="account.group_account_user" model="res.groups">
        <field name="implied_ids" eval="[(3, ref('group_justech_do_fiscal_user'))]"/>
    </record>
</odoo>
