<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        P0: remove duplicate customer block under company header on quotations.
        Root cause: sale.report_saleorder_document sets t-set="address" with
        doc.partner_id; web.external_layout_bubble prints it via web.address_layout.
        Keep #informations / customer_info as the only customer block.
        Do NOT alter web.external_layout_bubble or web.address_layout globally.
    -->
    <template
        id="report_saleorder_document_hide_header_address"
        inherit_id="sale.report_saleorder_document"
        priority="99"
    >
        <xpath expr="//t[@t-set='address']" position="replace">
            <t t-set="address" t-value="False"/>
        </xpath>
    </template>
</odoo>
