<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="cron_purchase_sale_recompute_links" model="ir.cron">
            <field name="name">Margen compra-venta: recalcular enlaces pendientes</field>
            <field name="model_id" ref="model_purchase_sale_cost_link"/>
            <field name="state">code</field>
            <field name="code">model.env["purchase.sale.trace.engine"].cron_recompute_pending_links()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="False"/>
        </record>

        <record id="cron_purchase_sale_margin_alerts" model="ir.cron">
            <field name="name">Margen compra-venta: alertas de margen negativo</field>
            <field name="model_id" ref="model_purchase_sale_margin_snapshot"/>
            <field name="state">code</field>
            <field name="code">model.env["purchase.sale.margin.service"].cron_flag_margin_alerts()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="active" eval="False"/>
        </record>

        <!-- 19.0.3.0.0: Auxiliar de Cuentas por Pagar -->
        <record id="cron_purchase_sale_payable_auxiliary_refresh" model="ir.cron">
            <field name="name">Auxiliar CxP: actualizar estado operativo</field>
            <field name="model_id" ref="model_purchase_sale_payable_auxiliary"/>
            <field name="state">code</field>
            <field name="code">model.env["purchase.sale.payable.auxiliary"].cron_refresh_all()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="False"/>
        </record>

        <!-- 19.0.8.29.7: auto-confirm MTX when SO→PO→Bill FKs are strong -->
        <record id="cron_margin_auto_confirm_strong_trace" model="ir.cron">
            <field name="name">Márgenes: auto-confirmar trazabilidad fuerte SO→OC→FP</field>
            <field name="model_id" ref="model_purchase_sale_margin_transaction"/>
            <field name="state">code</field>
            <field name="code">model._cron_auto_confirm_strong_trace()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="False"/>
        </record>

    </data>
</odoo>
