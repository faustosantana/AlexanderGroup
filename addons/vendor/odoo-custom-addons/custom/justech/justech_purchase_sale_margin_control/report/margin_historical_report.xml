<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_sale_margin_report_wizard_form" model="ir.ui.view">
        <field name="name">purchase.sale.margin.report.wizard.form</field>
        <field name="model">purchase.sale.margin.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Reportes históricos">
                <group>
                    <group>
                        <field name="report_type"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="company_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        <field name="header_company_id" options="{'no_create': True}"
                                 help="Define logo y datos legales del PDF."/>
                    </group>
                </group>
                <footer>
                    <button name="action_generate_preview" type="object" string="Vista previa" class="btn-primary"/>
                    <button name="action_print_pdf" type="object" string="Imprimir PDF" class="btn-secondary"/>
                    <button string="Cerrar" special="cancel" class="btn-secondary"/>
                </footer>
                <field name="line_ids" readonly="1">
                    <list create="0" delete="0">
                        <field name="company_id"/>
                        <field name="transaction_id"/>
                        <field name="customer_id"/>
                        <field name="sale_amount"/>
                        <field name="cost_amount"/>
                        <field name="margin_amount"/>
                        <field name="margin_pct"/>
                        <field name="margin_band"/>
                        <field name="next_action" optional="hide"/>
                    </list>
                </field>
            </form>
        </field>
    </record>

    <record id="action_purchase_sale_margin_report_wizard" model="ir.actions.act_window">
        <field name="name">Reportes históricos</field>
        <field name="res_model">purchase.sale.margin.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <template id="report_margin_historical_pdf_document">
        <t t-call="web.external_layout">
            <div class="page">
                <h2>Reporte de márgenes compra-venta</h2>
                <p>
                    Compañías:
                    <t t-esc="', '.join(doc.company_ids.mapped('name'))"/>
                    · Desde <span t-field="doc.date_from"/> hasta <span t-field="doc.date_to"/>
                    · Generado por <t t-esc="user.name"/>
                </p>
                <table class="table table-sm o_main_table">
                    <thead>
                        <tr>
                            <th>Empresa</th>
                            <th>Operación</th>
                            <th>Cliente</th>
                            <th class="text-end">Venta</th>
                            <th class="text-end">Costo</th>
                            <th class="text-end">Margen</th>
                            <th class="text-end">Margen %</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="doc.line_ids" t-as="line">
                            <td><t t-esc="line.company_id.name"/></td>
                            <td><t t-esc="line.transaction_id.display_name"/></td>
                            <td><t t-esc="line.customer_id.name"/></td>
                            <td class="text-end"><t t-esc="'%.2f' % (line.sale_amount or 0)"/></td>
                            <td class="text-end"><t t-esc="'%.2f' % (line.cost_amount or 0)"/></td>
                            <td class="text-end"><t t-esc="'%.2f' % (line.margin_amount or 0)"/></td>
                            <td class="text-end"><t t-esc="'%.2f' % (line.margin_pct or 0)"/></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </t>
    </template>

    <template id="report_margin_historical_pdf">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="company" t-value="doc._get_report_header_company()"/>
                <t t-call="justech_purchase_sale_margin_control.report_margin_historical_pdf_document"/>
            </t>
        </t>
    </template>

    <record id="action_report_margin_historical_pdf" model="ir.actions.report">
        <field name="name">Márgenes históricos (PDF)</field>
        <field name="model">purchase.sale.margin.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">justech_purchase_sale_margin_control.report_margin_historical_pdf</field>
        <field name="report_file">justech_purchase_sale_margin_control.report_margin_historical_pdf</field>
        <field name="print_report_name">'Margenes_%s' % (object.date_to)</field>
        <field name="binding_model_id" eval="False"/>
    </record>
</odoo>
