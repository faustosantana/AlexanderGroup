<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="paperformat_payable_operational_landscape" model="report.paperformat">
        <field name="name">CxP Operativo A4 Horizontal</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">20</field>
        <field name="margin_bottom">12</field>
        <field name="margin_left">8</field>
        <field name="margin_right">8</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">16</field>
        <field name="dpi">96</field>
    </record>

    <record id="view_purchase_sale_payable_auxiliary_report_form" model="ir.ui.view">
        <field name="name">purchase.sale.payable.auxiliary.report.form</field>
        <field name="model">purchase.sale.payable.auxiliary.report</field>
        <field name="arch" type="xml">
            <form string="Cuentas por Pagar">
                <sheet>
                    <group>
                        <group string="Período">
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                        <group string="Filtros">
                            <field name="company_ids" widget="many2many_tags" options="{'no_create': True}"
                                     groups="base.group_multi_company"/>
                            <field name="company_id" invisible="1"/>
                            <field name="vendor_id" options="{'no_create': True}"/>
                            <field name="situation_filter"/>
                        </group>
                    </group>
                    <div invisible="not export_filename">
                        <field name="export_filename" readonly="1"/>
                    </div>
                </sheet>
                <footer>
                    <button name="action_preview" type="object" string="Previsualizar" class="btn-primary"/>
                    <button name="action_download_pdf" type="object" string="Descargar PDF" class="btn-secondary"/>
                    <button name="action_download_xlsx" type="object" string="Descargar Excel" class="btn-secondary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_purchase_sale_payable_auxiliary_report" model="ir.actions.act_window">
        <field name="name">Cuentas por Pagar</field>
        <field name="res_model">purchase.sale.payable.auxiliary.report</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <template id="report_payable_operational_document">
        <t t-set="ctx" t-value="doc._report_context()"/>
        <div class="page jm-cxp-op" style="font-family: system-ui, sans-serif; font-size: 12.5px; color: #111;">
            <h2 style="margin:0 0 6px; font-size:18px;">Cuentas por Pagar</h2>
            <div style="margin-bottom:10px; font-size:12px; color:#444;">
                <div>Período: <t t-esc="ctx['date_from']"/> – <t t-esc="ctx['date_to']"/></div>
                <div>Compañías: <t t-esc="ctx['company_names']"/></div>
                <div>Generado: <t t-esc="ctx['generated_at']"/> · Usuario: <t t-esc="ctx['user_name']"/></div>
            </div>

            <t t-set="summary" t-value="ctx['summary']"/>
            <table style="width:100%; border-collapse:collapse; margin-bottom:12px; font-size:12.5px;">
                <tr>
                    <td style="padding:6px 8px; border:1px solid #ddd; background:#f8fafc;">
                        <div style="font-size:11px; color:#666;">FACTURAS PENDIENTES</div>
                        <div style="font-size:16px; font-weight:700;"><t t-esc="summary['bill_count']"/></div>
                    </td>
                    <td style="padding:6px 8px; border:1px solid #ddd; background:#f8fafc;">
                        <div style="font-size:11px; color:#666;">RELACIONADAS CON VENTAS</div>
                        <div style="font-size:16px; font-weight:700;"><t t-esc="summary['related']"/></div>
                    </td>
                    <td style="padding:6px 8px; border:1px solid #ddd; background:#f8fafc;">
                        <div style="font-size:11px; color:#666;">SIN VENTA</div>
                        <div style="font-size:16px; font-weight:700;"><t t-esc="summary['no_sale']"/></div>
                    </td>
                    <td style="padding:6px 8px; border:1px solid #ddd; background:#f8fafc;">
                        <div style="font-size:11px; color:#666;">CLIENTES COBRADOS</div>
                        <div style="font-size:16px; font-weight:700;"><t t-esc="summary['collected']"/></div>
                    </td>
                    <td style="padding:6px 8px; border:1px solid #ddd; background:#f8fafc;">
                        <div style="font-size:11px; color:#666;">CLIENTES PENDIENTES</div>
                        <div style="font-size:16px; font-weight:700;"><t t-esc="summary['pending_cust']"/></div>
                    </td>
                </tr>
            </table>

            <div style="margin-bottom:10px; font-size:12.5px;">
                <strong>Total por pagar por moneda</strong>
                <t t-foreach="summary['by_currency']" t-as="cur">
                    <div>
                        <t t-esc="cur['currency']"/>:
                        <t t-esc="'%.2f' % cur['residual']"/>
                        (<t t-esc="cur['count']"/> facturas)
                    </div>
                </t>
            </div>

            <t t-foreach="ctx['rows']" t-as="r">
                <div style="border:1px solid #d1d5db; border-radius:6px; padding:8px 10px; margin-bottom:8px; page-break-inside:avoid;">
                    <table style="width:100%; border-collapse:collapse;">
                        <tr>
                            <td style="width:50%; vertical-align:top; padding-right:8px;">
                                <div style="font-size:11px; color:#666; font-weight:700;">COSTO / PROVEEDOR</div>
                                <div style="font-weight:700; font-size:13px;"><t t-esc="r['vendor']"/></div>
                                <div><t t-esc="r['bill_name']"/> · NCF <t t-esc="r['ncf'] or '—'"/></div>
                                <div>Fecha <t t-esc="r['invoice_date'] or '—'"/> · Vence <t t-esc="r['invoice_date_due'] or '—'"/></div>
                                <div>OC: <t t-esc="r['po_names']"/></div>
                                <div style="margin-top:4px;">
                                    Total <strong><t t-esc="r['currency']"/> <t t-esc="'%.2f' % r['amount_total']"/></strong>
                                    · Pagado <t t-esc="'%.2f' % r['amount_paid']"/>
                                    · <strong>Saldo <t t-esc="'%.2f' % r['amount_residual']"/></strong>
                                    · <t t-esc="r['payment_state']"/>
                                </div>
                            </td>
                            <td style="width:50%; vertical-align:top; padding-left:8px; border-left:1px solid #e5e7eb;">
                                <div style="font-size:11px; color:#666; font-weight:700;">VENTA / CLIENTE</div>
                                <div>Venta: <t t-esc="r['so_names']"/></div>
                                <div>Cliente: <t t-esc="r['customer']"/></div>
                                <div>Factura cliente: <t t-esc="r['customer_invoice']"/></div>
                                <div>Cobro: <strong><t t-esc="r['customer_collection']"/></strong></div>
                                <div style="margin-top:4px;">
                                    Relación: <t t-esc="r['relation_state']"/>
                                    · Situación: <t t-esc="r['situation']"/>
                                </div>
                                <div>
                                    <t t-if="r['sale_amount'] is not None">
                                        Venta <t t-esc="'%.2f' % r['sale_amount']"/>
                                        − Costo <t t-esc="'%.2f' % r['cost_amount']"/>
                                        = Margen <strong><t t-esc="'%.2f' % (r['margin'] or 0)"/></strong>
                                        (<t t-esc="'%.1f' % (r['margin_pct'] or 0)"/>%)
                                    </t>
                                    <t t-else="">Margen: —</t>
                                </div>
                            </td>
                        </tr>
                    </table>
                </div>
            </t>

            <t t-if="not ctx['rows']">
                <div style="padding:16px; color:#666;">No hay facturas de proveedor pendientes para los filtros seleccionados.</div>
            </t>
        </div>
    </template>

    <template id="report_payable_operational">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="justech_purchase_sale_margin_control.report_payable_operational_document"/>
            </t>
        </t>
    </template>

    <record id="action_report_payable_operational_pdf" model="ir.actions.report">
        <field name="name">Cuentas por Pagar (PDF)</field>
        <field name="model">purchase.sale.payable.auxiliary.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">justech_purchase_sale_margin_control.report_payable_operational</field>
        <field name="report_file">justech_purchase_sale_margin_control.report_payable_operational</field>
        <field name="print_report_name">'Cuentas_por_Pagar_%s' % (object.date_to)</field>
        <field name="paperformat_id" ref="paperformat_payable_operational_landscape"/>
    </record>

</odoo>
