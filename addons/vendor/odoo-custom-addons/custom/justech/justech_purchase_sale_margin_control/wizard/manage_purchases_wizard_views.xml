<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- HUB operativo limpio: cobertura inventario + compra -->
    <record id="view_purchase_sale_manage_purchases_wizard_form" model="ir.ui.view">
        <field name="name">purchase.sale.manage.purchases.wizard.form</field>
        <field name="model">purchase.sale.manage.purchases.wizard</field>
        <field name="arch" type="xml">
            <form string="Gestionar compras">
                <field name="company_id" invisible="1"/>
                <field name="currency_id" invisible="1"/>
                <field name="has_pending" invisible="1"/>
                <field name="demand_source" invisible="1"/>
                <field name="is_readonly_mode" invisible="1"/>
                <field name="show_more_options" invisible="1"/>
                <field name="show_operation_info" invisible="1"/>
                <field name="show_line_detail" invisible="1"/>
                <field name="summary_html" invisible="1"/>
                <field name="primary_sale_order_id" invisible="1"/>
                <field name="detail_line_id" invisible="1"/>

                <field name="header_html" nolabel="1" colspan="2"/>
                <field name="coverage_summary_html" nolabel="1" colspan="2"/>

                <separator string="Artículos"/>
                <div class="mb-2" invisible="is_readonly_mode">
                    <button name="action_select_all_lines" type="object"
                            string="Seleccionar sin cubrir" class="btn-link btn-sm"/>
                    <button name="action_clear_selection" type="object"
                            string="Quitar selección" class="btn-link btn-sm"/>
                </div>
                <field name="line_ids" nolabel="1" colspan="2">
                    <list create="0" delete="0" edit="1" open_form_view="false"
                          decoration-danger="line_status == 'pending'"
                          decoration-warning="line_status == 'partial'"
                          decoration-success="line_status == 'complete'">
                        <field name="selected" string=" " widget="boolean_toggle"
                                 readonly="not selection_allowed or parent.is_readonly_mode"/>
                        <field name="selection_allowed" column_invisible="1"/>
                        <field name="product_name" string="Artículo" readonly="1"/>
                        <field name="sold_qty" string="Vendido" sum="Vendido" readonly="1"/>
                        <field name="historical_qty" string="Inventario" sum="Inventario" readonly="1"/>
                        <field name="purchase_qty" string="En compra" sum="En compra" readonly="1"/>
                        <field name="pending_qty" string="Sin cubrir" sum="Sin cubrir" readonly="1"/>
                        <field name="pending_receive_qty" string="Pend. recibir" optional="hide" readonly="1"/>
                        <field name="status_label" string="Estado" readonly="1"/>
                        <field name="line_status" column_invisible="1"/>
                        <field name="sale_line_id" column_invisible="1"/>
                        <field name="product_id" column_invisible="1"/>
                        <field name="covered_qty" column_invisible="1"/>
                        <field name="stock_available" column_invisible="1"/>
                    </list>
                </field>

                <group invisible="not show_line_detail" string="Detalle de costo">
                    <field name="detail_html" nolabel="1" colspan="2"/>
                    <div colspan="2">
                        <button name="action_detail_open_purchase" type="object"
                                string="Ver OC" class="btn-secondary"/>
                        <button name="action_close_line_detail" type="object"
                                string="Cerrar" class="btn-link"/>
                    </div>
                </group>

                <separator string="Acciones" invisible="is_readonly_mode or not has_pending"/>
                <div class="mb-3" invisible="is_readonly_mode or not has_pending">
                    <button name="action_open_inventory" type="object"
                            string="Usar inventario" class="btn-secondary"/>
                    <button name="action_open_link_purchase" type="object"
                            string="Vincular compra existente" class="btn-secondary"/>
                    <button name="action_open_create_purchase" type="object"
                            string="Crear nueva compra" class="btn-primary"/>
                </div>

                <div class="text-muted mt-3 mb-1" colspan="2">
                    <button name="action_toggle_operation_info" type="object"
                            string="Detalle de documentos"
                            class="btn-link btn-sm text-muted"/>
                    <button name="action_toggle_more_options" type="object"
                            string="Más opciones"
                            class="btn-link btn-sm text-muted"
                            groups="base.group_system"/>
                </div>

                <group invisible="not show_operation_info" string="Detalle de documentos">
                    <field name="documents_html" nolabel="1" colspan="2"/>
                    <field name="sale_label" string="Venta" readonly="1"/>
                    <field name="invoice_label" string="Factura" readonly="1"/>
                    <field name="customer_label" string="Cliente" readonly="1"/>
                    <field name="salesperson_label" string="Vendedor" readonly="1"/>
                    <field name="sale_untaxed" string="Venta sin ITBIS" readonly="1"/>
                    <field name="coverage_pct" string="Cobertura %" readonly="1" widget="progressbar"/>
                    <field name="coverage_state" string="Estado de costos" readonly="1"/>
                </group>

                <group invisible="not show_more_options"
                       string="Más opciones (administración)"
                       groups="base.group_system">
                    <div colspan="2">
                        <button name="action_relate_existing_purchases" type="object"
                                string="Asistente avanzado (admin)" class="btn-link"/>
                        <button name="action_open_historical_cost" type="object"
                                string="Histórico masivo" class="btn-link"/>
                    </div>
                </group>

                <footer>
                    <button string="Cerrar" special="cancel" class="btn-primary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_purchase_sale_manage_purchases_wizard" model="ir.actions.act_window">
        <field name="name">Gestionar compras</field>
        <field name="res_model">purchase.sale.manage.purchases.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
