<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_sale_cost_breakdown_wizard_form" model="ir.ui.view">
        <field name="name">purchase.sale.cost.breakdown.wizard.form</field>
        <field name="model">purchase.sale.cost.breakdown.wizard</field>
        <field name="arch" type="xml">
            <form string="Costos y Márgenes" create="0" edit="0" delete="0">
                <group>
                    <group>
                        <field name="sale_order_id"/>
                        <field name="sale_untaxed"/>
                        <field name="total_cost"/>
                    </group>
                    <group>
                        <field name="margin_amount"/>
                        <field name="margin_pct" widget="float"/>
                        <field name="cost_origin"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                </group>
                <field name="line_ids" nolabel="1">
                    <list create="0" delete="0" edit="0">
                        <field name="product_id"/>
                        <field name="sold_qty"/>
                        <field name="unit_cost"/>
                        <field name="total_cost"/>
                        <field name="source_label"/>
                        <field name="document_name"/>
                        <button name="action_open_document" type="object" string="Abrir"
                                icon="fa-external-link"
                                invisible="not vendor_bill_id and not purchase_order_id"/>
                        <field name="vendor_bill_id" column_invisible="1"/>
                        <field name="purchase_order_id" column_invisible="1"/>
                        <field name="currency_id" column_invisible="1"/>
                        <field name="cost_qty" column_invisible="1"/>
                    </list>
                </field>
                <footer>
                    <button string="Cerrar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
