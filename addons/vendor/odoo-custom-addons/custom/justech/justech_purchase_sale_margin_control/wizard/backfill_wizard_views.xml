<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_purchase_sale_backfill_wizard_form" model="ir.ui.view">
        <field name="name">purchase.sale.backfill.wizard.form</field>
        <field name="model">purchase.sale.backfill.wizard</field>
        <field name="arch" type="xml">
            <form string="Backfill de trazabilidad compra-venta">
                <sheet>
                    <group>
                        <group>
                            <field name="year"/>
                            <field name="company_ids" widget="many2many_tags"/>
                            <field name="dry_run"/>
                            <field name="batch_size"/>
                        </group>
                        <group>
                            <field name="date_from" readonly="1"/>
                            <field name="date_to" readonly="1"/>
                            <field name="state" widget="badge"/>
                        </group>
                    </group>
                    <group string="Resultado" invisible="state != 'done'">
                        <group>
                            <field name="scanned_po_lines"/>
                            <field name="links_created"/>
                            <field name="links_updated"/>
                        </group>
                        <group>
                            <field name="scanned_bill_lines"/>
                            <field name="allocations_created"/>
                            <field name="allocations_updated"/>
                            <field name="skipped_manual_locked"/>
                        </group>
                    </group>
                    <field name="result_summary" readonly="1" invisible="not result_summary"/>
                </sheet>
                <footer>
                    <button name="action_run" type="object" string="Ejecutar" class="btn-primary"/>
                    <button string="Cerrar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_purchase_sale_backfill_wizard" model="ir.actions.act_window">
        <field name="name">Backfill trazabilidad 2026</field>
        <field name="res_model">purchase.sale.backfill.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
