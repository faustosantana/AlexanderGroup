<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_purchase_sale_product_cost_wizard_form" model="ir.ui.view">
        <field name="name">purchase.sale.product.cost.wizard.form</field>
        <field name="model">purchase.sale.product.cost.wizard</field>
        <field name="arch" type="xml">
            <form string="Gestionar costo">
                <field name="hub_wizard_id" invisible="1"/>
                <field name="company_id" invisible="1"/>
                <field name="sale_line_id" invisible="1"/>
                <field name="product_id" invisible="1"/>
                <field name="is_readonly" invisible="1"/>
                <field name="step" invisible="1"/>
                <field name="purchase_order_domain" invisible="1"/>
                <field name="vendor_bill_domain" invisible="1"/>

                <group>
                    <div colspan="2">
                        <h2>GESTIONAR COSTO</h2>
                        <p><b><field name="product_label" nolabel="1"/></b></p>
                        <p>
                            Vendido: <field name="sold_qty" nolabel="1" class="oe_inline"/>
                            · Cubierto: <field name="covered_qty" nolabel="1" class="oe_inline"/>
                            · Pendiente: <field name="pending_qty" nolabel="1" class="oe_inline"/>
                        </p>
                        <p class="text-muted">
                            Inventario Odoo (referencia): existencia
                            <field name="stock_qty" nolabel="1" class="oe_inline"/>
                            · reservado
                            <field name="stock_reserved" nolabel="1" class="oe_inline"/>
                            · disponible
                            <field name="stock_available" nolabel="1" class="oe_inline"/>
                            — no se consume automáticamente.
                        </p>
                    </div>
                </group>

                <!-- CHOOSE -->
                <group invisible="step != 'choose'" string="¿Cómo se obtuvo este artículo?">
                    <div colspan="2">
                        <button name="action_choose_relate" type="object"
                                string="Compra existente / OC" class="btn-primary"
                                invisible="is_readonly"/>
                        <button name="action_choose_bill" type="object"
                                string="Factura proveedor existente" class="btn-secondary"
                                invisible="is_readonly"/>
                        <button name="action_choose_create_po" type="object"
                                string="Crear nueva compra" class="btn-secondary"
                                invisible="is_readonly"/>
                        <button name="action_choose_historical" type="object"
                                string="Inventario histórico / costo manual" class="btn-secondary"
                                invisible="is_readonly"/>
                        <button name="action_choose_sources" type="object"
                                string="Ver fuentes aplicadas" class="btn-link"/>
                    </div>
                </group>

                <!-- RELATE PO -->
                <group invisible="step != 'relate'" string="Compra existente">
                    <field name="supplier_id" options="{'no_create': True}"
                             placeholder="Buscar proveedor…"/>
                    <field name="show_exhausted" string="Mostrar OC sin disponible"/>
                    <field name="purchase_order_id"
                             domain="purchase_order_domain"
                             options="{'no_create': True}"
                             context="{'default_company_id': company_id}"/>
                    <field name="eligible_po_ids" widget="many2many_tags" readonly="1"
                             string="OC con disponible"/>
                </group>
                <field name="pol_pick_ids" invisible="step != 'relate'"
                         string="Artículos de la OC">
                    <list editable="bottom" create="0" delete="0"
                          decoration-info="is_focus_product"
                          decoration-muted="qty_available &lt;= 0">
                        <field name="is_focus_product" column_invisible="1"/>
                        <field name="purchase_line_id" column_invisible="1"/>
                        <field name="product_id" string="Producto"/>
                        <field name="qty_purchased" string="Comprado"/>
                        <field name="qty_assigned" string="Ya relacionado"/>
                        <field name="qty_available" string="Disponible"/>
                        <field name="unit_cost" optional="hide"/>
                        <field name="qty_to_use" string="Usar"/>
                    </list>
                </field>
                <div invisible="step != 'relate'" class="mb-2">
                    <button name="action_apply_relate" type="object"
                            string="Aplicar" class="btn-primary"/>
                    <button name="action_back_choose" type="object"
                            string="Volver" class="btn-link"/>
                </div>

                <!-- VENDOR BILL -->
                <group invisible="step != 'bill'" string="Factura de proveedor existente">
                    <field name="bill_supplier_id" options="{'no_create': True}"/>
                    <field name="bill_search" placeholder="Número / NCF / referencia…"/>
                    <field name="vendor_bill_id"
                             domain="vendor_bill_domain"
                             options="{'no_create': True}"/>
                </group>
                <field name="bill_line_ids" invisible="step != 'bill'"
                         string="Líneas de la factura">
                    <list editable="bottom" create="0" delete="0"
                          decoration-info="is_focus_product">
                        <field name="is_focus_product" column_invisible="1"/>
                        <field name="move_line_id" column_invisible="1"/>
                        <field name="product_id" string="Producto"/>
                        <field name="qty_on_bill" string="En factura"/>
                        <field name="unit_cost" string="Costo unit."/>
                        <field name="qty_to_use" string="Usar"/>
                    </list>
                </field>
                <div invisible="step != 'bill'" class="mb-2">
                    <button name="action_apply_bill" type="object"
                            string="Aplicar" class="btn-primary"/>
                    <button name="action_back_choose" type="object"
                            string="Volver" class="btn-link"/>
                </div>

                <!-- CREATE PO (review before create) -->
                <group invisible="step != 'create_po'" string="Preparar nueva orden de compra">
                    <field name="new_partner_id" options="{'no_create': True}" required="step == 'create_po'"/>
                    <field name="new_currency_id"/>
                    <field name="new_date_order"/>
                    <field name="new_payment_term_id"/>
                    <field name="new_partner_ref"/>
                    <field name="new_user_id"/>
                    <field name="new_buy_qty"
                             string="Cantidad a comprar (puede ser mayor que la venta)"/>
                    <field name="new_assign_qty"
                             string="Cantidad atribuida a esta venta"/>
                    <field name="new_residual_qty" readonly="1"
                             string="Residual libre (no atribuido)"/>
                    <field name="new_price" string="Precio unitario (editable)"/>
                    <field name="new_notes" colspan="2"/>
                    <div class="text-muted" colspan="2">
                        La OC se crea solo al confirmar. El residual queda libre comercialmente.
                        No se confirma automáticamente.
                    </div>
                </group>
                <div invisible="step != 'create_po'" class="mb-2">
                    <button name="action_confirm_create_po" type="object"
                            string="Crear OC y atribuir a la venta" class="btn-primary"/>
                    <button name="action_back_choose" type="object"
                            string="Volver" class="btn-link"/>
                </div>

                <!-- HISTORICAL -->
                <group invisible="step != 'historical'" string="Inventario histórico / costo manual">
                    <field name="hist_qty"/>
                    <field name="hist_unit_cost"/>
                    <field name="hist_note" placeholder="Nota / motivo…"/>
                    <div class="text-muted" colspan="2">
                        Solo cobertura comercial/margen. Sin stock.move, sin asiento, sin recepción.
                    </div>
                </group>
                <div invisible="step != 'historical'" class="mb-2">
                    <button name="action_apply_historical" type="object"
                            string="Aplicar" class="btn-primary"/>
                    <button name="action_back_choose" type="object"
                            string="Volver" class="btn-link"/>
                </div>

                <!-- SOURCES -->
                <group invisible="step != 'sources'" string="Fuentes aplicadas">
                    <field name="source_html" nolabel="1" colspan="2"/>
                    <button name="action_back_choose" type="object"
                            string="Volver" class="btn-link"
                            invisible="is_readonly"/>
                </group>

                <footer>
                    <button name="action_close" type="object" string="Cerrar" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
