<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_purchase_sale_relate_sale_wizard_form" model="ir.ui.view">
        <field name="name">purchase.sale.relate.sale.wizard.form</field>
        <field name="model">purchase.sale.relate.sale.wizard</field>
        <field name="arch" type="xml">
            <form string="Relacionar factura de proveedor con ventas">
                <sheet>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="payable_auxiliary_id"/>
                            <field name="vendor_bill_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="transaction_ids" widget="many2many_tags"/>
                        <field name="sale_order_ids" widget="many2many_tags"/>
                        <field name="customer_invoice_ids" widget="many2many_tags"/>
                    </group>
                    <field name="notes" placeholder="Notas..."/>
                </sheet>
                <footer>
                    <button name="action_confirm" type="object" string="Confirmar" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_purchase_sale_relate_sale_wizard" model="ir.actions.act_window">
        <field name="name">Relacionar ventas</field>
        <field name="res_model">purchase.sale.relate.sale.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
