<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_purchase_sale_link_sale_wizard_form" model="ir.ui.view">
        <field name="name">purchase.sale.link.sale.wizard.form</field>
        <field name="model">purchase.sale.link.sale.wizard</field>
        <field name="arch" type="xml">
            <form string="Vincular a venta">
                <field name="state" invisible="1"/>
                <field name="company_id" invisible="1"/>
                <field name="show_customer_invoice" invisible="1"/>
                <field name="sale_order_domain" invisible="1"/>
                <field name="customer_invoice_domain" invisible="1"/>
                <field name="customer_commercial_id_int" invisible="1"/>
                <field name="can_confirm" invisible="1"/>
                <sheet>
                    <div class="alert alert-info mb-3" role="status" invisible="state != 'client'">
                        <strong>Cliente y venta</strong> — El proveedor ya está definido en la orden de compra.
                    </div>
                    <div class="alert alert-info mb-3" role="status" invisible="state != 'match'">
                        <strong>Relacionar artículos</strong> — Revise las asignaciones y confirme.
                        Venta: <field name="sale_order_label" nolabel="1" class="oe_inline fw-bold"/>
                    </div>

                    <group invisible="state != 'client'">
                        <group string="Orden de compra">
                            <field name="purchase_order_id" readonly="1"/>
                            <field name="supplier_label" readonly="1"/>
                        </group>
                        <group string="Cliente y venta">
                            <field name="customer_id" options="{'no_create': True}"/>
                            <div class="text-muted" colspan="2" invisible="not customer_id">
                                <field name="sale_hint" nolabel="1" readonly="1"/>
                            </div>
                            <field name="sale_order_id"
                                     domain="sale_order_domain"
                                     options="{'no_create': True}"
                                     context="{
                                         'justech_margin_wizard': True,
                                         'justech_margin_wizard_company_id': company_id,
                                         'justech_margin_wizard_customer_id': customer_commercial_id_int,
                                         'default_company_id': company_id,
                                     }"/>
                            <field name="customer_invoice_id"
                                     invisible="not show_customer_invoice"
                                     domain="customer_invoice_domain"
                                     options="{'no_create': True}"
                                     context="{
                                         'justech_margin_wizard': True,
                                         'justech_margin_wizard_company_id': company_id,
                                         'justech_margin_wizard_customer_id': customer_commercial_id_int,
                                         'default_company_id': company_id,
                                     }"/>
                        </group>
                    </group>

                    <field name="line_ids" nolabel="1" invisible="state != 'match'">
                        <list editable="bottom" create="0" delete="0"
                              decoration-success="link_status == 'linked'"
                              decoration-warning="link_status == 'partial'"
                              decoration-danger="link_status == 'unlinked'">
                            <field name="product_po_label" string="Artículo OC" readonly="1"/>
                            <field name="qty_po" string="Cant. OC" readonly="1"/>
                            <field name="sale_line_id" string="Línea venta"
                                     domain="sale_line_domain"
                                     options="{'no_create': True, 'no_open': True}"/>
                            <field name="qty_sold" string="Vendido" readonly="1"/>
                            <field name="qty_covered" string="Ya cubierto" readonly="1"/>
                            <field name="qty_to_assign" string="Asignar"/>
                            <field name="status_label" string="Estado" readonly="1"/>
                            <field name="link_status" column_invisible="1"/>
                            <field name="needs_selection" column_invisible="1"/>
                            <field name="sale_line_domain" column_invisible="1"/>
                            <field name="purchase_line_id" column_invisible="1"/>
                            <field name="sale_line_label" column_invisible="1"/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button name="action_next_match" type="object"
                            string="Siguiente: artículos" class="btn-primary"
                            invisible="state != 'client'"/>
                    <button name="action_back_client" type="object"
                            string="Atrás" class="btn-secondary"
                            invisible="state != 'match'"/>
                    <button name="action_confirm_link" type="object"
                            string="Confirmar vinculación" class="btn-primary"
                            invisible="state != 'match'"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_purchase_sale_link_sale_wizard" model="ir.actions.act_window">
        <field name="name">Vincular a venta</field>
        <field name="res_model">purchase.sale.link.sale.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
