<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_purchase_sale_add_purchase_wizard_form" model="ir.ui.view">
        <field name="name">purchase.sale.add.purchase.wizard.form</field>
        <field name="model">purchase.sale.add.purchase.wizard</field>
        <field name="arch" type="xml">
            <form string="Agregar costos a la operación">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        <strong>3 pasos:</strong> 1) Proveedor · 2) Documentos · 3) Confirmar.
                        Las órdenes de compra se cargan sin marcar: usted selecciona cada una.
                    </div>

                    <group string="Operación">
                        <group>
                            <field name="company_id" string="Empresa" groups="base.group_multi_company" readonly="1"/>
                            <field name="transaction_id" string="Operación" readonly="1"/>
                            <field name="sale_order_id" string="Orden de venta" invisible="transaction_id" readonly="1"/>
                            <field name="customer_invoice_id" invisible="1"/>
                            <field name="header_customer" string="Cliente" readonly="1"/>
                            <field name="header_sale_invoice" string="Factura / venta" readonly="1"/>
                        </group>
                        <group>
                            <field name="company_currency_id" invisible="1"/>
                            <field name="header_sale_untaxed" string="Venta sin ITBIS" readonly="1"/>
                            <field name="header_current_cost" string="Costos actuales" readonly="1"/>
                            <field name="header_current_margin" string="Margen actual" readonly="1"/>
                        </group>
                    </group>

                    <group string="1. Proveedor">
                        <field name="partner_id" string="Proveedor" options="{'no_create': True}" required="1"
                                 placeholder="Escriba el nombre del proveedor..."/>
                        <field name="search_ncf" string="NCF / e-CF (opcional)" placeholder="Opcional"/>
                        <field name="search_product_id" string="Filtrar producto" options="{'no_create': True}" optional="hide"/>
                        <field name="available_po_ids" invisible="1"/>
                        <field name="purchase_order_ids" invisible="1"/>
                        <field name="vendor_bill_ids" invisible="1"/>
                        <field name="show_direct_bills" invisible="1"/>
                    </group>

                    <div class="alert alert-warning" role="status" invisible="partner_id">
                        Seleccione un proveedor para consultar sus documentos disponibles.
                    </div>

                    <div class="alert alert-secondary" role="status" invisible="not partner_id">
                        <field name="po_selection_help" nolabel="1"/>
                        <div class="mt-1"><field name="selection_counter" nolabel="1"/></div>
                        <div invisible="not vendor_bill_pending_note" class="text-muted mt-1">
                            <field name="vendor_bill_pending_note" nolabel="1"/>
                        </div>
                    </div>

                    <group string="2. Órdenes de compra disponibles" invisible="not partner_id">
                        <field name="po_candidate_ids" nolabel="1" mode="list">
                            <list editable="bottom" create="0" delete="0" limit="20">
                                <field name="selected" string="Sel."/>
                                <field name="purchase_order_id" string="OC" readonly="1"/>
                                <field name="date_order" string="Fecha" readonly="1"/>
                                <field name="origin" string="Origen" readonly="1" optional="show"/>
                                <field name="state_label" string="Estado" readonly="1"/>
                                <field name="state" column_invisible="1"/>
                                <field name="amount_total" string="Total" readonly="1" sum="Total" widget="monetary"/>
                                <field name="currency_id" string="Moneda" readonly="1" optional="hide"/>
                                <field name="amount_to_invoice" string="Pendiente de facturar" readonly="1" widget="monetary"/>
                                <field name="existing_bills" string="Facturas relacionadas" readonly="1" optional="show"/>
                            </list>
                        </field>
                    </group>

                    <group invisible="not partner_id">
                        <div class="oe_button_box mb-2">
                            <field name="vendor_bill_open_count" string="Facturas abiertas del proveedor" readonly="1"/>
                            <button name="action_show_vendor_bills_summary" type="object"
                                    string="Ver facturas del proveedor" class="btn-secondary"/>
                            <button name="action_add_direct_vendor_bills" type="object"
                                    string="Agregar factura directa del proveedor" class="btn-link"/>
                            <button name="action_search_bill_without_partner" type="object"
                                    string="Buscar factura sin seleccionar proveedor" class="btn-link"/>
                        </div>
                    </group>

                    <group invisible="not partner_id or (not bill_candidate_ids and not show_direct_bills)">
                        <separator string="Facturas relacionadas"/>
                        <field name="bill_section_title" readonly="1" nolabel="1" class="text-muted"/>
                        <field name="bill_candidate_ids" nolabel="1" mode="list">
                            <list editable="bottom" create="0" delete="0" limit="20">
                                <field name="selected" string="Sel."/>
                                <field name="vendor_bill_id" string="Factura" readonly="1"/>
                                <field name="ncf" string="NCF / e-CF" readonly="1"/>
                                <field name="invoice_date" string="Fecha" readonly="1"/>
                                <field name="po_names" string="OC" readonly="1"/>
                                <field name="amount_untaxed" string="Subtotal" readonly="1" widget="monetary"/>
                                <field name="amount_tax" string="ITBIS" readonly="1" widget="monetary"/>
                                <field name="amount_total" string="Total" readonly="1" sum="Total" widget="monetary"/>
                                <field name="amount_residual" string="Saldo" readonly="1" widget="monetary"/>
                                <field name="payment_state_label" string="Pago" readonly="1"/>
                                <field name="invoice_state_label" string="Estado" readonly="1" optional="show"/>
                                <field name="move_type_label" string="Tipo" readonly="1" optional="hide"/>
                                <field name="payment_state" column_invisible="1"/>
                                <field name="move_type" column_invisible="1"/>
                                <field name="currency_id" column_invisible="1"/>
                            </list>
                        </field>
                    </group>

                    <group string="3. Resumen" invisible="not partner_id">
                        <div class="oe_button_box mb-2">
                            <button name="action_toggle_article_detail" type="object"
                                    string="Ver artículos" class="btn-link"
                                    invisible="show_article_detail"/>
                            <button name="action_toggle_article_detail" type="object"
                                    string="Ocultar artículos" class="btn-link"
                                    invisible="not show_article_detail"/>
                        </div>
                    </group>

                    <group string="Detalle de artículos" invisible="not show_article_detail">
                        <field name="line_ids" nolabel="1">
                            <list create="0" delete="0" editable="bottom">
                                <field name="selected" string="Usar"/>
                                <field name="purchase_order_id" readonly="1" string="OC"/>
                                <field name="vendor_bill_id" readonly="1" string="Factura" optional="show"/>
                                <field name="product_id" readonly="1" string="Producto"/>
                                <field name="description" readonly="1" string="Descripción" optional="hide"/>
                                <field name="product_qty" readonly="1" string="Cant. comprada"/>
                                <field name="qty_invoiced" readonly="1" string="Cant. facturada" optional="show"/>
                                <field name="qty_available" readonly="1" string="Disponible"/>
                                <field name="qty_to_assign" string="A asignar"/>
                                <field name="price_unit" readonly="1" string="Costo unitario"/>
                                <field name="available_amount" readonly="1" string="Monto asignable"/>
                                <field name="currency_id" column_invisible="1"/>
                                <field name="purchase_line_id" column_invisible="1"/>
                                <field name="qty_received" column_invisible="1"/>
                                <field name="assigned_amount_elsewhere" column_invisible="1"/>
                                <field name="cost_usage_type" column_invisible="1"/>
                            </list>
                        </field>
                    </group>

                    <field name="notes" placeholder="Observación opcional..." invisible="not partner_id"/>
                </sheet>
                <footer>
                    <button name="action_confirm" type="object" string="Agregar costos a la operación" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_purchase_sale_add_purchase_wizard" model="ir.actions.act_window">
        <field name="name">Agregar costos a la operación</field>
        <field name="res_model">purchase.sale.add.purchase.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
