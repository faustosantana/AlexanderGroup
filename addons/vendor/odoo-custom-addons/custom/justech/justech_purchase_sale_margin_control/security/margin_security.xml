<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!--
            Privilege shown on Settings → Users (no developer mode).
            Primary selectable levels: Usuario / Responsable / Administrador.
            Specialized groups (Auditor / Ventas / Compras) keep XMLIDs + ACLs
            but are not offered as separate privilege options (avoid duplicate UI).
        -->
        <record id="module_category_margin_control" model="ir.module.category">
            <field name="name">Control de Costos y Márgenes</field>
            <field name="sequence">25</field>
        </record>

        <record id="res_groups_privilege_margin_control" model="res.groups.privilege">
            <field name="name">Control de Costos y Márgenes</field>
            <field name="sequence">25</field>
            <field name="category_id" ref="module_category_margin_control"/>
        </record>

        <!-- A. Usuario (read / consult) -->
        <record id="group_margin_readonly" model="res.groups">
            <field name="name">Usuario</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="res_groups_privilege_margin_control"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Consulta costos, márgenes, operaciones y reportes de lectura. Sin configuración ni administración.</field>
        </record>

        <!-- Technical specialized roles (not in privilege radio) -->
        <record id="group_margin_auditor" model="res.groups">
            <field name="name">Auditor</field>
            <field name="sequence">15</field>
            <field name="privilege_id" eval="False"/>
            <field name="implied_ids" eval="[(4, ref('group_margin_readonly'))]"/>
            <field name="comment">Rol técnico: lectura completa e historial. Preferir Usuario / Responsable / Administrador en la ficha de usuario.</field>
        </record>

        <record id="group_margin_sales" model="res.groups">
            <field name="name">Ventas</field>
            <field name="sequence">16</field>
            <field name="privilege_id" eval="False"/>
            <field name="implied_ids" eval="[(4, ref('group_margin_readonly'))]"/>
            <field name="comment">Rol técnico con alcance de vendedor. Preferir Usuario / Responsable / Administrador.</field>
        </record>

        <record id="group_margin_purchase" model="res.groups">
            <field name="name">Compras</field>
            <field name="sequence">17</field>
            <field name="privilege_id" eval="False"/>
            <field name="implied_ids" eval="[(4, ref('group_margin_readonly'))]"/>
            <field name="comment">Rol técnico operativo de compras. Incluido por Responsable.</field>
        </record>

        <!-- B. Responsable (functional ops) — reuses finance XMLID -->
        <record id="group_margin_finance" model="res.groups">
            <field name="name">Responsable</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="res_groups_privilege_margin_control"/>
            <field name="implied_ids" eval="[(4, ref('group_margin_purchase')), (4, ref('group_margin_auditor'))]"/>
            <field name="comment">Opera el módulo: relacionar, asignar, prorratear, validar y reportes. Sin administrar seguridad ni parámetros protegidos.</field>
        </record>

        <!-- C. Administrador -->
        <record id="group_margin_admin" model="res.groups">
            <field name="name">Administrador</field>
            <field name="sequence">30</field>
            <field name="privilege_id" ref="res_groups_privilege_margin_control"/>
            <field name="implied_ids" eval="[(4, ref('group_margin_finance')), (4, ref('group_margin_sales'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
            <field name="comment">Acceso completo: configuración del módulo, auditoría y administración funcional.</field>
        </record>

        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_margin_admin'))]"/>
        </record>

        <!-- ============================================================
             Section / capability groups (granular access 19.0.8.29.0)
             Not shown as privilege radios; managed via Permisos → caps.
             Each implies Usuario so root menu + base ACL ticket apply.
             ============================================================ -->
        <record id="group_margin_sec_board" model="res.groups">
            <field name="name">Sección: Resumen financiero</field>
            <field name="sequence">40</field>
            <field name="privilege_id" eval="False"/>
            <field name="implied_ids" eval="[(4, ref('group_margin_readonly'))]"/>
            <field name="comment">Ver dashboard KPI (ventas, costos, márgenes, CxC/CxP, flujo).</field>
        </record>
        <record id="group_margin_sec_inbox" model="res.groups">
            <field name="name">Sección: Pendientes</field>
            <field name="sequence">41</field>
            <field name="privilege_id" eval="False"/>
            <field name="implied_ids" eval="[(4, ref('group_margin_readonly'))]"/>
        </record>
        <record id="group_margin_sec_ops_view" model="res.groups">
            <field name="name">Sección: Operaciones (ver)</field>
            <field name="sequence">42</field>
            <field name="privilege_id" eval="False"/>
            <field name="implied_ids" eval="[(4, ref('group_margin_readonly'))]"/>
        </record>
        <record id="group_margin_sec_ops_manage" model="res.groups">
            <field name="name">Sección: Operaciones (gestionar)</field>
            <field name="sequence">43</field>
            <field name="privilege_id" eval="False"/>
            <field name="implied_ids" eval="[(4, ref('group_margin_sec_ops_view'))]"/>
            <field name="comment">Incluye herramientas operativas (relacionar, registrar, asignar).</field>
        </record>
        <record id="group_margin_sec_margins_view" model="res.groups">
            <field name="name">Sección: Márgenes (ver)</field>
            <field name="sequence">44</field>
            <field name="privilege_id" eval="False"/>
            <field name="implied_ids" eval="[(4, ref('group_margin_readonly'))]"/>
            <field name="comment">Campos de costo/margen/rentabilidad en operaciones.</field>
        </record>
        <record id="group_margin_sec_margins_manage" model="res.groups">
            <field name="name">Sección: Márgenes (gestionar)</field>
            <field name="sequence">45</field>
            <field name="privilege_id" eval="False"/>
            <field name="implied_ids" eval="[(4, ref('group_margin_sec_margins_view'))]"/>
        </record>
        <record id="group_margin_sec_cxp_view" model="res.groups">
            <field name="name">Sección: Cuentas por Pagar (ver)</field>
            <field name="sequence">46</field>
            <field name="privilege_id" eval="False"/>
            <field name="implied_ids" eval="[(4, ref('group_margin_readonly'))]"/>
        </record>
        <record id="group_margin_sec_cxp_manage" model="res.groups">
            <field name="name">Sección: Cuentas por Pagar (gestionar)</field>
            <field name="sequence">47</field>
            <field name="privilege_id" eval="False"/>
            <field name="implied_ids" eval="[(4, ref('group_margin_sec_cxp_view'))]"/>
        </record>
        <record id="group_margin_sec_reports_view" model="res.groups">
            <field name="name">Sección: Reportes (ver)</field>
            <field name="sequence">48</field>
            <field name="privilege_id" eval="False"/>
            <field name="implied_ids" eval="[(4, ref('group_margin_readonly'))]"/>
        </record>
        <record id="group_margin_sec_reports_export" model="res.groups">
            <field name="name">Sección: Reportes (exportar)</field>
            <field name="sequence">49</field>
            <field name="privilege_id" eval="False"/>
            <field name="implied_ids" eval="[(4, ref('group_margin_sec_reports_view'))]"/>
        </record>
        <record id="group_margin_sec_config" model="res.groups">
            <field name="name">Sección: Configuración</field>
            <field name="sequence">50</field>
            <field name="privilege_id" eval="False"/>
            <field name="implied_ids" eval="[(4, ref('group_margin_readonly'))]"/>
        </record>

        <!-- Privilege ladder → section caps (Usuario/Responsable/Administrador) -->
        <record id="group_margin_readonly" model="res.groups">
            <field name="implied_ids" eval="[
                (4, ref('group_margin_sec_board')),
                (4, ref('group_margin_sec_inbox')),
                (4, ref('group_margin_sec_ops_view')),
                (4, ref('group_margin_sec_margins_view')),
                (4, ref('group_margin_sec_cxp_view')),
                (4, ref('group_margin_sec_reports_view')),
            ]"/>
        </record>
        <record id="group_margin_finance" model="res.groups">
            <field name="implied_ids" eval="[
                (4, ref('group_margin_sec_ops_manage')),
                (4, ref('group_margin_sec_margins_manage')),
                (4, ref('group_margin_sec_cxp_manage')),
                (4, ref('group_margin_sec_reports_export')),
            ]"/>
        </record>
        <record id="group_margin_admin" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_margin_sec_config'))]"/>
        </record>

        <!-- Multi-company record rules -->
        <record id="rule_cost_link_multi_company" model="ir.rule">
            <field name="name">Enlace costo-venta: multi-compañía</field>
            <field name="model_id" ref="model_purchase_sale_cost_link"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="rule_cost_allocation_multi_company" model="ir.rule">
            <field name="name">Asignación de costo: multi-compañía</field>
            <field name="model_id" ref="model_purchase_sale_cost_allocation"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="rule_margin_snapshot_multi_company" model="ir.rule">
            <field name="name">Foto de margen: multi-compañía</field>
            <field name="model_id" ref="model_purchase_sale_margin_snapshot"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="rule_reconciliation_rule_multi_company" model="ir.rule">
            <field name="name">Regla de conciliación: multi-compañía</field>
            <field name="model_id" ref="model_purchase_sale_reconciliation_rule"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="rule_cost_link_sales_scope" model="ir.rule">
            <field name="name">Enlace costo-venta: alcance ventas</field>
            <field name="model_id" ref="model_purchase_sale_cost_link"/>
            <field name="domain_force">['|', ('sale_id.user_id', '=', user.id), ('sale_id', '=', False)]</field>
            <field name="groups" eval="[(4, ref('group_margin_sales'))]"/>
        </record>

        <record id="rule_cost_allocation_sales_scope" model="ir.rule">
            <field name="name">Asignación de costo: alcance ventas</field>
            <field name="model_id" ref="model_purchase_sale_cost_allocation"/>
            <field name="domain_force">['|', ('sale_order_id.user_id', '=', user.id), ('sale_order_id', '=', False)]</field>
            <field name="groups" eval="[(4, ref('group_margin_sales'))]"/>
        </record>

        <record id="rule_cost_link_admin_unrestricted" model="ir.rule">
            <field name="name">Enlace costo-venta: administrador sin restricción</field>
            <field name="model_id" ref="model_purchase_sale_cost_link"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_margin_admin'))]"/>
        </record>

        <record id="rule_cost_allocation_admin_unrestricted" model="ir.rule">
            <field name="name">Asignación de costo: administrador sin restricción</field>
            <field name="model_id" ref="model_purchase_sale_cost_allocation"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_margin_admin'))]"/>
        </record>

        <record id="rule_margin_transaction_multi_company" model="ir.rule">
            <field name="name">Operación de margen: multi-compañía</field>
            <field name="model_id" ref="model_purchase_sale_margin_transaction"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="rule_margin_transaction_line_multi_company" model="ir.rule">
            <field name="name">Línea de operación de margen: multi-compañía</field>
            <field name="model_id" ref="model_purchase_sale_margin_transaction_line"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="rule_margin_transaction_sales_scope" model="ir.rule">
            <field name="name">Operación de margen: alcance ventas</field>
            <field name="model_id" ref="model_purchase_sale_margin_transaction"/>
            <field name="domain_force">['|', ('salesperson_id', '=', user.id), ('salesperson_id', '=', False)]</field>
            <field name="groups" eval="[(4, ref('group_margin_sales'))]"/>
        </record>

        <record id="rule_margin_transaction_admin_unrestricted" model="ir.rule">
            <field name="name">Operación de margen: administrador sin restricción</field>
            <field name="model_id" ref="model_purchase_sale_margin_transaction"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_margin_admin'))]"/>
        </record>

        <record id="rule_payable_auxiliary_multi_company" model="ir.rule">
            <field name="name">Auxiliar CxP: multi-compañía</field>
            <field name="model_id" ref="model_purchase_sale_payable_auxiliary"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="rule_payable_auxiliary_admin_unrestricted" model="ir.rule">
            <field name="name">Auxiliar CxP: administrador sin restricción</field>
            <field name="model_id" ref="model_purchase_sale_payable_auxiliary"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_margin_admin'))]"/>
        </record>

        <!-- 19.0.8.29.2: CxP section may read vendor bills (menu source) -->
        <record id="rule_cxp_vendor_bills_only" model="ir.rule">
            <field name="name">CxP: solo facturas/NC de proveedor</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="domain_force">[('move_type', 'in', ('in_invoice', 'in_refund')), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_margin_sec_cxp_view'))]"/>
        </record>

    </data>
</odoo>
