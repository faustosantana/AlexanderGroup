<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_purchase_sale_payable_auxiliary_list" model="ir.ui.view">
        <field name="name">purchase.sale.payable.auxiliary.list</field>
        <field name="model">purchase.sale.payable.auxiliary</field>
        <field name="arch" type="xml">
            <list decoration-success="operational_state in ('paid', 'closed')" decoration-warning="operational_state in ('partial_relation', 'partial_paid')" decoration-danger="operational_state == 'pending_relation'">
                <field name="company_id" string="Empresa" groups="base.group_multi_company"/>
                <field name="partner_id" string="Proveedor"/>
                <field name="vendor_bill_id" string="Factura proveedor"/>
                <field name="ncf_number" string="NCF" optional="show"/>
                <field name="invoice_date" string="Fecha"/>
                <field name="invoice_date_due" string="Vencimiento" optional="show"/>
                <field name="amount_total" string="Total" sum="Total"/>
                <field name="amount_paid" string="Pagado" sum="Total"/>
                <field name="amount_residual" string="Saldo pendiente" sum="Total"/>
                <field name="related_customer_id" string="Cliente relacionado" optional="show"/>
                <field name="related_customer_invoice_id" string="Factura cliente" optional="show"/>
                <field name="related_sale_order_id" string="Venta relacionada" optional="show"/>
                <field name="recovered_cost_amount" string="Costo recuperado" sum="Total"/>
                <field name="pending_recovery_amount" string="Costo pendiente de recuperar" sum="Total"/>
                <field name="payment_state" string="Estado de pago" widget="badge"/>
                <field name="relation_status_label" string="Estado de relación"/>
                <field name="purchase_responsible_id" string="Responsable" optional="hide"/>
                <field name="what_is_missing" string="¿Qué falta?" optional="show"/>
                <field name="operational_state" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_purchase_sale_payable_auxiliary_form" model="ir.ui.view">
        <field name="name">purchase.sale.payable.auxiliary.form</field>
        <field name="model">purchase.sale.payable.auxiliary</field>
        <field name="arch" type="xml">
            <form string="Auxiliar de cuentas por pagar">
                <header>
                    <button name="action_relate_sales" type="object" string="Relacionar ventas" class="btn-primary"/>
                    <button name="action_recompute_state" type="object" string="Actualizar estado" class="btn-secondary"/>
                    <button name="action_close" type="object" string="Cerrar" class="btn-secondary" invisible="manually_closed"/>
                    <button name="action_reopen" type="object" string="Reabrir" class="btn-secondary" invisible="not manually_closed"/>
                    <field name="operational_state" widget="statusbar" statusbar_visible="pending_relation,partial_relation,full_relation,pending_customer_collection,pending_vendor_payment,paid,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_vendor_bill" type="object" class="oe_stat_button" icon="fa-file-text">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Factura proveedor</span>
                            </div>
                        </button>
                        <button name="action_view_transactions" type="object" class="oe_stat_button" icon="fa-line-chart" invisible="not transaction_count">
                            <field name="transaction_count" widget="statinfo" string="Operaciones"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="not what_is_missing">
                        <strong>¿Qué falta?</strong>
                        <field name="what_is_missing" nolabel="1"/>
                    </div>
                    <group>
                        <group string="Factura de proveedor">
                            <field name="company_id" string="Empresa" groups="base.group_multi_company"/>
                            <field name="vendor_bill_id" string="Factura proveedor" readonly="1"/>
                            <field name="partner_id" string="Proveedor"/>
                            <field name="ncf_number" string="NCF"/>
                            <field name="invoice_date" string="Fecha"/>
                            <field name="invoice_date_due" string="Vencimiento"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="company_currency_id" invisible="1"/>
                            <field name="relation_status_label" string="Estado de relación"/>
                        </group>
                        <group string="Montos">
                            <field name="amount_total" string="Total"/>
                            <field name="amount_paid" string="Pagado"/>
                            <field name="amount_residual" string="Saldo pendiente"/>
                            <field name="payment_state" string="Estado de pago" widget="badge"/>
                        </group>
                    </group>
                    <group>
                        <group string="Recuperación de costo">
                            <field name="recovered_cost_amount"/>
                            <field name="pending_recovery_amount"/>
                            <field name="recovery_percent" digits="[16,2]"/>
                            <field name="coverage_percent" digits="[16,2]"/>
                        </group>
                        <group string="Margen">
                            <field name="margin_generated"/>
                            <field name="purchase_responsible_id"/>
                            <field name="finance_responsible_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Relaciones" name="relations">
                            <group>
                                <field name="transaction_ids" widget="many2many_tags"/>
                                <field name="sale_order_ids" widget="many2many_tags"/>
                                <field name="customer_invoice_ids" widget="many2many_tags"/>
                            </group>
                        </page>
                        <page string="Notas" name="notes">
                            <field name="notes" placeholder="Notas..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_purchase_sale_payable_auxiliary_search" model="ir.ui.view">
        <field name="name">purchase.sale.payable.auxiliary.search</field>
        <field name="model">purchase.sale.payable.auxiliary</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="vendor_bill_id" string="Factura proveedor"/>
                <field name="partner_id" string="Proveedor"/>
                <field name="ncf_number" string="NCF / e-CF"/>
                <field name="related_customer_id" string="Cliente"/>
                <field name="related_sale_order_id" string="Venta"/>
                <field name="related_customer_invoice_id" string="Factura cliente"/>
                <field name="transaction_ids"/>
                <filter string="Todas" name="filter_all" domain="[]"/>
                <filter string="Pendientes de pago" name="filter_pending_payment" domain="[('payment_state', 'not in', ('paid', 'in_payment'))]"/>
                <filter string="Pagadas" name="filter_paid" domain="[('payment_state', '=', 'paid')]"/>
                <filter string="Con venta relacionada" name="filter_with_sale" domain="['|', '|', ('sale_order_ids', '!=', False), ('customer_invoice_ids', '!=', False), ('transaction_ids', '!=', False)]"/>
                <filter string="Sin venta relacionada" name="filter_no_sale" domain="[('sale_order_ids', '=', False), ('customer_invoice_ids', '=', False), ('transaction_ids', '=', False)]"/>
                <filter string="Parcialmente relacionadas" name="filter_partial" domain="[('operational_state', '=', 'partial_relation')]"/>
                <filter string="Totalmente relacionadas" name="filter_full" domain="[('operational_state', 'in', ('full_relation', 'invoiced_to_customer', 'pending_customer_collection', 'pending_vendor_payment', 'partial_paid', 'paid'))]"/>
                <separator/>
                <filter string="Proveedor" name="group_partner" context="{'group_by': 'partner_id'}"/>
                <filter string="Estado de relación" name="group_state" context="{'group_by': 'operational_state'}"/>
                <filter string="Estado de pago" name="group_payment_state" context="{'group_by': 'payment_state'}"/>
                <filter string="Empresa" name="group_company" context="{'group_by': 'company_id'}"/>
            </search>
        </field>
    </record>

    <!-- 19.0.8.29.2: CxP menu = real open vendor bills (account.move), not empty auxiliary -->
    <record id="view_account_move_jm_cxp_list" model="ir.ui.view">
        <field name="name">account.move.jm.cxp.list</field>
        <field name="model">account.move</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false"
                  decoration-muted="payment_state == 'paid'"
                  decoration-danger="payment_state == 'not_paid'"
                  decoration-warning="payment_state in ('partial', 'in_payment')">
                <field name="company_id" string="Empresa" groups="base.group_multi_company"/>
                <field name="partner_id" string="Proveedor"/>
                <field name="name" string="Factura"/>
                <field name="ref" string="Referencia" optional="hide"/>
                <field name="invoice_date" string="Fecha"/>
                <field name="invoice_date_due" string="Vencimiento"/>
                <field name="amount_total" string="Total" sum="Total"/>
                <field name="amount_residual" string="Saldo pendiente" sum="Total"/>
                <field name="payment_state" string="Estado de pago" widget="badge"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" column_invisible="1"/>
                <field name="move_type" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_account_move_jm_cxp_search" model="ir.ui.view">
        <field name="name">account.move.jm.cxp.search</field>
        <field name="model">account.move</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id" string="Proveedor"/>
                <field name="ref"/>
                <field name="invoice_date"/>
                <field name="invoice_date_due"/>
                <filter string="Facturas por Pagar" name="jm_cxp_open"
                        domain="[('state', '=', 'posted'), ('amount_residual', '!=', 0)]"/>
                <filter string="Pagadas" name="jm_cxp_paid"
                        domain="[('state', '=', 'posted'), ('amount_residual', '=', 0)]"/>
                <filter string="Borrador" name="jm_cxp_draft" domain="[('state', '=', 'draft')]"/>
                <separator/>
                <filter string="Proveedor" name="group_partner" context="{'group_by': 'partner_id'}"/>
                <filter string="Vencimiento" name="group_due" context="{'group_by': 'invoice_date_due'}"/>
                <filter string="Empresa" name="group_company" context="{'group_by': 'company_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_purchase_sale_payable_auxiliary" model="ir.actions.act_window">
        <field name="name">Cuentas por Pagar</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('move_type', 'in', ('in_invoice', 'in_refund')), ('state', '=', 'posted'), ('amount_residual', '!=', 0)]</field>
        <field name="context">{"create": False, "default_move_type": "in_invoice", "search_default_jm_cxp_open": 1}</field>
        <field name="search_view_id" ref="view_account_move_jm_cxp_search"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_account_move_jm_cxp_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': False})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay facturas de proveedor con saldo pendiente
            </p>
            <p>Se listan facturas/NC de proveedor publicadas con residual distinto de cero.</p>
        </field>
    </record>

    <record id="action_purchase_sale_payable_auxiliary_pending_relation" model="ir.actions.act_window">
        <field name="name">Pendientes de relación</field>
        <field name="res_model">purchase.sale.payable.auxiliary</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_purchase_sale_payable_auxiliary_search"/>
        <field name="domain">[('operational_state', '=', 'pending_relation')]</field>
    </record>

    <record id="action_purchase_sale_payable_auxiliary_pending_invoice" model="ir.actions.act_window">
        <field name="name">Pendientes de facturar</field>
        <field name="res_model">purchase.sale.payable.auxiliary</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_purchase_sale_payable_auxiliary_search"/>
        <field name="domain">[('operational_state', 'in', ('full_relation', 'invoiced_to_customer'))]</field>
    </record>

    <record id="action_purchase_sale_payable_auxiliary_pending_payment" model="ir.actions.act_window">
        <field name="name">Pendientes de pago</field>
        <field name="res_model">purchase.sale.payable.auxiliary</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_purchase_sale_payable_auxiliary_search"/>
        <field name="domain">[('payment_state', '!=', 'paid'), ('manually_closed', '=', False)]</field>
    </record>

    <record id="action_purchase_sale_payable_auxiliary_paid" model="ir.actions.act_window">
        <field name="name">Pagadas</field>
        <field name="res_model">purchase.sale.payable.auxiliary</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_purchase_sale_payable_auxiliary_search"/>
        <field name="domain">[('payment_state', '=', 'paid')]</field>
    </record>

    <record id="action_purchase_sale_payable_auxiliary_closed" model="ir.actions.act_window">
        <field name="name">Cerradas</field>
        <field name="res_model">purchase.sale.payable.auxiliary</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_purchase_sale_payable_auxiliary_search"/>
        <field name="domain">[('manually_closed', '=', True)]</field>
    </record>

    <record id="action_purchase_sale_payable_auxiliary_differences" model="ir.actions.act_window">
        <field name="name">Diferencias</field>
        <field name="res_model">purchase.sale.payable.auxiliary</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_purchase_sale_payable_auxiliary_search"/>
        <field name="domain">[('operational_state', '=', 'partial_relation')]</field>
    </record>

    <record id="action_purchase_sale_payable_auxiliary_no_sale" model="ir.actions.act_window">
        <field name="name">Sin venta relacionada</field>
        <field name="res_model">purchase.sale.payable.auxiliary</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_purchase_sale_payable_auxiliary_search"/>
        <field name="domain">[('sale_order_ids', '=', False), ('customer_invoice_ids', '=', False), ('transaction_ids', '=', False)]</field>
    </record>

</odoo>
