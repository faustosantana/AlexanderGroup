<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_purchase_sale_cost_link_list" model="ir.ui.view">
        <field name="name">purchase.sale.cost.link.list</field>
        <field name="model">purchase.sale.cost.link</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancelled'" decoration-success="state == 'confirmed'" decoration-warning="state == 'suggested'">
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="purchase_id"/>
                <field name="supplier_id"/>
                <field name="sale_id"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="cost_usage_type"/>
                <field name="link_source"/>
                <field name="confidence"/>
                <field name="allocation_status"/>
                <field name="committed_amount_company" sum="Total"/>
                <field name="realized_amount_company" sum="Total"/>
                <field name="state" widget="badge"/>
                <field name="is_manual"/>
            </list>
        </field>
    </record>

    <record id="view_purchase_sale_cost_link_form" model="ir.ui.view">
        <field name="name">purchase.sale.cost.link.form</field>
        <field name="model">purchase.sale.cost.link</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_recalculate" type="object" string="Recalcular trazabilidad" class="btn-secondary" invisible="is_manual and state == 'confirmed'"/>
                    <button name="action_confirm" type="object" string="Confirmar" class="btn-primary" invisible="state == 'confirmed'"/>
                    <button name="action_cancel" type="object" string="Cancelar" invisible="state == 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,suggested,confirmed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_allocations" type="object" class="oe_stat_button" icon="fa-list">
                            <field name="allocation_count" widget="statinfo" string="Asignaciones"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Manual" bg_color="text-bg-info" invisible="not is_manual"/>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Origen (compra)">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="purchase_id"/>
                            <field name="purchase_line_id"/>
                            <field name="supplier_id"/>
                            <field name="product_id"/>
                        </group>
                        <group string="Destino (venta)">
                            <field name="sale_id"/>
                            <field name="sale_line_id" domain="[('order_id', '=', sale_id)]"/>
                            <field name="partner_id"/>
                        </group>
                    </group>
                    <group>
                        <group string="Clasificación">
                            <field name="cost_usage_type"/>
                            <field name="exclude_from_sales_margin"/>
                            <field name="allocation_status"/>
                        </group>
                        <group string="Trazabilidad">
                            <field name="link_source"/>
                            <field name="confidence"/>
                            <field name="is_manual"/>
                        </group>
                    </group>
                    <group>
                        <group string="Montos">
                            <field name="currency_id"/>
                            <field name="company_currency_id" groups="base.group_multi_company"/>
                            <field name="committed_amount"/>
                            <field name="realized_amount"/>
                            <field name="committed_amount_company"/>
                            <field name="realized_amount_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Asignaciones" name="allocations">
                            <field name="allocation_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="sale_order_id"/>
                                    <field name="allocated_amount" sum="Total"/>
                                    <field name="cost_usage_type"/>
                                    <field name="state"/>
                                    <field name="is_manual"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notas" name="notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_purchase_sale_cost_link_search" model="ir.ui.view">
        <field name="name">purchase.sale.cost.link.search</field>
        <field name="model">purchase.sale.cost.link</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="purchase_id"/>
                <field name="sale_id"/>
                <field name="product_id"/>
                <field name="supplier_id"/>
                <field name="partner_id"/>
                <filter string="Por revisar" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Sugeridos" name="filter_suggested" domain="[('state', '=', 'suggested')]"/>
                <filter string="Confirmados" name="filter_confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="Manual" name="filter_manual" domain="[('is_manual', '=', True)]"/>
                <filter string="Sin asignar" name="filter_unallocated" domain="[('allocation_status', '=', 'unallocated')]"/>
                <separator/>
                <filter string="Baja confianza (&lt;70)" name="filter_low_confidence" domain="[('confidence', '&lt;', 70)]"/>
                <separator/>
                <filter string="Clasificación" name="group_cost_usage" context="{'group_by': 'cost_usage_type'}"/>
                <filter string="Fuente" name="group_source" context="{'group_by': 'link_source'}"/>
                <filter string="Estado" name="group_state" context="{'group_by': 'state'}"/>
                <filter string="Compañía" name="group_company" context="{'group_by': 'company_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_purchase_sale_cost_link" model="ir.actions.act_window">
        <field name="name">Enlaces costo-venta</field>
        <field name="res_model">purchase.sale.cost.link</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_purchase_sale_cost_link_search"/>
        <field name="context">{'search_default_filter_draft': 0}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea tu primer enlace costo-venta
            </p>
        </field>
    </record>

    <record id="action_purchase_sale_cost_link_pending" model="ir.actions.act_window">
        <field name="name">Compras pendientes de relación</field>
        <field name="res_model">purchase.sale.cost.link</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_purchase_sale_cost_link_search"/>
        <field name="domain">['|', ('state', 'in', ('draft', 'suggested')), ('allocation_status', 'in', ('unallocated', 'partial'))]</field>
        <field name="context">{'search_default_filter_unallocated': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay compras pendientes de relación
            </p>
        </field>
    </record>

</odoo>
