<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_purchase_sale_margin_snapshot_list" model="ir.ui.view">
        <field name="name">purchase.sale.margin.snapshot.list</field>
        <field name="model">purchase.sale.margin.snapshot</field>
        <field name="arch" type="xml">
            <list decoration-danger="real_margin &lt; 0">
                <field name="name"/>
                <field name="sale_id"/>
                <field name="partner_id"/>
                <field name="snapshot_date"/>
                <field name="revenue_amount" sum="Total"/>
                <field name="estimated_cost_amount" sum="Total"/>
                <field name="real_cost_amount" sum="Total"/>
                <field name="estimated_margin" sum="Total"/>
                <field name="estimated_margin_pct" digits="[16,2]"/>
                <field name="real_margin" sum="Total"/>
                <field name="real_margin_pct" digits="[16,2]"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_purchase_sale_margin_snapshot_form" model="ir.ui.view">
        <field name="name">purchase.sale.margin.snapshot.form</field>
        <field name="model">purchase.sale.margin.snapshot</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_recompute" type="object" string="Recalcular" class="btn-secondary"/>
                    <button name="action_set_final" type="object" string="Marcar como final" class="btn-primary" invisible="state == 'final'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,final"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="sale_id"/>
                            <field name="partner_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="snapshot_date"/>
                            <field name="currency_id"/>
                        </group>
                    </group>
                    <group string="Margen">
                        <group>
                            <field name="revenue_amount"/>
                            <field name="estimated_cost_amount"/>
                            <field name="real_cost_amount"/>
                            <field name="unallocated_cost_amount"/>
                        </group>
                        <group>
                            <field name="estimated_margin"/>
                            <field name="estimated_margin_pct" digits="[16,2]"/>
                            <field name="real_margin"/>
                            <field name="real_margin_pct" digits="[16,2]"/>
                            <field name="margin_variance"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="Notas..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_purchase_sale_margin_snapshot_search" model="ir.ui.view">
        <field name="name">purchase.sale.margin.snapshot.search</field>
        <field name="model">purchase.sale.margin.snapshot</field>
        <field name="arch" type="xml">
            <search>
                <field name="sale_id"/>
                <field name="partner_id"/>
                <filter string="Margen real negativo" name="filter_negative" domain="[('real_margin', '&lt;', 0)]"/>
                <filter string="Finales" name="filter_final" domain="[('state', '=', 'final')]"/>
                <separator/>
                <filter string="Cliente" name="group_partner" context="{'group_by': 'partner_id'}"/>
                <filter string="Estado" name="group_state" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="action_purchase_sale_margin_snapshot" model="ir.actions.act_window">
        <field name="name">Fotos de margen</field>
        <field name="res_model">purchase.sale.margin.snapshot</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_purchase_sale_margin_snapshot_search"/>
    </record>

</odoo>
