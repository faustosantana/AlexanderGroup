<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_purchase_sale_cost_allocation_list" model="ir.ui.view">
        <field name="name">purchase.sale.cost.allocation.list</field>
        <field name="model">purchase.sale.cost.allocation</field>
        <field name="arch" type="xml">
            <list decoration-muted="state in ('cancelled', 'excluded')" decoration-success="state in ('confirmed', 'complete')" decoration-warning="state == 'suggested'" decoration-danger="state == 'conflict'">
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="vendor_bill_id"/>
                <field name="purchase_order_id"/>
                <field name="sale_order_id"/>
                <field name="product_id"/>
                <field name="cost_usage_type"/>
                <field name="additional_cost_type"/>
                <field name="allocation_method"/>
                <field name="allocated_amount" sum="Total"/>
                <field name="allocated_amount_company_currency" sum="Total" groups="base.group_multi_company"/>
                <field name="confidence" digits="[16,2]"/>
                <field name="state" widget="badge"/>
                <field name="is_manual"/>
                <field name="fx_alert" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_purchase_sale_cost_allocation_form" model="ir.ui.view">
        <field name="name">purchase.sale.cost.allocation.form</field>
        <field name="model">purchase.sale.cost.allocation</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" type="object" string="Confirmar" class="btn-primary" invisible="state == 'confirmed'"/>
                    <button name="action_exclude" type="object" string="Excluir del margen" invisible="state in ('excluded', 'cancelled')"/>
                    <button name="action_cancel" type="object" string="Cancelar" invisible="state == 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,suggested,confirmed,complete"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Manual confirmada" bg_color="text-bg-info" invisible="not (is_manual and state == 'confirmed')"/>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Origen (costo)">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="link_id"/>
                            <field name="vendor_bill_id"/>
                            <field name="vendor_bill_line_id"/>
                            <field name="purchase_order_id"/>
                            <field name="purchase_order_line_id"/>
                            <field name="supplier_id"/>
                        </group>
                        <group string="Destino (venta)">
                            <field name="sale_order_id"/>
                            <field name="sale_order_line_id" domain="[('order_id', '=', sale_order_id)]"/>
                            <field name="customer_invoice_id"/>
                            <field name="customer_invoice_line_id"/>
                            <field name="partner_id"/>
                        </group>
                    </group>
                    <group>
                        <group string="Montos">
                            <field name="product_id"/>
                            <field name="currency_id"/>
                            <field name="company_currency_id" groups="base.group_multi_company"/>
                            <field name="source_amount"/>
                            <field name="allocated_amount"/>
                            <field name="allocated_amount_company_currency" groups="base.group_multi_company"/>
                            <field name="allocation_percentage"/>
                            <field name="allocated_quantity"/>
                        </group>
                        <group string="Clasificación y trazabilidad">
                            <field name="allocation_method"/>
                            <field name="cost_usage_type"/>
                            <field name="additional_cost_type"/>
                            <field name="source"/>
                            <field name="confidence" digits="[16,2]"/>
                            <field name="is_manual"/>
                            <field name="exclude_from_sales_margin"/>
                        </group>
                    </group>
                    <group string="Moneda / FX" invisible="currency_id == company_currency_id">
                        <field name="fx_rate"/>
                        <field name="fx_rate_date"/>
                        <field name="fx_alert"/>
                    </group>
                    <group string="Confirmación">
                        <field name="confirmed_by_id" readonly="1"/>
                        <field name="confirmed_at" readonly="1"/>
                    </group>
                    <field name="notes" placeholder="Notas..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_purchase_sale_cost_allocation_search" model="ir.ui.view">
        <field name="name">purchase.sale.cost.allocation.search</field>
        <field name="model">purchase.sale.cost.allocation</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="vendor_bill_id"/>
                <field name="purchase_order_id"/>
                <field name="sale_order_id"/>
                <field name="product_id"/>
                <filter string="Confirmadas" name="filter_confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="Sugeridas" name="filter_suggested" domain="[('state', '=', 'suggested')]"/>
                <filter string="Excluidas" name="filter_excluded" domain="[('state', '=', 'excluded')]"/>
                <filter string="Manual" name="filter_manual" domain="[('is_manual', '=', True)]"/>
                <filter string="Alerta FX" name="filter_fx_alert" domain="[('fx_alert', '=', True)]"/>
                <separator/>
                <filter string="Clasificación" name="group_cost_usage" context="{'group_by': 'cost_usage_type'}"/>
                <filter string="Costo adicional" name="group_additional" context="{'group_by': 'additional_cost_type'}"/>
                <filter string="Estado" name="group_state" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="action_purchase_sale_cost_allocation" model="ir.actions.act_window">
        <field name="name">Asignaciones de costo</field>
        <field name="res_model">purchase.sale.cost.allocation</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_purchase_sale_cost_allocation_search"/>
    </record>

</odoo>
