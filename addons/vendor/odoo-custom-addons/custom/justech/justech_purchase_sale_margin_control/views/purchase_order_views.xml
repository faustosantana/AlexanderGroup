<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_purchase_order_form_margin_control" model="ir.ui.view">
        <field name="name">purchase.order.form.margin.control</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button name="action_view_related_sale_orders" type="object" class="oe_stat_button" icon="fa-shopping-bag"
                        groups="base.group_system"
                        invisible="1">
                    <field name="jm_related_sale_order_count" widget="statinfo" string="Ventas relacionadas"/>
                </button>
                <button name="action_view_margin_transactions" type="object" class="oe_stat_button" icon="fa-line-chart"
                        groups="base.group_system"
                        invisible="margin_transaction_count == 0">
                    <field name="margin_transaction_count" widget="statinfo" string="Operación margen"/>
                </button>
                <button name="action_open_cost_links" type="object" class="oe_stat_button" icon="fa-random"
                        groups="base.group_system"
                        invisible="cost_link_count == 0">
                    <field name="cost_link_count" widget="statinfo" string="Enlaces de costo"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='order_line']//field[@name='product_id']" position="after">
                <field name="cost_usage_type" optional="show"
                         groups="justech_purchase_sale_margin_control.group_margin_purchase,justech_purchase_sale_margin_control.group_margin_finance,justech_purchase_sale_margin_control.group_margin_admin"/>
            </xpath>
            <xpath expr="//notebook" position="before">
                <field name="margin_review_needed" invisible="1"/>
                <field name="margin_link_sale_id" invisible="1"/>
                <field name="margin_link_coverage_qty" invisible="1"/>
                <field name="margin_assigned_cost" invisible="1"/>
                <field name="jm_related_sale_order_count" invisible="1"/>
                <field name="margin_transaction_count" invisible="1"/>
                <field name="cost_link_count" invisible="1"/>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="action_link_to_sale" type="object" string="Vincular a venta" class="btn-primary"
                        invisible="margin_link_sale_id"
                        groups="justech_purchase_sale_margin_control.group_margin_purchase,justech_purchase_sale_margin_control.group_margin_finance,justech_purchase_sale_margin_control.group_margin_admin"/>
                <button name="action_link_to_sale" type="object" string="Gestionar vinculación" class="btn-secondary"
                        invisible="not margin_link_sale_id"
                        groups="justech_purchase_sale_margin_control.group_margin_purchase,justech_purchase_sale_margin_control.group_margin_finance,justech_purchase_sale_margin_control.group_margin_admin"/>
                <button name="action_unlink_from_sale" type="object" string="Desvincular de venta" class="btn-secondary"
                        invisible="not margin_link_sale_id"
                        confirm="¿Desvincular esta orden de compra de la venta? No se borran documentos."
                        groups="justech_purchase_sale_margin_control.group_margin_purchase,justech_purchase_sale_margin_control.group_margin_finance,justech_purchase_sale_margin_control.group_margin_admin"/>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="margin_link_sale_id" string="Venta vinculada"
                         invisible="not margin_link_sale_id"
                         options="{'no_create': True, 'no_open': False}"
                         groups="justech_purchase_sale_margin_control.group_margin_purchase,justech_purchase_sale_margin_control.group_margin_finance,justech_purchase_sale_margin_control.group_margin_admin"/>
            </xpath>
        </field>
    </record>

</odoo>
