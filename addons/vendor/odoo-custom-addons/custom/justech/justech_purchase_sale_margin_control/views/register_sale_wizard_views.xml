<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_purchase_sale_register_sale_wizard_form" model="ir.ui.view">
        <field name="name">purchase.sale.register.sale.wizard.form</field>
        <field name="model">purchase.sale.register.sale.wizard</field>
        <field name="arch" type="xml">
            <form string="Registrar venta">
                <sheet>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="transaction_id"/>
                            <field name="new_transaction_name" invisible="transaction_id"/>
                            <field name="mode"/>
                            <field name="data_origin" invisible="mode == 'invoice_line'"/>
                        </group>
                        <group>
                            <field name="customer_invoice_line_id" invisible="mode != 'invoice_line'"/>
                            <field name="sale_order_id"/>
                            <field name="partner_id"/>
                            <field name="product_id"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="description"/>
                        </group>
                        <group>
                            <field name="currency_id"/>
                            <field name="amount" readonly="mode == 'invoice_line'"/>
                            <field name="notes"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm" type="object" string="Registrar" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_purchase_sale_register_sale_wizard" model="ir.actions.act_window">
        <field name="name">Registrar venta</field>
        <field name="res_model">purchase.sale.register.sale.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
