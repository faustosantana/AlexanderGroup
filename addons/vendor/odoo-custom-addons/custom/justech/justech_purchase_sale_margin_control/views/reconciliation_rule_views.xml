<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_purchase_sale_reconciliation_rule_list" model="ir.ui.view">
        <field name="name">purchase.sale.reconciliation.rule.list</field>
        <field name="model">purchase.sale.reconciliation.rule</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="rule_type"/>
                <field name="trace_method"/>
                <field name="cost_usage_type"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="auto_confirm"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_purchase_sale_reconciliation_rule_form" model="ir.ui.view">
        <field name="name">purchase.sale.reconciliation.rule.form</field>
        <field name="model">purchase.sale.reconciliation.rule</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Nombre de la regla"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="rule_type"/>
                            <field name="sequence"/>
                            <field name="active"/>
                            <field name="company_id"/>
                        </group>
                        <group>
                            <field name="trace_method" invisible="rule_type != 'trace_priority'"/>
                            <field name="cost_usage_type" invisible="rule_type != 'classification'"/>
                            <field name="min_confidence"/>
                            <field name="max_confidence"/>
                            <field name="auto_confirm"/>
                        </group>
                    </group>
                    <group string="Aplicabilidad" invisible="rule_type != 'classification'">
                        <field name="product_categ_ids" widget="many2many_tags"/>
                        <field name="product_ids" widget="many2many_tags"/>
                        <field name="partner_ids" widget="many2many_tags"/>
                    </group>
                    <field name="notes" placeholder="Notas..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_purchase_sale_reconciliation_rule" model="ir.actions.act_window">
        <field name="name">Reglas de conciliación</field>
        <field name="res_model">purchase.sale.reconciliation.rule</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
