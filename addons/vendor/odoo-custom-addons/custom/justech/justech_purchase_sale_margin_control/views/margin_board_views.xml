<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_purchase_sale_margin_board_form" model="ir.ui.view">
        <field name="name">purchase.sale.margin.board.form</field>
        <field name="model">purchase.sale.margin.board</field>
        <field name="arch" type="xml">
            <form string="Resumen financiero" create="0" delete="0" duplicate="0">
                <sheet>
                    <div class="oe_title mb-2">
                        <h1>Resumen financiero</h1>
                        <field name="display_name" invisible="1"/>
                        <field name="context_label" readonly="1" class="text-muted"/>
                        <div class="text-muted">
                            <span>Compañías incluidas: </span>
                            <field name="included_companies_label" readonly="1" nolabel="1" class="d-inline"/>
                        </div>
                    </div>
                    <group>
                        <group string="Período comercial (Ventas)">
                            <field name="company_id" string="Filtrar una empresa (opcional)" options="{'no_create': True}"
                                     domain="[('id', 'in', company_ids)]"/>
                            <field name="company_ids" invisible="1"/>
                            <field name="date_from" string="Desde"/>
                            <field name="date_to" string="Hasta"/>
                            <field name="commercial_period_label" readonly="1" nolabel="1"/>
                        </group>
                        <group string="Saldos financieros">
                            <field name="currency_id" invisible="1"/>
                            <field name="balance_as_of_label" readonly="1"/>
                            <button name="action_refresh" type="object" string="Actualizar" class="btn-primary"/>
                        </group>
                    </group>

                    <separator string="Resultado"/>
                    <div class="o_margin_board_kanban">
                        <div class="o_margin_kpi_card o_margin_kpi_ok">
                            <div class="o_margin_kpi_title">Ventas reales</div>
                            <button name="action_open_all_sales" type="object" class="btn btn-link p-0">
                                <div class="o_margin_kpi_value"><field name="total_sales_amount" widget="monetary" nolabel="1"/></div>
                            </button>
                            <div class="o_margin_kpi_meta">
                                <field name="total_sales_count" nolabel="1"/> facturas ·
                                <field name="posted_credit_note_count" nolabel="1"/> NC
                            </div>
                        </div>
                        <div class="o_margin_kpi_card">
                            <div class="o_margin_kpi_title">Facturación bruta</div>
                            <div class="o_margin_kpi_value"><field name="gross_sales_amount" widget="monetary" nolabel="1"/></div>
                            <div class="o_margin_kpi_meta">NC: <field name="credit_note_amount" widget="monetary" nolabel="1"/></div>
                        </div>
                        <div class="o_margin_kpi_card">
                            <div class="o_margin_kpi_title">Costos</div>
                            <button name="action_open_related_costs" type="object" class="btn btn-link p-0">
                                <div class="o_margin_kpi_value"><field name="related_costs_amount" widget="monetary" nolabel="1"/></div>
                            </button>
                            <div class="o_margin_kpi_meta">Relacionados al período</div>
                        </div>
                        <div class="o_margin_kpi_card o_margin_kpi_ok">
                            <div class="o_margin_kpi_title">Margen confirmado</div>
                            <button name="action_open_confirmed_margin" type="object" class="btn btn-link p-0">
                                <div class="o_margin_kpi_value"><field name="confirmed_real_margin" widget="monetary" nolabel="1"/></div>
                            </button>
                            <div class="o_margin_kpi_meta">
                                <field name="confirmed_real_margin_pct" digits="[16,2]" nolabel="1"/> % ·
                                <field name="margin_ops_count" nolabel="1"/> ops con margen
                            </div>
                        </div>
                        <div class="o_margin_kpi_card">
                            <div class="o_margin_kpi_title">Ventas estimadas</div>
                            <div class="o_margin_kpi_value"><field name="estimated_sales_amount" widget="monetary" nolabel="1"/></div>
                            <div class="o_margin_kpi_meta">SO sin factura · no sumadas a reales</div>
                        </div>
                        <div class="o_margin_kpi_card">
                            <div class="o_margin_kpi_title">Margen estimado</div>
                            <div class="o_margin_kpi_value"><field name="estimated_margin_total" widget="monetary" nolabel="1"/></div>
                            <div class="o_margin_kpi_meta">Incluye operaciones abiertas</div>
                        </div>
                    </div>

                    <separator string="Posición financiera"/>
                    <div class="o_margin_board_kanban">
                        <div class="o_margin_kpi_card o_margin_kpi_warn">
                            <div class="o_margin_kpi_title">Cuentas por cobrar</div>
                            <button name="action_open_amount_to_collect" type="object" class="btn btn-link p-0">
                                <div class="o_margin_kpi_value"><field name="amount_to_collect_total" widget="monetary" nolabel="1"/></div>
                            </button>
                            <div class="o_margin_kpi_meta">
                                <field name="balance_as_of_label" nolabel="1"/>
                            </div>
                            <div class="o_margin_kpi_meta">
                                <field name="cxc_breakdown_label" nolabel="1"/>
                            </div>
                        </div>
                        <div class="o_margin_kpi_card o_margin_kpi_warn">
                            <div class="o_margin_kpi_title">Cuentas por pagar</div>
                            <button name="action_open_amount_to_pay" type="object" class="btn btn-link p-0">
                                <div class="o_margin_kpi_value"><field name="amount_to_pay_total" widget="monetary" nolabel="1"/></div>
                            </button>
                            <div class="o_margin_kpi_meta">
                                <field name="balance_as_of_label" nolabel="1"/>
                            </div>
                            <div class="o_margin_kpi_meta">
                                <field name="cxp_breakdown_label" nolabel="1"/>
                            </div>
                        </div>
                        <div class="o_margin_kpi_card">
                            <div class="o_margin_kpi_title">Flujo neto</div>
                            <div class="o_margin_kpi_value"><field name="net_cash_flow" widget="monetary" nolabel="1"/></div>
                            <div class="o_margin_kpi_meta">CxC − CxP al corte</div>
                        </div>
                        <div class="o_margin_kpi_card">
                            <div class="o_margin_kpi_title">Facturas proveedor abiertas</div>
                            <button name="action_open_vendor_bills_balance" type="object" class="btn btn-link p-0">
                                <div class="o_margin_kpi_value"><field name="committed_vendor_flow" widget="monetary" nolabel="1"/></div>
                            </button>
                            <div class="o_margin_kpi_meta">Solo bills/NC · sin CXP Accionistas</div>
                        </div>
                    </div>

                    <separator string="Pendientes"/>
                    <div class="o_margin_board_kanban">
                        <div class="o_margin_kpi_card o_margin_kpi_danger">
                            <div class="o_margin_kpi_title">Ventas sin costos</div>
                            <button name="action_open_sales_without_cost" type="object" class="btn btn-link p-0">
                                <div class="o_margin_kpi_value"><field name="sales_without_cost_count" nolabel="1"/></div>
                            </button>
                            <div class="o_margin_kpi_meta"><field name="sales_without_cost_amount" widget="monetary" nolabel="1"/></div>
                        </div>
                        <div class="o_margin_kpi_card o_margin_kpi_warn">
                            <div class="o_margin_kpi_title">Compras sin ventas</div>
                            <button name="action_open_purchases_without_sale" type="object" class="btn btn-link p-0">
                                <div class="o_margin_kpi_value"><field name="purchases_without_sale_count" nolabel="1"/></div>
                            </button>
                            <div class="o_margin_kpi_meta"><field name="purchases_without_sale_amount" widget="monetary" nolabel="1"/></div>
                        </div>
                        <div class="o_margin_kpi_card">
                            <div class="o_margin_kpi_title">Revisión Compras</div>
                            <button name="action_open_pending_validation" type="object" class="btn btn-link p-0">
                                <div class="o_margin_kpi_value"><field name="pending_validation_count" nolabel="1"/></div>
                            </button>
                        </div>
                        <div class="o_margin_kpi_card">
                            <div class="o_margin_kpi_title">Aprobación Finanzas</div>
                            <button name="action_open_pending_approval" type="object" class="btn btn-link p-0">
                                <div class="o_margin_kpi_value"><field name="pending_approval_count" nolabel="1"/></div>
                            </button>
                        </div>
                        <div class="o_margin_kpi_card o_margin_kpi_danger">
                            <div class="o_margin_kpi_title">Márgenes negativos</div>
                            <button name="action_open_negative_margins" type="object" class="btn btn-link p-0">
                                <div class="o_margin_kpi_value"><field name="negative_margin_count" nolabel="1"/></div>
                            </button>
                        </div>
                    </div>

                    <!-- Help texts hidden from card body; available as optional fields for accessibility -->
                    <group invisible="1">
                        <field name="kpi_sales_help"/>
                        <field name="kpi_costs_help"/>
                        <field name="kpi_margin_help"/>
                        <field name="kpi_collect_help"/>
                        <field name="kpi_pay_help"/>
                        <field name="kpi_sales_no_cost_help"/>
                        <field name="kpi_purchases_no_sale_help"/>
                        <field name="kpi_suggested_help"/>
                        <field name="kpi_approval_help"/>
                        <field name="kpi_negative_help"/>
                        <field name="cxc_dop_amount"/>
                        <field name="cxc_usd_amount"/>
                        <field name="cxc_usd_equiv_dop"/>
                        <field name="cxp_dop_amount"/>
                        <field name="cxp_usd_amount"/>
                        <field name="cxp_usd_equiv_dop"/>
                        <field name="cxp_other_amount"/>
                        <field name="open_vendor_bills_amount"/>
                        <field name="suggested_relation_count"/>
                        <field name="purchases_recovered_amount"/>
                        <field name="purchases_pending_recovery"/>
                        <field name="purchases_pending_payment_count"/>
                        <field name="purchases_without_sale_aux_count"/>
                        <field name="cost_recovery_percent"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Migración de tipo: act_window → server (mismo xmlid) -->
    <delete model="ir.actions.act_window" id="action_purchase_sale_margin_board"/>

    <record id="action_purchase_sale_margin_board" model="ir.actions.server">
        <field name="name">Resumen financiero</field>
        <field name="model_id" ref="model_purchase_sale_margin_board"/>
        <field name="state">code</field>
        <field name="code">action = model.get_board_action()</field>
        <field name="group_ids" eval="[(6, 0, [ref('justech_purchase_sale_margin_control.group_margin_readonly')])]"/>
    </record>

</odoo>
