# === Variables de entorno / secretos ===
.env
.env.*
!.env.example

# === Logs y volcados ===
*.log
*.sql
*.dump
*.backup
*.zip
*.tar
*.tar.gz

# === Datos de Odoo RUNTIME (nunca en Git) ===
# Scoped a raíz para NO excluir los `data/` de los módulos Odoo (addons/**/data/
# contienen XML de datos legítimos del módulo, no datos productivos).
/filestore/
/data/
/backups/
/sessions/
**/filestore/
**/sessions/

# === Python ===
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/
*.egg-info/

# === Editores / IDE / SO ===
.vscode/
.idea/
.DS_Store

# === Configuración real de Odoo y certificados ===
odoo.conf
*.pem
*.key
*.crt
*.pfx
*.p12

# === Doralex: artefactos de servidor que NO se versionan ===
# Addons Enterprise (licencia): se montan en el servidor, nunca en Git.
deployment/doralex/*/enterprise/
# Backups locales de .env dentro de directorios de respaldo.
env.backup

# === Frontend / build ===
node_modules/
dist/
build/
