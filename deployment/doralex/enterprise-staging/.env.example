# Doralex ENTERPRISE STAGING — plantilla. Copiar a `.env` en el servidor.
# NUNCA commitear el `.env` real.

ODOO_ENVIRONMENT=enterprise-staging

POSTGRES_DB=doralex_ent_staging
POSTGRES_USER=doralex_ent_staging
POSTGRES_PASSWORD=

# Community hasta Wave 2. Tras el .deb oficial: doralex-odoo-enterprise:19
ODOO_IMAGE=odoo:19
ODOO_ADMIN_PASSWD=
ODOO_DBFILTER=^doralex_ent_staging$
ODOO_HTTP_PORT=8269
ODOO_LONGPOLLING_PORT=8272

# Addons Enterprise clonados en ESTE entorno (nunca /opt/doralex/enterprise
# mientras Prod Community siga montando ese path).
ENTERPRISE_SRC=./enterprise-addons
CUSTOM_ADDONS_SRC=./custom-addons
ENTERPRISE_SOURCE_PENDING=TRUE

ODOO_BASE_URL=https://enterprise.doralexgroup.cloud
