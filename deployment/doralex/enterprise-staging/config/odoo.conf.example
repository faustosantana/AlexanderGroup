; Doralex ENTERPRISE STAGING — plantilla (se renderiza a odoo.conf).

[options]
admin_passwd = ${ODOO_ADMIN_PASSWD}

dbfilter = ${ODOO_DBFILTER}
list_db = False

; Enterprise (staging) + custom Doralex. El core 19 viene de la imagen.
addons_path = /mnt/enterprise,/mnt/custom-addons
server_wide_modules = base,web

data_dir = /var/lib/odoo

proxy_mode = True
http_enable = True
http_port = 8069
gevent_port = 8072

; Staging: un worker para no competir con Prod/Dev (host ~8 GiB).
workers = 1
max_cron_threads = 1
limit_time_cpu = 600
limit_time_real = 1200
limit_request = 8192
limit_memory_soft = 1610612736
limit_memory_hard = 2147483648

log_level = info
logfile = /var/log/odoo/odoo.log
