# Reverse proxy — ENTERPRISE STAGING
# Dominio: enterprise.doralexgroup.cloud -> 127.0.0.1:8269 (ws 8272)
# Requiere registro A a 2.25.121.111 y certificado Let's Encrypt.
# No sustituye doralexgroup.cloud.

upstream doralex_ent_staging_odoo {
    server 127.0.0.1:8269;
}
upstream doralex_ent_staging_odoo_chat {
    server 127.0.0.1:8272;
}

server {
    listen 80;
    server_name enterprise.doralexgroup.cloud;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

