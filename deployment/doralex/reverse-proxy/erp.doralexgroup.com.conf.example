# Reverse proxy (Nginx de host) — PRODUCCION
# Dominio previsto: erp.doralexgroup.com  ->  Odoo Produccion (127.0.0.1:8069)
# ------------------------------------------------------------------------------
# ESTADO: PENDING_DNS. No emitir certificados ni activar 443 hasta que el DNS
# de erp.doralexgroup.com resuelva a la IP del servidor. Ver DNS_AND_SSL.md.
# Certificados con certbot (Let's Encrypt); NUNCA commitear *.pem/*.key/*.crt.
# ------------------------------------------------------------------------------

upstream doralex_prod_odoo {
    server 127.0.0.1:8069;
}
upstream doralex_prod_odoo_chat {
    server 127.0.0.1:8072;
}

# HTTP: solo para el challenge de certbot y redirección a HTTPS (activar tras DNS).
server {
    listen 80;
    server_name erp.doralexgroup.com;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

