# Reverse proxy (Nginx de host) — DEV
# Dominio previsto: dev.doralexgroup.com  ->  Odoo Dev (127.0.0.1:8169)
# ------------------------------------------------------------------------------
# ESTADO: PENDING_DNS. No emitir certificados ni activar 443 hasta que el DNS
# de dev.doralexgroup.com resuelva a la IP del servidor. Ver DNS_AND_SSL.md.
# ------------------------------------------------------------------------------

upstream doralex_dev_odoo {
    server 127.0.0.1:8169;
}
upstream doralex_dev_odoo_chat {
    server 127.0.0.1:8172;
}

server {
    listen 80;
    server_name dev.doralexgroup.com;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

