; Doralex DEV — odoo.conf (PLANTILLA)
; Se RENDERIZA a `config/odoo.conf` (gitignored) con scripts/render_config.sh.
; NUNCA commitear el odoo.conf renderizado.

[options]
admin_passwd = ${ODOO_ADMIN_PASSWD}

; Conexión a DB por variables de entorno del contenedor (ver docker-compose.yml).

dbfilter = ${ODOO_DBFILTER}
; En Dev puede activarse el gestor de bases para crear/duplicar entornos de prueba.
list_db = True

; --- addons_path FINAL (idéntico a Produccion, enterprise-ready) ---
addons_path = /mnt/enterprise,/mnt/custom-addons
server_wide_modules = base,web

data_dir = /var/lib/odoo

proxy_mode = True
http_enable = True
http_port = 8069
gevent_port = 8072

; Dev con menos recursos que Produccion (pero misma arquitectura).
workers = 2
max_cron_threads = 1
limit_time_cpu = 600
limit_time_real = 1200

log_level = info
logfile = /var/log/odoo/odoo.log
