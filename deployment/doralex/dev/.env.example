# Doralex DEV — variables de entorno (PLANTILLA)
# Copiar a `.env` en el servidor y completar. NUNCA commitear el `.env` real.

# --- Identidad del entorno ---
ODOO_ENVIRONMENT=dev

# --- PostgreSQL (aislado de Produccion) ---
POSTGRES_DB=doralex_dev
POSTGRES_USER=doralex_dev
POSTGRES_PASSWORD=

# --- Odoo ---
ODOO_IMAGE=odoo:19
ODOO_ADMIN_PASSWD=
# En Dev el dbfilter puede ser más laxo para permitir bases de prueba doralex_dev*.
ODOO_DBFILTER=^doralex_dev.*$
# Puertos DISTINTOS a Produccion (solo loopback); el proxy enruta dev.doralexgroup.com aquí.
ODOO_HTTP_PORT=8169
ODOO_LONGPOLLING_PORT=8172

# --- Dominio previsto (ver DNS_AND_SSL.md) ---
ODOO_BASE_URL=https://dev.doralexgroup.com
