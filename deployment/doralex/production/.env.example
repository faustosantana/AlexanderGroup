# Doralex PRODUCCION — variables de entorno (PLANTILLA)
# Copiar a `.env` en el servidor y completar con valores fuertes.
# NUNCA commitear el `.env` real. Los valores sensibles aquí van VACIOS o placeholder.

# --- Identidad del entorno ---
ODOO_ENVIRONMENT=production

# --- PostgreSQL (aislado de Dev) ---
POSTGRES_DB=doralex_prod
POSTGRES_USER=doralex_prod
POSTGRES_PASSWORD=

# --- Odoo ---
# Imagen: por defecto Community. Cambiar a imagen Enterprise cuando exista licencia.
ODOO_IMAGE=odoo:19
# admin_passwd (master password de Odoo). Se inyecta en odoo.conf vía render_config.sh.
ODOO_ADMIN_PASSWD=
# dbfilter para aislar la base productiva (regex).
ODOO_DBFILTER=^doralex_prod$
# Publicación SOLO a loopback; el reverse proxy enruta erp.doralexgroup.com aquí.
ODOO_HTTP_PORT=8069
ODOO_LONGPOLLING_PORT=8072

# --- Dominio previsto (ver DNS_AND_SSL.md) ---
ODOO_BASE_URL=https://erp.doralexgroup.com
