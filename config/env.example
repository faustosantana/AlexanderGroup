# Plantilla de variables de entorno — Alexander Group (Odoo 19)
# Copiar como `.env` y completar. NUNCA subir el `.env` real al repositorio.
# Todos los valores sensibles se dejan VACÍOS a propósito.

ODOO_VERSION=19
ODOO_ENVIRONMENT=development

# --- Base de datos (conexión de Odoo) ---
ODOO_DB_HOST=
ODOO_DB_PORT=5432
ODOO_DB_USER=
ODOO_DB_PASSWORD=
ODOO_DB_NAME=

# --- PostgreSQL (servicio) ---
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# --- Odoo ---
ODOO_ADMIN_PASSWD=
ODOO_BASE_URL=

# --- Correo saliente (SMTP) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# --- Rutas ---
BACKUP_PATH=
ADDONS_PATH=
